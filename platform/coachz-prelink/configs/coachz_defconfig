# Source-only CPU/GIC baseline. No peripheral driver is qualified on Coachz.
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# The block device class is UniXNU RamBlock, with USB behind it (platform drivers/RamBlock).
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# CONFIG_XNU_BOOT_PROGRESS is not set
# The BCM2837 fixed panic region address is not memory on SC7180; ask the device tree instead.
CONFIG_XNU_DT_PANIC_REGION=y
