+    if(!init(event,kTemperatureEventBytes)) {event->release();return nullptr;}
+    auto raw=reinterpret_cast<uint8_t *>(event);
+    auto data=*reinterpret_cast<uint8_t **>(raw+16);
+    *reinterpret_cast<uint64_t *>(raw+48)=mach_absolute_time();
+    *reinterpret_cast<uint64_t *>(raw+64)=1ull<<15;
+    *reinterpret_cast<uint32_t *>(raw+72)=1;
+    *reinterpret_cast<uint32_t *>(data+4)=15;
+    *reinterpret_cast<uint32_t *>(data+8)=1;
+    *reinterpret_cast<int32_t *>(data+16)=fixed;
+    return event;
+}
+static OSObject *coachzTemperatureCopyEvent(IOService *driver,uint32_t type,OSObject *matching,uint32_t options) {
+    if(type!=15)return gOriginalCopyEvent(driver,type,matching,options);
+    const uint32_t count=gTemperatureDriverCount;
+    for(uint32_t n=0;n<count;++n) {
+        if(gTemperatureDrivers[n].driver!=driver)continue;
+        const uint8_t source=gTemperatureDrivers[n].source;
+        const int64_t milli=source==COACHZ_TEMP_BATTERY?(int64_t)coachz_battery_centi_c*10:(int64_t)coachz_tsens_mc[source>>4][source&15];
+        coachz_temperature_reads=coachz_temperature_reads+1;
+        return coachzTemperatureEvent((int32_t)(milli*65536/1000));
+    }
+    return nullptr;
+}
+static bool coachzHookTemperatureDriver(IOService *driver,uint8_t source) {
+    auto object=reinterpret_cast<void ***>(driver);
+    if(!gTemperatureDriverVtable) {
+        auto copy=static_cast<void **>(IOMalloc(kEventDriverSlots*sizeof(void *)));
+        if(!copy)return false;
+        memcpy(copy,*object,kEventDriverSlots*sizeof(void *));
+        gOriginalCopyEvent=reinterpret_cast<CopyEventFunction>(copy[kCopyEventSlot]);
+        copy[kCopyEventSlot]=reinterpret_cast<void *>(coachzTemperatureCopyEvent);
+        gTemperatureDriverVtable=copy;
+    }
+    const uint32_t n=gTemperatureDriverCount;
+    if(n>=kTemperatureSensorCount)return false;
+    gTemperatureDrivers[n].driver=driver;
+    gTemperatureDrivers[n].source=source;
+    __sync_synchronize();
+    gTemperatureDriverCount=n+1;
+    __sync_synchronize();
+    *object=gTemperatureDriverVtable;
+    return true;
+}
+
+class CoachzTemperatureDevice : public IOHIDDevice {
+    OSDeclareDefaultStructors(CoachzTemperatureDevice)
+    static IOWorkLoop *sharedLoop;
+    IOTimerEventSource *timer=nullptr;
+    unsigned index=0,tries=0;
+    static void tick(OSObject *owner,IOTimerEventSource *sender) {
+        auto self=OSDynamicCast(CoachzTemperatureDevice,owner);
+        if(!self)return;
+        IOService *interface=self->getClient();
+        IOService *driver=interface?interface->getClient():nullptr;
+        if(driver && driver->metaCast("IOHIDEventDriver")) {
+            if(!coachzHookTemperatureDriver(driver,kTemperatureSensors[self->index].source))printf("COACHZ thermal: could not take over the '%s' driver\n",kTemperatureSensors[self->index].name);
+            return;
+        }
+        if(++self->tries<240)sender->setTimeoutMS(500);
+        else printf("COACHZ thermal: no driver above '%s'\n",kTemperatureSensors[self->index].name);
+    }
+public:
+    void setIndex(unsigned value) {index=value;}
+    IOWorkLoop *getWorkLoop() const override {return sharedLoop;}
+    OSString *newTransportString() const override {return OSString::withCString("SPU");}
+    OSString *newProductString() const override {return OSString::withCString(kTemperatureSensors[index].name);}
+    IOReturn newReportDescriptor(IOMemoryDescriptor **out) const override {
+        // The primary pair {0xff00, 5}; one vendor bit, which IOHIDEventDriver keeps so that it starts, in a report never sent; the motion sensors' empty
+        // collection {0xff0c, 3} that its personality attaches by.
+        static const unsigned char descriptor[]={0x06,0x00,0xff,0x09,0x05,0xa1,0x01,
+            0x06,0x01,0xff,0x09,0x01,0x15,0x00,0x25,0x01,0x75,0x01,0x95,0x01,0x81,0x02,0x95,0x07,0x81,0x03,0xc0,
+            0x06,0x0c,0xff,0x09,0x03,0xa1,0x01,0xc0};
+        if(!out)return kIOReturnBadArgument;
+        *out=IOBufferMemoryDescriptor::withBytes(descriptor,sizeof(descriptor),kIODirectionNone);
+        return *out?kIOReturnSuccess:kIOReturnNoMemory;
+    }
+    bool start(IOService *provider) override {
+        if(!sharedLoop)sharedLoop=IOWorkLoop::workLoop();
+        if(!sharedLoop)return false;
+        if(!setProperty("HIDDefaultBehavior",true))return false;
+        setProperty("Built-In",true);
+        if(!IOHIDDevice::start(provider))return false;
+        timer=IOTimerEventSource::timerEventSource(this,tick);
+        if(!timer || sharedLoop->addEventSource(timer)!=kIOReturnSuccess) {OSSafeReleaseNULL(timer);return false;}
+        timer->setTimeoutMS(100);
+        return true;
+    }
+    void stop(IOService *provider) override {
+        if(timer){timer->cancelTimeout();sharedLoop->removeEventSource(timer);OSSafeReleaseNULL(timer);}
+        IOHIDDevice::stop(provider);
+    }
+    void free() override {IOHIDDevice::free();}
+};
+IOWorkLoop *CoachzTemperatureDevice::sharedLoop=nullptr;
+OSDefineMetaClassAndStructors(CoachzTemperatureDevice,IOHIDDevice)
+extern "C" unsigned coachz_temperature_hid_count(void) {return kTemperatureSensorCount;}
+extern "C" IOService *coachz_temperature_hid_allocate(unsigned index) {auto device=new CoachzTemperatureDevice;if(device)device->setIndex(index);return device;}
