+def coachz_usb_declared_dependencies(entries, original_data, roots):
+    """Two stale AppleSMC library declarations in the qualified ARM64 cache.
+
+    Neither library exists in that cache. Keep every executable, pointer and
+    instruction relocation check: any real reference must still resolve against
+    a selected component or an exact native kernel export.
+    """
+    usb = 'com.apple.driver.usb.AppleUSBHostT8011'
+    if usb not in roots:
+        return []
+    if hashlib.sha256(original_data).hexdigest() != 'f18b4df865405f2a287b84977d7aca745e056d656d9fc9df1662970ce2969de7':
+        raise ValueError('USB dependency normalization requires the qualified kernelcache')
+    expected = {'com.apple.iokit.IOACPIFamily': '1.4', 'com.apple.driver.watchdog': '1.0.0'}
+    libraries = entries['com.apple.driver.AppleSMC']['OSBundleLibraries']
+    if any(key in entries or libraries.get(key) != version for key, version in expected.items()):
+        raise ValueError('Unexpected AppleSMC dependency metadata')
+    for key in expected:
+        del libraries[key]
+    return sorted(expected)
+
