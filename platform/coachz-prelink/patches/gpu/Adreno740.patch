+unsigned NativeAdrenoVm::walkBits(const Mapping &m) const
+{
+    const NativeAdrenoMemory *memory=m.memory;
+    if(!memory)return 0;
+    unsigned bits=0;
+    const bool skipped=coherentMapping(m.writeback) || importedUntouched(memory);
+    const bool ready=memory->backed() && memory->prepared() && !memory->quarantined();
+    /* publishForDevice does nothing for an import every CPU mapping holds non-cacheable, nor for a trusted write-combined BO. */
+    if(skipped)bits|=WalkPublishSkip;
+    else if(!ready || !((memory->imported() && memory->ownerUncached()) ||
+        (!memory->imported() && memory->writeCombined() && !distrust_write_combined_)))bits|=WalkPublish;
+    /* acquireDeviceWrites visits GPU-writable imports alone and does nothing for one held non-cacheable. */
+    if(memory->imported() && (m.permissions&ArmSmmu4KWrite)) {
+        if(skipped)bits|=WalkAcquireSkip;
+        else if(!ready || !memory->ownerUncached())bits|=WalkAcquire;
+    }
+    if(memory->writeCombined() && memory->spanCount() && !memory->system())bits|=WalkReassert;
+    return bits;
+}
+void NativeAdrenoVm::countWalks(const Mapping &m,bool add)
+{
+    for(unsigned i=0;i<5;++i)if(m.walks&(1u<<i)) {
+        if(add)++walk_counts_[i];
+        else if(walk_counts_[i])--walk_counts_[i];
+    }
 }
+void NativeAdrenoVm::recountWalks()
+{
+    memset(walk_counts_,0,sizeof(walk_counts_));
+    walk_distrust_=distrust_write_combined_;walk_coherent_=native_adreno_io_coherent;
+    for(size_t i=0;i<high_;++i) {
+        Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        m.walks=walkBits(m);countWalks(m,true);
+    }
+}
+void NativeAdrenoVm::refreshWalks()
+{
+    if(walk_distrust_!=distrust_write_combined_ || walk_coherent_!=native_adreno_io_coherent)recountWalks();
+}
