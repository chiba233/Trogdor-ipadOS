+static bool coachzMakeAudit(NBEncoder *encoder) {
+ NBCommandBuffer *commands=encoder.commandBuffer;
+ CoachzTurnAudit *audit=encoder->coachzAuditLease;
+ const size_t bytes=audit.colors.count*512;
+ std::vector<uint32_t> initial(bytes/sizeof(uint32_t),0);
+ for(size_t i=0;i<audit.colors.count*2;i++)initial[i*64+2]=UINT32_MAX;
+ NBBuffer *report=[NBBuffer new];
+ report.handle=nmb_buffer_new(gDevice,bytes,MTLResourceStorageModeShared,initial.data());
+ report.options=MTLResourceStorageModeShared;
+ if(!report.handle)return false;
+ audit.report=report;
+ [commands.coachzEncodedOwners addObject:report];
+ [commands.coachzEncodedOwners addObject:encoder->coachzAuditPipeline];
+ [commands.coachzEncodedOwners addObject:encoder->coachzTurnView];
+ const uint64_t threads[3]={128,128,1},group[3]={16,8,1};
+ NmbEncoder *compute=nmb_compute_encoder_new(commands.handle);
+ if(!compute)return false;
+ bool ok=nmb_compute_set_pipeline(compute,encoder->coachzAuditPipeline.handle);
+ for(NSUInteger i=0;ok && i<audit.colors.count;i++) {
+  CoachzTurnColor *color=audit.colors[i];
+  if(color.store!=MTLStoreActionStore)continue;
+  const uint32_t dimensions[4]={(uint32_t)color.source.width,(uint32_t)color.source.height,encoder->coachzNative?1u:0u,0};
+  ok=nmb_encoder_set_texture(compute,0,color.source.handle,0) && nmb_encoder_set_texture(compute,0,color.rotated.handle,1) &&
+   nmb_encoder_set_buffer(compute,0,report.handle,i*256,0) && nmb_encoder_set_bytes(compute,0,dimensions,sizeof dimensions,1) &&
+   nmb_compute_dispatch(compute,threads,group,true);
+  if(ok) {
+   const uint32_t identity[4]={(uint32_t)color.source.width,(uint32_t)color.source.height,1,0};
+   ok=nmb_encoder_set_texture(compute,0,color.control.handle,1) &&
+    nmb_encoder_set_buffer(compute,0,report.handle,(audit.colors.count+i)*256,0) &&
+    nmb_encoder_set_bytes(compute,0,identity,sizeof identity,1) && nmb_compute_dispatch(compute,threads,group,true);
+  }
+ }
+ if(!ok){nmb_encoder_discard(compute);return false;}
+ return nmb_encoder_end(compute);
+}
