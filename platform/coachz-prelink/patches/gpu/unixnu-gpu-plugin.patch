+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_coachz_placement_profile(out: *mut u64, overflow: *mut u64) -> bool {
+    if out.is_null() || overflow.is_null() { return false; }
+    let (rows, skipped) = metal2vulkan_runtime::coachz_placement_profile();
