+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_coachz_copy_profile(out: *mut u64, rows: usize) -> usize {
+    if out.is_null() || rows == 0 { return 0; }
+    let profile = metal2vulkan_runtime::coachz_copy_profile();
+    let count = profile.len().min(rows);
+    for (i, row) in profile.iter().take(count).enumerate() {
+        unsafe { std::ptr::copy_nonoverlapping(row.as_ptr(), out.add(i * 8), 8); }
+    }
+    count
+}
