+entry:
+  %twice = shl i32 %vid, 1
+  %bx = and i32 %twice, 2
+  %by = and i32 %vid, 2
+  %fx = tail call float @air.convert.f.f32.u.i32(i32 %bx)
+  %fy = tail call float @air.convert.f.f32.u.i32(i32 %by)
+  %nx = fmul float %fx, 2.000000e+00
+  %ny = fmul float %fy, 2.000000e+00
+  %x = fadd float %nx, -1.000000e+00
+  %y = fadd float %ny, -1.000000e+00
+  %p0 = insertelement <4 x float> <float 0.000000e+00, float 0.000000e+00, float 0.000000e+00, float 1.000000e+00>, float %x, i64 0
+  %p1 = insertelement <4 x float> %p0, float %y, i64 1
+  %uv0 = insertelement <2 x float> poison, float %fy, i64 0
+  %uv = insertelement <2 x float> %uv0, float %fx, i64 1
+  %r0 = insertvalue <{ <4 x float>, <2 x float> }> undef, <4 x float> %p1, 0
+  %r1 = insertvalue <{ <4 x float>, <2 x float> }> %r0, <2 x float> %uv, 1
+  ret <{ <4 x float>, <2 x float> }> %r1
