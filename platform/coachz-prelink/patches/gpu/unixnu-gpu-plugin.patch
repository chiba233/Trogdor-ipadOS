+// Keep the IOSurface contract: external readers and snapshots see completed pixels too.
+// The retained views, not the frame dictionary, own the backing import and countUse lease.
+// Called under gCoachzFrameLock. The surface ID validates its in-band tag.
+static CoachzFrame *coachzFrameForWrite(NBTexture *texture,NBTexture **root) {
+ IOSurfaceRef surface=texture.surface;
+ *root=coachzGpuRoot(texture);
+ if(!surface)return nil;
+ const size_t at=coachzTagOffset(IOSurfaceGetWidth(surface),IOSurfaceGetBytesPerRow(surface),IOSurfaceGetHeight(surface),IOSurfaceGetAllocSize(surface));
+ uint8_t *base=(uint8_t *)IOSurfaceGetBaseAddress(surface);
