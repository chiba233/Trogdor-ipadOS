+// Mask 2: a tracked frame bound to a shader. Metal lets a shader write only a texture whose usage has ShaderWrite (an unknown
+// usage allows anything), so only such a binding can change pixels outside the raster scissors. A read-only binding changes
+// nothing and leaves the mirror's range alone; it is counted.
+static bool coachzShaderMayWriteFrame(NBTexture *texture) {
+ NBTexture *root=nil;os_unfair_lock_lock(&gCoachzFrameLock);
+ CoachzFrame *frame=coachzFrameForWrite(texture,&root);
+ const bool direct=frame && texture.coachzDirect;
+ const uint64_t requested=direct?frame.importDescriptor.usage:0;
+ os_unfair_lock_unlock(&gCoachzFrameLock);
+ if(!frame)return false;
+ auto writable=[](uint64_t usage){return usage==MTLTextureUsageUnknown || (usage&MTLTextureUsageShaderWrite);};
+ if(writable(texture.usage) || writable(root.usage) || (direct && writable(requested)))return true;
+ gCoachzReadBindings++;
+ return false;
+}
+static CoachzFrameWrite *coachzAddFrameWrite(NSMutableArray *writes,NBTexture *texture) {
+ NBTexture *root=nil;os_unfair_lock_lock(&gCoachzFrameLock);
