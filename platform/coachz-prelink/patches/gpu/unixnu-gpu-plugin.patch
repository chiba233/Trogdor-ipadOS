diff --git a/CoachzProfileTrace.h b/CoachzProfileTrace.h
new file mode 100644
--- /dev/null
+++ b/CoachzProfileTrace.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace coachz_profile {
+constexpr uint64_t BlockMagic = UINT64_C(0x33505a4843414f43); // COACHZP3
+constexpr uint64_t EndMagic = UINT64_C(0x3350555047444e45);   // ENDGPUP3
+constexpr uint32_t RecordBytes = 72, MaxRecords = 256;
+struct Block {
+    uint64_t magic, epoch, first;
+    uint32_t version, recordBytes, count, pid;
+    uint64_t dropped, checksum;
+};
+struct End {uint64_t magic, checksum;};
+static_assert(sizeof(Block) == 56 && sizeof(End) == 16, "profile framing ABI");
+constexpr size_t MaxBlockBytes = sizeof(Block) + MaxRecords * RecordBytes + sizeof(End);
+
+inline uint64_t checksum(const void *bytes, size_t count,
+                         uint64_t hash = UINT64_C(14695981039346656037)) {
+    const auto p = static_cast<const uint8_t *>(bytes);
+    for (size_t i = 0; i < count; ++i) hash = (hash ^ p[i]) * UINT64_C(1099511628211);
+    return hash;
+}
+
+// Resume exactly where a short write stopped. EINTR retries; a real failure
+// leaves offset and the caller's immutable block intact for the next attempt.
+template<class Write>
+bool writePending(Write write, const void *bytes, size_t size, size_t &offset, int &error) {
+    if (offset > size) {error = EINVAL; return false;}
+    const auto p = static_cast<const uint8_t *>(bytes);
+    while (offset < size) {
+        const auto done = write(p + offset, size - offset);
+        if (done > 0) {
+            if (size_t(done) > size - offset) {error = EIO; return false;}
+            offset += size_t(done);
+            continue;
+        }
+        if (done < 0 && errno == EINTR) continue;
+        error = done == 0 || !errno ? EIO : errno;
+        return false;
+    }
+    error = 0;
+    return true;
+}
+
+inline size_t seal(void *out, const void *records, uint32_t count, uint64_t epoch,
+                   uint64_t first, uint64_t dropped, uint32_t pid) {
+    if (!count || count > MaxRecords) return 0;
+    const size_t payload = size_t(count) * RecordBytes;
+    Block block{BlockMagic, epoch, first, 3, RecordBytes, count, pid, dropped, 0};
+    const uint64_t hash = checksum(records, payload, checksum(&block, sizeof block));
+    block.checksum = hash;
+    const End end{EndMagic, hash};
+    auto p = static_cast<uint8_t *>(out);
+    // memmove permits the producer to snapshot directly after the header.
+    memmove(p + sizeof(Block), records, payload);
+    memcpy(p, &block, sizeof block);
+    memcpy(p + sizeof(Block) + payload, &end, sizeof end);
+    return sizeof(Block) + payload + sizeof(End);
+}
+
+inline bool validate(const void *bytes, size_t available, Block &out, size_t &size) {
+    size = 0;
+    if (available < sizeof(Block)) return false;
+    const auto p = static_cast<const uint8_t *>(bytes);
+    memcpy(&out, p, sizeof out);
+    if (out.magic != BlockMagic || out.version != 3 || out.recordBytes != RecordBytes ||
+        !out.count || out.count > MaxRecords) return false;
+    const size_t payload = size_t(out.count) * RecordBytes;
+    const size_t total = sizeof(Block) + payload + sizeof(End);
+    if (available < total) return false;
+    End end{};memcpy(&end, p + sizeof(Block) + payload, sizeof end);
+    Block checked = out;checked.checksum = 0;
+    if (end.magic != EndMagic || end.checksum != out.checksum ||
+        checksum(p + sizeof(Block), payload, checksum(&checked, sizeof checked)) != out.checksum) return false;
+    size = total;
+    return true;
+}
+}
diff --git a/CoachzExportScratch.h b/CoachzExportScratch.h
new file mode 100644
--- /dev/null
+++ b/CoachzExportScratch.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstddef>
+#include <mutex>
+#include <vector>
+
+// Only successful GPU completion returns a report here. Leased reports stay
+// with their command buffers and are never members of this free list.
+template<class Resource>
+class CoachzExportScratch {
+    struct Entry {Resource resource;size_t bytes;};
+    std::mutex lock_;
+    std::vector<Entry> free_;
+    size_t bytes_ = 0;
+public:
+    static constexpr size_t MaxBytes = 1024 * 1024, MaxResource = 64 * 1024, MaxCount = 32;
+    Resource take(size_t bytes) {
+        std::lock_guard<std::mutex> guard(lock_);
+        size_t best = free_.size();
+        for (size_t i = 0; i < free_.size(); ++i)
+            if (free_[i].bytes >= bytes && (best == free_.size() || free_[i].bytes < free_[best].bytes)) best = i;
+        if (best == free_.size()) return {};
+        Resource resource = free_[best].resource;
+        bytes_ -= free_[best].bytes;
+        free_.erase(free_.begin() + best);
+        return resource;
+    }
+    bool recycleCompleted(Resource resource, size_t bytes) {
+        if (!resource || !bytes || bytes > MaxResource) return false;
+        std::lock_guard<std::mutex> guard(lock_);
+        if (free_.size() >= MaxCount || bytes > MaxBytes - bytes_) return false;
+        free_.push_back({resource, bytes});bytes_ += bytes;
+        return true;
+    }
+    void purge() {
+        std::vector<Entry> gone;
+        {std::lock_guard<std::mutex> guard(lock_);gone.swap(free_);bytes_ = 0;}
+        // Release resources outside the pool lock.
+    }
+};
diff --git a/CoachzPublicationDamage.h b/CoachzPublicationDamage.h
new file mode 100644
--- /dev/null
+++ b/CoachzPublicationDamage.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+// Damage is in the canonical target's coordinates. Partial publication is
+// allowed only over initialized pixels and bounded writes to this same side.
+class CoachzPublicationDamage {
+public:
+    struct Rect {uint64_t x=0,y=0,width=0,height=0;};
+private:
+    uint64_t width_,height_;
+    bool full_;
+    Rect dirty_{};
+public:
+    CoachzPublicationDamage(uint64_t width,uint64_t height,bool initialized)
+        :width_(width),height_(height),full_(!initialized) {}
+    void add(Rect r,bool bounded,bool sameSide) {
+        if(!bounded || !sameSide){full_=true;return;}
+        if(r.x>=width_ || r.y>=height_)return;
+        r.width=std::min(r.width,width_-r.x);r.height=std::min(r.height,height_-r.y);
+        if(!r.width || !r.height)return;
+        if(!dirty_.width || !dirty_.height){dirty_=r;return;}
+        const uint64_t x=std::min(dirty_.x,r.x),y=std::min(dirty_.y,r.y);
+        dirty_={x,y,std::max(dirty_.x+dirty_.width,r.x+r.width)-x,
+                    std::max(dirty_.y+dirty_.height,r.y+r.height)-y};
+    }
+    Rect rect()const{return full_?Rect{0,0,width_,height_}:dirty_;}
+};
