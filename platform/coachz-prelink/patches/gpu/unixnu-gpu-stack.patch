++}
++
+ static VkResult
+ darwin_device_check_status(struct tu_device *device)
+ {
+@@ -1743,10 +1752,13 @@ darwin_device_check_status(struct tu_device *device)
+    if (kr != KERN_SUCCESS)
+       return vk_device_set_lost(&device->vk, "error getting GPU status: 0x%x", kr);
+    if (reply.faults != device->fault_count) {
+-      const uint64_t before = device->fault_count;
++      /* UniXNU c72a8a5: the kernel ended a submission of this device (a hang or a fault): it retired that submission, restarted the
++       * GPU and replayed every other one. The device's memory, pipelines and queues are as they were, so the device is not lost: a
++       * Metal device keeps its resources across a GPU restart and only the command buffer in flight ends with an error, and a render
++       * server cannot make its resources again. The count is kept for telemetry (tu_darwin_restarts).
