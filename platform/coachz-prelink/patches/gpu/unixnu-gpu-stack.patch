+--- a/crates/metal2vulkan-runtime/src/shadow.rs
++++ b/crates/metal2vulkan-runtime/src/shadow.rs
+@@ -3083,3 +3083,48 @@
+         copies
+     }
+ }
++
++// Coachz: planned payload bytes, not measured DRAM traffic or completed work.
++// Unknown representations are counted rather than converted with an assumed bytes-per-pixel.
++static COACHZ_COPIES: std::sync::Mutex<Vec<[u64; 8]>> = std::sync::Mutex::new(Vec::new());
++pub(super) fn coachz_count_copy(copy: &ShadowCopy) {
++    let backing = match copy.copies.backing {
++        Backing::Image => 0, Backing::PrivateBuffer => 1, Backing::MappedBuffer => 2,
++        Backing::HostPages => 3, Backing::AliasedHostPages => 4, Backing::Surface => 5,
++    };
++    let cause = match (&copy.step, copy.cause) {
++        (Step::Back, _) => 0, (Step::Keep(_), _) => 1, (Step::Merge(_), _) => 2,
++        (_, Some(CopyCause::First)) => 3, (_, Some(CopyCause::BeyondHeld)) => 4,
++        (_, Some(CopyCause::Bounded)) => 5, (_, Some(CopyCause::Changed(Lost::OtherShadow))) => 6,
++        (_, Some(CopyCause::Changed(Lost::TwoWays))) => 7,
++        (_, Some(CopyCause::Changed(Lost::Written))) => 8,
++        (_, Some(CopyCause::Changed(Lost::Within))) => 9,
++        (_, Some(CopyCause::Changed(Lost::Dropped))) => 10, _ => 11,
++    };
++    let known = match copy.copies.target() {
++        Some(ShadowTarget::Image { texel: Some(bpp), regions, .. }) => {
++            let w = regions.iter().map(|r| r.image_extent.width).max().unwrap_or(0) as u64;
++            let h = regions.iter().map(|r| r.image_extent.height).max().unwrap_or(0) as u64;
++            (copy.texels_in().checked_mul(*bpp), copy.texels_back().checked_mul(*bpp), w, h)
++        },
++        _ => (None, None, 0, 0),
++    };
++    let Ok(mut rows) = COACHZ_COPIES.lock() else { return; };
++    let index = match rows.iter().position(|r| r[0] == backing && r[1] == cause) {
++        Some(i) => i,
++        None if rows.len() < 96 => { rows.push([backing, cause, 0, 0, 0, 0, 0, 0]); rows.len() - 1 },
++        None => return,
++    };
++    let r = &mut rows[index];r[2] += 1;
++    match known {
++        (Some(a), Some(b), w, h) if matches!(copy.step, Step::Into | Step::Back) => {
++            r[3] = r[3].saturating_add(a);r[4] = r[4].saturating_add(b);
++            if w * h > r[6] * r[7] { r[6] = w;r[7] = h; }
++        },
++        _ => r[5] += 1,
++    }
++}
++pub(super) fn coachz_copy_profile() -> Vec<[u64; 8]> {
++    let Ok(rows) = COACHZ_COPIES.lock() else { return Vec::new(); };
++    let mut rows = rows.clone();rows.sort_by_key(|r| std::cmp::Reverse(r[3].saturating_add(r[4])));rows
++}
