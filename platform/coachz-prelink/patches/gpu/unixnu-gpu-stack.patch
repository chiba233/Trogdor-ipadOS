+ 
++/* Submissions of this process's devices the kernel ended at a hang or a fault (darwin_device_check_status). */
++static uint32_t darwin_restarts;
++extern "C" __attribute__((visibility("default"))) uint32_t tu_darwin_restarts(void);
++extern "C" __attribute__((visibility("default"))) uint32_t
++tu_darwin_restarts(void)
++{
