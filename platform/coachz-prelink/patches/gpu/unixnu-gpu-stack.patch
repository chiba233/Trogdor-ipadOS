++static void coachz_image_layout(const struct tu_image *image, const VkImageCreateInfo *info)
++{
++   if ((uint64_t)info->extent.width * info->extent.height < 2000000) return;
++   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
++   static uint64_t keys[32][7];
++   static unsigned used;
++   const VkImageFormatListCreateInfo *list = vk_find_struct_const(info->pNext, IMAGE_FORMAT_LIST_CREATE_INFO);
++   const uint64_t key[7] = {info->format,info->extent.width,info->extent.height,info->usage,info->flags,
++                           image->layout[0].tile_mode | (uint64_t)image->layout[0].ubwc << 32,
++                           list ? list->viewFormatCount : 0};
++   simple_mtx_lock(&lock);
++   for (unsigned i=0; i<used; ++i) if (!memcmp(keys[i],key,sizeof key)) { simple_mtx_unlock(&lock); return; }
++   if (used == 32) { simple_mtx_unlock(&lock); return; }
++   memcpy(keys[used++],key,sizeof key);
++   simple_mtx_unlock(&lock);
++   char text[96] = {};
++   snprintf(text,sizeof(text),"IMG f%u %ux%u u%x fl%x tile%u ubwc%u views%u",info->format,
++      info->extent.width,info->extent.height,info->usage,info->flags,image->layout[0].tile_mode,
++      image->layout[0].ubwc,list ? list->viewFormatCount : 0);
++   uint32_t words[24];memcpy(words,text,sizeof(words));tu_darwin_note(3,words,24);
++}
++#endif
+
+ template <chip CHIP>
+ VkResult
+@@ -829,6 +855,9 @@
+          image->vk.array_layers * sizeof(struct tu_subsampled_metadata);
+    }
+
++#ifdef TU_HAS_DARWIN
