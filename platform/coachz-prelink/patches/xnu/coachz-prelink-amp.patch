+#if CONFIG_SCHED_EDGE
 /*
+ * Coachz: no CLPC runs here to recommend clusters, and with every thread group left on pset0 (the A55s) the
+ * default edges would never let it reach the A76s (E->P migration is off). Once all clusters are up
+ * (sched_edge_cpu_init_completed) the fixed-priority, foreground and user-initiated buckets prefer the P
+ * cluster and default, utility and background the E cluster; the P->E edge spills work back when the two
+ * A76s are busy. Before that every bucket stays on the boot cluster, whose pset is the only one sure to exist.
+ */
+static bool sched_edge_coachz_recommend;
+static uint32_t sched_edge_coachz_p_cluster;
+
+static uint32_t
+sched_edge_coachz_bucket_cluster(sched_bucket_t bucket)
+{
+	if (!os_atomic_load(&sched_edge_coachz_recommend, acquire)) {
+		return pset0.pset_cluster_id;
+	}
+	switch (bucket) {
+	case TH_BUCKET_FIXPRI:
+	case TH_BUCKET_SHARE_FG:
+	case TH_BUCKET_SHARE_IN:
+		return sched_edge_coachz_p_cluster;
+	default:
+		return pset0.pset_cluster_id;
+	}
+}
+#endif /* CONFIG_SCHED_EDGE */
