+/* Coachz: the fixed recommendation above for one thread group (thread_group_coachz_foreach). */
+static void
+sched_edge_coachz_recommend_tg(struct thread_group *tg)
+{
+	uint32_t preferred[TH_BUCKET_SCHED_MAX];
+	for (sched_bucket_t bucket = TH_BUCKET_FIXPRI; bucket < TH_BUCKET_SCHED_MAX; bucket++) {
+		preferred[bucket] = sched_edge_coachz_bucket_cluster(bucket);
+	}
+	sched_edge_tg_preferred_cluster_change(tg, preferred, 0);
+}
+
+static void
+sched_edge_coachz_recommend_all(void)
+{
+	uint32_t p_cluster = UINT32_MAX;
+	for (int cluster_id = 0; cluster_id < sched_edge_max_clusters; cluster_id++) {
+		if (pset_array[cluster_id] != PROCESSOR_SET_NULL && pset_array[cluster_id]->pset_type == CLUSTER_TYPE_P) {
+			p_cluster = (uint32_t)cluster_id;
+			break;
+		}
+	}
+	if (p_cluster == UINT32_MAX) {
+		printf("COACHZ sched: no P cluster, every bucket stays on cluster %u\n", pset0.pset_cluster_id);
+		return;
+	}
+	sched_edge_coachz_p_cluster = p_cluster;
+	os_atomic_store(&sched_edge_coachz_recommend, true, release);
+	thread_group_coachz_foreach(sched_edge_coachz_recommend_tg);
+	printf("COACHZ sched: Edge, %d clusters, FIXPRI/FG/IN prefer P cluster %u, DF/UT/BG cluster %u\n",
+	    sched_edge_max_clusters, p_cluster, pset0.pset_cluster_id);
+}
