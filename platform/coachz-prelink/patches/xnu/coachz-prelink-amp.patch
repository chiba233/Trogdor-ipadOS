 /*
+ * Coachz: every existing thread group, under tg_lock (sched_clutch.c's recommendation once all clusters are up).
+ */
+void
+thread_group_coachz_foreach(void (*fn)(struct thread_group *))
+{
+	struct thread_group *tg;
+
+	lck_mtx_lock(&tg_lock);
+	qe_foreach_element(tg, &tg_queue, tg_queue_chain) {
+		fn(tg);
+	}
+	lck_mtx_unlock(&tg_lock);
+}
