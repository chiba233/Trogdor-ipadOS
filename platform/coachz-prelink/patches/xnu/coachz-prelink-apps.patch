+	bool installer = kauth_cred_getuid(cred) == 0 &&
+	    (strcmp(path, "/usr/libexec/coachz-apps") == 0 ||
+	    strcmp(path, "/private/var/ngpu/owner-apps/boot/coachz-apps") == 0);
+	bool application = strcmp(path, "/private/var/jb/Applications/Sileo.app/Sileo") == 0 ||
+	    strcmp(path, "/var/jb/Applications/Sileo.app/Sileo") == 0 ||
+	    strcmp(path, "/private/var/jb/Applications/TrollStoreLite.app/TrollStoreLite") == 0 ||
+	    strcmp(path, "/var/jb/Applications/TrollStoreLite.app/TrollStoreLite") == 0;
+	if (installer || application) {
+		__atomic_store_n(&p->p_coachz_apps_nosandbox, 1, __ATOMIC_RELEASE);
+		printf("COACHZ apps: task marked pid %d installer %d application %d\n", proc_pid(p), installer, application);
+	}
+#else
+	(void)p;
+	(void)vp;
+	(void)cred;
+#endif
+}
+
+bool
+coachz_apps_root_skip(struct mac_policy_conf *mpc, proc_t p, const char *operation)
+{
+#if defined(BCM2837)
+	if (__atomic_load_n(&coachz_apps_root_enabled, __ATOMIC_ACQUIRE) &&
+	    p != PROC_NULL && __atomic_load_n(&p->p_coachz_apps_nosandbox, __ATOMIC_ACQUIRE) &&
+	    strcmp(mpc->mpc_name, "Sandbox") == 0) {
+		/* Report the two execution gates once, without paths or credential identifiers. */
+		static unsigned reported;
+		unsigned bit = 0;
+		if (strcmp(operation, "vnode_check_exec") == 0) { bit = 1; }
+		if (strcmp(operation, "file_check_mmap") == 0) { bit = 2; }
+		if (strcmp(operation, "file_check_mmap_downgrade") == 0) { bit = 4; }
+		if (bit && !(__atomic_fetch_or(&reported, bit, __ATOMIC_RELAXED) & bit)) {
+			printf("COACHZ apps: installer tree Sandbox bypass %s\n", operation);
+		}
+		return true;
+	}
+#else
+	(void)mpc;
+	(void)p;
+	(void)operation;
+#endif
+	return false;
+}
