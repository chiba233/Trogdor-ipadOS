+/* Global read/executable extensions for the provisioned rootless tree, without write access.
+ * vn_getpath uses only the name cache here; no filesystem reentry from a MAC hook.
+ */
+bool
+coachz_apps_read_skip(struct mac_policy_conf *mpc, vnode_t vp, const char *operation)
+{
+#if defined(BCM2837)
+	if (__atomic_load_n(&coachz_apps_root_enabled, __ATOMIC_ACQUIRE) && vp != NULLVP &&
+	    strcmp(mpc->mpc_name, "Sandbox") == 0) {
+		char path[MAXPATHLEN];
+		int length = sizeof(path);
+		if (vn_getpath(vp, path, &length) != 0) { return false; }
+		const char *tail = NULL;
+		if (strncmp(path, "/private/var/jb", 15) == 0) { tail = path + 15; }
+		if (strncmp(path, "/var/jb", 7) == 0) { tail = path + 7; }
+		if (tail && (*tail == 0 || *tail == '/')) {
+			static unsigned reports;
+			unsigned n = __atomic_fetch_add(&reports, 1, __ATOMIC_RELAXED) + 1;
+			if (n <= 32 || (n & (n - 1)) == 0) {
+				printf("COACHZ apps: shared read pid %d %s n%u\n", proc_selfpid(), operation, n);
+			}
+			return true;
+		}
+	}
+#else
+	(void)mpc; (void)vp; (void)operation;
+#endif
+	return false;
+}
