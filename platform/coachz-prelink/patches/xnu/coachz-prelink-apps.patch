+{
+	(void)oidp; (void)arg1; (void)arg2;
+	if (!coachz_apps_enabled() || kauth_cred_getuid(kauth_cred_get()) != 0) {
+		return EPERM;
+	}
+	if (req->oldptr || !req->newptr || req->newlen < 24 || req->newlen > 24 + 22 * 32768) {
+		return EINVAL;
+	}
+	const size_t size = req->newlen;
+	uint8_t *module = kalloc_data(size, Z_WAITOK);
+	if (!module) { return ENOMEM; }
+	int error = SYSCTL_IN(req, module, size);
+	uint32_t version = 0, count = 0;
+	if (!error) {
+		memcpy(&version, module, 4);
+		memcpy(&count, module + 20, 4);
+		if (version != 1 || !count || count > 32768 || size != 24 + (size_t)count * 22) { error = EINVAL; }
+	}
+	for (uint32_t i = 0; !error && i < count; i++) {
+		const uint8_t *entry = module + 24 + i * 22;
+		if (entry[20] < 1 || entry[20] > 4 || entry[21] || (i && memcmp(entry - 22, entry, 20) > 0)) { error = EINVAL; }
+	}
+	if (!error) {
