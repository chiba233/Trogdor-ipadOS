+/* Explicit image opt-in, independent of machine identity and ordinary boot arguments. */
+static bool
+coachz_apps_enabled(void)
+{
+	DTEntry chosen;
+	void *value = NULL;
+	unsigned size = 0;
+	uint32_t enabled = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "coachz-owner-apps", &value, &size) != kSuccess || size != sizeof(enabled)) {
+		return false;
+	}
+	memcpy(&enabled, value, sizeof(enabled));
+	return enabled == 1;
+}
