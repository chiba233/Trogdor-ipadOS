+int
+coachz_baseband_archive(uint8_t **data, uint64_t *bytes, size_t *allocated)
+{
+    const size_t chunk = 1u << 20;
+    vfs_context_t context = vfs_context_kernel();
+    uint64_t blob = WIFI_FW_BLOB_USB;
+    unsigned on_emmc = 0;
+    int error = ENOENT;
+    uint8_t *header = kalloc_data(4096, Z_WAITOK);
+
+    if (!header) return ENOMEM;
+    if (PE_parse_boot_argn("coachz-root-emmc", &on_emmc, sizeof(on_emmc)) && on_emmc == 1) blob = WIFI_FW_BLOB_EMMC;
+    for (unsigned which = 0; which < (unsigned)(sizeof(wifi_fw_disks) / sizeof(wifi_fw_disks[0])) && error == ENOENT; which++) {
+        vnode_t disk = NULLVP;
+        if (vnode_open(wifi_fw_disks[which], FREAD, 0, 0, &disk, context)) continue;
+        if (!wifi_fw_read(disk, context, header, 4096, blob) && !memcmp(header, "COACHZMODEMFW1", 14)) {
+            const uint32_t count = cw_u32(header + 16);
+            for (uint32_t i = 0; i < count && i < 8 && error == ENOENT; i++) {
