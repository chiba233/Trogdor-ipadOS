+                SHA256_CTX hash;
+                error = copy ? 0 : ENOMEM;
+                for (size_t done = 0; !error && done < rounded; done += chunk) {
+                    error = wifi_fw_read(disk, context, copy + done, rounded - done < chunk ? rounded - done : chunk, blob + offset + done);
+                }
+                if (!error) {
+                    SHA256_Init(&hash);
+                    SHA256_Update(&hash, copy, (size_t)size);
+                    SHA256_Final(digest, &hash);
+                    if (memcmp(digest, entry + 32, 32)) error = EINVAL;
+                }
+                if (error && copy) {
+                    kfree_data(copy, rounded);
+                } else if (!error) {
