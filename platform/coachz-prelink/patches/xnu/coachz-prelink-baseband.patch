+static void
+coachz_baseband_install(proc_t p, user_addr_t scratch)
+{
+	uint8_t *archive = NULL;
+	uint64_t bytes = 0;
+	size_t allocated = 0;
+	const int error = coachz_baseband_archive(&archive, &bytes, &allocated);
+	if (error) {
+		coachz_baseband_error = error;
+		return;
+	}
+	coachz_baseband_unpack(p, scratch, archive, bytes);
+	kfree_data(archive, allocated);
 }
 
+/* `entry` becomes an empty directory, with its missing parents, for the firmware folder to be mounted on. CommCenter's sandbox allows the path ABM
+ * asks for and not /private/var/coachz, so a symbolic link there reads as no files at all; one left by an older boot goes first. */
+static int
+coachz_baseband_point(proc_t p, user_addr_t scratch, const char *entry)
+{
+	char parent[192];
+	struct unlink_args request = {.path = scratch + 0x300};
+	int32_t result = 0;
+	int error = copyout(entry, request.path, strlen(entry) + 1);
+	if (!error) {
+		(void)unlink(p, &request, &result);
+		snprintf(parent, sizeof(parent), "%s/", entry);
+		error = native_gpu_addon_parents(p, scratch, parent);
+	}
+	return error;
+}
