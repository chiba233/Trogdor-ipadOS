+/*
+ * The cellular bridge (/chosen/coachz-baseband, drivers/RamBlock coachz_baseband.cpp). BBUpdater serves the Mav16 firmware from a folder of the
+ * bbfw's files: capabilities::radio::personalizedFirmwarePath, MSU's personalized base (the preboot directory named after the boot manifest
+ * hash) plus /usr/local/standalone/firmware/Baseband/Mav16. The kernel partition carries those files (coachz_baseband_archive, tools/linux_log.py
+ * --baseband) in the GPU addon's layout under its own magic; each goes to /private/var/coachz/baseband/Mav16 when it differs. Read-only unions
+ * then show the folder as /private/preboot/<HASH>/usr/local/standalone/firmware/Baseband/Mav16 and /usr/standalone/firmware/Baseband/Mav16;
+ * ABM's log ("FW base path", "FW path ... exists") says which one it takes.
+ */
+extern int coachz_baseband_archive(uint8_t **, uint64_t *, size_t *);
+static volatile int coachz_baseband_files = -1, coachz_baseband_written, coachz_baseband_same, coachz_baseband_failed, coachz_baseband_error;
+
+static void
+coachz_baseband_unpack(proc_t p, user_addr_t scratch, const uint8_t *archive, uint64_t bytes)
+{
+	uint64_t declared = 0, at = 24;
+	uint32_t count = 0;
+	if (bytes < 24 || memcmp(archive, "CZBBFW01", 8)) {
+		coachz_baseband_error = EINVAL;
+		return;
+	}
+	memcpy(&count, archive + 8, 4);
+	memcpy(&declared, archive + 16, 8);
+	if (declared != bytes || !count || count > 256) {
+		coachz_baseband_error = EINVAL;
+		return;
+	}
+	/* The whole archive is checked before anything is written. */
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t name_bytes = 0, mode = 0;
+		uint64_t size = 0, packed = 0;
+		if (bytes - at < 24) {
+			coachz_baseband_error = EINVAL;
+			return;
+		}
+		memcpy(&name_bytes, archive + at, 4);
+		memcpy(&mode, archive + at + 4, 4);
+		memcpy(&size, archive + at + 8, 8);
+		memcpy(&packed, archive + at + 16, 8);
+		at += 24;
+		const char *name = (const char *)(archive + at);
+		const uint64_t name_padded = (name_bytes + 7) & ~7ULL, data_padded = (packed + 7) & ~7ULL;
+		if (name_bytes < 2 || name_bytes > 120 || bytes - at < name_padded || name[name_bytes - 1] || strnlen(name, name_bytes) != name_bytes - 1 ||
+		    name[0] == '/' || strnstr(name, "..", name_bytes) || (mode & ~0777) || size > INT32_MAX || !packed || packed > INT32_MAX ||
+		    bytes - at - name_padded < data_padded) {
+			coachz_baseband_error = EINVAL;
+			return;
+		}
+		at += name_padded + data_padded;
+	}
+	if (at != bytes) {
+		coachz_baseband_error = EINVAL;
+		return;
+	}
+	coachz_baseband_files = (int)count;
+	vfs_context_t ctx = vfs_context_current();
+	char path[192];
+	at = 24;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t name_bytes = 0, mode = 0;
+		uint64_t size = 0, packed = 0;
+		memcpy(&name_bytes, archive + at, 4);
+		memcpy(&mode, archive + at + 4, 4);
+		memcpy(&size, archive + at + 8, 8);
+		memcpy(&packed, archive + at + 16, 8);
+		at += 24;
+		const char *name = (const char *)(archive + at);
+		at += (name_bytes + 7) & ~7ULL;
+		snprintf(path, sizeof(path), "/private/var/coachz/baseband/Mav16/%s", name);
+		uint8_t *data = kalloc_data(size ? size : 1, Z_WAITOK);
+		int error = data ? native_gpu_addon_inflate(archive + at, packed, data, size) : ENOMEM;
+		if (!error) {
+			error = native_gpu_addon_write(path, data, size, mode, ctx);
+			if (error == ENOENT && !(error = native_gpu_addon_parents(p, scratch, path))) {
+				error = native_gpu_addon_write(path, data, size, mode, ctx);
+			}
+		}
+		if (data) {
+			kfree_data(data, size ? size : 1);
+		}
+		if (error < 0) {
+			coachz_baseband_same++;
+		} else if (error) {
+			coachz_baseband_failed++;
+			coachz_baseband_error = error;
+		} else {
+			coachz_baseband_written++;
+		}
+		at += (packed + 7) & ~7ULL;
+	}
+}
