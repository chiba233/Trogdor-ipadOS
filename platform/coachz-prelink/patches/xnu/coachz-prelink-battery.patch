+// SPDX-License-Identifier: BSD-2-Clause
+// The Coachz battery as iPadOS reads it (coachz-battery=1): an IOPMPowerSource fed by the Chrome EC, which keeps its own charger,
+// PD and battery management. Every ten seconds it reads BATTERY_GET_DYNAMIC and CHARGE_STATE through bsd/dev/coachz_ec.c; it only
+// queries. The publishing follows UniXNU-sheng's ShengBattery.cpp (BSD-2-Clause-Patent), as iPadOS 17 consumed it on that board:
+// CurrentCapacity is the percentage with MaxCapacity 100, raw mAh in AppleRawCurrentCapacity/AppleRawMaxCapacity, the service is
+// registered only after the first valid reading (an early 0 % would read as an empty battery), and updateStatus() tells powerd.
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+extern "C" {
+#include "../../bsd/dev/coachz_ec_proto.h"
+int coachz_ec_command(uint16_t command, uint8_t version, const void *args, uint32_t size, void *reply, uint32_t room,
+    uint32_t *length);
+void coachz_battery_start(void);
+// The gauge's temperature in hundredths of a degree, for the system's thermal service (NativeHidInput.cpp).
+volatile int32_t coachz_battery_centi_c = 3000;
+}
+
+// The ports are read every two seconds, the battery and the EC console every ten, or at once when a port changes.
+static const uint32_t kPortPollMs = 2000;
+static const uint32_t kRefreshTicks = 5;
+
+// One USB-C port in the registry, its properties kept current by CoachzBattery, for anything that matches CoachzTypeCPort.
+class CoachzTypeCPort : public IOService {
+	OSDeclareDefaultStructors(CoachzTypeCPort)
+};
+OSDefineMetaClassAndStructors(CoachzTypeCPort, IOService)
+
+struct PortView {
+	uint8_t powerRole, chargerType, dualRole, controlKnown, enabled, role, polarity, ccState, dpMode, mux;
+	uint16_t maxMillivolts, maxMilliamps, limitMilliamps;
+	char state[32];
+};
+
+class CoachzBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(CoachzBattery)
+	IOWorkLoop *loop = nullptr;
+	IOTimerEventSource *timer = nullptr;
+	bool published = false;
+	int lastPercent = -1, lastFlags = -1, lastError = -1;
+	uint32_t reads = 0, failures = 0;
+	uint32_t lastPort[2][3] = {};
+	PortView ports[2] = {};
+	CoachzTypeCPort *portService[2] = {};
+	bool portPublished[2] = {}, portsRead = false, sbsError = false;
+	uint8_t controlVersion = 2;
+	uint32_t ticks = 0;
+	int lastTenths = -2, lastCycles = -2;
+	bool lastWarn = false, lastCritical = false;
+	bool portError = false, consoleStopped = false;
+	uint8_t consoleReply[EC_MAX_REPLY];
+	char consoleLine[160];
+	uint32_t consoleUsed = 0;
+
+	void number(const char *key, int64_t value) {
+		const OSSymbol *symbol = OSSymbol::withCString(key);
+		OSNumber *n = OSNumber::withNumber((unsigned long long)value, 32);
+		if (symbol && n) {
+			setPSProperty(symbol, n);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(symbol);
+	}
+	void flag(const char *key, bool value) {
+		const OSSymbol *symbol = OSSymbol::withCString(key);
+		if (symbol) {
+			setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		}
+		OSSafeReleaseNULL(symbol);
+	}
+
+	// Both USB-C ports as the EC reports them, read only, in the order Linux's cros_ec_typec and cros_usbpd_charger ask: USB_PD_POWER_INFO
+	// (power role and charger type; role 0 none, 1 source, 2 sink, 3 sink not charging; type 0 none, 1 PD, 2 Type-C, 3 proprietary, 4-6
+	// BC1.2 DCP, CDP, SDP, 8 VBUS), USB_PD_CONTROL with nothing to change (connection, data role, polarity, PD state; version 2, older ECs
+	// answer 1), USB_PD_MUX_INFO (USB, DisplayPort, flip). Anything but the live voltage is published on the port's registry entry and
+	// told to its clients at once; the return value makes the battery refresh too, so a plug shows within one 2 s poll.
+	bool readPorts() {
+		bool changed = !portsRead;
+		for (uint8_t port = 0; port < 2; port++) {
+			uint8_t r[16], control[40], mux = 0;
+			const uint8_t request[4] = {port, 0, 0, 0};
+			uint32_t length = 0;
+			int error = coachz_ec_command(EC_CMD_USB_PD_POWER_INFO, 0, &port, 1, r, sizeof(r), &length);
+			if (error || length < sizeof(r)) {
+				if (!portError) {
+					printf("COACHZ ec port %u: error 0x%x length %u\n", port, (unsigned)error, length);
+					portError = true;
+				}
+				continue;
+			}
+			uint32_t now[3] = {(uint32_t)r[0] | (uint32_t)r[1] << 8 | (uint32_t)r[2] << 16, coachz_ec_le16(r + 4), (uint32_t)coachz_ec_le16(r + 8) | (uint32_t)coachz_ec_le16(r + 10) << 16};
+			if (now[0] != lastPort[port][0] || now[1] != lastPort[port][1] || now[2] != lastPort[port][2] || !portsRead) {
+				printf("COACHZ ec port %u: role %u type %u dual %u, %u mV now, max %u mV %u mA, limit %u mA, max %u uW\n", port, r[0], r[1], r[2],
+				    coachz_ec_le16(r + 6), coachz_ec_le16(r + 4), coachz_ec_le16(r + 8), coachz_ec_le16(r + 10), coachz_ec_le32(r + 12));
+				lastPort[port][0] = now[0];
+				lastPort[port][1] = now[1];
+				lastPort[port][2] = now[2];
+			}
+			uint32_t controlLength = 0;
+			bzero(control, sizeof(control));
+			error = coachz_ec_command(EC_CMD_USB_PD_CONTROL, controlVersion, request, sizeof(request), control, sizeof(control), &controlLength);
+			if (error && controlVersion == 2) {
+				controlVersion = 1;
+				error = coachz_ec_command(EC_CMD_USB_PD_CONTROL, controlVersion, request, sizeof(request), control, sizeof(control), &controlLength);
+			}
+			uint32_t muxLength = 0;
+			const int muxError = coachz_ec_command(EC_CMD_USB_PD_MUX_INFO, 0, &port, 1, &mux, 1, &muxLength);
+			PortView view = {};
+			view.powerRole = r[0];
+			view.chargerType = r[1];
+			view.dualRole = r[2];
+			view.maxMillivolts = coachz_ec_le16(r + 4);
+			view.maxMilliamps = coachz_ec_le16(r + 8);
+			view.limitMilliamps = coachz_ec_le16(r + 10);
+			if (!error && controlLength >= 3) {
+				view.controlKnown = 1;
+				view.enabled = control[0];
+				view.role = control[1];
+				view.polarity = control[2];
+				if (controlLength >= 35) {
+					memcpy(view.state, control + 3, 31);
+					view.ccState = control[35];
+					view.dpMode = control[36];
+				}
+			}
+			view.mux = muxError || !muxLength ? 0xff : mux;
+			if (memcmp(&view, &ports[port], sizeof(view)) || !portsRead) {
+				ports[port] = view;
+				publishPort(port);
+				changed = true;
+			}
+		}
+		if (changed || !portsRead) {
+			publishAdapter();
+		}
+		portsRead = true;
+		return changed;
+	}
+
+	void publishPort(uint8_t port) {
+		const PortView &view = ports[port];
+		if (!portService[port]) {
+			CoachzTypeCPort *service = OSTypeAlloc(CoachzTypeCPort);
+			if (service && service->init() && service->attach(IOService::getPlatform())) {
+				service->setProperty("PortNumber", (unsigned long long)port, 32);
+				portService[port] = service;
+			} else {
+				printf("COACHZ usbc port %u: could not attach\n", port);
+				OSSafeReleaseNULL(service);
+				return;
+			}
+		}
+		CoachzTypeCPort *service = portService[port];
+		const bool connected = view.controlKnown ? (view.enabled & 2) != 0 : view.powerRole != 0;
+		const char *power = view.powerRole == 1 ? "source" : view.powerRole == 2 ? "sink" : view.powerRole == 3 ? "sink not charging" : "none";
+		const char *data = !connected ? "none" : (view.role & 2) ? "host" : "device";
+		service->setProperty("Connected", connected);
+		service->setProperty("PowerRole", power);
+		service->setProperty("DataRole", data);
+		service->setProperty("PDCapable", (view.enabled & 4) != 0);
+		service->setProperty("Polarity", (unsigned long long)view.polarity, 32);
+		service->setProperty("ChargerType", (unsigned long long)view.chargerType, 32);
+		service->setProperty("MaxMillivolts", (unsigned long long)view.maxMillivolts, 32);
+		service->setProperty("MaxMilliamps", (unsigned long long)view.maxMilliamps, 32);
+		service->setProperty("LimitMilliamps", (unsigned long long)view.limitMilliamps, 32);
+		service->setProperty("USBEnabled", view.mux != 0xff && (view.mux & 1) != 0);
+		service->setProperty("DisplayPortEnabled", view.mux != 0xff && (view.mux & 2) != 0);
+		char state[32];
+		memcpy(state, view.state, sizeof(state) - 1);
+		state[sizeof(state) - 1] = 0;
+		service->setProperty("PDState", state);
+		if (!portPublished[port]) {
+			portPublished[port] = true;
+			service->registerService();
+		}
+		service->messageClients(kIOMessageServicePropertyChange);
+		printf("COACHZ usbc port %u: connected %d power %s data %s pd %d polarity %u cc %u mux 0x%x state '%s'\n", port, connected, power, data,
+		    (view.enabled & 4) != 0, view.polarity, view.ccState, view.mux, state);
+	}
+
+	// The charger the battery reads from: the port the EC sinks from, as IOPMPowerSource's AdapterDetails. FamilyCode is IOKit's USB family
+	// error space, as IOPSKeysPrivate lists it: 0xe0004000 + 0 host, 4 dedicated, 5 downstream, 9 Type-C, 10 PD.
+	void publishAdapter() {
+		const PortView *sink = nullptr;
+		for (const PortView &view : ports) {
+			if (view.powerRole == 2 || view.powerRole == 3) {
+				sink = &view;
+			}
+		}
+		OSDictionary *details = OSDictionary::withCapacity(5);
+		if (!details) {
+			return;
+		}
+		if (sink) {
+			const uint32_t watts = (uint32_t)sink->maxMillivolts * sink->maxMilliamps / 1000000u;
+			const uint32_t family = sink->chargerType == 1 ? 0xe000400au : sink->chargerType == 2 ? 0xe0004009u : sink->chargerType == 4 ? 0xe0004004u :
+			    sink->chargerType == 5 ? 0xe0004005u : sink->chargerType == 6 ? 0xe0004000u : 0xe0004007u;
+			const char *description = sink->chargerType == 1 ? "pd charger" : sink->chargerType == 2 ? "usb type-c" : sink->chargerType == 6 ? "usb host" : "usb charger";
+			detailNumber(details, kIOPMPSAdapterDetailsWattsKey, watts);
+			detailNumber(details, kIOPMPSAdapterDetailsVoltage, sink->maxMillivolts);
+			detailNumber(details, kIOPMPSAdapterDetailsAmperageKey, sink->maxMilliamps);
+			detailNumber(details, kIOPMPSAdapterDetailsFamilyKey, family);
+			OSString *text = OSString::withCString(description);
+			if (text) {
+				details->setObject(kIOPMPSAdapterDetailsDescriptionKey, text);
+				text->release();
+			}
+			printf("COACHZ battery: adapter %u W %u mV %u mA family 0x%x '%s'\n", watts, sink->maxMillivolts, sink->maxMilliamps, family, description);
+		}
+		const OSSymbol *key = OSSymbol::withCString(kIOPMPSAdapterDetailsKey);
+		if (key) {
+			setPSProperty(key, details);
+			key->release();
+		}
+		details->release();
+	}
+
+	static void detailNumber(OSDictionary *details, const char *key, uint32_t value) {
+		OSNumber *n = OSNumber::withNumber(value, 32);
+		if (n) {
+			details->setObject(key, n);
+			n->release();
+		}
+	}
+
+	// One word from the gas gauge, as sbs-battery reads it through Linux's cros-ec tunnel: remote bus 0, address 0x0b, write the register,
+	// read two bytes (EC_CMD_I2C_PASSTHRU; only the gauge's command byte is written). Debian shows the same temperature and cycle count.
+	bool sbsWord(uint8_t reg, uint16_t *out) {
+		const uint8_t args[11] = {0, 2, 0x0b, 0x00, 1, 0, 0x0b, 0x80, 2, 0, reg};
+		uint8_t r[4];
+		uint32_t length = 0;
+		int error = coachz_ec_command(EC_CMD_I2C_PASSTHRU, 0, args, sizeof(args), r, sizeof(r), &length);
+		if (error || length < sizeof(r) || r[0] || r[1] != 2) {
+			if (!sbsError) {
+				printf("COACHZ battery: gauge register 0x%x: error 0x%x length %u status 0x%x\n", reg, (unsigned)error, length, length ? r[0] : 0u);
+				sbsError = true;
+			}
+			return false;
+		}
+		*out = coachz_ec_le16(r + 2);
+		return true;
+	}
+
+	void readGauge(bool external, bool charging) {
+		uint16_t word = 0;
+		int tenths = -1, cycles = -1, minutes = -1;
+		if (sbsWord(0x08, &word) && word > 2000 && word < 4000) {   // tenths of a kelvin
+			const int centi = ((int)word - 2732) * 10;
+			tenths = centi / 10;
+			number("Temperature", centi);
+			coachz_battery_centi_c = centi;
+		}
+		if (sbsWord(0x17, &word) && word != 0xffff) {
+			cycles = word;
+			setCycleCount(word);
+		}
+		if (sbsWord(0x18, &word) && word && word != 0xffff) {
+			number("DesignCapacity", word);
+		}
+		const bool toFull = external && charging;
+		if ((toFull || !external) && sbsWord(toFull ? 0x13 : 0x12, &word) && word && word != 0xffff) {
+			minutes = word;
+		}
+		setTimeRemaining(minutes >= 0 ? (unsigned)minutes : 0xffff);
+		number("AvgTimeToEmpty", !external && minutes >= 0 ? minutes : 0xffff);
+		number("AvgTimeToFull", toFull && minutes >= 0 ? minutes : 0xffff);
+		if (tenths != lastTenths || cycles != lastCycles) {
+			printf("COACHZ battery: %d.%d C, %d cycles, %d minutes %s\n", tenths / 10, tenths % 10, cycles, minutes, toFull ? "to full" : "to empty");
+			lastTenths = tenths;
+			lastCycles = cycles;
+		}
+	}
+	void consoleByte(uint8_t byte) {
+		if (byte != '\n' && byte != '\r') {
+			consoleLine[consoleUsed++] = byte >= 0x20 && byte < 0x7f ? (char)byte : '.';
+		}
+		if (consoleUsed && (byte == '\n' || consoleUsed == sizeof(consoleLine) - 1)) {
+			consoleLine[consoleUsed] = 0;
+			printf("COACHZ ec: %s\n", consoleLine);
+			consoleUsed = 0;
+		}
+	}
+
+	// The EC's own console, as Linux's cros_ec_debugfs reads it: a snapshot, then CONSOLE_READ_RECENT until an empty reply. Neither changes the EC's state.
+	void readConsole() {
+		uint32_t length = 0;
+		uint8_t recent = 1;
+		if (consoleStopped) {
+			return;
+		}
+		int error = coachz_ec_command(EC_CMD_CONSOLE_SNAPSHOT, 0, nullptr, 0, consoleReply, sizeof(consoleReply), &length);
+		for (unsigned i = 0; !error && i < 64; i++) {
+			error = coachz_ec_command(EC_CMD_CONSOLE_READ, 1, &recent, 1, consoleReply, sizeof(consoleReply), &length);
+			if (error || !length || !consoleReply[0]) {
+				break;
+			}
+			for (uint32_t at = 0; at < length && consoleReply[at]; at++) {
+				consoleByte(consoleReply[at]);
+			}
+		}
+		if (error) {
+			printf("COACHZ ec console: error 0x%x, stopped\n", (unsigned)error);
+			consoleStopped = true;
+		}
+	}
+
+	void refresh() {
+		uint8_t reply[EC_MAX_REPLY], index = 0, charge[10] = {0};   // CHARGE_STATE: cmd 0 = GET_STATE, the union and chgnum zero
+		uint32_t length = 0;
+		coachz_ec_battery b;
+		coachz_ec_charge c;
+		reads++;
+		readConsole();
+		int error = coachz_ec_command(EC_CMD_BATTERY_GET_DYNAMIC, 0, &index, 1, reply, sizeof(reply), &length);
+		if (!error && !coachz_ec_battery_decode(reply, length, &b)) {
+			error = EC_ERR_SHORT;
+		}
+		int stateError = error ? -1 : coachz_ec_command(EC_CMD_CHARGE_STATE, 0, charge, sizeof(charge), reply, sizeof(reply), &length);
+		bool haveState = !stateError && coachz_ec_charge_decode(reply, length, &c);
+		if (error || !(b.flags & EC_BATT_FLAG_BATT_PRESENT) || (b.flags & EC_BATT_FLAG_INVALID_DATA) || b.full_mah <= 0) {
+			failures++;
+			if (error != lastError) {
+				printf("COACHZ battery: read %u failed: error 0x%x flags 0x%x (last good kept, %u failures)\n", reads, (unsigned)error,
+				    error ? 0u : b.flags, failures);
+				lastError = error;
+			}
+			return;   // last good values stay published; a failed read never becomes 0 %
+		}
+		lastError = 0;
+		int percent = haveState && c.percent >= 0 && c.percent <= 100 ? c.percent : b.remaining_mah * 100 / b.full_mah;
+		bool external = (b.flags & EC_BATT_FLAG_AC_PRESENT) || (haveState && c.ac);
+		bool charging = (b.flags & EC_BATT_FLAG_CHARGING) != 0;
+		setBatteryInstalled(true);
+		setExternalConnected(external);
+		setExternalChargeCapable(external);
+		setIsCharging(charging);
+		// Low battery as iPadOS reads it: the warning at 10 % and critical at 3 % off the charger, or when the EC itself says critical.
+		const bool warn = !external && percent <= 10;
+		const bool critical = (b.flags & EC_BATT_FLAG_LEVEL_CRITICAL) != 0 || (!external && percent <= 3);
+		setAtWarnLevel(warn);
+		setAtCriticalLevel(critical);
+		if (warn != lastWarn || critical != lastCritical) {
+			printf("COACHZ battery: low level warn %d critical %d at %d %%\n", warn, critical, percent);
+			lastWarn = warn;
+			lastCritical = critical;
+		}
+		setCurrentCapacity((unsigned)percent);
+		setMaxCapacity(100);
+		setVoltage((unsigned)(b.voltage_mv > 0 ? b.voltage_mv : 0));
+		setAmperage(b.current_ma);
+		readGauge(external, charging);
+		flag("FullyCharged", external && !charging && percent >= 100);
+		number("InstantAmperage", b.current_ma);
+		number("AppleRawCurrentCapacity", b.remaining_mah);
+		number("AppleRawMaxCapacity", b.full_mah);
+		number("NominalChargeCapacity", b.full_mah);
+		if (percent != lastPercent || (int)b.flags != lastFlags) {
+			printf("COACHZ battery: %d %% %d mV %d mA %d/%d mAh flags 0x%x ac %d charger %d mV %d mA input %d mA (read %u, EC state %d)\n",
+			    percent, b.voltage_mv, b.current_ma, b.remaining_mah, b.full_mah, b.flags, haveState ? c.ac : -1,
+			    haveState ? c.charge_mv : -1, haveState ? c.charge_ma : -1, haveState ? c.input_ma : -1, reads, stateError);
+			lastPercent = percent;
+			lastFlags = (int)b.flags;
+		}
+		if (!published) {
+			published = true;   // the properties are in place before anyone finds the service
+			registerService();
+			printf("COACHZ battery: published\n");
+		}
+		updateStatus();
+	}
+
+	static void timerAction(OSObject *owner, IOTimerEventSource *sender) {
+		CoachzBattery *self = OSDynamicCast(CoachzBattery, owner);
+		if (!self) {
+			return;
+		}
+		const bool changed = self->readPorts();
+		if (changed || ++self->ticks >= kRefreshTicks) {
+			self->ticks = 0;
+			self->refresh();
+		}
+		sender->setTimeoutMS(kPortPollMs);
+	}
+
+public:
+	bool startBattery() {
+		loop = IOWorkLoop::workLoop();
+		timer = IOTimerEventSource::timerEventSource(this, &CoachzBattery::timerAction);
+		if (!loop || !timer || loop->addEventSource(timer) != kIOReturnSuccess) {
+			return false;
+		}
+		timer->setTimeoutMS(1);
+		return true;
+	}
+};
+OSDefineMetaClassAndStructors(CoachzBattery, IOPMPowerSource)
+
+// Called once from the sampler thread (bsd/dev/coachz_sample.c) after IOKit is up.
+extern "C" void
+coachz_battery_start(void)
+{
+	static bool started;
+	int enabled = 0;
+	if (started || !PE_parse_boot_argn("coachz-battery", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	started = true;
+	CoachzBattery *battery = OSTypeAlloc(CoachzBattery);
+	if (!battery || !battery->init() || !battery->attach(IOService::getPlatform())) {
+		printf("COACHZ battery: could not attach\n");
+		OSSafeReleaseNULL(battery);
+		return;
+	}
+	if (!battery->startBattery()) {
+		printf("COACHZ battery: could not start its work loop\n");
+		battery->detach(IOService::getPlatform());
+	}
+	battery->release();   // the platform's attachment keeps it
+}
