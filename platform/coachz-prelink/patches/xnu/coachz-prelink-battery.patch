@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * ChromeOS EC host command protocol 3: request framing, response checks and the battery replies Coachz reads.
+ * Pure functions, no hardware access, so the host tests run them unchanged. Layouts from the pinned Chrome EC
+ * include/ec_commands.h: ec_host_request/ec_host_response (8 bytes each), EC_CMD_BATTERY_GET_DYNAMIC 0x0601 (14 bytes),
+ * EC_CMD_CHARGE_STATE 0x00a0 GET_STATE (20 bytes), EC_CMD_GET_PROTOCOL_INFO 0x000b (12 bytes).
+ */
+#ifndef COACHZ_EC_PROTO_H
+#define COACHZ_EC_PROTO_H
+#include <stdint.h>
+
+#define EC_CMD_HELLO 0x0001u
+#define EC_CMD_GET_PROTOCOL_INFO 0x000bu
+#define EC_CMD_CHARGE_STATE 0x00a0u
+#define EC_CMD_BATTERY_GET_DYNAMIC 0x0601u
+#define EC_HEADER 8u
+#define EC_MAX_PARAMS 32u
+#define EC_MAX_REPLY 64u
+
+/* Errors: low byte the stage, the EC result code above it for EC_ERR_RESULT. */
+enum {
+	EC_ERR_ARGS = 1, EC_ERR_VERSION, EC_ERR_RESERVED, EC_ERR_LENGTH, EC_ERR_SHORT, EC_ERR_CHECKSUM, EC_ERR_RESULT
+};
+
+#define EC_BATT_FLAG_AC_PRESENT 0x01
+#define EC_BATT_FLAG_BATT_PRESENT 0x02
+#define EC_BATT_FLAG_DISCHARGING 0x04
+#define EC_BATT_FLAG_CHARGING 0x08
+#define EC_BATT_FLAG_LEVEL_CRITICAL 0x10
+#define EC_BATT_FLAG_INVALID_DATA 0x20
+
+struct coachz_ec_battery {
+	int voltage_mv, current_ma, remaining_mah, full_mah, desired_mv, desired_ma;
+	unsigned flags;
+};
+
+struct coachz_ec_charge {
+	int ac, charge_mv, charge_ma, input_ma, percent;
+};
+
+static inline uint16_t coachz_ec_le16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
+static inline uint32_t coachz_ec_le32(const uint8_t *p) {
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* The request: header (version 3, checksum making the byte sum zero, command, command version, data length) and params. */
+static inline uint32_t coachz_ec_request(uint8_t *out, uint16_t command, uint8_t version, const uint8_t *params, uint32_t size) {
+	if (size > EC_MAX_PARAMS) {
+		return 0;
+	}
+	out[0] = 3;
+	out[1] = 0;
+	out[2] = (uint8_t)command;
+	out[3] = (uint8_t)(command >> 8);
+	out[4] = version;
+	out[5] = 0;
+	out[6] = (uint8_t)size;
+	out[7] = (uint8_t)(size >> 8);
+	uint8_t sum = 0;
+	for (uint32_t i = 0; i < size; i++) {
+		out[EC_HEADER + i] = params[i];
+	}
+	for (uint32_t i = 0; i < EC_HEADER + size; i++) {
+		sum = (uint8_t)(sum + out[i]);
+	}
+	out[1] = (uint8_t)-sum;
+	return EC_HEADER + size;
+}
+
+/*
+ * The response as read after the frame start byte: in holds `got` bytes. A reply must be complete: it is never padded, so a short
+ * answer cannot become a valid zero. *length gets the payload length.
+ */
+static inline uint32_t coachz_ec_response(const uint8_t *in, uint32_t got, uint32_t *length) {
+	if (got < EC_HEADER) {
+		return EC_ERR_SHORT;
+	}
+	uint32_t result = coachz_ec_le16(in + 2), size = coachz_ec_le16(in + 4);
+	if (in[0] != 3) {
+		return EC_ERR_VERSION;
+	}
+	if (in[6] || in[7]) {
+		return EC_ERR_RESERVED;
+	}
+	if (size > EC_MAX_REPLY) {
+		return EC_ERR_LENGTH;
+	}
+	if (got < EC_HEADER + size) {
+		return EC_ERR_SHORT;
+	}
+	uint8_t sum = 0;
+	for (uint32_t i = 0; i < EC_HEADER + size; i++) {
+		sum = (uint8_t)(sum + in[i]);
+	}
+	if (sum) {
+		return EC_ERR_CHECKSUM;
+	}
+	if (result) {
+		return EC_ERR_RESULT | result << 8;
+	}
+	*length = size;
+	return 0;
+}
+
+/* BATTERY_GET_DYNAMIC v0: seven little-endian int16 in mV, mA (negative while discharging) and mAh, then flags. */
+static inline int coachz_ec_battery_decode(const uint8_t *p, uint32_t size, struct coachz_ec_battery *b) {
+	if (size < 14) {
+		return 0;
+	}
+	b->voltage_mv = (int16_t)coachz_ec_le16(p);
+	b->current_ma = (int16_t)coachz_ec_le16(p + 2);
+	b->remaining_mah = (int16_t)coachz_ec_le16(p + 4);
+	b->full_mah = (int16_t)coachz_ec_le16(p + 6);
+	b->flags = coachz_ec_le16(p + 8);
+	b->desired_mv = (int16_t)coachz_ec_le16(p + 10);
+	b->desired_ma = (int16_t)coachz_ec_le16(p + 12);
+	return 1;
+}
+
+/* CHARGE_STATE GET_STATE: five little-endian int32: AC present, charger voltage and current, input current limit, state of charge. */
+static inline int coachz_ec_charge_decode(const uint8_t *p, uint32_t size, struct coachz_ec_charge *c) {
+	if (size < 20) {
+		return 0;
+	}
+	c->ac = (int32_t)coachz_ec_le32(p);
+	c->charge_mv = (int32_t)coachz_ec_le32(p + 4);
+	c->charge_ma = (int32_t)coachz_ec_le32(p + 8);
+	c->input_ma = (int32_t)coachz_ec_le32(p + 12);
+	c->percent = (int32_t)coachz_ec_le32(p + 16);
+	return 1;
+}
+#endif
