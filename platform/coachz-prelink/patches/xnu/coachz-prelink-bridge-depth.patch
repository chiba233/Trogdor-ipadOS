+/*
+ * The SN65DSI86 eDP bridge's output depth. Coreboot's sn65dsi86_bridge_configure writes SN_DATA_FORMAT_REG 1 (18 bpp) whatever
+ * the panel says, and XNU keeps the firmware's display, so every channel reached the panel with 6 bits: white scenes and
+ * shadows show bands. Linux (ti-sn65dsi86.c) takes the depth from the EDID, 24 bpp on this 8-bit panel, and trains at the lowest
+ * rate that carries it. The firmware trains for 18 bpp, so the depth changes here only if the running link already has the
+ * capacity Linux would ask for; training is not repeated. The video stream is stopped around the change, as Linux's disable
+ * and enable do and as Coreboot writes it. Before and after go to the log.
+ *
+ * Board facts: Coreboot's BRIDGE_BUS is QUPV3_0_SE2 at 0x888000; Linux runs that bus at 400 kHz and the bridge at address 0x2d.
+ * GCC: S2's vote is bit 12 of 0x52008, its branch 0x17290, its RCG 0x17294 (gcc-sc7180.c). The GENI I2C engine follows
+ * bsd/dev/coachz_touch.c (i2c-qcom-geni.c), polled, one register at a time.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void coachz_bridge_start(void);
+
+#define GCC_PA          0x00100000u
+#define GCC_VOTE        0x52008u
+#define GCC_VOTE_BITS   ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 12))
+#define GCC_S2_CBCR     0x17290u
+#define GCC_S2_DFS_CMD  0x172a8u
+#define GCC_S2_DFS_L0   0x172b0u
+#define SE2_PA          0x00888000u
+#define BRIDGE_ADDR     0x2d
+
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL  0x024u
+#define SE_CGC_CTRL     0x028u
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_IF_DISABLE   0x064u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_SCL          0x278u
+#define SE_BYTE_GRAN    0x254u
+#define SE_DMA          0x258u
+#define SE_TX_PACK0     0x260u
+#define SE_TX_PACK1     0x264u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_RX_PACK0     0x284u
+#define SE_RX_PACK1     0x288u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_S_IRQ_EN     0x644u
+#define SE_S_IRQ_CLR    0x648u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM        0x810u
+#define SE_RX_RFR       0x814u
+#define SE_GSI_EVENT_EN 0xe18u
+#define SE_IRQ_ROUTE    0xe1cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DMA_CFG      0xe30u
+#define SE_DONE         (1u << 0)
+#define SE_ABORT_DONE   (1u << 5)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+#define SN_ACTIVE_LINE  0x20u
+#define SN_VDISPLAY     0x24u
+#define SN_HSYNC        0x2cu
+#define SN_VSYNC        0x30u
+#define SN_HBP          0x34u
+#define SN_VBP          0x36u
+#define SN_HFP          0x38u
+#define SN_VFP          0x3au
+#define SN_ENH_FRAME    0x5au
+#define SN_DATA_FORMAT  0x5bu
+#define SN_SSC_CONFIG   0x93u
+#define SN_DATARATE     0x94u
+#define SN_ML_TX_MODE   0x96u
+#define VSTREAM_ENABLE  (1u << 3)
+#define BPP_18_RGB      (1u << 0)
+#define ML_TX_NORMAL    1u
+#define PANEL_HZ        60u
+
+static vm_offset_t se;
+static int bridge_chan;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+spin_us(unsigned us)
+{
+	uint64_t hz, start, now;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(hz));
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+	const uint64_t ticks = (hz ? hz : 19200000) * us / 1000000 + 1;
+	do {
+		__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(now));
+	} while (now - start < ticks);
+}
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bridge_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(base, off) & mask)) {
+			return true;
+		}
+		spin_us(1);
+	}
+	return false;
+}
+
+static void
+engine_abort(void)
+{
+	wr(se, SE_CTRL, 2);
+	for (unsigned i = 0; i < 5000 && !(rd(se, SE_IRQ) & SE_ABORT_DONE); ++i) {
+		spin_us(1);
+	}
+	(void)wait_clear(se, SE_STATUS, 1u);
+	for (unsigned i = 0; i < 1024 && (rd(se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)rd(se, SE_RX);
+	}
+	wr(se, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* One FIFO message of at most four bytes, written or read. stretch keeps the bus for a repeated start. */
+static int
+engine_msg(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	unsigned got = 0;
+	bool sent = false;
+
+	if (!wait_clear(se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(se, SE_IRQ_CLR, 0xffffffffu);
+	wr(se, SE_TX_WM, nt ? 1u : 0u);
+	wr(se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)BRIDGE_ADDR << 9) | (stretch ? 4u : 0u));
+	for (unsigned waited = 0; waited < 50000; ++waited) {
+		uint32_t irq = rd(se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			const int error = (irq & SE_NACK) ? ENXIO : EIO;
+			engine_abort();
+			return error;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(se, SE_TX, word);
+			sent = true;
+			wr(se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(se, SE_RX_COUNT) & 0x1ffffffu;
+		while (count--) {
+			uint32_t word = rd(se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			wr(se, SE_IRQ_CLR, irq);
+			return got == nr && (!nt || sent) ? 0 : EIO;
+		}
+		wr(se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		spin_us(10);
+	}
+	engine_abort();
+	return ETIMEDOUT;
+}
+
+static int
+reg_read(uint8_t reg, uint8_t *value)
+{
+	int error = engine_msg(&reg, 1, NULL, 0, true);
+	return error ? error : engine_msg(NULL, 0, value, 1, false);
+}
+
+static int
+reg_write(uint8_t reg, uint8_t value)
+{
+	const uint8_t bytes[2] = { reg, value };
+	return engine_msg(bytes, 2, NULL, 0, false);
+}
+
+static int
+reg_read16(uint8_t reg, unsigned *value)
+{
+	uint8_t low = 0, high = 0;
+	int error = reg_read(reg, &low);
+	if (!error) {
+		error = reg_read((uint8_t)(reg + 1), &high);
+	}
+	*value = low | ((unsigned)high << 8);
+	return error;
+}
+
+static bool
+engine_init(void)
+{
+	uint32_t fw = rd(se, SE_FW), tx = rd(se, SE_HW_TX), rx = rd(se, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3u || (rd(se, SE_IF_DISABLE) & 1u) || ((tx >> 24) & 0x3fu) != 32u ||
+	    ((rx >> 24) & 0x3fu) != 32u || (rd(se, SE_STATUS) & 0x1001u)) {
+		return false;
+	}
+	wr(se, SE_GSI_EVENT_EN, 0);
+	wr(se, SE_IRQ_ROUTE, 0);
+	wr(se, SE_S_IRQ_EN, 0);
+	wr(se, SE_IRQ_CLR, 0xffffffffu);
+	wr(se, SE_S_IRQ_CLR, 0xffffffffu);
+	wr(se, SE_DMA, 0);
+	wr(se, SE_CGC_CTRL, rd(se, SE_CGC_CTRL) | 0x7fu);
+	wr(se, SE_DMA_CFG, rd(se, SE_DMA_CFG) | 0x0fu);
+	wr(se, SE_OUTPUT_CTRL, 0x7f);
+	wr(se, SE_FORCE_DEFAULT, 1);
+	wr(se, SE_CLK_SEL, 0);
+	wr(se, SE_MCLK, (2u << 4) | 1u);
+	wr(se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	wr(se, SE_BYTE_GRAN, 0);
+	wr(se, SE_TX_PACK0, SE_PACK0);
+	wr(se, SE_TX_PACK1, SE_PACK1);
+	wr(se, SE_RX_PACK0, SE_PACK0);
+	wr(se, SE_RX_PACK1, SE_PACK1);
+	wr(se, SE_TX_WM, 0);
+	wr(se, SE_RX_WM, 0);
+	wr(se, SE_RX_RFR, ((rx >> 16) & 0x3fu) - 1u);
+	wr(se, SE_IRQ_EN, SE_EVENTS);
+	return true;
+}
+
+/*
+ * Two scanout buffers, as mainline's DPU flips a plane in video mode: SSPP_SRC0_ADDR (VIG0, sspp 0x4000 from the MDP's 0x0ae01000) is double buffered and
+ * takes effect at the vsync after CTL_FLUSH (0x18) has the pipe's bit, BIT(0) for VIG0 in dpu_hw_ctl_get_bitmask_sspp; the hardware clears the bit then, and
+ * the driver's wait_for_commit_done waits for that. The active CTL is the one whose CTL_INTF_ACTIVE (0xf4) is set. The buffers lie in low memory after the
+ * other DMA pools and before the LTE mpss_mem at 0x86000000. The firmware framebuffer stays the console's: a panic or a dead presenter goes back to it.
+ */
+#define FLIP_BASE 0x82400000ull
+#define FLIP_LIMIT 0x86000000ull
+#define FLIP_SSPP_SRC0 0x5014u
+#define FLIP_CTL(n) (0x2000u + (n) * 0x200u)
+#define FLIP_CTL_FLUSH 0x18u
+#define FLIP_CTL_INTF_ACTIVE 0xf4u
+static vm_offset_t flip_mdp;
+static uint32_t flip_ctl, flip_home_pa, flip_buffers[2];
+static volatile int flip_away;
+static uint32_t flip_count, flip_timeouts, flip_max_us, flip_late;
+static uint64_t flip_total_us, flip_latch_us, flip_requested;
+static volatile int flip_pending;
+extern void IOSleep(unsigned int);
+
+/*
+ * Direct scanout (CoachzGpu.cpp, coachz_gpu_scanout_direct): VIG0 fetches a frame the GPU rendered, of another size, and its QSEED3 scaler fits
+ * it to the panel, as mainline's DPU programs a plane: dpu_hw_sspp.c (dpu_hw_sspp_setup_format, setup_rects, setup_sourceaddress,
+ * setup_pe_config), dpu_hw_util.c dpu_hw_setup_scaler3, dpu_plane.c _dpu_plane_setup_scaler3 and _dpu_plane_setup_pixel_ext, msm_mdss.c
+ * msm_mdss_6x_setup_ubwc. sc7180 (dpu_6_2_sc7180.h): VIG0 at 0x4000 of the MDP with QSEED3 3.0 at +0xa00, whose preloads are QSEED4's (4
+ * across, 2 down); UBWC 2.0 with highest bank bit 14 and swizzle levels 2 and 3 (ubwc_config.c, the values the GPU writes with). The pipe
+ * reads apps SMMU addresses once the display's stream is routed (CoachzGpu.cpp). The registers below, as the firmware left them, are written
+ * back before a buffer flip or the panic path's return: those scan the firmware's linear format at the panel's own size.
+ */
+#define SSPP 0x5000u
+#define SSPP_SRC_SIZE 0x00u
+#define SSPP_SRC_XY 0x08u
+#define SSPP_OUT_SIZE 0x0cu
+#define SSPP_OUT_XY 0x10u
+#define SSPP_SRC0_ADDR 0x14u
+#define SSPP_SRC1_ADDR 0x18u
+#define SSPP_SRC2_ADDR 0x1cu
+#define SSPP_SRC3_ADDR 0x20u
+#define SSPP_SRC_YSTRIDE0 0x24u
+#define SSPP_SRC_YSTRIDE1 0x28u
+#define SSPP_SRC_FORMAT 0x30u
+#define SSPP_SRC_UNPACK_PATTERN 0x34u
+#define SSPP_SRC_OP_MODE 0x38u
+#define SSPP_UBWC_STATIC_CTRL 0x44u
+#define SSPP_FETCH_CONFIG 0x48u
+#define SSPP_DANGER_LUT 0x60u
+#define SSPP_SAFE_LUT 0x64u
+#define SSPP_QOS_CTRL 0x6cu
+#define SSPP_CREQ_LUT_0 0x74u
+#define SSPP_CREQ_LUT_1 0x78u
+#define SSPP_CDP_CNTL 0x134u
+#define SSPP_PE_C0_LR 0x100u
+#define SSPP_PE_C0_TB 0x104u
+#define SSPP_PE_C0_REQ 0x108u
+#define SSPP_PE_C1C2_LR 0x110u
+#define SSPP_PE_C1C2_TB 0x114u
+#define SSPP_PE_C1C2_REQ 0x118u
+#define SSPP_PE_C3_LR 0x120u
+#define SSPP_PE_C3_TB 0x124u
+#define SSPP_PE_C3_REQ 0x128u
+#define SSPP_UBWC_ERROR_STATUS 0x138u
+#define QSEED3 0xa00u
+#define QSEED3_OP_MODE 0x04u
+#define QSEED3_PHASE_STEP_Y_H 0x10u
+#define QSEED3_PHASE_STEP_Y_V 0x14u
+#define QSEED3_PHASE_STEP_UV_H 0x18u
+#define QSEED3_PHASE_STEP_UV_V 0x1cu
+#define QSEED3_PRELOAD 0x20u
+#define QSEED3_SRC_SIZE_Y_RGB_A 0x40u
+#define QSEED3_SRC_SIZE_UV 0x44u
+#define QSEED3_DST_SIZE 0x48u
+#define QSEED3_PHASE_INIT_Y_H 0x90u
+#define QSEED3_PHASE_INIT_Y_V 0x94u
+#define QSEED3_PHASE_INIT_UV_H 0x98u
+#define QSEED3_PHASE_INIT_UV_V 0x9cu
+#define MDSS_HW_VERSION 0x0u
+#define MDSS_UBWC_STATIC 0x144u
+#define MDSS_UBWC_CTRL_2 0x150u
+#define MDSS_UBWC_PREDICTION_MODE 0x154u
+#define OP_BWC_EN (1u << 0)
+#define OP_FLIP_LR (1u << 13)
+#define OP_FLIP_UD (1u << 14)
+#define OP_PE_OVERRIDE (1u << 31)
+#define DISPCC_PA 0x0af00000u
+#define DISPCC_MDP_CMD_RCGR 0x20c8u
+
+/* The SSPP registers a direct frame changes, with the scaler's mode last. */
+static const uint16_t direct_kept[] = {
+	SSPP_SRC_SIZE, SSPP_SRC_XY, SSPP_OUT_SIZE, SSPP_OUT_XY, SSPP_SRC0_ADDR, SSPP_SRC1_ADDR, SSPP_SRC2_ADDR, SSPP_SRC3_ADDR,
+	SSPP_SRC_YSTRIDE0, SSPP_SRC_YSTRIDE1, SSPP_SRC_FORMAT, SSPP_SRC_UNPACK_PATTERN, SSPP_SRC_OP_MODE, SSPP_UBWC_STATIC_CTRL,
+	SSPP_FETCH_CONFIG, SSPP_PE_C0_LR, SSPP_PE_C0_TB, SSPP_PE_C0_REQ, SSPP_PE_C1C2_LR, SSPP_PE_C1C2_TB, SSPP_PE_C1C2_REQ, SSPP_PE_C3_LR,
+	SSPP_PE_C3_TB, SSPP_PE_C3_REQ, QSEED3 + QSEED3_OP_MODE, SSPP_DANGER_LUT, SSPP_SAFE_LUT, SSPP_QOS_CTRL, SSPP_CREQ_LUT_0,
+	SSPP_CREQ_LUT_1, SSPP_CDP_CNTL,
+};
+#define DIRECT_KEPT (sizeof(direct_kept) / sizeof(direct_kept[0]))
+static uint32_t direct_saved[DIRECT_KEPT];
+/* direct_on: the pipe holds a direct frame's configuration (also from the panic path, so plain stores only). The tags name what the pipe
+ * scans, 0 for the buffers and the firmware framebuffer: shown has latched, pending waits for the next vsync. */
+static volatile int direct_on;
+static volatile uint32_t direct_shown, direct_pending;
+static int direct_ubwc_ready;
+static uint32_t direct_count, direct_ubwc_count, direct_scaled_count;
+
+/* Both sides declare this record (CoachzGpu.cpp): the display addresses of a frame and its layout. */
+struct coachz_scanout_frame {
+	uint32_t color, meta;          /* apps SMMU addresses of the color and UBWC flag planes (meta 0 for a linear frame) */
+	uint32_t color_pitch, meta_pitch;
+	uint32_t width, height;
+	uint32_t ubwc, order;          /* order: the bytes in memory, 1 R,G,B,A (XBGR8888), 2 B,G,R,A (XRGB8888) */
+	uint32_t tag;                  /* 1 to 31: the caller's name for the frame, reported by coachz_scanout_busy */
+};
+_Static_assert(sizeof(struct coachz_scanout_frame) == 36, "coachz_scanout_frame is shared with CoachzGpu.cpp");
+int coachz_scanout_direct(const struct coachz_scanout_frame *frame);
+uint32_t coachz_scanout_busy(void);
+uint64_t coachz_scanout_display_window(uint64_t *bytes);
+
+bool
+coachz_scanout_prepare(uint64_t firmware, uint64_t oneBuffer, uint64_t *base)
+{
+	if (firmware >> 32 || FLIP_BASE + 2 * oneBuffer > FLIP_LIMIT) {
+		return false;
+	}
+	flip_mdp = ml_io_map(0x0ae00000u, 0x8000);
+	if (!flip_mdp) {
+		return false;
+	}
+	unsigned ctl = 3;
+	for (unsigned n = 0; n < 3; ++n) {
+		if (rd(flip_mdp, FLIP_CTL(n) + FLIP_CTL_INTF_ACTIVE)) {
+			ctl = n;
+			break;
+		}
+	}
+	const uint32_t shown = rd(flip_mdp, FLIP_SSPP_SRC0);
+	printf("COACHZ flip: ctl %u, pipe scans 0x%x (firmware 0x%llx), buffers at 0x%llx, %llu bytes each\n", ctl, shown, firmware, FLIP_BASE, oneBuffer);
+	if (ctl == 3 || shown != (uint32_t)firmware) {
+		return false;
+	}
+	for (unsigned i = 0; i < DIRECT_KEPT; ++i) {
+		direct_saved[i] = rd(flip_mdp, SSPP + direct_kept[i]);
+	}
+	flip_ctl = FLIP_CTL(ctl);
+	flip_home_pa = (uint32_t)firmware;
+	flip_buffers[0] = (uint32_t)FLIP_BASE;
+	flip_buffers[1] = (uint32_t)(FLIP_BASE + oneBuffer);
+	*base = FLIP_BASE;
+	return true;
+}
+
+/* The physical memory the pipe scans before a direct frame: the firmware framebuffer and the two buffers, which CoachzGpu.cpp keeps at
+ * IOVA = PA once the display's stream is translated. Returns the firmware framebuffer's address and the length of one buffer. */
+uint64_t
+coachz_scanout_display_window(uint64_t *bytes)
+{
+	if (!flip_ctl) {
+		return 0;
+	}
+	*bytes = flip_buffers[1] - flip_buffers[0];
+	return flip_home_pa;
+}
+
+/* The firmware's linear configuration again, before the pipe scans one of its own memories (plain stores: the panic path uses it). */
+static void
+direct_restore(void)
+{
+	if (!direct_on) {
+		return;
+	}
+	for (unsigned i = 0; i < DIRECT_KEPT; ++i) {
+		wr(flip_mdp, SSPP + direct_kept[i], direct_saved[i]);
+	}
+	direct_on = 0;
+}
+
+/*
+ * The commit-done half of a flip: the pipe latched the last address once the hardware cleared the flush bit at a vsync. Mainline runs it
+ * after the kickoff in the commit worker (msm_atomic_commit_tail: flush_commit, then wait_flush, dpu_encoder_wait_for_commit_done), not in the
+ * caller's ioctl, and the next commit waits for it before it kicks off. Here it runs before the presenter draws into the other buffer, the
+ * one the pipe scanned until that latch, and before the next flush. The presenter's GPU copy and the swap's release no longer wait for a vsync.
+ */
+void
+coachz_scanout_flip_wait(void)
+{
+	if (!flip_ctl || !flip_pending) {
+		return;
+	}
+	const uint64_t began = mach_absolute_time();
+	unsigned waited = 0;
+	if (rd(flip_mdp, flip_ctl + FLIP_CTL_FLUSH) & 1u) {
+		++flip_late;   /* the next frame came before the last flip latched */
+	}
+	while ((rd(flip_mdp, flip_ctl + FLIP_CTL_FLUSH) & 1u) && waited < 34) {
+		IOSleep(1);
+		++waited;
+	}
+	const uint64_t now = mach_absolute_time();
+	uint64_t ns = 0, latch = 0;
+	absolutetime_to_nanoseconds(now - began, &ns);
+	absolutetime_to_nanoseconds(now - flip_requested, &latch);
+	const uint32_t us = (uint32_t)(ns / 1000);
+	flip_pending = 0;
+	/* A flush that did not clear in 34 ms leaves both configurations possible: neither is reported free. */
+	if (waited < 34) {
+		direct_shown = direct_pending;
+	}
+	flip_total_us += us;
+	flip_latch_us += latch / 1000;
+	if (us > flip_max_us) {
+		flip_max_us = us;
+	}
+	if (waited >= 34) {
+		++flip_timeouts;
+	}
+	if (++flip_count % 600 == 1) {
+		/* formatted here: the kernel's printf encodes every argument for os_log and a long row overflows it */
+		char row[256];
+		snprintf(row, sizeof(row), "COACHZ flip: %u flips, %u timeouts, %u still pending at the next frame, wait mean %llu max %u us, "
+		    "request to seen latched mean %llu us; direct %u (UBWC %u, scaled %u)", flip_count, flip_timeouts, flip_late,
+		    flip_total_us / flip_count, flip_max_us, flip_latch_us / flip_count, direct_count, direct_ubwc_count, direct_scaled_count);
+		printf("%s\n", row);
+		flip_max_us = 0;
+	}
+}
+
+/* The kickoff half (dpu_encoder_kickoff): the plane address and the pipe's flush bit, then return. One flip is in flight at a time. */
+void
+coachz_scanout_flip(uint32_t buffer)
+{
+	if (!flip_ctl || buffer > 1) {
+		return;
+	}
+	coachz_scanout_flip_wait();
+	direct_restore();
+	flip_away = 1;
+	wr(flip_mdp, FLIP_SSPP_SRC0, flip_buffers[buffer]);
+	wr(flip_mdp, flip_ctl + FLIP_CTL_FLUSH, 1u);
+	flip_requested = mach_absolute_time();
+	direct_pending = 0;
+	flip_pending = 1;
+}
+
+/* Also from the panic path: registers only, no lock and no wait. A later coachz_scanout_flip_wait sees the return latch, after which
+ * the pipe no longer fetches a direct frame. */
+void
+coachz_scanout_home(void)
+{
+	if (flip_ctl && (flip_away || direct_on)) {
+		flip_away = 0;
+		direct_restore();
+		wr(flip_mdp, FLIP_SSPP_SRC0, flip_home_pa);
+		wr(flip_mdp, flip_ctl + FLIP_CTL_FLUSH, 1u);
+		direct_pending = 0;
+		flip_requested = mach_absolute_time();
+		flip_pending = 1;
+	}
+}
+
+/* The tags the pipe may still fetch from (bit n for tag n; bit 0 the buffers and the firmware framebuffer): the latched one and, while a
+ * flush waits for its vsync, the pending one. */
+uint32_t
+coachz_scanout_busy(void)
+{
+	if (!flip_ctl) {
+		return 0;
+	}
+	const bool waiting = flip_pending || (rd(flip_mdp, flip_ctl + FLIP_CTL_FLUSH) & 1u);
+	return (1u << (direct_shown & 31)) | (waiting ? 1u << (direct_pending & 31) : 0u);
+}
+
+/* MDSS UBWC parameters for 6.x (msm_mdss_6x_setup_ubwc with sc7180's UBWC 2.0, highest bank bit 14), and what the firmware left for the
+ * MDP's core clock (dispcc-sc7180.c: RCG at 0x20c8; source 0 XO, 1 disp_cc_pll0, 4 GPLL0 at 600 MHz; a half divider): the scaler fetches
+ * 1488 rows in 1440 rows' time, about 3 % more pixels per line time than the firmware's own frame. Read only, except the UBWC words. */
+static bool
+direct_ubwc_setup(void)
+{
+	const uint32_t hw = rd(flip_mdp, MDSS_HW_VERSION);
+	const vm_offset_t dispcc = ml_io_map(DISPCC_PA, 0x3000);
+	const uint32_t cmd = dispcc ? rd(dispcc, DISPCC_MDP_CMD_RCGR) : 0, cfg = dispcc ? rd(dispcc, DISPCC_MDP_CMD_RCGR + 4) : 0;
+	const uint32_t before = rd(flip_mdp, MDSS_UBWC_STATIC);
+	if (hw >> 28 < 6) {
+		printf("COACHZ scanout: MDSS version 0x%x before 6.0, UBWC left alone\n", hw);
+		return false;
+	}
+	wr(flip_mdp, MDSS_UBWC_STATIC, 6u | (1u << 3) | ((14u - 13u) << 4));   /* swizzle levels 2 and 3, bank spread, highest bank bit 14 */
+	wr(flip_mdp, MDSS_UBWC_CTRL_2, 0);                                     /* qcom_ubwc_version_tag: 0 below UBWC 3.0 */
+	wr(flip_mdp, MDSS_UBWC_PREDICTION_MODE, 0);                            /* 0 below UBWC 4.0 */
+	printf("COACHZ scanout: MDSS 0x%x UBWC_STATIC 0x%x -> 0x%x; MDP clock RCG cmd 0x%x cfg 0x%x (source %u, half divider %u)\n", hw,
+	    before, rd(flip_mdp, MDSS_UBWC_STATIC), cmd, cfg, (cfg >> 8) & 7u, cfg & 0x1fu);
+	return true;
+}
+
+/*
+ * One frame through VIG0, then the flush (the caller waits for the latch with coachz_scanout_flip_wait). The output rectangle stays the
+ * firmware's (the panel), the source is the frame; a frame of another size goes through the scaler with the bilinear filter, as
+ * _dpu_plane_setup_scaler3 sets it for RGB, with the pixel extension the scaler then needs (no extra rows or columns). The format is
+ * XBGR8888 or XRGB8888 without alpha, as the firmware's SRC_FORMAT 0x236ff: the compositor's alpha is not opacity on the base plane.
+ */
+int
+coachz_scanout_direct(const struct coachz_scanout_frame *frame)
+{
+	if (!flip_ctl || !frame || !frame->tag || frame->tag > 31 || !frame->color || !frame->width || !frame->height ||
+	    frame->width > 4096 || frame->height > 4096 || frame->color_pitch < frame->width * 4 || frame->color_pitch > 0xffffu ||
+	    (frame->order != 1 && frame->order != 2) || (frame->ubwc && (frame->order != 1 || !frame->meta || !frame->meta_pitch ||
+	    frame->meta_pitch > 0xffffu))) {
+		return EINVAL;
+	}
+	if (frame->ubwc && !direct_ubwc_ready) {
+		if (!direct_ubwc_setup()) {
+			return ENOTSUP;
+		}
+		direct_ubwc_ready = 1;
+	}
+	const uint32_t out = direct_saved[2];   /* SSPP_OUT_SIZE: height << 16 | width */
+	const uint32_t dst_w = out & 0xffffu, dst_h = out >> 16, w = frame->width, h = frame->height;
+	if (!dst_w || !dst_h || w > 4 * dst_w || h > 4 * dst_h || dst_w > 4 * w || dst_h > 4 * h) {
+		return EINVAL;
+	}
+	const bool scaled = w != dst_w || h != dst_h;
+	coachz_scanout_flip_wait();
+	const vm_offset_t pipe = flip_mdp + SSPP, scaler = flip_mdp + SSPP + QSEED3;
+	uint32_t op = direct_saved[12] & ~(OP_FLIP_LR | OP_FLIP_UD | OP_BWC_EN | OP_PE_OVERRIDE);   /* the firmware's SSPP_SRC_OP_MODE */
+	if (frame->ubwc) {
+		op |= OP_BWC_EN;
+	}
+	op |= OP_PE_OVERRIDE;
+	/* dpu_hw_setup_format_impl: 8 bits a channel, no alpha, 4 bytes, unpack 4 tight; UBWC is fetch mode 2 at bit 30 with its own
+	 * fetch config (highest bank bit at 18) and static control (swizzle and bank bit, no fast clear without alpha). */
+	wr(pipe, SSPP_FETCH_CONFIG, frame->ubwc ? 0x87u | ((14u - 13u) << 18) : direct_saved[14]);
+	if (frame->ubwc) {
+		wr(pipe, SSPP_UBWC_STATIC_CTRL, 6u | ((14u - 13u) << 4));
+	}
+	wr(pipe, SSPP_SRC_FORMAT, 0x236ffu | (frame->ubwc ? 2u << 30 : 0));
+	wr(pipe, SSPP_SRC_UNPACK_PATTERN, frame->order == 1 ? 0x03010002u : 0x03020001u);
+	wr(pipe, SSPP_SRC_OP_MODE, op);
+	if (frame->ubwc) {
+		wr(pipe, SSPP_UBWC_ERROR_STATUS, 1u << 31);
+	}
+	/*
+	 * The fetch's QoS as _dpu_plane_set_qos_lut and _dpu_plane_set_qos_ctrl set it for a real-time pipe, from sc7180_perf_data: the
+	 * linear or the macrotile (UBWC) row of danger_lut_tbl, safe_lut_tbl and qos_lut_tbl (one entry each, so the fill level does not
+	 * matter), an 8-level CREQ LUT (DPU 6.x) and danger/safe on. Client driven prefetch as dpu_setup_cdp with cdp_cfg's read enable:
+	 * preload 64 ahead, and for UBWC the flags plane and tile amortizing.
+	 */
+	const uint64_t creq = frame->ubwc ? 0x0011223344556677ull : 0x0011222222335777ull;
+	wr(pipe, SSPP_DANGER_LUT, frame->ubwc ? 0xffffu : 0xffu);
+	wr(pipe, SSPP_SAFE_LUT, frame->ubwc ? 0xff00u : 0xfff0u);
+	wr(pipe, SSPP_CREQ_LUT_0, (uint32_t)creq);
+	wr(pipe, SSPP_CREQ_LUT_1, (uint32_t)(creq >> 32));
+	wr(pipe, SSPP_QOS_CTRL, 1u);
+	wr(pipe, SSPP_CDP_CNTL, (1u << 3) | 1u | (frame->ubwc ? (1u << 1) | (1u << 2) : 0));
+	/* setup_rects and setup_sourceaddress: plane 0 the color, plane 2 the UBWC flags; strides of planes 0 and 2. */
+	wr(pipe, SSPP_SRC_SIZE, h << 16 | w);
+	wr(pipe, SSPP_SRC_XY, 0);
+	wr(pipe, SSPP_OUT_SIZE, direct_saved[2]);
+	wr(pipe, SSPP_OUT_XY, direct_saved[3]);
+	wr(pipe, SSPP_SRC0_ADDR, frame->color);
+	wr(pipe, SSPP_SRC1_ADDR, 0);
+	wr(pipe, SSPP_SRC2_ADDR, frame->ubwc ? frame->meta : 0);
+	wr(pipe, SSPP_SRC3_ADDR, 0);
+	wr(pipe, SSPP_SRC_YSTRIDE0, frame->color_pitch);
+	wr(pipe, SSPP_SRC_YSTRIDE1, frame->ubwc ? frame->meta_pitch : 0);
+	/* setup_pe_config: no extension, the requested pixels are the source's for every component. */
+	const uint32_t req = h << 16 | w;
+	wr(pipe, SSPP_PE_C0_LR, 0);
+	wr(pipe, SSPP_PE_C0_TB, 0);
+	wr(pipe, SSPP_PE_C0_REQ, req);
+	wr(pipe, SSPP_PE_C1C2_LR, 0);
+	wr(pipe, SSPP_PE_C1C2_TB, 0);
+	wr(pipe, SSPP_PE_C1C2_REQ, req);
+	wr(pipe, SSPP_PE_C3_LR, 0);
+	wr(pipe, SSPP_PE_C3_TB, 0);
+	wr(pipe, SSPP_PE_C3_REQ, req);
+	if (scaled) {
+		/* _dpu_plane_setup_scaler3: phase steps of 2^21 times source over destination, the same for the chroma planes of RGB. */
+		const uint32_t step_x = (uint32_t)(((uint64_t)w << 21) / dst_w), step_y = (uint32_t)(((uint64_t)h << 21) / dst_h);
+		wr(scaler, QSEED3_PHASE_INIT_Y_H, 0);
+		wr(scaler, QSEED3_PHASE_INIT_Y_V, 0);
+		wr(scaler, QSEED3_PHASE_INIT_UV_H, 0);
+		wr(scaler, QSEED3_PHASE_INIT_UV_V, 0);
+		wr(scaler, QSEED3_PHASE_STEP_Y_H, step_x & 0xffffffu);
+		wr(scaler, QSEED3_PHASE_STEP_Y_V, step_y & 0xffffffu);
+		wr(scaler, QSEED3_PHASE_STEP_UV_H, step_x & 0xffffffu);
+		wr(scaler, QSEED3_PHASE_STEP_UV_V, step_y & 0xffffffu);
+		wr(scaler, QSEED3_PRELOAD, 4u | 2u << 8 | 4u << 16 | 2u << 24);
+		wr(scaler, QSEED3_SRC_SIZE_Y_RGB_A, h << 16 | w);
+		wr(scaler, QSEED3_SRC_SIZE_UV, h << 16 | w);
+		wr(scaler, QSEED3_DST_SIZE, dst_h << 16 | dst_w);
+		/* enable, DPU_SCALE_BIL (3) for Y/RGB, blend, and not 10-bit (bit 14); no alpha filter without alpha */
+		wr(scaler, QSEED3_OP_MODE, 1u | 3u << 16 | 1u << 31 | 1u << 14);
+	} else {
+		wr(scaler, QSEED3_OP_MODE, 1u << 14);
+	}
+	direct_on = 1;
+	flip_away = 1;
+	wr(flip_mdp, flip_ctl + FLIP_CTL_FLUSH, 1u);
+	flip_requested = mach_absolute_time();
+	direct_pending = frame->tag;
+	flip_pending = 1;
+	++direct_count;
+	direct_ubwc_count += frame->ubwc ? 1 : 0;
+	direct_scaled_count += scaled ? 1 : 0;
+	if (direct_count <= 2) {
+		char row[256];
+		snprintf(row, sizeof(row), "COACHZ scanout: direct %u: %ux%u to %ux%u, %s order %u, color 0x%x pitch %u, flags 0x%x pitch %u, op 0x%x; "
+		    "firmware QoS danger 0x%x safe 0x%x ctrl 0x%x cdp 0x%x",
+		    direct_count, w, h, dst_w, dst_h, frame->ubwc ? "UBWC" : "linear", frame->order, frame->color, frame->color_pitch, frame->meta,
+		    frame->meta_pitch, op, direct_saved[25], direct_saved[26], direct_saved[27], direct_saved[30]);
+		printf("%s\n", row);
+	}
+	return 0;
+}
+
+
+/* What a later direct scanout has to change, read only: the pipe the firmware left scanning, the controller, the interface and the
+ * apps SMMU entries of the display's streams (Linux: iommus = <&apps_smmu 0x800 0x2>). */
+static void
+display_state(void)
+{
+	static const uint32_t regs[] = { 0xae05000u, 0xae05014u, 0xae05024u, 0xae05030u };
+	const vm_offset_t mdp = ml_io_map(0x0ae00000u, 0x100000), smmu = ml_io_map(0x15000000u, 0x1000);
+
+	if (!mdp || !smmu) {
+		return;
+	}
+	printf("COACHZ display: pipe size 0x%x scanout 0x%x stride 0x%x format 0x%x; SMMU cr0 0x%x idr0 0x%x\n",
+	    rd(mdp, regs[0] - 0xae00000u), rd(mdp, regs[1] - 0xae00000u), rd(mdp, regs[2] - 0xae00000u), rd(mdp, regs[3] - 0xae00000u),
+	    rd(smmu, 0), rd(smmu, 0x20));
+	const unsigned groups = rd(smmu, 0x20) & 0xffu;
+	for (unsigned n = 0; n < groups; ++n) {
+		const uint32_t smr = rd(smmu, 0x800 + n * 4);
+		const uint32_t id = smr & 0xffffu, mask = (smr >> 16) & 0x7fffu;
+		if ((smr & (1u << 31)) && ((0x800u ^ id) & ~mask) == 0) {
+			printf("COACHZ display: stream group %u smr 0x%x s2cr 0x%x\n", n, smr, rd(smmu, 0xc00 + n * 4));
+		}
+	}
+}
+
+static void
+bridge_thread(__unused void *arg, __unused wait_result_t result)
+{
+	static const unsigned rates[] = { 0, 1620, 2160, 2430, 2700, 3240, 4320, 5400 };
+	const vm_offset_t gcc = ml_io_map(GCC_PA, 0x60000);
+	uint8_t frame = 0, format = 0, ssc = 0, rate = 0, mode = 0, hbp = 0, vbp = 0, hfp = 0, vfp = 0;
+	unsigned line = 0, height = 0, hsync = 0, vsync = 0;
+	int error;
+
+	display_state();
+	se = ml_io_map(SE2_PA, 0x4000);
+	if (!gcc || !se) {
+		printf("COACHZ bridge: no mapping\n");
+		goto done;
+	}
+	wr(gcc, GCC_VOTE, rd(gcc, GCC_VOTE) | GCC_VOTE_BITS);
+	if (!wait_clear(gcc, GCC_S2_CBCR, 1u << 31) ||
+	    ((rd(gcc, GCC_S2_DFS_CMD) & 1u) && (rd(gcc, GCC_S2_DFS_L0) & 0x371fu) != 1u) || !engine_init()) {
+		printf("COACHZ bridge: bus not usable: cbcr 0x%x fw 0x%x status 0x%x\n", rd(gcc, GCC_S2_CBCR), rd(se, SE_FW), rd(se, SE_STATUS));
+		goto done;
+	}
+	error = reg_read(SN_ENH_FRAME, &frame);
+	error = error ? error : reg_read(SN_DATA_FORMAT, &format);
+	error = error ? error : reg_read(SN_SSC_CONFIG, &ssc);
+	error = error ? error : reg_read(SN_DATARATE, &rate);
+	error = error ? error : reg_read(SN_ML_TX_MODE, &mode);
+	error = error ? error : reg_read16(SN_ACTIVE_LINE, &line);
+	error = error ? error : reg_read16(SN_VDISPLAY, &height);
+	error = error ? error : reg_read16(SN_HSYNC, &hsync);
+	error = error ? error : reg_read16(SN_VSYNC, &vsync);
+	error = error ? error : reg_read(SN_HBP, &hbp);
+	error = error ? error : reg_read(SN_VBP, &vbp);
+	error = error ? error : reg_read(SN_HFP, &hfp);
+	error = error ? error : reg_read(SN_VFP, &vfp);
+	if (error) {
+		printf("COACHZ bridge: register read failed: %d\n", error);
+		goto done;
+	}
+	hsync &= 0x7fffu;
+	vsync &= 0x7fffu;
+	const unsigned field = (ssc >> 4) & 3u, lanes = field == 3 ? 4 : field;
+	const unsigned mbps = rates[rate >> 5];
+	const uint64_t pixel_khz = (uint64_t)(line + hsync + hbp + hfp) * (height + vsync + vbp + vfp) * PANEL_HZ / 1000;
+	/* ti_sn_bridge_calc_min_dp_rate_idx: the pixel clock times the depth, plus a quarter, over the lanes. */
+	const uint64_t need = (pixel_khz * 24 * 5 / 4 + 999) / 1000 / (lanes ? lanes : 1);
+	printf("COACHZ bridge: firmware state 5a 0x%x 5b 0x%x 93 0x%x 94 0x%x 96 0x%x; %ux%u, %llu kHz, %u lanes at %u MHz, 24 bpp needs %llu\n",
+	    frame, format, ssc, rate, mode, line, height, pixel_khz, lanes, mbps, need);
+	if (!(format & BPP_18_RGB)) {
+		printf("COACHZ bridge: already 24 bpp\n");
+		goto done;
+	}
+	if (mode != ML_TX_NORMAL || !lanes || !mbps || need > mbps) {
+		printf("COACHZ bridge: left at 18 bpp, the running link would not carry 24\n");
+		goto done;
+	}
+	error = reg_write(SN_ENH_FRAME, frame & ~VSTREAM_ENABLE);
+	sleep_ms(20);
+	const int format_error = error ? error : reg_write(SN_DATA_FORMAT, format & ~BPP_18_RGB);
+	/* The stream comes back whatever happened, or the panel stays dark. */
+	error = reg_write(SN_ENH_FRAME, frame | VSTREAM_ENABLE);
+	sleep_ms(100);
+	uint8_t after_format = 0xff, after_frame = 0xff, after_mode = 0xff;
+	(void)reg_read(SN_DATA_FORMAT, &after_format);
+	(void)reg_read(SN_ENH_FRAME, &after_frame);
+	(void)reg_read(SN_ML_TX_MODE, &after_mode);
+	printf("COACHZ bridge: depth write %d, stream write %d; now 5a 0x%x 5b 0x%x 96 0x%x\n", format_error, error, after_frame, after_format, after_mode);
+done:
+	(void)thread_terminate(current_thread());
+}
+
+void
+coachz_bridge_start(void)
+{
+	static bool started;
+	int enabled = 0;
+	thread_t thread;
+
+	if (started || !PE_parse_boot_argn("coachz-display", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(bridge_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
