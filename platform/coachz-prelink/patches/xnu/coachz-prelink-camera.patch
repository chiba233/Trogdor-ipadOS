+/*
+ * The camera's path to memory (drivers/RamBlock/camera/coachz_camera.c): CPAS's cam_hf_1_mnoc path in sc7180-camera.dtsi is
+ * qxm_camnoc_hf0 to ebi, whose mmss hop qns_mem_noc_hf (32 bytes, one channel) is MM0's only node in sc7180.c; qns_llcc and ebi carry
+ * the DDR vote's top level. The display's qxm_mdp0 also reaches DDR through qns_mem_noc_hf, and nothing else votes MM0 here, so its
+ * share (as coachz_venus_bus_vote computes it) is always included and the peak never drops below its floor. kB/s in.
+ */
+int coachz_camera_bus_vote(uint64_t avg_kbps, uint64_t peak_kbps);
+int
+coachz_camera_bus_vote(uint64_t avg_kbps, uint64_t peak_kbps)
+{
+    const uint64_t display_bw = 2160ull * (1440 + 3 + 6 + 31) * 60 * 4;
+    const uint64_t display_prefill = display_bw * 24 / (31 + 6);
+    const uint64_t display_fetch = display_bw > display_prefill ? display_bw : display_prefill;
+    const uint64_t display_avg = display_fetch * 120 / 100 / 1000, display_peak = 1600000;
+    const struct wifi_bcm path = {"MM0", 32, 1, 0, avg_kbps + display_avg, peak_kbps > display_peak ? peak_kbps : display_peak};
+    const vm_offset_t db = wifi_cmd_db();
+    return db ? wifi_bcm_send(db, "camera bus", &path, 1) : -1;
+}
