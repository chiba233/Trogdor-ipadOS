+/*
+ * What the clusters really run at under load, for the thermal clamp's test: one A55 and one A76 spin past the governor's 16 ms windows,
+ * then the dependent add chain times them. The caller must be a thread that can block.
+ */
+void
+coachz_cluster_mhz(const char *why)
+{
+	static const unsigned cores[2] = { 0, 6 };
+	uint64_t mhz[2] = { 0 }, loop2 = 0;
+	int where[2] = { -1, -1 };
+	for (unsigned index = 0; index < 2; index++) {
+		if ((unsigned)ml_get_cpu_count() <= cores[index] || !processor_array[cores[index]]) {
+			continue;
+		}
+		thread_bind(processor_array[cores[index]]);
+		thread_block(THREAD_CONTINUE_NULL);
+		where[index] = cpu_number();
+		uint64_t until;
+		clock_interval_to_deadline(48, NSEC_PER_MSEC, &until);
+		while (mach_absolute_time() < until) {
+		}
+		mhz[index] = coachz_core_mhz(&loop2);
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	printf("COACHZ thermal: %s: measured A55 %llu MHz on %d, A76 %llu MHz on %d\n", why, mhz[0], where[0], mhz[1], where[1]);
 }
 
