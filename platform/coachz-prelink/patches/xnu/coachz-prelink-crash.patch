+
+/*
+ * What a crash leaves in the disk log: where the exiting thread faulted, in the addresses of its shared cache slide. The first
+ * few per process name; only signals that mean a fault or an abort, and only on the exiting process's own thread.
+ */
+void coachz_crash_capture(const char *name, int pid, int status);
+
+void
+coachz_crash_capture(const char *name, int pid, int status)
+{
+	static struct {
+		char name[20];
+		unsigned count;
+	} seen[24];
+	static unsigned total;
+	const int signal = status & 0x7f;
+	char line[640];
+	arm_saved_state_t *state;
+	size_t used;
+	unsigned slot;
+
+	if (signal != 4 && signal != 5 && signal != 6 && signal != 8 && signal != 10 && signal != 11 && signal != 12) {
+		return;
+	}
+	for (slot = 0; slot < 24; slot++) {
+		if (!seen[slot].name[0]) {
+			strlcpy(seen[slot].name, name, sizeof(seen[slot].name));
+			break;
+		}
+		if (!strncmp(seen[slot].name, name, sizeof(seen[slot].name) - 1)) {
+			break;
+		}
+	}
+	if (slot == 24 || seen[slot].count++ >= 3 || total++ >= 48 || !(state = find_user_regs(current_thread()))) {
+		return;
+	}
+	used = (size_t)snprintf(line, sizeof(line),
+	    "@crash %s[%d] signal %d slide 0x%x pc %llx lr %llx sp %llx far %llx esr %x x0 %llx x1 %llx x2 %llx x16 %llx:",
+	    name, pid, signal, current_task()->task_shared_region_slide, (unsigned long long)get_saved_state_pc(state),
+	    (unsigned long long)get_saved_state_lr(state), (unsigned long long)get_saved_state_sp(state),
+	    (unsigned long long)state->ss_64.far, (unsigned)state->ss_64.esr,
+	    (unsigned long long)get_saved_state_reg(state, 0), (unsigned long long)get_saved_state_reg(state, 1),
+	    (unsigned long long)get_saved_state_reg(state, 2), (unsigned long long)get_saved_state_reg(state, 16));
+	if (used < sizeof(line) - 1) {
+		used += coachz_user_frames(line + used, sizeof(line) - 1 - used, current_map(), get_saved_state_fp(state),
+		    get_saved_state_sp(state), 24);
+	}
+	if (used > sizeof(line) - 2) {
+		used = sizeof(line) - 2;
+	}
+	line[used++] = '\n';
+	coachz_log_append(line, used);
+}
+
+/* Each report, where the main threads of the tapped app and of SpringBoard are, for the disk log. */
+int coachz_preferences_pid;
+void coachz_sample_main_threads(void);
+
+static void
+coachz_sample_main_thread(int pid, const char *label)
+{
+	struct proc *p = pid > 0 ? proc_find(pid) : NULL;
+	char line[640];
+	uint64_t pc = 0, lr = 0, fp = 0, sp = 0, x16 = 0;
+	unsigned hint = 0, thread_state = 0;
+	size_t used;
+	bool found = false;
+
+	if (!p) {
+		return;
+	}
+	task_t task = proc_task(p);
+	task_lock(task);
+	if (!queue_empty(&task->threads)) {
+		thread_t thread = (thread_t)queue_first(&task->threads);
+		arm_saved_state_t *saved = find_user_regs(thread);
+		if (saved) {
+			pc = get_saved_state_pc(saved);
+			lr = get_saved_state_lr(saved);
+			fp = get_saved_state_fp(saved);
+			sp = get_saved_state_sp(saved);
+			x16 = get_saved_state_reg(saved, 16);
+			hint = (unsigned)thread->block_hint;
+			thread_state = (unsigned)thread->state;
+			found = true;
+		}
+	}
+	const unsigned slide = task->task_shared_region_slide;
+	task_unlock(task);
+	if (found) {
+		extern vm_map_t get_task_map_reference(task_t);
+		vm_map_t map = get_task_map_reference(task);
+		used = (size_t)snprintf(line, sizeof(line), "@sample %s[%d] t%u slide 0x%x state 0x%x hint %u pc %llx lr %llx x16 %lld:",
+		    label, pid, coachz_launch_seconds(), slide, thread_state, hint, pc, lr, (long long)x16);
+		if (map != VM_MAP_NULL) {
+			if (used < sizeof(line) - 1) {
+				used += coachz_user_frames(line + used, sizeof(line) - 1 - used, map, fp, sp, 24);
+			}
+			vm_map_deallocate(map);
+		}
+		if (used > sizeof(line) - 2) {
+			used = sizeof(line) - 2;
+		}
+		line[used++] = '\n';
+		coachz_log_append(line, used);
+	}
+	proc_rele(p);
+}
+
+void
+coachz_sample_main_threads(void)
+{
+	if (!coachz_oslog_match("SpringBoard")) {
+		return;
+	}
+	coachz_sample_main_thread(coachz_preferences_pid, "Preferences");
+	coachz_sample_main_thread(os_atomic_load(&coachz_sb_pid, relaxed), "SpringBoard");
 }
