+/*
+ * Adapted from Droid-VM's iPadOS bring-up patch (BSD-2-Clause-Patent). APFS answers class 0 for every file on a volume
+ * without content protection and keeps no class a caller sets, so PosterBoard, which creates its poster data store with
+ * NSFileProtectionNone (class D) and checks the class back, judges the store not viable and has no wallpaper. With the
+ * AppleKeyStore stand-in (coachz-aks) a writable volume without content protection keeps the class in an extended
+ * attribute, and a file without one reads as class D, which is what an unencrypted file is. Nothing is encrypted.
+ */
+#define COACHZ_DATAPROTECT_XATTR "com.coachz.dataprotect-class"
+#define COACHZ_DATAPROTECT_CLASS_D 4
+
+static int
+coachz_dataprotect_emulated(vnode_t vp)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		uint32_t value = 0;
+		enabled = PE_parse_boot_argn("coachz-aks", &value, sizeof(value)) && value != 0;
+	}
+	mount_t mp = vnode_mount(vp);
+	return enabled && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
+	       (vnode_isreg(vp) || vnode_isdir(vp));
+}
+
+static void
+coachz_dataprotect_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = 0;
+	size_t size = sizeof(class);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_getxattr(vp, COACHZ_DATAPROTECT_XATTR, uio, &size, XATTR_NOSECURITY, ctx) != 0 || class == 0 || class > 7) {
+		class = COACHZ_DATAPROTECT_CLASS_D;
+	}
+	uio_free(uio);
+	vap->va_dataprotect_class = class;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Keeps the class asked for and takes it out of what the file system is asked to set (which would only drop it). */
+static void
+coachz_dataprotect_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	static int reported;
+	uint32_t class = vap->va_dataprotect_class;
+	int error = ENOMEM;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio != NULL) {
+		uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+		error = vn_setxattr(vp, COACHZ_DATAPROTECT_XATTR, uio, XATTR_NOSECURITY, ctx);
+		if (error == 0) {
+			VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+			VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+		}
+		uio_free(uio);
+	}
+	if (reported < 12) {
+		char name[17] = "";
+		reported++;
+		proc_selfname(name, sizeof(name));
+		printf("COACHZ dataprotect: %s set class %u: %d\n", name, class, error);
+	}
+}
+
