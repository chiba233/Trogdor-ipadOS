@@ -54,15 +54,49 @@
 char coachz_log_capture[1u << 20];
 volatile uint64_t coachz_log_head;
 
+/*
+ * The same bytes, mirrored into depthcharge's ramoops buffer once coachz_early_log.c has mapped it (Device memory: byte stores, and the
+ * head as one aligned u64), so that a boot that stops before the disk log opens leaves its tail for the next boot to read back.
+ */
+uint64_t coachz_ramoops_base, coachz_ramoops_size;
+volatile uint8_t *volatile coachz_early_mirror;
+volatile uint64_t *coachz_early_mirror_head;
+uint64_t coachz_early_mirror_mask;
+
+void
+coachz_early_note_ramoops(const uint8_t *note)
+{
+	static const char magic[8] = {'C', 'Z', 'R', 'A', 'M', 'O', 'O', 'P'};
+	for (unsigned i = 0; i < 8; i++) {
+		if (note[i] != (uint8_t)magic[i]) {
+			return;
+		}
+	}
+	uint64_t base = 0, size = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		base |= (uint64_t)note[8 + i] << (8 * i);
+		size |= (uint64_t)note[16 + i] << (8 * i);
+	}
+	coachz_ramoops_base = base;
+	coachz_ramoops_size = size;
+}
