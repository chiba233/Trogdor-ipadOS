+	volatile uint8_t *mirror = __atomic_load_n(&coachz_early_mirror, __ATOMIC_ACQUIRE);
 
 	for (size_t i = 0; i < count; i++) {
 		coachz_log_capture[(at + i) & ((1u << 20) - 1)] = bytes[i];
+		if (mirror) {
+			mirror[(at + i) & coachz_early_mirror_mask] = (uint8_t)bytes[i];
+		}
 	}
+	if (mirror) {
+		*coachz_early_mirror_head = at + count;
+	}
