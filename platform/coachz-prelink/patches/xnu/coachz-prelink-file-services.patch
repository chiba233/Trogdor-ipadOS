+/* Original fseventsd selects its global logger by the returned ROOTFS flag and checks the opened directory's fsid.
+ * Trace the API results without changing the mount view, return codes, files or UUIDs. */
+static void
+coachz_files_stat_result(mount_t mp, const char *operation, int fd, unsigned returned_flags, int error)
+{
+	proc_t p = current_proc();
+	static unsigned records;
+	if (!p || strcmp(p->p_comm, "fseventsd")) {
+		return;
+	}
+	unsigned seq = __atomic_fetch_add(&records, 1, __ATOMIC_RELAXED);
+	if (seq > 256) {
+		return;
+	}
+	if (seq == 256) {
+		printf("COACHZ files: stat diagnostic budget exhausted\n");
+		return;
+	}
+	mount_t root_mp = rootvnode ? vnode_mount(rootvnode) : NULL;
+	printf("COACHZ files: stat seq %u pid %d op %s fd %d error %d fsid 0x%x flags 0x%llx returned 0x%x root-fsid 0x%x root-flags 0x%llx iopolicy 0x%x\n",
+	    seq, proc_selfpid(), operation, fd, error, mp ? (unsigned)vfs_statfs(mp)->f_fsid.val[0] : 0,
+	    mp ? (unsigned long long)vfs_flags(mp) : 0, returned_flags,
+	    root_mp ? (unsigned)vfs_statfs(root_mp)->f_fsid.val[0] : 0, root_mp ? (unsigned long long)vfs_flags(root_mp) : 0,
+	    (unsigned)p->p_vfs_iopolicy);
+}
