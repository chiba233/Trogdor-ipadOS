+/* Bounded FSEvents startup evidence. Labels name only the three system log directories, never file names or UUID contents.
+ * Copy the pathname in this leaf helper so its small buffer is gone before the open enters APFS or crypto. */
+/* Labels: 1 root journal, 2 fallback journal, 3 Data journal, 4 unavailable,
+ * 5 temporary directory, 6 root mount, 7 Data mount, 8 another resolved path, 9 known relative journal leaf. */
+unsigned coachz_files_kernel_label(const char *path);
+unsigned coachz_files_path_label(user_addr_t address, int segment, vfs_context_t ctx);
+void coachz_files_operation_result(unsigned label, const char *operation, int fd, int error, vnode_t vp, uint64_t detail);
+
+unsigned
+coachz_files_kernel_label(const char *path)
+{
+	static const char *const directories[] = {"/.fseventsd", "/private/var/db/fseventsd", "/private/var/.fseventsd"};
+	if (!path) {
+		return 4;
+	}
+	for (unsigned i = 0; i < sizeof(directories) / sizeof(directories[0]); ++i) {
+		size_t n = strlen(directories[i]);
+		if (!strncmp(path, directories[i], n) && (path[n] == 0 || path[n] == '/')) {
+			return i + 1;
+		}
+	}
+	if (!strcmp(path, "/tmp") || !strcmp(path, "/private/var/tmp")) {
+		return 5;
+	}
+	if (!strcmp(path, "/")) {
+		return 6;
+	}
+	if (!strcmp(path, "/private/var")) {
+		return 7;
+	}
+	if (!strcmp(path, "fseventsd-uuid") || !strcmp(path, "no_log") || !strcmp(path, "ignore")) {
+		return 9;
+	}
+	return 0;
+}
+
+__attribute__((noinline)) unsigned
+coachz_files_path_label(user_addr_t address, int segment, vfs_context_t ctx)
+{
+	proc_t p = vfs_context_proc(ctx);
+	char path[128];
+	size_t copied;
+	if (!p || strcmp(p->p_comm, "fseventsd")) {
+		return 0;
+	}
+	if (!address) {
+		return 4;
+	}
+	if (segment == UIO_SYSSPACE) {
+		strlcpy(path, (const char *)(uintptr_t)address, sizeof(path));
+	} else if (copyinstr(address, path, sizeof(path), &copied)) {
+		return 4;
+	}
+	return coachz_files_kernel_label(path);
+}
+
+static unsigned
+coachz_files_open_label(struct nameidata *ndp, vfs_context_t ctx)
+{
+	return coachz_files_path_label(ndp->ni_dirp, ndp->ni_segflg, ctx);
+}
+
+void
+coachz_files_operation_result(unsigned label, const char *operation, int fd, int error, vnode_t vp, uint64_t detail)
+{
+	proc_t p = current_proc();
+	static unsigned records;
+	if (!label || !p || strcmp(p->p_comm, "fseventsd")) {
+		return;
+	}
+	unsigned seq = __atomic_fetch_add(&records, 1, __ATOMIC_RELAXED);
+	if (seq > 256) {
+		return;
+	}
+	if (seq == 256) {
+		printf("COACHZ files: operation diagnostic budget exhausted\n");
+		return;
+	}
+	mount_t mp = vp ? vnode_mount(vp) : NULL;
+	printf("COACHZ files: operation seq %u pid %d op %s path-label %u fd %d error %d vnode %u fsid 0x%x flags 0x%llx detail 0x%llx\n",
+	    seq, proc_selfpid(), operation, label, fd, error, (unsigned)(vp != NULLVP),
+	    mp ? (unsigned)vfs_statfs(mp)->f_fsid.val[0] : 0,
+	    mp ? (unsigned long long)vfs_flags(mp) : 0, (unsigned long long)detail);
+}
+
+static void
+coachz_files_open_result(unsigned label, int requested, int final, int error, vnode_t vp)
+{
+	static unsigned records;
+	if (!label) {
+		return;
+	}
+	unsigned seq = __atomic_fetch_add(&records, 1, __ATOMIC_RELAXED);
+	if (seq > 256) {
+		return;
+	}
+	if (seq == 256) {
+		printf("COACHZ files: open diagnostic budget exhausted\n");
+		return;
+	}
+	mount_t mp = vp ? vnode_mount(vp) : NULL;
+	printf("COACHZ files: open seq %u pid %d directory %u requested 0x%x final 0x%x error %d type %u vid %u fsid 0x%x flags 0x%llx\n",
+	    seq, proc_selfpid(), label, (unsigned)requested, (unsigned)final, error, vp ? vnode_vtype(vp) : 0, vp ? vnode_vid(vp) : 0,
+	    mp ? (unsigned)vfs_statfs(mp)->f_fsid.val[0] : 0, mp ? (unsigned long long)vfs_flags(mp) : 0);
+}
