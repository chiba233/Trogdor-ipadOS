+boolean_t
+coachz_kobj_map_grant(ipc_port_t port, mach_msg_id_t msgh_id)
+{
+	if ((msgh_id != 2863 && msgh_id != 2864) || !IP_VALID(port) || ip_kotype(port) != IKOT_IOKIT_CONNECT) {
