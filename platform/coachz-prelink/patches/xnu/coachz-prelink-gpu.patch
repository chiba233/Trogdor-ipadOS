+static inline uint32_t core_r(const struct coachz_gpu_io *io, uint32_t reg) { return gpu_r(io, GPU_CORE, CORE(reg)); }
+static inline void core_w(const struct coachz_gpu_io *io, uint32_t reg, uint32_t value) { gpu_w(io, GPU_CORE, CORE(reg), value); }
+/* Two 32-bit writes, low word first, as Linux's gpu_write64: many of these registers are not 8-byte aligned, and an unaligned store to
+ * Device memory aborts. On hardware a 64-bit store to UCHE_WRITE_RANGE_MAX (0xe05, byte offset 0x3814) panicked the kernel. */
+static inline void core_w64(const struct coachz_gpu_io *io, uint32_t reg, uint64_t value) {
+	core_w(io, reg, (uint32_t)value);
+	core_w(io, reg + 1u, (uint32_t)(value >> 32));
+}
+
+static inline uint32_t core_poll(const struct coachz_gpu_io *io, uint32_t reg, uint32_t mask, uint32_t want) {
+	for (uint32_t i = 1; i <= CORE_POLLS; i++) {
+		if ((core_r(io, reg) & mask) == want) return i;
+		io->delay_us(io->cookie, 100);
+	}
+	return 0;
+}
+
+static inline uint32_t core_pool_poll(const struct coachz_gpu_io *io, uint32_t at, uint32_t want) {
+	for (uint32_t i = 1; i <= CORE_POLLS; i++) {
+		if (gmu_mem_r(io, at) == want) return i;
+		io->delay_us(io->cookie, 100);
+	}
+	return 0;
+}
+
+static inline uint32_t pm4_parity(uint32_t value) {
+	return (0x9669u >> (0xfu & (value ^ value >> 4 ^ value >> 8 ^ value >> 12 ^ value >> 16 ^ value >> 20 ^ value >> 24 ^ value >> 28))) & 1u;
+}
+static inline uint32_t pm4_type7(uint32_t opcode, uint32_t count) {
+	return 0x70000000u | count | pm4_parity(count) << 15 | opcode << 16 | pm4_parity(opcode) << 23;
+}
+
+static inline void core_ring(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, uint32_t word) {
+	gmu_mem_w(io, GPU_RING + r->core_wptr * 4u, word);
+	r->core_wptr = (r->core_wptr + 1u) % GPU_RING_WORDS;
+}
+
+/* Tells the CP how far the ring goes after asking it to report its read pointer, as a6xx_flush does. */
+static inline void core_flush(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	core_ring(io, r, pm4_type7(PM4_WHERE_AM_I, 2u));
+	core_ring(io, r, (uint32_t)GPU_VA(GPU_SHADOW));
+	core_ring(io, r, (uint32_t)(GPU_VA(GPU_SHADOW) >> 32));
+	core_w(io, CP_RB_WPTR, r->core_wptr);
+}
+
+/* What the CP and the SMMU say now: RBBM status and interrupts, CP fault and protect status, bank 0's fault status. */
+static inline void core_snapshot(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	const uint32_t bank = r->smmu_bank_base + GPU_BANK * r->smmu_page;
+	r->core_state[0] = core_r(io, RBBM_STATUS);
+	r->core_state[1] = core_r(io, RBBM_INT_0_STATUS);
+	r->core_state[2] = core_r(io, CP_HW_FAULT);
+	r->core_state[3] = core_r(io, CP_INTERRUPT_STATUS);
+	r->core_state[4] = core_r(io, CP_PROTECT_STATUS);
+	r->core_state[5] = core_r(io, CP_RB_RPTR);
+	r->core_state[6] = gpu_r(io, GPU_SMMU, bank + SMMU_CB_FSR);
+	r->core_state[7] = gpu_r(io, GPU_SMMU, bank + SMMU_CB_FSYNR0);
+	r->core_far = gpu_r64(io, GPU_SMMU, bank + SMMU_CB_FAR);
+}
+
+/* Bank 0 over the GPU's pool, for stream 0; the GMU's bank is already live. 1 only when its translations are right. */
+static inline int core_map(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	const uint32_t bank = r->smmu_bank_base + GPU_BANK * r->smmu_page, cbar = r->smmu_page + 4u * GPU_BANK, cba2r = r->smmu_page + SMMU_CBA2R + 4u * GPU_BANK;
+	gmu_table_entry(io, GPU_L1, (uint32_t)(GPU_VA(GPU_RING) >> 30), (GMU_POOL_PA + GPU_L2) | LPAE_TABLE);
+	gmu_table_entry(io, GPU_L2, (uint32_t)(GPU_VA(GPU_RING) >> 21) & 511u, (GMU_POOL_PA + GPU_L3) | LPAE_TABLE);
+	for (uint32_t at = GPU_RING; at < GPU_SQE + GPU_SQE_MAX; at += 0x1000u) {
+		gmu_table_entry(io, GPU_L3, (uint32_t)(GPU_VA(at) >> 12) & 511u, (GMU_POOL_PA + at) | LPAE_PAGE);
+	}
+	r->own_core_map = 1;
+	gpu_w(io, GPU_SMMU, cba2r, SMMU_CBA2R_VA64);
+	gpu_w(io, GPU_SMMU, cbar, SMMU_CBAR_S1);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR2, SMMU_TCR2_36BIT);
+	gpu_w64(io, GPU_SMMU, bank + SMMU_CB_TTBR0, GMU_POOL_PA + GPU_L1);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR, SMMU_TCR_32BIT);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR0, SMMU_MAIR0_VALUE);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR1, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_FSR, ~0u);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_SCTLR, SMMU_SCTLR_GPU);
+	gpu_w(io, GPU_SMMU, SMMU_S2CR + 4u * GPU_GROUP, GPU_BANK);
+	gpu_w(io, GPU_SMMU, SMMU_SMR + 4u * GPU_GROUP, SMMU_SMR_VALID | GPU_STREAM);
+	if (!gmu_tlb_sync(io)) {
+		r->error = "GPU SMMU TLB sync did not finish for bank 0";
+		return 0;
+	}
+	gpu_w(io, GPU_SMMU, SMMU_SCR0, gpu_r(io, GPU_SMMU, SMMU_SCR0) | SMMU_SCR0_USFCFG);
+	static const uint32_t mapped[3] = {GPU_RING, GPU_FENCE & ~0xfffu, GPU_SQE};
+	for (unsigned i = 0; i < 3u; i++) {
+		uint64_t par = 0;
+		if (!gmu_translate(io, bank, (uint32_t)GPU_VA(mapped[i]), &par) || (par & SMMU_PAR_FAULT) || (par & SMMU_PAR_PA) != GMU_POOL_PA + mapped[i]) {
+			r->error = "bank 0 translation differs from the tables";
+			r->ats_wrong_va = (uint32_t)GPU_VA(mapped[i]);
+			r->ats_wrong_par = par;
+			return 0;
+		}
+	}
+	uint64_t miss = 0;
+	if (!gmu_translate(io, bank, (uint32_t)GPU_VA(GPU_SQE + GPU_SQE_MAX), &miss) || !(miss & SMMU_PAR_FAULT)) {
+		r->error = "bank 0 translated an unmapped address";
+		r->ats_wrong_par = miss;
+		return 0;
+	}
+	return 1;
+}
+
+/* Bank 0 and its stream as they were. */
+static inline void core_unmap(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	const uint32_t bank = r->smmu_bank_base + GPU_BANK * r->smmu_page;
+	gpu_w(io, GPU_SMMU, SMMU_SMR + 4u * GPU_GROUP, r->smr[GPU_GROUP]);
+	gpu_w(io, GPU_SMMU, SMMU_S2CR + 4u * GPU_GROUP, r->s2cr[GPU_GROUP]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_SCTLR, r->cb[GPU_BANK][0]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR, r->cb[GPU_BANK][1]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR2, 0);
+	gpu_w64(io, GPU_SMMU, bank + SMMU_CB_TTBR0, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR0, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_FSR, ~0u);
+	gpu_w(io, GPU_SMMU, r->smmu_page + 4u * GPU_BANK, r->cbar[GPU_BANK]);
+	gpu_w(io, GPU_SMMU, r->smmu_page + SMMU_CBA2R + 4u * GPU_BANK, r->cba2r[GPU_BANK]);
+}
+
+/* The lowest frequency, before GPU_SET as a6xx_gmu_resume does: 1 on an acknowledged request. */
+static inline int core_set_frequency(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	gpu_w(io, GPU_GMU, GMU_DCVS_ACK_OPTION, 0);
+	gpu_w(io, GPU_GMU, GMU_DCVS_PERF_SETTING, 3u << 28 | (r->mode >= 9 ? CORE_PERF_RUN : CORE_PERF_LOWEST));
+	gpu_w(io, GPU_GMU, GMU_DCVS_BW_SETTING, 0xffu);
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_DCVS_SET);
+	r->dcvs_polls = gmu_poll_long(io, GMU_GMU2HOST_INTR_INFO, 1u << GMU_OOB_DCVS_ACK, 1u << GMU_OOB_DCVS_ACK);
+	gpu_w(io, GPU_GMU, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_DCVS_ACK);
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_DCVS_ACK);
+	r->dcvs_return = gpu_r(io, GPU_GMU, GMU_DCVS_RETURN);
+	if (!r->dcvs_polls) r->error = "the firmware did not acknowledge the frequency request";
+	return r->dcvs_polls != 0;   /* a nonzero return is printed; Linux only logs it too */
+}
+
+/* The firmware the CP runs: the file without its first dword. Accepted as Linux accepts it: patched, or at least 1.90 (both have WHERE_AM_I). */
+static inline int core_load_sqe(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	const uint32_t words = io->sqe_bytes / 4u - 1u;
+	r->sqe_version = io->sqe[1];
+	if (!(((io->sqe[1] & 0xfu) == 0xau && (io->sqe[3] & 0xfu) >= 1u) || (io->sqe[1] & 0xfffu) >= 0x190u)) {
+		r->error = "SQE firmware older than 1.90";
+		return 0;
+	}
+	for (uint32_t i = 0; i < words; i++) gmu_mem_w(io, GPU_SQE + i * 4u, io->sqe[i + 1u]);
+	for (uint32_t i = 0; i < words; i++) {
+		if (gmu_mem_r(io, GPU_SQE + i * 4u) != io->sqe[i + 1u]) {
+			r->error = "SQE firmware does not read back from the pool";
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* a6xx hw_init for a618, with the CP not yet running. */
+static inline void core_registers(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	core_w(io, GBIF_HALT, 0);
+	(void)core_r(io, GBIF_HALT);
+	core_w(io, RBBM_GBIF_HALT, 0);
+	(void)core_r(io, RBBM_GBIF_HALT);
+	core_w(io, RBBM_SECVID_TSB_CNTL, 0);
+	core_w64(io, RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	core_w(io, RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	for (unsigned i = 0; i < 12u; i++) core_w(io, core_addr_modes[i], 1u);
+	/* Hardware clock gating, with the SP clock off while its registers change. */
+	gpu_w(io, GPU_GMU, GMU_CGC_MODE_CNTL, 0x222u);
+	gpu_w(io, GPU_GMU, GMU_CGC_DELAY_CNTL, 0x111u);
+	gpu_w(io, GPU_GMU, GMU_CGC_HYST_CNTL, 0x555u);
+	gpu_w(io, GPU_GMU, GMU_SPTPRAC_CLOCK_CONTROL, gpu_r(io, GPU_GMU, GMU_SPTPRAC_CLOCK_CONTROL) & ~1u);
+	for (unsigned i = 0; i < 63u; i++) core_w(io, core_hwcg[i].reg, core_hwcg[i].value);
+	gpu_w(io, GPU_GMU, GMU_SPTPRAC_CLOCK_CONTROL, gpu_r(io, GPU_GMU, GMU_SPTPRAC_CLOCK_CONTROL) | 1u);
+	core_w(io, RBBM_CLOCK_CNTL, CORE_CLOCK_CNTL_ON);
+	core_w64(io, UCHE_WRITE_RANGE_MAX, 0x0001ffffffffffc0ull);
+	core_w64(io, UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	core_w64(io, UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	core_w64(io, UCHE_GMEM_RANGE_MIN, 0x100000u);
+	core_w64(io, UCHE_GMEM_RANGE_MAX, 0x100000u + 0x80000u - 1u);
+	for (unsigned i = 0; i < sizeof(core_setup) / sizeof(core_setup[0]); i++) core_w(io, core_setup[i].reg, core_setup[i].value);
+	gpu_w(io, GPU_GMU, GMU_CX_BUSY_MASK, 0xff000000u);
+	gpu_w(io, GPU_GMU, GMU_CX_POWER_COUNTER_SELECT_0, (gpu_r(io, GPU_GMU, GMU_CX_POWER_COUNTER_SELECT_0) & ~0xffu) | (1u << 5));
+	gpu_w(io, GPU_GMU, GMU_CX_POWER_COUNTER_ENABLE, 1u);
+	/* The CP may only reach what Linux lets it reach; the last span runs to the end of the register space. */
+	core_w(io, CP_PROTECT_CNTL, 0xbu);
+	for (unsigned i = 0; i < 32u; i++) core_w(io, CP_PROTECT + i, core_protect[i]);
+	r->core_registers_done = 1;
+}
+
+/* From SQE start to the three visible results. */
+static inline void core_commands(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	core_w64(io, CP_SQE_INSTR_BASE, GPU_VA(GPU_SQE));
+	core_w64(io, CP_RB_BASE, GPU_VA(GPU_RING));
+	core_w(io, CP_RB_CNTL, CORE_RB_CNTL);
+	core_w64(io, CP_RB_RPTR_ADDR, GPU_VA(GPU_SHADOW));
+	gmu_note(io, r, 10);
+	core_w(io, CP_SQE_CNTL, 1u);
+	core_ring(io, r, pm4_type7(PM4_ME_INIT, 8u));
+	core_ring(io, r, 0x0000002fu);   /* multiple hardware contexts, error detection, no header dump, no workarounds */
+	core_ring(io, r, 0x00000003u);
+	core_ring(io, r, 0x20000000u);
+	for (unsigned i = 0; i < 5u; i++) core_ring(io, r, 0);
+	core_flush(io, r);
+	r->core_init_polls = core_poll(io, CP_RB_RPTR, ~0u, r->core_wptr);
+	r->core_idle_polls = core_poll(io, RBBM_STATUS, CORE_STATUS_IDLE_MASK, 0);
+	core_snapshot(io, r);
+	if (!r->core_init_polls) {
+		r->error = "the CP did not take ME_INIT";
+		return;
+	}
+	if (!r->core_idle_polls) {
+		r->error = "the GPU did not go idle after ME_INIT";
+		return;
+	}
+	core_w(io, RBBM_SECVID_TRUST_CNTL, 0);   /* no zap shader on this board: Linux leaves secure mode this way */
+	gmu_note(io, r, 11);
+	/* A memory write straight from the ring. */
+	core_ring(io, r, pm4_type7(PM4_MEM_WRITE, 3u));
+	core_ring(io, r, (uint32_t)GPU_VA(GPU_RESULT_RING));
+	core_ring(io, r, (uint32_t)(GPU_VA(GPU_RESULT_RING) >> 32));
+	core_ring(io, r, GPU_RING_VALUE);
+	core_flush(io, r);
+	r->core_ring_polls = core_pool_poll(io, GPU_RESULT_RING, GPU_RING_VALUE);
+	if (!r->core_ring_polls) {
+		core_snapshot(io, r);
+		r->error = "the CP's ring memory write never arrived";
+		return;
+	}
+	/* The same from an indirect buffer, then a fence after everything before it. */
+	gmu_mem_w(io, GPU_IB, pm4_type7(PM4_MEM_WRITE, 3u));
+	gmu_mem_w(io, GPU_IB + 4u, (uint32_t)GPU_VA(GPU_RESULT_IB));
+	gmu_mem_w(io, GPU_IB + 8u, (uint32_t)(GPU_VA(GPU_RESULT_IB) >> 32));
+	gmu_mem_w(io, GPU_IB + 12u, GPU_IB_VALUE);
+	core_ring(io, r, pm4_type7(PM4_INDIRECT_BUFFER, 3u));
+	core_ring(io, r, (uint32_t)GPU_VA(GPU_IB));
+	core_ring(io, r, (uint32_t)(GPU_VA(GPU_IB) >> 32));
+	core_ring(io, r, 4u);
+	core_ring(io, r, pm4_type7(PM4_EVENT_WRITE, 4u));
+	core_ring(io, r, PM4_CACHE_FLUSH_TS);
+	core_ring(io, r, (uint32_t)GPU_VA(GPU_FENCE));
+	core_ring(io, r, (uint32_t)(GPU_VA(GPU_FENCE) >> 32));
+	core_ring(io, r, GPU_FENCE_VALUE);
+	core_flush(io, r);
+	r->core_ib_polls = core_pool_poll(io, GPU_RESULT_IB, GPU_IB_VALUE);
+	r->core_fence_polls = core_pool_poll(io, GPU_FENCE, GPU_FENCE_VALUE);
+	r->core_shadow = gmu_mem_r(io, GPU_SHADOW);
+	core_snapshot(io, r);
+	if (!r->core_ib_polls) r->error = "the CP's indirect buffer write never arrived";
+	else if (!r->core_fence_polls) r->error = "the fence never arrived";
+}
+
+/* Mode 8, GPU_SET acknowledged. */
+static inline void core_run(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	if (!core_map(io, r)) return;
+	if (!core_load_sqe(io, r)) return;
+	gmu_note(io, r, 9);
+	r->own_core = 1;
+	core_registers(io, r);
+	core_commands(io, r);
+}
+
+/* The CP stopped and the GPU's bus quiet while GX is still on: a6xx_bus_clear_pending_transactions and the software reset. */
+static inline void core_stop(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	core_w(io, CP_SQE_CNTL, 0);
+	core_w(io, RBBM_GBIF_HALT, 1u);
+	r->core_halt_polls[0] = core_poll(io, RBBM_GBIF_HALT_ACK, 1u, 1u);
+	core_w(io, GBIF_HALT, 1u);
+	r->core_halt_polls[1] = core_poll(io, GBIF_HALT_ACK, 1u, 1u);
+	core_w(io, GBIF_HALT, 2u);
+	r->core_halt_polls[2] = core_poll(io, GBIF_HALT_ACK, 2u, 2u);
+	core_w(io, GBIF_HALT, 0);
+	core_w(io, RBBM_SW_RESET_CMD, 1u);
+	(void)core_r(io, RBBM_SW_RESET_CMD);
+	io->delay_us(io->cookie, 101);
+	core_w(io, RBBM_SW_RESET_CMD, 0);
+	(void)core_r(io, RBBM_SW_RESET_CMD);
+	io->delay_us(io->cookie, 1);
+	gpu_w(io, GPU_GMU, GMU_CX_POWER_COUNTER_ENABLE, 0);
+	gpu_w(io, GPU_GMU, GMU_CGC_MODE_CNTL, r->cgc_before[0]);
+	gpu_w(io, GPU_GMU, GMU_CGC_DELAY_CNTL, r->cgc_before[1]);
+	gpu_w(io, GPU_GMU, GMU_CGC_HYST_CNTL, r->cgc_before[2]);
+}
+#endif
