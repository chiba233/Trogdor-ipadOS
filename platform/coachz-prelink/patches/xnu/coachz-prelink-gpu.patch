+#define RSCC_HIDDEN_TCS_CMD0_DATA RSCC(0xeu)
+#define RSCC_OVERRIDE_START_ADDR RSCC(0x100u)
+#define RSCC_SEQ_BUSY_DRV0 RSCC(0x101u)
+#define RSCC_SEQ_MEM_0_DRV0 RSCC(0x180u)
+#define RSC_STATUS0_SDE_GATE_OFF (1u << 24)
+#define RSC_STATUS0_POWERED_OFF (1u << 16)
+
+/* The PDC: a6xx.xml dword offset * 4 from 0x0b290000; its sequencer memory at 0x0b490000. */
+#define PDC_ENABLE 0x4500u
+#define PDC_SEQ_START_ADDR 0x4520u
+#define PDC_TCS1_CONTROL 0x55c8u
+#define PDC_TCS1_ENABLE_BANK 0x55ccu
+#define PDC_TCS1_WAIT_BANK 0x55d0u
+#define PDC_TCS1_CMD0 0x55d4u
+#define PDC_TCS3_CONTROL 0x5758u
+#define PDC_TCS3_ENABLE_BANK 0x575cu
+#define PDC_TCS3_WAIT_BANK 0x5760u
+#define PDC_TCS3_CMD0 0x5764u
+#define PDC_MSGID 0x10108u
+#define PDC_ADDR_GFX 0x30090u            /* a618's level resource */
+
+/* HFI: the table, two queue headers, then a 4 KiB queue each (a6xx_hfi.c, legacy). Offsets from the pool. */
+#define HFI_CMD_HEADER (GMU_POOL_HFI + 24u)
+#define HFI_RSP_HEADER (HFI_CMD_HEADER + 48u)
+#define HFI_CMD_DATA (GMU_POOL_HFI + 0x1000u)
+#define HFI_RSP_DATA (GMU_POOL_HFI + 0x2000u)
+#define HFI_QUEUE_WORDS 1024u
+#define HFI_READ_INDEX 40u
+#define HFI_WRITE_INDEX 44u
+#define HFI_RESPONSE_WORDS 19u
+#define HFI_MSG_INIT 0u
+#define HFI_MSG_FW_VERSION 1u
+#define HFI_MSG_BW_TABLE 3u
+#define HFI_MSG_PERF_TABLE 4u
+#define HFI_MSG_TEST 5u
+#define HFI_MSG_ERROR 100u
+#define HFI_BW_DWORDS 160u
+#define HFI_PERF_DWORDS 43u
+
+/* CMD DB, the always-on processor's table of RPMh resources (sc7180.dtsi aop_cmd_db_mem; layout from Linux cmd-db.c). */
+#define CMD_DB_MAGIC 0x0c0330dbu
+#define CMD_DB_DATA 0x90u
+#define CMD_DB_RSCS 8u
+#define CMD_DB_ENTRY 24u
+/* Resource names as two little-endian words. */
+#define CMD_DB_GFX_LVL 0x2e786667u, 0x006c766cu
+#define CMD_DB_MX_LVL 0x6c2e786du, 0x00006c76u
+#define CMD_DB_CX_LVL 0x6c2e7863u, 0x00006c76u
+#define GMU_LEVELS_GX 8u
+#define GMU_LEVELS_CX 2u
+/* This board's OPP tables as Debian reads them (opp-825000000 needs a higher speed bin), with the "off" level Linux adds first. */
+static const struct { uint32_t khz, level; } gmu_gx_levels[GMU_LEVELS_GX] = {{0, 0}, {180000, 48}, {267000, 64}, {355000, 128}, {430000, 192},
+    {565000, 256}, {650000, 320}, {800000, 384}};
+static const struct { uint32_t khz, level; } gmu_cx_levels[GMU_LEVELS_CX] = {{0, 0}, {200000, 48}};
+
+static inline uint64_t gmu_bank(const struct coachz_gpu_report *r) {
+	return (uint64_t)r->smmu_bank_base + GMU_BANK * (uint64_t)r->smmu_page;
+}
+
+static inline void gmu_note(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, unsigned step) {
+	r->gmu_step = step;
+	if (io->note) io->note(io->cookie, r);
+}
+
+/* An unsynchronized global invalidate of what the bank may hold, then the wait: 1 on done. */
+static inline int gmu_tlb_sync(const struct coachz_gpu_io *io) {
+	gpu_w(io, GPU_SMMU, SMMU_TLBIALLNSNH, 0);
+	gpu_w(io, GPU_SMMU, SMMU_TLBGSYNC, 0);
+	return gpu_poll(io, GPU_SMMU, SMMU_TLBGSTATUS, 1u, 0) != 0;
+}
+
+static inline void gmu_table_entry(const struct coachz_gpu_io *io, uint32_t table, uint32_t index, uint64_t value) {
+	io->pool[(table + index * 8u) / 8u] = value;
+}
+
+/* One translation: 1 with the result in *par, 0 if the operation never finished. */
+static inline int gmu_translate(const struct coachz_gpu_io *io, uint32_t bank, uint32_t va, uint64_t *par) {
+	gpu_w64(io, GPU_SMMU, bank + SMMU_CB_ATS1PR, va);
+	if (!gpu_poll(io, GPU_SMMU, bank + SMMU_CB_ATSR, 1u, 0)) return 0;
+	*par = gpu_r64(io, GPU_SMMU, bank + SMMU_CB_PAR);
+	return 1;
+}
+
+static inline void gmu_check_translation(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, uint32_t bank, uint32_t va,
+    int mapped, uint64_t want) {
+	uint64_t par = 0;
+	const int done = gmu_translate(io, bank, va, &par);
+	const int right = done && (mapped ? !(par & SMMU_PAR_FAULT) && (par & SMMU_PAR_PA) == want : (par & SMMU_PAR_FAULT));
+	r->ats_total++;
+	if (right) {
+		r->ats_right++;
+	} else if (r->ats_right + 1 == r->ats_total) {
+		r->ats_wrong_va = va;
+		r->ats_wrong_par = par;
+	}
+}
+
+/* Mode 5. The inventory has been read. 1 only if the bank is live and every translation came out right. */
+static inline int gmu_map(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	if (r->error) return 0;
+	if (!io->pool || !(r->smmu[0] & SMMU_SCR0_CLIENTPD) || r->smmu_groups <= GMU_GROUP || r->smmu_banks <= GMU_BANK ||
+	    (r->cb[GMU_BANK][0] & 1u)) {
+		r->error = "GPU SMMU is not free: nothing written";
+		return 0;
+	}
+	for (uint32_t i = 0; i < r->smmu_groups; i++) {
+		if (r->smr[i] & SMMU_SMR_VALID) {
+			r->error = "GPU SMMU has a valid stream match: nothing written";
+			return 0;
+		}
+	}
+	gmu_note(io, r, 1);
+	for (uint32_t i = 0; i < GMU_POOL_BYTES / 8u; i++) io->pool[i] = 0;
+	gmu_table_entry(io, GMU_POOL_L1, GMU_IOVA_DUMMY >> 30, (GMU_POOL_PA + GMU_POOL_L2) | LPAE_TABLE);
+	gmu_table_entry(io, GMU_POOL_L2, (GMU_IOVA_DUMMY >> 21) & 511u, (GMU_POOL_PA + GMU_POOL_L3) | LPAE_TABLE);
+	for (unsigned i = 0; i < GMU_REGIONS; i++) {
+		for (uint32_t at = 0; at < gmu_regions[i].bytes; at += 0x1000u) {
+			gmu_table_entry(io, GMU_POOL_L3, ((gmu_regions[i].iova + at) >> 12) & 511u,
+			    (GMU_POOL_PA + gmu_regions[i].pool + at) | LPAE_PAGE);
+		}
+	}
+	const uint32_t bank = (uint32_t)gmu_bank(r), cbar = r->smmu_page + 4u * GMU_BANK, cba2r = r->smmu_page + SMMU_CBA2R + 4u * GMU_BANK;
+	r->own_smmu = 1;
+	gpu_w(io, GPU_SMMU, SMMU_SGFSR, gpu_r(io, GPU_SMMU, SMMU_SGFSR));
+	gpu_w(io, GPU_SMMU, cba2r, SMMU_CBA2R_VA64);
+	gpu_w(io, GPU_SMMU, cbar, SMMU_CBAR_S1);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR2, SMMU_TCR2_36BIT);
+	gpu_w64(io, GPU_SMMU, bank + SMMU_CB_TTBR0, (GMU_POOL_PA + GMU_POOL_L1) | ((uint64_t)GMU_BANK << 48));
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR, SMMU_TCR_32BIT);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR0, SMMU_MAIR0_VALUE);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR1, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_FSR, ~0u);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	gpu_w(io, GPU_SMMU, SMMU_S2CR + 4u * GMU_GROUP, GMU_BANK);
+	gpu_w(io, GPU_SMMU, SMMU_SMR + 4u * GMU_GROUP, SMMU_SMR_VALID | GMU_STREAM);
+	if (!gmu_tlb_sync(io)) {
+		r->error = "GPU SMMU TLB sync did not finish";
+		return 0;
+	}
+	gpu_w(io, GPU_SMMU, SMMU_SCR0, (r->smmu[0] & ~SMMU_SCR0_CLEAR_BITS) | SMMU_SCR0_ENABLE_BITS);
+	r->scr0_on = gpu_r(io, GPU_SMMU, SMMU_SCR0);
+	for (unsigned i = 0; i < GMU_REGIONS; i++) {
+		const uint32_t iova = gmu_regions[i].iova, last = gmu_regions[i].bytes - 0x1000u;
+		gmu_check_translation(io, r, bank, iova, 1, GMU_POOL_PA + gmu_regions[i].pool);
+		gmu_check_translation(io, r, bank, iova + last, 1, GMU_POOL_PA + gmu_regions[i].pool + last);
+	}
+	for (unsigned i = 0; i < GMU_ATS_MISSES; i++) {
+		gmu_check_translation(io, r, bank, gmu_misses[i], 0, 0);
+	}
+	r->smmu_fsr = gpu_r(io, GPU_SMMU, bank + SMMU_CB_FSR);
+	r->smmu_gfsr = gpu_r(io, GPU_SMMU, SMMU_SGFSR);
+	if (r->ats_right != GMU_ATS_CHECKS) {
+		r->error = "GPU SMMU translation differs from the tables";
+		return 0;
+	}
+	return 1;
+}
+
+/* The bank and the stream as they were, and the SMMU back to bypass. */
+static inline void gmu_unmap(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	const uint32_t bank = (uint32_t)gmu_bank(r);
+	gpu_w(io, GPU_SMMU, SMMU_SCR0, r->smmu[0]);
+	gpu_w(io, GPU_SMMU, SMMU_SMR + 4u * GMU_GROUP, r->smr[GMU_GROUP]);
+	gpu_w(io, GPU_SMMU, SMMU_S2CR + 4u * GMU_GROUP, r->s2cr[GMU_GROUP]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_SCTLR, r->cb[GMU_BANK][0]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR, r->cb[GMU_BANK][1]);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_TCR2, 0);
+	gpu_w64(io, GPU_SMMU, bank + SMMU_CB_TTBR0, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_MAIR0, 0);
+	gpu_w(io, GPU_SMMU, bank + SMMU_CB_FSR, ~0u);
+	gpu_w(io, GPU_SMMU, r->smmu_page + 4u * GMU_BANK, r->cbar[GMU_BANK]);
+	gpu_w(io, GPU_SMMU, r->smmu_page + SMMU_CBA2R + 4u * GMU_BANK, r->cba2r[GMU_BANK]);
+	r->unmap_clean = gmu_tlb_sync(io);
+	r->scr0_after = gpu_r(io, GPU_SMMU, SMMU_SCR0);
+}
+
+static inline void gmu_pdc_cmd(const struct coachz_gpu_io *io, uint32_t first, unsigned index, uint32_t addr, uint32_t data) {
+	gpu_w(io, GPU_PDC, first + index * 0x10u, PDC_MSGID);
+	gpu_w(io, GPU_PDC, first + index * 0x10u + 4u, addr);
+	gpu_w(io, GPU_PDC, first + index * 0x10u + 8u, data);
+}
+
+/* The RSC asked to power off, as Linux does after programming it: the polls taken, 0 if it never reported. */
+static inline uint32_t gmu_rsc_stop(const struct coachz_gpu_io *io) {
+	gpu_w(io, GPU_GMU, GMU_RSCC_CONTROL_REQ, 1u);
+	const uint32_t polls = gpu_poll(io, GPU_GMU, RSCC_RSC_STATUS0_DRV0, RSC_STATUS0_POWERED_OFF, RSC_STATUS0_POWERED_OFF);
+	gpu_w(io, GPU_GMU, GMU_RSCC_CONTROL_REQ, 0);
+	return polls;
+}
+
+/* a618's RSC and PDC: the sleep and wake sequences and the TCS commands they use. */
+static inline void gmu_rsc_program(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	static const uint32_t rsc_seq[5] = {0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u};
+	static const uint32_t pdc_seq[5] = {0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu};
+	gpu_w(io, GPU_GMU, RSCC_RSC_STATUS0_DRV0, RSC_STATUS0_SDE_GATE_OFF);
+	gpu_w(io, GPU_GMU, RSCC_PDC_SLAVE_ID_DRV0, 1u);
+	for (unsigned i = 0; i < 3; i++) {
+		gpu_w(io, GPU_GMU, RSCC_HIDDEN_TCS_CMD0_DATA + i * 8u, i == 2 ? 0x80000000u : 0);
+		gpu_w(io, GPU_GMU, RSCC_HIDDEN_TCS_CMD0_ADDR + i * 8u, 0);
+	}
+	gpu_w(io, GPU_GMU, RSCC_OVERRIDE_START_ADDR, 0);
+	gpu_w(io, GPU_GMU, RSCC_PDC_SEQ_START_ADDR, 0x4520u);
+	gpu_w(io, GPU_GMU, RSCC_PDC_MATCH_VALUE_LO, 0x4510u);
+	gpu_w(io, GPU_GMU, RSCC_PDC_MATCH_VALUE_HI, 0x4514u);
+	for (unsigned i = 0; i < 5; i++) gpu_w(io, GPU_GMU, RSCC_SEQ_MEM_0_DRV0 + i * 4u, rsc_seq[i]);
+	for (unsigned i = 0; i < 5; i++) gpu_w(io, GPU_PDC_SEQ, i * 4u, pdc_seq[i]);
+	gpu_w(io, GPU_PDC, PDC_TCS1_ENABLE_BANK, 7u);
+	gpu_w(io, GPU_PDC, PDC_TCS1_WAIT_BANK, 0);
+	gpu_w(io, GPU_PDC, PDC_TCS1_CONTROL, 0);
+	gmu_pdc_cmd(io, PDC_TCS1_CMD0, 0, 0x30010u, 1u);
+	gmu_pdc_cmd(io, PDC_TCS1_CMD0, 1, 0x30000u, 0);
+	gmu_pdc_cmd(io, PDC_TCS1_CMD0, 2, PDC_ADDR_GFX, 0);
+	gpu_w(io, GPU_PDC, PDC_TCS3_ENABLE_BANK, 7u);
+	gpu_w(io, GPU_PDC, PDC_TCS3_WAIT_BANK, 0);
+	gpu_w(io, GPU_PDC, PDC_TCS3_CONTROL, 0);
+	gmu_pdc_cmd(io, PDC_TCS3_CMD0, 0, 0x30010u, 2u);
+	gmu_pdc_cmd(io, PDC_TCS3_CMD0, 1, 0x30000u, 2u);
+	gmu_pdc_cmd(io, PDC_TCS3_CMD0, 2, PDC_ADDR_GFX, 3u);
+	gpu_w(io, GPU_PDC, PDC_SEQ_START_ADDR, 0);
+	gpu_w(io, GPU_PDC, PDC_ENABLE, 0x80000001u);
+	r->rsc_stop_polls = gmu_rsc_stop(io);
+}
+
+/* The RSC woken for the GMU: 1 on done. */
+static inline int gmu_rsc_start(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	gpu_w(io, GPU_GMU, GMU_RSCC_CONTROL_REQ, 2u);
+	r->rsc_start_polls = gpu_poll(io, GPU_GMU, GMU_RSCC_CONTROL_ACK, 2u, 2u);
+	if (!r->rsc_start_polls) {
+		r->error = "GPU RSC did not acknowledge the wake request";
+		gpu_w(io, GPU_GMU, GMU_RSCC_CONTROL_REQ, 0);
+		return 0;
+	}
+	const uint32_t idle = gpu_poll(io, GPU_GMU, RSCC_SEQ_BUSY_DRV0, ~0u, 0);
+	gpu_w(io, GPU_GMU, GMU_RSCC_CONTROL_REQ, 0);
+	if (!idle) r->error = "GPU RSC sequence stayed busy";
+	return idle != 0;
+}
+
+static inline uint32_t gmu_poll_long(const struct coachz_gpu_io *io, uint32_t offset, uint32_t mask, uint32_t want) {
+	for (uint32_t i = 1; i <= GMU_INIT_POLLS; i++) {
+		if ((gpu_r(io, GPU_GMU, offset) & mask) == want) return i;
+		io->delay_us(io->cookie, 100);
+	}
+	return 0;
+}
+
+static inline uint32_t gmu_mem_r(const struct coachz_gpu_io *io, uint32_t at) {
+	return ((volatile uint32_t *)io->pool)[at / 4u];
+}
+static inline void gmu_mem_w(const struct coachz_gpu_io *io, uint32_t at, uint32_t value) {
+	((volatile uint32_t *)io->pool)[at / 4u] = value;
+}
+
+static inline uint32_t gmu_db_u16(const struct coachz_gpu_io *io, uint32_t at) {
+	return (gpu_r(io, GPU_CMD_DB, at & ~3u) >> ((at & 2u) * 8u)) & 0xffffu;
+}
+
+/* A resource's table of 16-bit levels: its offset and count, or 0 when it is absent or out of bounds. */
+static inline uint32_t gmu_db_find(const struct coachz_gpu_io *io, uint32_t name0, uint32_t name1, uint32_t *count) {
+	for (uint32_t i = 0; i < CMD_DB_RSCS; i++) {
+		const uint32_t rsc = 8u + 16u * i;
+		if (!gmu_db_u16(io, rsc)) break;
+		const uint32_t headers = CMD_DB_DATA + gmu_db_u16(io, rsc + 2u), data = CMD_DB_DATA + gmu_db_u16(io, rsc + 4u);
+		const uint32_t entries = gmu_db_u16(io, rsc + 6u);
+		for (uint32_t j = 0; j < entries; j++) {
+			const uint32_t entry = headers + j * CMD_DB_ENTRY;
+			if (entry + CMD_DB_ENTRY > GPU_CMD_DB_SIZE) return 0;
+			if (gpu_r(io, GPU_CMD_DB, entry) != name0 || gpu_r(io, GPU_CMD_DB, entry + 4u) != name1) continue;
+			const uint32_t bytes = gmu_db_u16(io, entry + 20u), at = data + gmu_db_u16(io, entry + 22u);
+			if (!bytes || (at & 1u) || at + bytes > GPU_CMD_DB_SIZE) return 0;
+			*count = bytes / 2u;
+			return at;
+		}
+	}
+	return 0;
+}
+
+/* One level's vote: the level's value, the secondary rail's index and the primary rail's index (a6xx_gmu_rpmh_arc_votes_init). */
+static inline int gmu_arc_vote(const struct coachz_gpu_io *io, uint32_t pri, uint32_t pri_count, uint32_t sec, uint32_t sec_count,
+    uint32_t level, uint32_t *vote) {
+	uint32_t pindex = pri_count, sindex = 0;
+	for (uint32_t j = 0; j < pri_count; j++) {
+		if (gmu_db_u16(io, pri + 2u * j) >= level) {
+			pindex = j;
+			break;
+		}
+	}
+	if (pindex == pri_count) return 0;
+	for (uint32_t j = 0; j < sec_count; j++) {
+		const uint32_t value = gmu_db_u16(io, sec + 2u * j);
+		if (value >= level) {
+			sindex = j;
+			break;
+		}
+		if (value) sindex = j;
+	}
+	*vote = gmu_db_u16(io, pri + 2u * pindex) << 16 | sindex << 8 | pindex;
+	return 1;
+}
+
+/* The rail votes for every level; 1 on done. */
+static inline int gmu_build_votes(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, uint32_t *gx, uint32_t *cx) {
+	uint32_t gfx_count = 0, mx_count = 0, cx_count = 0;
+	if (gpu_r(io, GPU_CMD_DB, 4u) != CMD_DB_MAGIC) {
+		r->error = "CMD DB magic differs";
+		return 0;
+	}
+	const uint32_t gfx_at = gmu_db_find(io, CMD_DB_GFX_LVL, &gfx_count), mx_at = gmu_db_find(io, CMD_DB_MX_LVL, &mx_count);
+	const uint32_t cx_at = gmu_db_find(io, CMD_DB_CX_LVL, &cx_count);
+	r->db_counts[0] = gfx_count;
+	r->db_counts[1] = mx_count;
+	r->db_counts[2] = cx_count;
+	if (!gfx_at || !mx_at || !cx_at) {
+		r->error = "CMD DB lacks a rail level table";
+		return 0;
+	}
+	for (unsigned i = 0; i < GMU_LEVELS_GX; i++) {
+		if (!gmu_arc_vote(io, gfx_at, gfx_count, mx_at, mx_count, gmu_gx_levels[i].level, &gx[i])) {
+			r->error = "a GX level is not in CMD DB";
+			return 0;
+		}
+	}
+	for (unsigned i = 0; i < GMU_LEVELS_CX; i++) {
+		if (!gmu_arc_vote(io, cx_at, cx_count, mx_at, mx_count, gmu_cx_levels[i].level, &cx[i])) {
+			r->error = "a CX level is not in CMD DB";
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static inline void gmu_hfi_queue(const struct coachz_gpu_io *io, uint32_t header, uint32_t iova, uint32_t id) {
+	gmu_mem_w(io, header, 1u);                  /* status */
+	gmu_mem_w(io, header + 4u, iova);
+	gmu_mem_w(io, header + 8u, 10u << 8 | id);  /* type */
+	gmu_mem_w(io, header + 12u, HFI_QUEUE_WORDS);
+	gmu_mem_w(io, header + 24u, 1u);            /* rx watermark */
+	gmu_mem_w(io, header + 28u, 1u);            /* tx watermark */
+	gmu_mem_w(io, header + 32u, 1u);            /* rx request */
+}
+
+/* The queue table the firmware finds at HFI_QTBL_ADDR; the pool is already zero. */
+static inline void gmu_hfi_table(const struct coachz_gpu_io *io) {
+	gmu_mem_w(io, GMU_POOL_HFI + 4u, 24u + 2u * 48u);   /* size, as Linux writes it */
+	gmu_mem_w(io, GMU_POOL_HFI + 8u, 24u >> 2);         /* first queue header */
+	gmu_mem_w(io, GMU_POOL_HFI + 12u, 48u >> 2);        /* queue header size */
+	gmu_mem_w(io, GMU_POOL_HFI + 16u, 2u);              /* queues */
+	gmu_mem_w(io, GMU_POOL_HFI + 20u, 2u);              /* active queues */
+	gmu_hfi_queue(io, HFI_CMD_HEADER, GMU_IOVA_HFI + 0x1000u, 0);
+	gmu_hfi_queue(io, HFI_RSP_HEADER, GMU_IOVA_HFI + 0x2000u, 4u);
+}
+
+/* One command and its acknowledgement; msg[0] is filled in. 1 on done. */
+static inline int gmu_hfi_send(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, uint32_t id, uint32_t *msg, uint32_t dwords) {
+	const uint32_t seq = ++r->hfi_seq;
+	r->hfi_id = id;
+	msg[0] = seq << 20 | dwords << 8 | id;
+	uint32_t at = gmu_mem_r(io, HFI_CMD_HEADER + HFI_WRITE_INDEX);
+	for (uint32_t i = 0; i < dwords; i++) {
+		gmu_mem_w(io, HFI_CMD_DATA + at * 4u, msg[i]);
+		at = (at + 1u) % HFI_QUEUE_WORDS;
+	}
+	gmu_mem_w(io, HFI_CMD_HEADER + HFI_WRITE_INDEX, at);
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u);
+	if (!gmu_poll_long(io, GMU_GMU2HOST_INTR_INFO, GMU_INTR_MSGQ, GMU_INTR_MSGQ)) {
+		r->error = "an HFI message got no response";
+		return 0;
+	}
+	gpu_w(io, GPU_GMU, GMU_GMU2HOST_INTR_CLR, GMU_INTR_MSGQ);
+	for (unsigned tries = 0; tries < 8u; tries++) {
+		uint32_t read = gmu_mem_r(io, HFI_RSP_HEADER + HFI_READ_INDEX), response[HFI_RESPONSE_WORDS] = {0};
+		if (read == gmu_mem_r(io, HFI_RSP_HEADER + HFI_WRITE_INDEX) || read >= HFI_QUEUE_WORDS) break;
+		const uint32_t size = (gmu_mem_r(io, HFI_RSP_DATA + read * 4u) >> 8) & 0xffu;
+		if (!size || size > HFI_RESPONSE_WORDS) {
+			r->error = "an HFI response has an impossible size";
+			return 0;
+		}
+		for (uint32_t i = 0; i < size; i++) {
+			response[i] = gmu_mem_r(io, HFI_RSP_DATA + read * 4u);
+			read = (read + 1u) % HFI_QUEUE_WORDS;
+		}
+		gmu_mem_w(io, HFI_RSP_HEADER + HFI_READ_INDEX, read);
+		if ((response[0] & 0xffu) == HFI_MSG_ERROR) {
+			r->hfi_fw_error = response[1];
+			continue;
+		}
+		if (((response[1] >> 20) & 0xfffu) != seq) continue;
+		r->hfi_status = response[2];
+		if (response[2]) {
+			r->error = "the firmware refused an HFI message";
+			return 0;
+		}
+		r->hfi_payload = response[3];
+		r->hfi_done++;
+		return 1;
+	}
+	r->error = "the HFI response queue held no answer";
+	return 0;
+}
+
+/* a6xx_hfi_start_v1's messages. a618's GMU does no bus scaling: one "off" DDR level and the fixed CNOC votes. */
+static inline int gmu_hfi_messages(const struct coachz_gpu_io *io, struct coachz_gpu_report *r, const uint32_t *gx, const uint32_t *cx) {
+	uint32_t init[5] = {0, 0, GMU_IOVA_DEBUG, GMU_DEBUG_BYTES, GMU_BOOT_COLD};
+	if (!gmu_hfi_send(io, r, HFI_MSG_INIT, init, 5u)) return 0;
+	uint32_t version[2] = {0, 1u << 28 | 1u << 19 | 1u << 17};
+	if (!gmu_hfi_send(io, r, HFI_MSG_FW_VERSION, version, 2u)) return 0;
+	r->hfi_version = r->hfi_payload;
+	uint32_t perf[HFI_PERF_DWORDS] = {0, GMU_LEVELS_GX, GMU_LEVELS_CX};
+	for (unsigned i = 0; i < GMU_LEVELS_GX; i++) {
+		perf[3u + 2u * i] = gx[i];
+		perf[4u + 2u * i] = gmu_gx_levels[i].khz;
+	}
+	for (unsigned i = 0; i < GMU_LEVELS_CX; i++) {
+		perf[35u + 2u * i] = cx[i];
+		perf[36u + 2u * i] = gmu_cx_levels[i].khz;
+	}
+	if (!gmu_hfi_send(io, r, HFI_MSG_PERF_TABLE, perf, HFI_PERF_DWORDS)) return 0;
+	/* header, level count, CNOC and DDR command counts and wait masks, then the CNOC addresses [6] and data [2][6], the DDR addresses [8] and data [16][8]. */
+	uint32_t bw[HFI_BW_DWORDS] = {0, 1u, 1u, 3u, 1u, 1u};
+	bw[6] = 0x5007cu;
+	bw[12] = 0x40000000u;
+	bw[18] = 0x60000001u;
+	bw[24] = 0x50000u;
+	bw[25] = 0x5003cu;
+	bw[26] = 0x5000cu;
+	bw[32] = bw[33] = bw[34] = 0x40000000u;
+	if (!gmu_hfi_send(io, r, HFI_MSG_BW_TABLE, bw, HFI_BW_DWORDS)) return 0;
+	uint32_t test[1] = {0};
+	return gmu_hfi_send(io, r, HFI_MSG_TEST, test, 1u);
+}
+
+/* Mode 7, the firmware's init result in hand: GX, SPTPRAC, HFI and GPU_SET, in a6xx_gmu_resume's order. */
+static inline void gmu_bring_up_gx(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	uint32_t gx[GMU_LEVELS_GX], cx[GMU_LEVELS_CX];
+	if (!gmu_build_votes(io, r, gx, cx)) return;
+	r->gx_vote_top = gx[GMU_LEVELS_GX - 1u];
+	gmu_note(io, r, 5);
+	/* Linux's "default" level: the highest this board has. */
+	gpu_w(io, GPU_GMU, GMU_BOOT_SLUMBER_OPTION, 0);
+	gpu_w(io, GPU_GMU, GMU_GX_VOTE_IDX, r->gx_vote_top & 0xffu);
+	gpu_w(io, GPU_GMU, GMU_MX_VOTE_IDX, (r->gx_vote_top >> 8) & 0xffu);
+	r->own_gx = 1;
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_BOOT_SET);
+	r->oob_boot_polls = gmu_poll_long(io, GMU_GMU2HOST_INTR_INFO, 1u << GMU_OOB_BOOT_ACK, 1u << GMU_OOB_BOOT_ACK);
+	r->gx_state[0] = gpu_r(io, GPU_GMU, GMU_GMU2HOST_INTR_INFO);
+	gpu_w(io, GPU_GMU, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_BOOT_ACK);
+	r->gx_state[1] = gpu_r(io, GPU_CC, GPUCC_GX_GDSCR);
+	r->gx_state[2] = gpu_r(io, GPU_GMU, GMU_RPMH_POWER_STATE);
+	if (!r->oob_boot_polls) {
+		r->error = "the firmware did not acknowledge the boot OOB";
+		return;
+	}
+	gpu_w(io, GPU_GMU, GMU_GX_SPTPRAC_POWER_CONTROL, 0x778000u);
+	r->sptprac_polls = gpu_poll(io, GPU_GMU, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38u, 0x28u);
+	r->gx_state[3] = gpu_r(io, GPU_GMU, GMU_SPTPRAC_PWR_CLK_STATUS);
+	gpu_w(io, GPU_GMU, GMU_HFI_CTRL_INIT, 1u);
+	r->hfi_start_polls = gmu_poll_long(io, GMU_HFI_CTRL_STATUS, 1u, 1u);
+	if (!r->hfi_start_polls) {
+		r->error = "the HFI queues did not start";
+		return;
+	}
+	gmu_note(io, r, 6);
+	if (!gmu_hfi_messages(io, r, gx, cx)) return;
+	gmu_note(io, r, 7);
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_GPU_SET);
+	r->oob_gpu_polls = gmu_poll_long(io, GMU_GMU2HOST_INTR_INFO, 1u << GMU_OOB_GPU_ACK, 1u << GMU_OOB_GPU_ACK);
+	r->gx_state[4] = gpu_r(io, GPU_GMU, GMU_GMU2HOST_INTR_INFO);
+	gpu_w(io, GPU_GMU, GMU_GMU2HOST_INTR_CLR, 1u << GMU_OOB_GPU_ACK);
+	r->gx_state[5] = gpu_r(io, GPU_CC, GPUCC_GX_GDSCR);
+	r->gx_state[6] = gpu_r(io, GPU_GMU, GMU_SPTPRAC_PWR_CLK_STATUS);
+	r->gx_state[7] = gpu_r(io, GPU_GMU, GMU_RPMH_POWER_STATE);
+	if (!r->oob_gpu_polls) {
+		r->error = "the firmware did not acknowledge GPU_SET";
+		return;
+	}
+	gpu_w(io, GPU_GMU, GMU_HOST2GMU_INTR_SET, 1u << GMU_OOB_GPU_ACK);   /* the OOB cleared again: nothing uses the GPU */
+}
+
+/* Linux's a6xx_gmu_force_off without the GPU core's own registers, which nothing has touched. */
+static inline void gmu_gx_shutdown(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	static const uint32_t tcs[4] = {RSCC(0x346u), RSCC(0x3eeu), RSCC(0x496u), RSCC(0x53eu)};
+	gpu_w(io, GPU_GMU, GMU_PWR_COL_KEEPALIVE, 0);
+	gpu_w(io, GPU_CC, GPUCC_GX_GDSCR, gpu_r(io, GPU_CC, GPUCC_GX_GDSCR) | (1u << 11));   /* retention, then SPTP off */
+	gpu_w(io, GPU_GMU, GMU_GX_SPTPRAC_POWER_CONTROL, 0x778001u);
+	r->sptprac_off_polls = gmu_poll_long(io, GMU_SPTPRAC_PWR_CLK_STATUS, 4u, 4u);
+	for (unsigned i = 0; i < 4u; i++) {
+		if (gmu_poll_long(io, tcs[i], 1u, 1u)) r->tcs_idle++;
+	}
+	gpu_w(io, GPU_GMU, GMU_AHB_FENCE_STATUS_CLR, 7u);
+	gpu_w(io, GPU_GMU, GMU_AO_AHB_FENCE_CTRL, 0);
+}
+
+/* Mode 6, the bank live: everything up to the firmware's init result, then CM3 back in reset. */
+static inline void gmu_start(const struct coachz_gpu_io *io, const uint32_t *image, uint32_t image_bytes, struct coachz_gpu_report *r) {
+	if (!(r->gmu[0] & 1u)) {
+		r->error = "CM3 not held in reset: nothing started";
+		return;
+	}
+	gmu_note(io, r, 2);
+	r->votes_before = gpu_r(io, GPU_GMU, GMU_RPMH_CTRL);
+	r->general7_before = gpu_r(io, GPU_GMU, GMU_GENERAL_7);
+	r->own_rsc = 1;
+	gmu_rsc_program(io, r);
+	gmu_note(io, r, 3);
+	gpu_w(io, GPU_GMU, GMU_GENERAL_7, 1u);
+	if (!gmu_rsc_start(io, r)) return;
+	gpu_load_tcm(io, image, image_bytes, r);
+	if (r->error) return;
+	gpu_w(io, GPU_GMU, GMU_CM3_FW_INIT_RESULT, 0);
+	gpu_w(io, GPU_GMU, GMU_CM3_BOOT_CONFIG, 2u);
+	gpu_w(io, GPU_GMU, GMU_HFI_QTBL_ADDR, GMU_IOVA_HFI);
+	gpu_w(io, GPU_GMU, GMU_HFI_QTBL_INFO, 1u);
+	gpu_w(io, GPU_GMU, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE);
+	gpu_w(io, GPU_GMU, GMU_CM3_CFG, 0x4052u);
+	gpu_w(io, GPU_GMU, GMU_HFI_SFR_ADDR, GMU_CHIP_ID);
+	gpu_w(io, GPU_GMU, GMU_PWR_COL_CP_MSG, GMU_IOVA_LOG | 3u);   /* four 4 KiB pages */
+	gpu_w(io, GPU_GMU, GMU_SYS_BUS_CONFIG, 1u);
+	gpu_w(io, GPU_GMU, GMU_ICACHE_CONFIG, 1u);
+	gpu_w(io, GPU_GMU, GMU_DCACHE_CONFIG, 1u);
+	gpu_w(io, GPU_GMU, GMU_PWR_COL_INTER_FRAME_CTRL, 0x09c40400u);
+	gpu_w(io, GPU_GMU, GMU_RPMH_CTRL, r->votes_before | GMU_RPMH_CTRL_VOTES);
+	r->fw_version = gpu_r(io, GPU_GMU, GMU_FW_VERSION_AT);
+	const uint32_t mask = r->fw_version <= 0x20010004u ? ~0u : 0x1ffu, want = r->fw_version <= 0x20010004u ? 0xbabefaceu : 0x100u;
+	if (r->mode >= 7) gmu_hfi_table(io);
+	gmu_note(io, r, 4);
+	gpu_w(io, GPU_GMU, GMU_CM3_SYSRESET, 1u);
+	gpu_w(io, GPU_GMU, GMU_PWR_COL_CP_RESP, 0);
+	r->own_cm3 = 1;
+	gpu_w(io, GPU_GMU, GMU_CM3_SYSRESET, 0);
+	for (uint32_t i = 1; i <= GMU_INIT_POLLS; i++) {
+		r->fw_init = gpu_r(io, GPU_GMU, GMU_CM3_FW_INIT_RESULT);
+		if ((r->fw_init & mask) == want) {
+			r->fw_init_polls = i;
+			break;
+		}
+		io->delay_us(io->cookie, 100);
+	}
+	if (!r->fw_init_polls) r->error = "GMU firmware init result never came";
+	if (r->mode >= 7 && r->fw_init_polls) gmu_bring_up_gx(io, r);
+	/* What the firmware did to the rest of the machine in that time. */
+	const uint32_t bank = (uint32_t)gmu_bank(r);
+	r->after_start[0] = gpu_r(io, GPU_GMU, GMU_CM3_FW_BUSY);
+	r->after_start[1] = gpu_r(io, GPU_GMU, GMU_RPMH_POWER_STATE);
+	r->after_start[2] = gpu_r(io, GPU_GMU, GMU_AO_HOST_INTERRUPT_STATUS);
+	r->after_start[3] = gpu_r(io, GPU_GMU, GMU_GMU2HOST_INTR_INFO);
+	r->smmu_gfsr = gpu_r(io, GPU_SMMU, SMMU_SGFSR);
+	r->smmu_fsr = gpu_r(io, GPU_SMMU, bank + SMMU_CB_FSR);
+	r->smmu_fsynr0 = gpu_r(io, GPU_SMMU, bank + SMMU_CB_FSYNR0);
+	r->smmu_far = gpu_r64(io, GPU_SMMU, bank + SMMU_CB_FAR);
+	r->fw_log = io->pool[GMU_POOL_LOG / 8u];
+	r->fw_hfi = io->pool[GMU_POOL_HFI / 8u];
+	r->fw_dummy = io->pool[GMU_POOL_DUMMY / 8u];
+}
+
+/* Undoes what modes 5 to 7 did, inside the window: CM3 first, because it is the one using everything else. */
+static inline void gmu_undo(const struct coachz_gpu_io *io, struct coachz_gpu_report *r) {
+	if (r->own_gx) {
+		gmu_note(io, r, 8);
+		gmu_gx_shutdown(io, r);
+	}
+	if (r->own_cm3) {
+		gpu_w(io, GPU_GMU, GMU_CM3_SYSRESET, 1u);
+		r->sysreset_stopped = gpu_r(io, GPU_GMU, GMU_CM3_SYSRESET);
+	}
+	if (r->own_rsc) {
+		r->rsc_stop_polls_end = gmu_rsc_stop(io);
+		gpu_w(io, GPU_GMU, GMU_RPMH_CTRL, r->votes_before);
+		gpu_w(io, GPU_GMU, GMU_GENERAL_7, r->general7_before);
+	}
+	if (r->own_gx) {
+		/* The GX domain off before CX, as Linux drops its GX reference; the retention bit back as it was. */
+		r->gx_end = gpu_r(io, GPU_CC, GPUCC_GX_GDSCR);
+		gpu_w(io, GPU_CC, GPUCC_GX_GDSCR, r->gx_end | GDSC_SW_COLLAPSE);
+		io->delay_us(io->cookie, 500);
+		gpu_w(io, GPU_CC, GPUCC_GX_GDSCR, r->cc_before[2]);
+	}
+	if (r->own_smmu) gmu_unmap(io, r);
+}
