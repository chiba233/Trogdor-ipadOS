+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Adreno 618 core and CP (coachz-gpu=8), inside the GPU_SET OOB of coachz_gpu_gmu.h: the lowest GPU frequency, a stage-1 bank for the
+ * GPU's stream 0, a6xx hw_init's registers for a618, SQE started, ME_INIT, then three commands the host can see the result of: a memory
+ * write from the ring, one from an indirect buffer, and a CACHE_FLUSH_TS fence. Nothing here renders. The SQE firmware (linux-firmware
+ * qcom/a630_sqe.fw) goes in from an ignored path, as the GMU's does. Everything stops again before GX is shut down.
+ * coachz-gpu=9 runs only the frequency and hw_init parts here and leaves everything up: package/CoachzGpu.cpp takes over.
+ *
+ * Values and order follow Linux a6xx_gpu.c, a6xx_catalog.c and a6xx.xml (reference only, rewritten here). The tables were converted by
+ * script from a615_hwcg and a630_protect_regs, the ones a618 uses. No interrupt is wired: the host polls.
+ */
+#ifndef COACHZ_GPU_CORE_H
+#define COACHZ_GPU_CORE_H
+
+#define GPU_CORE_BASE 0x05000000u
+#define GPU_CORE_SIZE 0x00040000u
+#define CORE(reg) ((reg) * 4u)
+
+/* The GPU's part of the pool, and where it sits for the GPU: the global space starts at 16 MiB. */
+#define GPU_POOL 0x10000u
+#define GPU_L1 (GPU_POOL + 0x0000u)
+#define GPU_L2 (GPU_POOL + 0x1000u)
+#define GPU_L3 (GPU_POOL + 0x2000u)
+#define GPU_RING (GPU_POOL + 0x4000u)
+#define GPU_RING_BYTES 0x8000u
+#define GPU_RING_WORDS (GPU_RING_BYTES / 4u)
+#define GPU_MISC (GPU_POOL + 0xc000u)
+#define GPU_IB (GPU_POOL + 0xd000u)
+#define GPU_SQE (GPU_POOL + 0x10000u)
+#define GPU_SQE_MAX 0x10000u
