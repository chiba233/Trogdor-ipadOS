+static inline void coachz_gpu_run(const struct coachz_gpu_io *io, unsigned mode, const uint32_t *image, uint32_t image_bytes,
+    struct coachz_gpu_report *r) {
+	*r = (struct coachz_gpu_report){0};
+	r->mode = mode;
+	if (mode == 3 && (!image || image_bytes < 4 || image_bytes > GMU_TCM_BYTES || image_bytes % 4)) {
+		r->error = "no usable GMU firmware: nothing read or changed";
+		return;
+	}
+	r->gcc_before[3] = gpu_r(io, GPU_GCC, GCC_GPU_CFG_AHB);
+	const int ahb_running = !(r->gcc_before[3] & CBCR_CLK_OFF);
+	/* GPUCC sits behind the GPU AHB branch: with it stopped, any GPUCC access stalls the bus. */
+	gpu_snapshot(io, r->gcc_before, r->cc_before, ahb_running);
+	r->stage = 1;
+	if (mode != 2 && mode != 3 && mode != 4) {
+		if (!ahb_running) r->error = "GPU AHB branch off: GPUCC not read";
+		return;
+	}
+	const uint32_t *g = r->gcc_before, *c = r->cc_before;
+	if (!(g[0] & GPU_PLL_LOCKED) || !(g[1] & 1u)) {
+		r->error = "GPLL0 not locked or not voted: nothing changed";
+		return;
+	}
+	if (!ahb_running) {
+		gpu_w(io, GPU_GCC, GCC_GPU_CFG_AHB, g[3] | CBCR_ENABLE);
+		r->own_ahb = 1;
+		if (!gpu_poll(io, GPU_GCC, GCC_GPU_CFG_AHB, CBCR_CLK_OFF, 0)) {
+			r->error = "GPU AHB branch did not start";
+			gpu_rollback(io, r);
+			return;
+		}
+		gpu_snapshot(io, r->gcc_before, r->cc_before, 1);   /* GPUCC is readable now */
+	}
+	if (c[5] & CBCR_ENABLE) {
+		r->error = "cx-gmu already enabled by another owner: nothing more changed";
+		gpu_rollback(io, r);
+		return;
+	}
+	r->stage = 2;
+	/* CX GDSC */
+	if (!(gpu_r(io, GPU_CC, GPUCC_CX_GDS_HW_CTRL) & GDSC_PWR_ON)) {
+		gpu_w(io, GPU_CC, GPUCC_CX_GDSCR, c[0] & ~GDSC_SW_COLLAPSE);
+		r->own_cx = 1;
+		io->delay_us(io->cookie, 1);
+		r->cx_polls = gpu_poll(io, GPU_CC, GPUCC_CX_GDS_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON);
+		if (!r->cx_polls) {
+			r->error = "CX GDSC did not power on";
+			gpu_rollback(io, r);
+			return;
+		}
+	}
+	r->stage = 3;
+	/* GMU clock: GPLL0/2 into GPUCC, the RCG at 200 MHz, then the cxo and cx-gmu branches. */
+	if (!(gpu_r(io, GPU_GCC, GCC_BRANCH_VOTE) & GPU_GPLL0_DIV_GATE)) {
+		gpu_w(io, GPU_GCC, GCC_BRANCH_VOTE, gpu_r(io, GPU_GCC, GCC_BRANCH_VOTE) | GPU_GPLL0_DIV_GATE);
+		r->own_gate = 1;
+		io->delay_us(io->cookie, 10);
+	}
+	gpu_w(io, GPU_CC, GPUCC_GMU_RCG_CFG, (gpu_r(io, GPU_CC, GPUCC_GMU_RCG_CFG) & ~RCG_SRC_HID_MASK) | RCG_GMU_200MHZ);
+	gpu_w(io, GPU_CC, GPUCC_GMU_RCG_CMD, gpu_r(io, GPU_CC, GPUCC_GMU_RCG_CMD) | RCG_UPDATE);
+	if (!gpu_poll(io, GPU_CC, GPUCC_GMU_RCG_CMD, RCG_UPDATE, 0)) {
+		r->error = "GMU RCG update did not complete";
+		gpu_rollback(io, r);
+		return;
+	}
+	if (!(gpu_r(io, GPU_CC, GPUCC_CXO) & CBCR_ENABLE)) {
+		gpu_w(io, GPU_CC, GPUCC_CXO, gpu_r(io, GPU_CC, GPUCC_CXO) | CBCR_ENABLE);
+		r->own_cxo = 1;
+		if (!gpu_poll(io, GPU_CC, GPUCC_CXO, CBCR_CLK_OFF, 0)) {
+			r->error = "GPUCC cxo branch did not start";
+			gpu_rollback(io, r);
+			return;
+		}
+	}
+	/* The recommended wake/sleep fields (gpucc-sc7180.c probe), then the branch. */
+	gpu_w(io, GPU_CC, GPUCC_CX_GMU, gpu_r(io, GPU_CC, GPUCC_CX_GMU) | CBCR_WAKE_SLEEP | CBCR_ENABLE);
+	r->own_cx_gmu = 1;
+	r->clock_polls = gpu_poll(io, GPU_CC, GPUCC_CX_GMU, CBCR_CLK_OFF, 0);
+	if (!r->clock_polls) {
+		r->error = "cx-gmu branch did not start";
+		gpu_rollback(io, r);
+		return;
+	}
+	r->stage = 4;
+	/* The GMU's paths to memory: voted branches, enabled and left to the vote. */
+	if (!(gpu_r(io, GPU_GCC, GCC_GPU_MEMNOC_GFX) & CBCR_ENABLE)) {
+		gpu_w(io, GPU_GCC, GCC_GPU_MEMNOC_GFX, gpu_r(io, GPU_GCC, GCC_GPU_MEMNOC_GFX) | CBCR_ENABLE);
+		r->own_memnoc = 1;
+	}
+	if (!(gpu_r(io, GPU_GCC, GCC_DDRSS_GPU_AXI) & CBCR_ENABLE)) {
+		gpu_w(io, GPU_GCC, GCC_DDRSS_GPU_AXI, gpu_r(io, GPU_GCC, GCC_DDRSS_GPU_AXI) | CBCR_ENABLE);
+		r->own_axi = 1;
+	}
+	io->delay_us(io->cookie, 10);
+	gpu_snapshot(io, r->gcc_on, r->cc_on, 1);
+	r->stage = 5;
+	/* GMU registers: reads only. CM3 is expected to be held in reset with no firmware. */
+	for (unsigned i = 0; i < GPU_GMU_REGS; i++) {
+		r->gmu[i] = gpu_r(io, GPU_GMU, gpu_gmu_regs[i]);
+	}
+	if (mode == 4) {
+		gpu_read_smmu(io, r);
+	}
+	if (mode == 3) {
+		if (r->gmu[0] & 1u) {
+			gpu_load_tcm(io, image, image_bytes, r);
+		} else {
+			r->error = "CM3 not held in reset: firmware not written";
+		}
+	}
+	r->stage = 6;
+	gpu_rollback(io, r);
+	r->stage = r->restored && !r->error ? 7 : 6;
+}
+#endif
