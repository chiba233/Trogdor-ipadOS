+/* Only empty directories on the mounted volatile Data seed; original usermanagerd
+ * creates persona.kb itself. Reuse mkdir's real VFS path with a user scratch pointer.
+ */
+static int
+coachz_data_keybags_prepare(proc_t p, user_addr_t scratch)
+{
+	const char *const paths[] = {"/private/var/keybags", "/private/var/keybags/backup"};
+	struct mkdir_args request = {.path = scratch + 0x100, .mode = 0700};
+	vfs_context_t context = vfs_context_kernel();
+	int32_t result = 0;
+	int error;
+
+	for (unsigned index = 0; index < sizeof(paths) / sizeof(paths[0]); index++) {
+		vnode_t vnode = NULLVP;
+		struct vnode_attr attributes;
+		error = copyout(paths[index], request.path, strlen(paths[index]) + 1);
+		if (!error) {
+			error = mkdir(p, &request, &result);
+		}
+		if (error == EEXIST) {
+			error = 0;
+		}
+		if (!error) {
+			error = vnode_lookup(paths[index], VNODE_LOOKUP_NOFOLLOW, &vnode, context);
+		}
+		if (!error && vnode_vtype(vnode) != VDIR) {
+			error = ENOTDIR;
+		}
+		if (!error) {
+			VATTR_INIT(&attributes);
+			VATTR_WANTED(&attributes, va_uid);
+			VATTR_WANTED(&attributes, va_mode);
+			error = vnode_getattr(vnode, &attributes, context);
+			if (!error && (attributes.va_uid != 0 || (attributes.va_mode & 0022))) {
+				error = EACCES;
+			}
+		}
+		if (vnode) {
+			vnode_put(vnode);
+		}
+		printf("COACHZ Data: keybags directory %u: %d\n", index, error);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
