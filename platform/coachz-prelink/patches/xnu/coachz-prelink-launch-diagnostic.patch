+/* The first SIGKILLs sent through kill(), and the first lsd and SpringBoard starts and exits,
+ * with seconds since boot, so the report shows who killed SpringBoard while it waited on lsd.
+ */
+struct coachz_launch_event {
+	uint32_t seconds;
+	int pid;
+	int other_pid;
+	int status;
+	char name[24];
+	char other_name[24];
+};
+static struct coachz_launch_event coachz_kills[6];
+static uint32_t coachz_kill_count;
+static struct coachz_launch_event coachz_launches[10];
+static uint32_t coachz_launch_count;
+/* lsd seen while the first SpringBoard waits on it: two snapshots, 45 s and 80 s after that start. */
+static int coachz_lsd_pid;
+static int coachz_bbd_pid;
+static uint32_t coachz_sb_started;
+static char coachz_lsd_snapshots[2][1024];
+static uint32_t coachz_lsd_snapshot_count;
+void coachz_launch_signal(int, const char *, int, const char *, int);
+void coachz_launch_process(int, const char *, int, int);
+
+static uint32_t
+coachz_launch_seconds(void)
+{
+	clock_sec_t seconds;
+	clock_usec_t microseconds;
+	clock_get_system_microtime(&seconds, &microseconds);
+	return (uint32_t)seconds;
+}
+
+void
+coachz_launch_signal(int sender, const char *sender_name, int target, const char *target_name, int signum)
+{
+	uint32_t index;
+	if (signum != 9 || (index = os_atomic_inc_orig(&coachz_kill_count, relaxed)) >= 6) {
+		return;
+	}
+	coachz_kills[index] = (struct coachz_launch_event){ .seconds = coachz_launch_seconds(),
+		                                             .pid = sender, .other_pid = target };
+	strlcpy(coachz_kills[index].name, sender_name, sizeof(coachz_kills[index].name));
+	strlcpy(coachz_kills[index].other_name, target_name, sizeof(coachz_kills[index].other_name));
+}
+
+/* exited: 0 for exec, 1 for exit with its wait status. */
+void
+coachz_launch_process(int pid, const char *name, int exited, int status)
+{
+	uint32_t index;
+	if (!exited && !strcmp(name, "backboardd")) {
+		os_atomic_store(&coachz_bbd_pid, pid, relaxed);
+		return;
+	}
+	if ((strcmp(name, "lsd") && strcmp(name, "SpringBoard")) ||
+	    (index = os_atomic_inc_orig(&coachz_launch_count, relaxed)) >= 10) {
+		return;
+	}
+	coachz_launches[index] = (struct coachz_launch_event){ .seconds = coachz_launch_seconds(),
+		                                                .pid = pid, .other_pid = exited, .status = status };
+	if (!exited && !strcmp(name, "lsd")) {
+		os_atomic_store(&coachz_lsd_pid, pid, relaxed);
+	} else if (!exited && !coachz_sb_started) {
+		coachz_sb_started = coachz_launches[index].seconds;
+	}
+	strlcpy(coachz_launches[index].name, name, sizeof(coachz_launches[index].name));
+}
+
+struct proc;
+extern struct proc *proc_find(int);
+extern int proc_rele(struct proc *);
+extern task_t proc_task(struct proc *);
+
+static void
+coachz_lsd_snapshot(char *out, size_t size, uint32_t now)
+{
+	struct proc *p = proc_find(os_atomic_load(&coachz_lsd_pid, relaxed));
+	uint64_t pc[5] = {}, lr[5] = {}, x16[5] = {}, fp = 0, sp = 0;
+	unsigned state[5] = {}, hint[5] = {}, count = 0, threads;
+	size_t used;
+	task_t task;
+	thread_t thread;
+	vm_map_t map;
+
+	if (!p) {
+		snprintf(out, size, "COACHZ LSD at %u s: lsd not found\n", now);
+		return;
+	}
+	task = proc_task(p);
+	task_lock(task);
+	threads = task->thread_count;
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *saved = find_user_regs(thread);
+		if (count == 5) {
+			break;
+		}
+		state[count] = (unsigned)thread->state;
+		hint[count] = (unsigned)thread->block_hint;
+		if (saved) {
+			pc[count] = get_saved_state_pc(saved);
+			lr[count] = get_saved_state_lr(saved);
+			x16[count] = get_saved_state_reg(saved, 16);
+			if (!count) {
+				fp = get_saved_state_fp(saved);
+				sp = get_saved_state_sp(saved);
+			}
+		}
+		count++;
+	}
+	task_unlock(task);
+	used = snprintf(out, size, "COACHZ LSD at %u s (SB +%u s): threads %u header 0x%llx slide 0x%x\n", now,
+	    now - coachz_sb_started, threads, (unsigned long long)task->mach_header_vm_address,
+	    task->task_shared_region_slide);
+	for (unsigned index = 0; index < count && used < size; index++) {
+		used += snprintf(out + used, size - used, "COACHZ LSD t%u state 0x%x hint %u pc 0x%llx lr 0x%llx x16 0x%llx\n",
+		    index, state[index], hint[index], (unsigned long long)pc[index], (unsigned long long)lr[index],
+		    (unsigned long long)x16[index]);
+	}
+	/* The main thread's frame chain, read from lsd's own map. */
+	map = get_task_map_reference(task);
+	if (map) {
+		if (used < size) {
+			used += snprintf(out + used, size - used, "COACHZ LSD t0 frames:");
+		}
+		for (unsigned index = 0; index < 8 && used < size; index++) {
+			uint64_t frame[2];
+			if ((fp & 15) || fp < sp || fp - sp > 65536 ||
+			    vm_map_read_user(map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			used += snprintf(out + used, size - used, " 0x%llx", (unsigned long long)frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		if (used < size) {
+			snprintf(out + used, size - used, "\n");
+		}
+		vm_map_deallocate(map);
+	}
+	proc_rele(p);
 }
 
+/* ArmCpu's secondary-CPU evidence (steps: 1 nub, 2 registered, 3 start thread, 4 CPU_ON, 5 initCPU, 6 GIC, 7 running),
+ * each core's CurrentEL and MIDR (part 0x805 A55, 0x804 A76), and the cluster type XNU registered it with.
+ */
+extern volatile uint32_t armcpu_smp_requested, armcpu_smp_running, armcpu_boot_mpidr;
+extern volatile uint32_t armcpu_smp_step[8], armcpu_smp_fail[8], armcpu_core_timer[8], armcpu_core_sgi[8];
+extern volatile uint32_t armcpu_smp_sys[8][5], armcpu_boot_sys[5], armcpu_freq[3][6];
+extern volatile uint64_t coachz_frame_stats[3];
+extern volatile int32_t armcpu_smp_psci_rc[8];
+extern void armcpu_group1_sgi_probe(uint64_t *);
+static char coachz_sgi_probe[256];
+
+static void
+coachz_smp_report(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint64_t count = 2000000, start, end, hz;
+
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(hz));
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+	__asm__ volatile ("1: subs %0, %0, #1\n\tb.ne 1b" : "+r"(count) :: "cc");
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(end));
+	uint64_t us = hz ? (end - start) * 1000000 / hz : 0;
+	printf("COACHZ SMP v2: requested %u, %u secondary running, %u CPUs in %u clusters; loop on cpu %d: %llu per us\n",
+	    armcpu_smp_requested, armcpu_smp_running, topology ? topology->num_cpus : 0, topology ? topology->num_clusters : 0,
+	    cpu_number(), us ? 2000000 / us : 0);
+	for (unsigned half = 0; half < 2; half++) {
+		printf("COACHZ SMP %u-%u:", half * 4, half * 4 + 3);
+		for (unsigned index = half * 4; index < half * 4 + 4; index++) {
+			uint32_t el = index ? armcpu_smp_sys[index][0] : armcpu_boot_sys[0];
+			uint32_t midr = index ? armcpu_smp_sys[index][4] : armcpu_boot_sys[4];
+			/* The cluster type XNU registered the core with; a core not yet registered has no cpu_data. */
+			cpu_data_t *data = index < (unsigned)ml_get_cpu_count() ? cpu_datap(index) : NULL;
+			int type = data ? (int)data->cpu_cluster_type : -1;
+			printf(" [%u s%u rc%d f%u t%u g%u el%u p%03x %c]", index, index ? armcpu_smp_step[index] : 7,
+			    armcpu_smp_psci_rc[index], armcpu_smp_fail[index], armcpu_core_timer[index], armcpu_core_sgi[index],
+			    (el >> 2) & 3, (midr >> 4) & 0xfff, type == CLUSTER_TYPE_E ? 'E' : type == CLUSTER_TYPE_P ? 'P' : '-');
+		}
+		printf("\n");
+	}
+	/* Once: which non-secure SGIs to this core become pending as Group 1, and how is the CPU interface set? */
+	if (!coachz_sgi_probe[0]) {
+		uint64_t out[10];
+		armcpu_group1_sgi_probe(out);
+		snprintf(coachz_sgi_probe, sizeof(coachz_sgi_probe),
+		    "COACHZ SGI probe mpidr 0x%llx: grp1 0x%llx pmr 0x%llx igrpen1 0x%llx sre 0x%llx ctlr 0x%llx rpr 0x%llx hppir 0x%llx\n",
+		    out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7]);
+	}
+	printf("%s", coachz_sgi_probe);
+	{
+		static uint64_t reported_frames;
+		static uint32_t reported_seconds;
+		static uint64_t memcpy_mbs;
+		static const char names[3][4] = { "A55", "A76", "L3" };
+		uint64_t frames = coachz_frame_stats[0];
+		uint32_t now = coachz_launch_seconds();
+		printf("COACHZ frames: %llu (+%llu in %u s), last copy %llu us, gap %llu ms\n", frames, frames - reported_frames,
+		    now - reported_seconds, coachz_frame_stats[1], coachz_frame_stats[2]);
+		reported_frames = frames;
+		reported_seconds = now;
+		printf("COACHZ freq:");
+		for (unsigned domain = 0; domain < 3; domain++) {
+			printf(" [%s en%u state %u->%u/%u %u->%u MHz]", names[domain], armcpu_freq[domain][0], armcpu_freq[domain][1],
+			    armcpu_freq[domain][2], armcpu_freq[domain][3], armcpu_freq[domain][4], armcpu_freq[domain][5]);
+		}
+		printf("\n");
+		if (!memcpy_mbs) {
+			/* Larger than the L3: this is DRAM, which no CPU loop shows. */
+			const size_t size = 4 * 1024 * 1024;
+			void *from = kalloc_data(size, Z_WAITOK | Z_ZERO), *to = kalloc_data(size, Z_WAITOK | Z_ZERO);
+			if (from && to) {
+				uint64_t start = mach_absolute_time(), ns;
+				for (unsigned pass = 0; pass < 8; pass++) {
+					memcpy(to, from, size);
+					__asm__ volatile ("" : : "r" (to) : "memory");
+				}
+				absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+				memcpy_mbs = 8 * size * 1000 / (ns ? ns : 1);
+			}
+			kfree_data(from, size);
+			kfree_data(to, size);
+		}
+		printf("COACHZ mem: memcpy %llu MB/s\n", memcpy_mbs);
+	}
+}
+
+/* Each backboardd thread: state, block hint, priority, last CPU and the trap it sits in. */
+static void
+coachz_bbd_report(void)
+{
+	struct proc *p = proc_find(os_atomic_load(&coachz_bbd_pid, relaxed));
+	struct {
+		unsigned state, hint;
+		int pri, cpu;
+		long long trap;
+	} seen[12];
+	unsigned count = 0, threads;
+	task_t task;
+	thread_t thread;
+
+	if (!p) {
+		return;
+	}
+	task = proc_task(p);
+	task_lock(task);
+	threads = task->thread_count;
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *saved = find_user_regs(thread);
+		if (count == 12) {
+			break;
+		}
+		seen[count].state = (unsigned)thread->state;
+		seen[count].hint = (unsigned)thread->block_hint;
+		seen[count].pri = thread->sched_pri;
+		seen[count].cpu = thread->last_processor ? thread->last_processor->cpu_id : -1;
+		seen[count].trap = saved ? (long long)get_saved_state_reg(saved, 16) : 0;
+		count++;
+	}
+	task_unlock(task);
+	proc_rele(p);
+	printf("COACHZ BBD %u threads:", threads);
+	for (unsigned index = 0; index < count; index++) {
+		printf(" [s%x h%u p%d c%d x%lld]", seen[index].state, seen[index].hint, seen[index].pri, seen[index].cpu,
+		    seen[index].trap);
+	}
+	printf("\n");
+}
+
+static void
+coachz_launch_report(void)
+{
+	coachz_smp_report();
+	coachz_bbd_report();
+	uint32_t kills = os_atomic_load(&coachz_kill_count, relaxed);
+	uint32_t launches = os_atomic_load(&coachz_launch_count, relaxed);
+	printf("COACHZ LS v1: %u SIGKILL, %u lsd/SpringBoard events, now %u s\n", kills, launches,
+	    coachz_launch_seconds());
+	for (uint32_t index = 0; index < kills && index < 6; index++) {
+		printf("COACHZ LS kill %u s: %s(%d) -> %s(%d)\n", coachz_kills[index].seconds,
+		    coachz_kills[index].name, coachz_kills[index].pid,
+		    coachz_kills[index].other_name, coachz_kills[index].other_pid);
+	}
+	for (uint32_t index = 0; index < launches && index < 10; index++) {
+		printf("COACHZ LS %u s: %s(%d) %s 0x%x\n", coachz_launches[index].seconds,
+		    coachz_launches[index].name, coachz_launches[index].pid,
+		    coachz_launches[index].other_pid ? "exit" : "exec", coachz_launches[index].status);
+	}
+	uint32_t now = coachz_launch_seconds(), taken = coachz_lsd_snapshot_count;
+	if (taken < 2 && coachz_sb_started && os_atomic_load(&coachz_lsd_pid, relaxed) &&
+	    now >= coachz_sb_started + (taken ? 80 : 45)) {
+		coachz_lsd_snapshot(coachz_lsd_snapshots[taken], sizeof(coachz_lsd_snapshots[taken]), now);
+		coachz_lsd_snapshot_count = taken + 1;
+	}
+	for (uint32_t index = 0; index < coachz_lsd_snapshot_count; index++) {
+		printf("%s", coachz_lsd_snapshots[index]);
+	}
+}
