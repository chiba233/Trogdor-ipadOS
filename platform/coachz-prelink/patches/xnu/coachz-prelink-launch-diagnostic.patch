+/* The first SIGKILLs sent through kill(), and the first lsd and SpringBoard starts and exits,
+ * with seconds since boot, so the report shows who killed SpringBoard while it waited on lsd.
+ */
+struct coachz_launch_event {
+	uint32_t seconds;
+	int pid;
+	int other_pid;
+	int status;
+	char name[24];
+	char other_name[24];
+};
+static struct coachz_launch_event coachz_kills[6];
+static uint32_t coachz_kill_count;
+static struct coachz_launch_event coachz_launches[10];
+static uint32_t coachz_launch_count;
+void coachz_launch_signal(int, const char *, int, const char *, int);
+void coachz_launch_process(int, const char *, int, int);
+
+static uint32_t
+coachz_launch_seconds(void)
+{
+	clock_sec_t seconds;
+	clock_usec_t microseconds;
+	clock_get_system_microtime(&seconds, &microseconds);
+	return (uint32_t)seconds;
+}
+
+void
+coachz_launch_signal(int sender, const char *sender_name, int target, const char *target_name, int signum)
+{
+	uint32_t index;
+	if (signum != 9 || (index = os_atomic_inc_orig(&coachz_kill_count, relaxed)) >= 6) {
+		return;
+	}
+	coachz_kills[index] = (struct coachz_launch_event){ .seconds = coachz_launch_seconds(),
+		                                             .pid = sender, .other_pid = target };
+	strlcpy(coachz_kills[index].name, sender_name, sizeof(coachz_kills[index].name));
+	strlcpy(coachz_kills[index].other_name, target_name, sizeof(coachz_kills[index].other_name));
+}
+
+/* exited: 0 for exec, 1 for exit with its wait status. */
+void
+coachz_launch_process(int pid, const char *name, int exited, int status)
+{
+	uint32_t index;
+	if ((strcmp(name, "lsd") && strcmp(name, "SpringBoard")) ||
+	    (index = os_atomic_inc_orig(&coachz_launch_count, relaxed)) >= 10) {
+		return;
+	}
+	coachz_launches[index] = (struct coachz_launch_event){ .seconds = coachz_launch_seconds(),
+		                                                .pid = pid, .other_pid = exited, .status = status };
+	strlcpy(coachz_launches[index].name, name, sizeof(coachz_launches[index].name));
+}
+
+static void
+coachz_launch_report(void)
+{
+	uint32_t kills = os_atomic_load(&coachz_kill_count, relaxed);
+	uint32_t launches = os_atomic_load(&coachz_launch_count, relaxed);
+	printf("COACHZ LS v1: %u SIGKILL, %u lsd/SpringBoard events, now %u s\n", kills, launches,
+	    coachz_launch_seconds());
+	for (uint32_t index = 0; index < kills && index < 6; index++) {
+		printf("COACHZ LS kill %u s: %s(%d) -> %s(%d)\n", coachz_kills[index].seconds,
+		    coachz_kills[index].name, coachz_kills[index].pid,
+		    coachz_kills[index].other_name, coachz_kills[index].other_pid);
+	}
+	for (uint32_t index = 0; index < launches && index < 10; index++) {
+		printf("COACHZ LS %u s: %s(%d) %s 0x%x\n", coachz_launches[index].seconds,
+		    coachz_launches[index].name, coachz_launches[index].pid,
+		    coachz_launches[index].other_pid ? "exit" : "exec", coachz_launches[index].status);
+	}
+}
+
 int
 coachz_springboard_report(void)
 {
 	unsigned phase = os_atomic_load(&coachz_sb_captured, acquire);
+	coachz_launch_report();
 	if (phase != 2) {
 		printf("COACHZ SB v1: waiting for abnormal exit (capture %u)\n", phase);
 		return 0;
