+/*
+ * Diagnostic (coachz-match-log=1): the IOKit matching dictionaries and the services that locationd, backboardd and SpringBoard ask for,
+ * each distinct one once, to the log ring. It shows what CoreMotion looks for before an orientation source is made for it. Read only.
+ */
+#include <pexpert/pexpert.h>
+extern "C" void proc_selfname(char * buf, int size);
+static void
+coachz_match_log(const char * what, const OSObject * object)
+{
+	static int enabled = -1;
+	static uint32_t seen[256];
+	static unsigned count;
+	char name[17] = {};
+
+	if (enabled < 0) {
+		int value = 0;
+		enabled = PE_parse_boot_argn("coachz-match-log", &value, sizeof(value)) && value == 1;
+	}
+	if (!enabled || !object) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "locationd") && strcmp(name, "backboardd") && strcmp(name, "SpringBoard")) {
+		return;
+	}
+	OSSerialize * s = OSSerialize::withCapacity(512);
+	if (!s) {
+		return;
+	}
+	if (object->serialize(s)) {
+		const char * text = s->text();
+		uint32_t hash = 2166136261u;
+		const char * parts[] = {name, what, text};
+		for (const char * at : parts) {
+			for (; *at; at++) {
+				hash = (hash ^ (uint8_t) *at) * 16777619u;
+			}
+		}
+		bool known = false;
+		for (unsigned i = 0; i < count; i++) {
+			known = known || seen[i] == hash;
+		}
+		if (!known && count < 256) {
+			seen[count++] = hash;
+			printf("COACHZ match %s %s: %.400s\n", name, what, text);
+		}
+	}
+	s->release();
+}
+
+/* The registry properties locationd reads (coachz-match-log=1), by entry name and key: what CoreMotion needs from a motion node. */
+static void
+coachz_prop_log(IORegistryEntry * entry, const char * key)
+{
+	char name[17] = {}, text[128];
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "locationd")) {
+		return;
+	}
+	snprintf(text, sizeof(text), "%s %s", entry->getName(), key ? key : "*");
+	OSString * read = OSString::withCString(text);
+	coachz_match_log("prop", read);
+	OSSafeReleaseNULL(read);
 }
 
