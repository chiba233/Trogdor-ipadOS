+/*
+ * k36 measurements, one compact block every ten seconds:
+ *  - each core's busy share from its idle time, and its timer/SGI counts in the window;
+ *  - each core's clock from a chain of dependent adds (one per cycle on A55 and A76), with interrupts off,
+ *    next to the older two-instruction loop whose rate depends on how that loop is fetched;
+ *  - the hardware's current vote of the two CPU frequency domains (cpufreq-hw offset 0x704, units of 19.2 MHz);
+ *  - frame copies in the window: count, fastest/slowest copy, longest gap, the cores that copied;
+ *  - the five processes and five backboardd threads that used the most CPU time in the window.
+ * coachz-console-band=N keeps the screen console in the top N rows once the first frame is copied.
+ */
+#include <kern/recount.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+extern char *proc_name_address(void *p);
+extern void coachz_early_band(uint32_t rows);
+static unsigned coachz_compact;
+
+#define COACHZ_TOP 5
+struct coachz_usage {
+	int key;
+	uint64_t total, delta;
+	char name[20];
+};
+/* backboardd alone has 65 threads: a table smaller than that left the thread column empty in k36. */
+static struct coachz_usage coachz_tasks_seen[512], coachz_bbd_seen[128];
+static unsigned coachz_tasks_count, coachz_bbd_count;
+
+/* Remember a total under a key and return what it grew by since the last window. */
+static uint64_t
+coachz_usage_delta(struct coachz_usage *table, unsigned *count, unsigned size, int key, uint64_t total)
+{
+	for (unsigned index = 0; index < *count; index++) {
+		if (table[index].key == key) {
+			uint64_t delta = total >= table[index].total ? total - table[index].total : 0;
+			table[index].total = total;
+			return delta;
+		}
+	}
+	if (*count < size) {
+		table[(*count)++] = (struct coachz_usage){ .key = key, .total = total };
+	}
+	return 0;
+}
+
+static void
+coachz_top_insert(struct coachz_usage *top, const char *name, int key, uint64_t delta)
+{
+	unsigned at = COACHZ_TOP;
+	while (at > 0 && top[at - 1].delta < delta) {
+		at--;
+	}
+	if (at == COACHZ_TOP) {
+		return;
+	}
+	for (unsigned index = COACHZ_TOP - 1; index > at; index--) {
+		top[index] = top[index - 1];
+	}
+	top[at] = (struct coachz_usage){ .key = key, .delta = delta };
+	strlcpy(top[at].name, name, sizeof(top[at].name));
+}
+
+static uint64_t
+coachz_ms(uint64_t mach)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach, &ns);
+	return ns / 1000000;
+}
+
+/* Dependent adds per microsecond on the current core; *loop2 gets the older subs/b.ne loop's iterations per microsecond. */
+static uint64_t
+coachz_core_mhz(uint64_t *loop2)
+{
+	uint64_t hz, start, end, rounds = 200000, value = 0, count = 2000000;
+	boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(hz));
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+	__asm__ volatile ("1:\n\t.rept 32\n\tadd %1, %1, #1\n\t.endr\n\tsubs %0, %0, #1\n\tb.ne 1b"
+            : "+r"(rounds), "+r"(value) :: "cc");
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(end));
+	uint64_t chain = end - start;
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+	__asm__ volatile ("1: subs %0, %0, #1\n\tb.ne 1b" : "+r"(count) :: "cc");
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(end));
+	ml_set_interrupts_enabled(enabled);
+	if (!hz || !chain || end == start) {
+		*loop2 = 0;
+		return 0;
+	}
+	*loop2 = 2000000 * hz / ((end - start) * 1000000);
+	return 32 * 200000 * hz / (chain * 1000000);
+}
+
+/*
+ * k37: where a process's waiting threads sit. Threads are grouped by their first four kernel return addresses (unslid,
+ * low 36 bits; a thread blocked with a continuation has no stack and shows that continuation, marked c). Each group
+ * shows its size, five frames, the user pc of one member, its wait event and state. Symbolicate offline with the kernel.
+ */
+struct coachz_wait_group {
+	uint64_t lr[5], upc, event;
+	unsigned count, state, hint, cont;
+};
+
+static void
+coachz_wait_report(int pid, const char *label)
+{
+	struct coachz_wait_group groups[3] = { 0 };
+	unsigned used = 0, threads = 0, running = 0, other = 0;
+	struct proc *p = pid > 0 ? proc_find(pid) : NULL;
+	thread_t thread;
+
+	if (!p) {
+		printf("K37 W %s: not running\n", label);
+		return;
+	}
+	task_t task = proc_task(p);
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		struct coachz_wait_group seen = { .count = 1 };
+		threads++;
+		if (!(thread->state & TH_WAIT) || (thread->state & TH_RUN)) {
+			running++;
+			continue;
+		}
+		seen.state = (unsigned)thread->state;
+		seen.hint = (unsigned)thread->block_hint;
+		seen.event = (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event);
+		if (!thread->kernel_stack || !thread->machine.kstackptr) {
+			seen.cont = 1;
+			seen.lr[0] = (uint64_t)VM_KERNEL_UNSLIDE(thread->continuation);
+		} else {
+			const vm_offset_t low = thread->kernel_stack, high = low + kernel_stack_size;
+			/* kstackptr is the kernel context saved at the top of the stack when the thread blocked (as kdp reads it). */
+			const arm_kernel_saved_state_t *state = (const arm_kernel_saved_state_t *)thread->machine.kstackptr;
+			uint64_t fp = state->fp;
+			seen.lr[0] = (uint64_t)VM_KERNEL_UNSLIDE(state->lr);
+			for (unsigned frame = 1; frame < 5; frame++) {
+				if (!fp || (fp & 15) || fp < low || fp + 16 > high) {
+					break;
+				}
+				seen.lr[frame] = (uint64_t)VM_KERNEL_UNSLIDE(((const uint64_t *)fp)[1]);
+				fp = ((const uint64_t *)fp)[0];
+			}
+		}
+		arm_saved_state_t *user = find_user_regs(thread);
+		seen.upc = user ? (uint64_t)get_saved_state_pc(user) : 0;
+		unsigned index = 0;
+		while (index < used && memcmp(groups[index].lr, seen.lr, 4 * sizeof(seen.lr[0]))) {
+			index++;
+		}
+		if (index < used) {
+			groups[index].count++;
+		} else if (used < 3) {
+			groups[used++] = seen;
+		} else {
+			other++;
+		}
+	}
+	task_unlock(task);
+	proc_rele(p);
+	printf("K37 W %s(%d) %u threads, %u running, %u in other groups\n", label, pid, threads, running, other);
+	for (unsigned index = 0; index < used; index++) {
+		struct coachz_wait_group *g = &groups[index];
+		printf(" %ux%s s%x h%u:", g->count, g->cont ? " c" : "", g->state, g->hint);
+		for (unsigned frame = 0; frame < 5 && g->lr[frame]; frame++) {
+			printf(" %llx", g->lr[frame] & 0xfffffffffull);
+		}
+		printf(" e%llx u%llx\n", g->event & 0xfffffffffull, g->upc);
+	}
+}
+
+extern volatile uint64_t coachz_io_stats[8];
+
+/* Block I/O through the USB driver in the window: operations, KiB, time holding the device gate, time waiting for it, slowest operation. */
+static void
+coachz_io_report(void)
+{
+	static uint64_t last[8];
+	uint64_t now[8];
+	for (unsigned index = 0; index < 8; index++) {
+		now[index] = coachz_io_stats[index];
+	}
+	printf("K37 io: read %llu ops %llu KiB, write %llu ops %llu KiB, busy %llu ms, gate wait %llu ms, slowest %llu ms\n",
+	    now[0] - last[0], (now[1] - last[1]) / 1024, now[2] - last[2], (now[3] - last[3]) / 1024,
+	    coachz_ms(now[4] - last[4]), coachz_ms(now[5] - last[5]), coachz_ms(now[6]));
+	coachz_io_stats[6] = 0;
+	for (unsigned index = 0; index < 8; index++) {
+		last[index] = now[index];
