+		}
+		printf("\n");
+	}
+	coachz_io_report();
+	{
+		static unsigned turn;
+		static const char *const labels[3] = { "backboardd", "SpringBoard", "lsd" };
+		int pids[3] = { os_atomic_load(&coachz_bbd_pid, relaxed), os_atomic_load(&coachz_sb_pid, relaxed),
+			        os_atomic_load(&coachz_lsd_pid, relaxed) };
+		unsigned which = turn++ % 3;
+		if (os_atomic_load(&coachz_kill_captured, acquire) == 1) {
+			printf("%s", coachz_kill_capture);
+		} else {
+			coachz_wait_report(pids[which], labels[which]);
+		}
+	}
+	uint32_t kills = os_atomic_load(&coachz_kill_count, relaxed);
+	printf("K36 SB capture %u, %u SIGKILL", os_atomic_load(&coachz_sb_captured, acquire), kills);
+	if (kills) {
+		uint32_t last = (kills < 6 ? kills : 6) - 1;
+		printf(", last %s(%d) -> %s(%d) at %u s", coachz_kills[last].name, coachz_kills[last].pid,
+		    coachz_kills[last].other_name, coachz_kills[last].other_pid, coachz_kills[last].seconds);
+	}
+	printf(", now %u s\n", coachz_launch_seconds());
+}
