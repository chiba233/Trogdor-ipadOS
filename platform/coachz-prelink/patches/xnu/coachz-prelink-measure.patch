+/*
+ * k39: backboardd's side of the first SpringBoard kill, taken once in the kill() call itself. The killing thread's user
+ * frames say why it kills; the other backboardd threads that are not waiting for a message or parked (a user lock, a
+ * condition variable...) show what could keep SpringBoard's check-in from being answered. For each: hint, pc, lr, x16
+ * (syscall), x1/x2 (a ulock_wait's address and expected value) with the word now at x1, then the user frame chain.
+ */
+static char coachz_kill_capture[2048];
+static uint32_t coachz_kill_captured;
+
+static size_t
+coachz_user_frames(char *out, size_t size, vm_map_t map, uint64_t fp, uint64_t sp, unsigned limit)
+{
+	size_t used = 0;
+	for (unsigned index = 0; index < limit && used < size; index++) {
+		uint64_t frame[2];
+		if ((fp & 15) || fp < sp || fp - sp > 1024 * 1024 ||
+		    vm_map_read_user(map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+			break;
+		}
+		used += snprintf(out + used, size - used, " %llx", (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	return used;
+}
+
+static void
+coachz_capture_kill(uint32_t seconds)
+{
+	struct {
+		uint64_t pc, lr, fp, sp, x16, x1, x2;
+		unsigned hint;
+	} seen[4] = { 0 };
+	unsigned count = 0, threads;
+	thread_t self = current_thread(), thread;
+	task_t task = current_task();
+	vm_map_t map = current_map();
+	char *out = coachz_kill_capture;
+	const size_t size = sizeof(coachz_kill_capture);
+	size_t used;
+
+	task_lock(task);
+	threads = task->thread_count;
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		unsigned hint = (unsigned)thread->block_hint;
+		arm_saved_state_t *saved = find_user_regs(thread);
+		/* Slot 0 is the killer; then threads that wait on something other than a message or the workqueue. */
+		unsigned slot = thread == self ? 0 : count + 1;
+		if (!saved || (thread != self && (count == 3 || hint == 2 || hint == 3 || hint == 15))) {
+			continue;
+		}
+		seen[slot].hint = hint;
+		seen[slot].pc = get_saved_state_pc(saved);
+		seen[slot].lr = get_saved_state_lr(saved);
+		seen[slot].fp = get_saved_state_fp(saved);
+		seen[slot].sp = get_saved_state_sp(saved);
+		seen[slot].x16 = get_saved_state_reg(saved, 16);
+		seen[slot].x1 = get_saved_state_reg(saved, 1);
+		seen[slot].x2 = get_saved_state_reg(saved, 2);
+		if (thread != self) {
+			count++;
+		}
+	}
+	task_unlock(task);
+	used = snprintf(out, size, "K39 kill at %u s: backboardd %u threads, slide 0x%x, %u others\n", seconds, threads,
+	    task->task_shared_region_slide, count);
+	for (unsigned slot = 0; slot <= count && used < size; slot++) {
+		uint32_t word = 0;
+		if (seen[slot].x1 && copyin((user_addr_t)seen[slot].x1, &word, sizeof(word))) {
+			word = 0xdeadbeef;
+		}
+		used += snprintf(out + used, size - used, " %s h%u pc %llx lr %llx x16 %lld x1 %llx x2 %llx [x1] %x:",
+		    slot ? "T" : "KILLER", seen[slot].hint, seen[slot].pc, seen[slot].lr, (long long)seen[slot].x16,
+		    seen[slot].x1, seen[slot].x2, word);
+		if (used < size) {
+			used += coachz_user_frames(out + used, size - used, map, seen[slot].fp, seen[slot].sp, slot ? 10 : 14);
+		}
+		if (used < size) {
+			used += snprintf(out + used, size - used, "\n");
+		}
+	}
+	os_atomic_store(&coachz_kill_captured, 1, release);
+}
