+
+/* Temporary: the MobileGestalt cache on the persistent Data volume was written by boots without a
+ * display service and holds no main-screen answers. Remove it before launchd so it is rebuilt.
+ */
+int unlink1(vfs_context_t, vnode_t, user_addr_t, enum uio_seg, int);
+
+/* The calendar from the EC's RTC, before launchd, as rtc-cros-ec reads it (EC_CMD_RTC_GET_VALUE). BCM2837's configuration waits for no RTC
+ * service, so the calendar otherwise starts at the epoch, every TLS certificate fails and the system reports no internet.
+ */
+extern int coachz_ec_command(uint16_t, uint8_t, const void *, uint32_t, void *, uint32_t, uint32_t *);
+extern void clock_set_calendar_microtime(clock_sec_t, clock_usec_t);
+extern int coachz_rename_path(const char *, const char *);
+static void
+coachz_calendar_from_ec(void)
+{
+	uint32_t seconds = 0, length = 0;
+	const int error = coachz_ec_command(0x0044, 0, NULL, 0, &seconds, sizeof(seconds), &length);
+
+	if (!error && length >= sizeof(seconds) && seconds > 1577836800u) {
+		clock_set_calendar_microtime(seconds, 0);
+	}
+	printf("COACHZ clock: EC RTC error %d length %u, %u\n", error, length, seconds);
+}
+
+/* Icons generated while no GPU existed stay in the persistent cache. Moved aside once: the name it moves to then exists and later boots keep what the GPU drew. */
+static void
+coachz_icon_cache_reset(void)
+{
+	static const char from[] = "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.lsd.iconscache/Library/Caches/com.apple.IconsCache";
+	static const char to[] = "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.lsd.iconscache/Library/Caches/com.apple.IconsCache.coachz-old";
+
+	printf("COACHZ icons: cache moved aside: %d\n", coachz_rename_path(from, to));
+}
 
+/* Diagnostic (coachz-dump-mgcache=1): the rebuilt cache in hex to the log ring, once it exists and its size held for ten seconds,
+ * read only. It shows the main-screen answers MobileGestalt gave this display.
+ */
+static void
+coachz_mobilegestalt_cache_dump(void *parameter __unused, wait_result_t result __unused)
+{
+	static const char path[] = "/private/var/containers/Shared/SystemGroup/"
+	    "systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist";
+	static const char digits[] = "0123456789abcdef";
+	vfs_context_t context = vfs_context_kernel();
+	uint64_t last = 0;
+
+	for (int tries = 0; tries < 60; tries++) {
+		struct vnode_attr attributes;
+		vnode_t vnode = NULLVP;
+		uint64_t size = 0;
+		char line[2 * 48 + 1];
+		char *data;
+		int error, residual = 0;
+
+		delay(10 * 1000 * 1000);
+		if (vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vnode, context)) {
+			continue;
+		}
+		VATTR_INIT(&attributes);
+		VATTR_WANTED(&attributes, va_data_size);
+		if (!vnode_getattr(vnode, &attributes, context) && VATTR_IS_SUPPORTED(&attributes, va_data_size)) {
+			size = attributes.va_data_size;
+		}
+		if (!size || size > (1 << 20) || size != last) {
+			last = size;
+			vnode_close(vnode, FREAD, context);
+			continue;
+		}
+		data = kalloc_data((size_t)size, Z_WAITOK);   /* no Z_NOFAIL: refused above the zone sizes */
+		if (!data) {
+			vnode_close(vnode, FREAD, context);
+			printf("COACHZ mg: no %llu-byte buffer\n", (unsigned long long)size);
+			return;
+		}
+		error = vn_rdwr(UIO_READ, vnode, data, (int)size, 0, UIO_SYSSPACE, 0, vfs_context_ucred(context), &residual,
+		    vfs_context_proc(context));
+		vnode_close(vnode, FREAD, context);
+		printf("COACHZ mg: cache %llu bytes, read %d residual %d\n", (unsigned long long)size, error, residual);
+		for (uint64_t at = 0; !error && !residual && at < size; at += 48) {
+			unsigned count = size - at < 48 ? (unsigned)(size - at) : 48;
+			for (unsigned index = 0; index < count; index++) {
+				line[2 * index] = digits[(uint8_t)data[at + index] >> 4];
+				line[2 * index + 1] = digits[(uint8_t)data[at + index] & 15];
+			}
+			line[2 * count] = 0;
+			printf("COACHZ mg %05llx %s\n", (unsigned long long)at, line);
+		}
+		kfree_data(data, (size_t)size);
+		return;
+	}
+	printf("COACHZ mg: no settled cache in ten minutes\n");
+}
+
+static void
+coachz_mobilegestalt_cache_reset(void)
+{
+	static const char path[] = "/private/var/containers/Shared/SystemGroup/"
+	    "systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist";
+	int reset = 0, dump = 0;
+	thread_t thread;
+	int error;
+
+	coachz_calendar_from_ec();
+	coachz_icon_cache_reset();
+	if (!PE_parse_boot_argn("coachz-reset-mgcache", &reset, sizeof(reset)) || reset != 1) {
+		return;
+	}
+	if (PE_parse_boot_argn("coachz-dump-mgcache", &dump, sizeof(dump)) && dump == 1 &&
+	    kernel_thread_start(coachz_mobilegestalt_cache_dump, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	error = unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+	printf("COACHZ MobileGestalt cache removed: %d\n", error);
+}
