+
+/*
+ * coachz-oslog=1: the os_log of these processes reaches the disk log, not the screen. exec_extract_strings gives them
+ * OS_ACTIVITY_DT_MODE, which makes libtrace mirror os_log to stderr, and write and writev copy fds 1 and 2 here.
+ */
+extern void coachz_log_append(const char *bytes, size_t count);
+int coachz_oslog_match(const char *name);
+void coachz_oslog_write(const char *name, int pid, uint64_t address, uint64_t size);
+
+int
+coachz_oslog_match(const char *name)
+{
+	static const char *const names[] = {
+		"SpringBoard", "backboardd", "runningboardd", "lsd", "installd", "iconservicesagent", "splashboardd",
+		"Preferences", "MobileSMS", "MobileSafari", "MobileNotes", "MobileMail", "MobileSlideShow", "MobileCal",
+	};
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		unsigned value = 0;
+		enabled = PE_parse_boot_argn("coachz-oslog", &value, sizeof(value)) && value == 1;
+	}
+	if (enabled != 1) {
+		return 0;
+	}
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (!strcmp(name, names[i])) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+void
+coachz_oslog_write(const char *name, int pid, uint64_t address, uint64_t size)
+{
+	char line[768];
+	const int prefix = snprintf(line, sizeof(line), "@%s[%d] ", name, pid);
+	const uint64_t room = sizeof(line) - (uint64_t)prefix - 1;
+	uint32_t length = size > room ? (uint32_t)room : (uint32_t)size;
+
+	if (!length || copyin(address, line + prefix, length) || (length == 1 && line[prefix] == '\n')) {
+		return;
+	}
+	if (line[prefix + length - 1] != '\n') {
+		line[prefix + length++] = '\n';
+	}
+	coachz_log_append(line, (size_t)prefix + length);
+}
