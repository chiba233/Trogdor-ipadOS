  */
 char coachz_log_capture[1u << 20];
 volatile uint64_t coachz_log_head;
 
+/* User-space output for the disk log only: it never reaches the screen. */
 void
+coachz_log_append(const char *bytes, size_t count)
+{
+	uint64_t at = __atomic_fetch_add(&coachz_log_head, count, __ATOMIC_RELAXED);
+
+	for (size_t i = 0; i < count; i++) {
+		coachz_log_capture[(at + i) & ((1u << 20) - 1)] = bytes[i];
+	}
+}
