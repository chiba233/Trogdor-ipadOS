--- /dev/null
+++ b/iokit/Kernel/CoachzPMGR.cpp
@@ -0,0 +1,27 @@
+/*
+ * Coachz has no Apple power manager, but the original AMFI waits for an ApplePMGRNub on
+ * a thread call and panics ("AMFI: No PMGR?") when none appears. Its read and write go
+ * through the provider stored in the nub and do nothing without one, so a real nub with
+ * no provider satisfies it. The UniXNU sirius port found this approach. No PMGR hardware
+ * is touched.
+ */
+#include <IOKit/IOService.h>
+#include <libkern/OSKextLib.h>
+#include <libkern/c++/OSMetaClass.h>
+
+extern "C" void coachz_pmgr_publish(void);
+
+void
+coachz_pmgr_publish(void)
+{
+	OSReturn status = OSKextLoadKextWithIdentifier("com.apple.driver.ApplePMGR");
+	if (status != kOSReturnSuccess) {
+		panic("Coachz PMGR: ApplePMGR did not load: %x", status);
+	}
+	IOService *nub = OSDynamicCast(IOService, OSMetaClass::allocClassWithName("ApplePMGRNub"));
+	if (nub == NULL || !nub->init() || !nub->attach(IOService::getServiceRoot())) {
+		panic("Coachz PMGR: cannot create ApplePMGRNub");
+	}
+	nub->registerService();
+	nub->release();
+}
