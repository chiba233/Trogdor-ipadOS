 #endif /* CONFIG_FILE_LEASES */
+
+/*
+ * Coachz: the SystemOS volume is a native union over the root volume's "/" (kern_exec.c), so files under "/" come from two APFS
+ * volumes and getfsstat listed two mounts on "/". Userspace identifies a volume by its device id: LaunchServices, CoreServices'
+ * FileIDTree, launchd's feature flag store and fseventsd compare the number of a file with the one of the volume they enumerated.
+ * The union is reported as the root volume it covers, as UniXNU's macos-union-one-volume.patch does: getfsstat leaves it out and
+ * stat, statfs and getattrlist give the root volume's device id and fsid. MNT_ROOTFS, the mounts and the kernel's own view stay.
+ */
+mount_t coachz_union_identity(mount_t mp);
+int32_t coachz_union_devid(int32_t dev);
+fsid_t coachz_union_fsid(fsid_t fsid);
+
+mount_t
+coachz_union_identity(mount_t mp)
+{
+	if (mp != NULL && (mp->mnt_flag & MNT_UNION) && mp->mnt_vnodecovered != NULLVP &&
+	    (mp->mnt_vnodecovered->v_flag & VROOT) && (mp->mnt_vnodecovered->v_mount->mnt_flag & MNT_ROOTFS)) {
+		return mp->mnt_vnodecovered->v_mount;
+	}
+	return mp;
+}
+
+/* The same for a bare device id or fsid (getattrlistbulk packs entries without a vnode): the union's becomes the root volume's.
+ * rootvnode is the union's root once kern_exec.c has mounted it and does not change afterwards. */
+static mount_t
+coachz_union_on_root(void)
+{
+	vnode_t root = rootvnode;
+	mount_t mp = root ? root->v_mount : NULL;
+	return coachz_union_identity(mp) != mp ? mp : NULL;
+}
+
+int32_t
+coachz_union_devid(int32_t dev)
+{
+	mount_t mp = coachz_union_on_root();
+	if (mp && dev == mp->mnt_vfsstat.f_fsid.val[0]) {
+		return coachz_union_identity(mp)->mnt_vfsstat.f_fsid.val[0];
+	}
+	return dev;
+}
+
+fsid_t
+coachz_union_fsid(fsid_t fsid)
+{
+	mount_t mp = coachz_union_on_root();
+	if (mp && fsid.val[0] == mp->mnt_vfsstat.f_fsid.val[0] && fsid.val[1] == mp->mnt_vfsstat.f_fsid.val[1]) {
+		return coachz_union_identity(mp)->mnt_vfsstat.f_fsid;
+	}
+	return fsid;
+}
