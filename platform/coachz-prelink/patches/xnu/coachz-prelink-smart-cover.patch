+	void *interface = *reinterpret_cast<void **>(raw + 200);
+	uint8_t *reserved = *reinterpret_cast<uint8_t **>(raw + 256);
+	OSArray **slot = reserved ? reinterpret_cast<OSArray **>(reserved + 40) : nullptr;
+	OSArray *keyboard = slot ? *slot : nullptr;
