+IORegistryEntry *findEventDriver(IORegistryEntry *parent, unsigned depth) {
+	OSIterator *children = depth ? parent->getChildIterator(gIOServicePlane) : nullptr;
+	IORegistryEntry *found = nullptr;
+	if (children) {
+		while (OSObject *child = children->getNextObject()) {
+			IORegistryEntry *entry = OSDynamicCast(IORegistryEntry, child);
+			if (entry && entry->metaCast("IOHIDEventDriver")) {
+				found = entry;
+				break;
+			}
+			if (entry && (found = findEventDriver(entry, depth - 1))) {
+				break;
+			}
+		}
