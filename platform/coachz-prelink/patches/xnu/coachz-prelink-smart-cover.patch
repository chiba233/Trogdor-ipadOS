+/*
+ * MobileGestalt's cached answers, with hall-effect-sensor among them, carried in /chosen/coachz-mgcache (tools/xnu_screen.py --gestalt-cache). The
+ * capability decides whether backboardd makes its smart cover processor, and the cached CacheExtra answer is what MobileGestalt returns first.
+ */
+static void
+coachz_gestalt_cache_install(void)
+{
+	static const char path[] = "/private/var/containers/Shared/SystemGroup/"
+	    "systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist";
+	vfs_context_t context = vfs_context_kernel();
+	DTEntry chosen = NULL;
+	void const *data = NULL;
+	unsigned int size = 0;
+	vnode_t target = NULLVP;
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "coachz-mgcache", &data, &size) != kSuccess || !size) {
+		return;
+	}
+	error = vnode_open(path, O_CREAT | O_TRUNC | O_NOFOLLOW | FWRITE, 0644, 0, &target, context);
+	if (!error) {
+		struct vnode_attr attributes;
+
+		error = vn_rdwr(UIO_WRITE, target, __DECONST(caddr_t, data), (int)size, 0, UIO_SYSSPACE, IO_UNIT | IO_SYNC,
+		    vfs_context_ucred(context), NULL, vfs_context_proc(context));
+		if (!error) {
+			VATTR_INIT(&attributes);
+			VATTR_SET(&attributes, va_uid, 501);
+			VATTR_SET(&attributes, va_gid, 501);
+			VATTR_SET(&attributes, va_mode, 0644);
+			/* vnode_open leaves O_TRUNC to its caller: set the length explicitly. */
+			VATTR_SET(&attributes, va_data_size, (uint64_t)size);
+			error = vnode_setattr(target, &attributes, context);
+		}
+		vnode_close(target, FWRITE, context);
+	}
+	printf("COACHZ MobileGestalt cache: %u bytes carried: %d\n", size, error);
+}
