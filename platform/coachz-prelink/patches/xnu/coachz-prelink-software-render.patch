+
+/*
+ * coachz-null-call=1: iconservicesagent keeps running when it calls address 0. Without a GPU CoreImage still takes its OpenGL path
+ * (CIGLIsUsable always returns 1) and calls through an empty function table in CI::GLContext::init; UniXNU-sheng records the same
+ * crash. Every such call returns 0 to its caller. Settings waits on this agent for its icons, so its crash loop keeps Settings closed.
+ */
+int coachz_null_call_resume(arm_saved_state_t *state);
+
+int
+coachz_null_call_resume(arm_saved_state_t *state)
+{
+	static int enabled = -1;
+	static uint32_t logged;
+	void *bsd = get_bsdtask_info(current_task());
+	const uint64_t lr = get_saved_state_lr(state);
+
+	if (enabled < 0) {
+		unsigned value = 0;
+		enabled = PE_parse_boot_argn("coachz-null-call", &value, sizeof(value)) && value == 1;
+	}
+	/* The process's short name, cut to MAXCOMLEN characters. */
+	if (enabled != 1 || !bsd || !lr || strncmp(proc_name_address(bsd), "iconservicesagent", 16)) {
+		return 0;
+	}
+	if (logged < 32) {
+		char line[128];
+		const int used = snprintf(line, sizeof(line), "@nullcall iconservicesagent lr %llx slide 0x%x x1 %llx\n",
+		    (unsigned long long)lr, current_task()->task_shared_region_slide,
+		    (unsigned long long)get_saved_state_reg(state, 1));
+		logged++;
+		coachz_log_append(line, (size_t)used);
+	}
+	set_saved_state_reg(state, 0, 0);
+	set_saved_state_pc(state, lr);
+	return 1;
+}
