+/* The entries of a directory that start with prefix, leaving out those that start with a dot. */
+static int
+coachz_dir_names(const char *path, const char *prefix, char (*names)[64], unsigned max, unsigned *found)
+{
+	vfs_context_t ctx = vfs_context_current();
+	const size_t prefix_length = strlen(prefix);
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, 0, &vp, ctx);
+	int eof = 0;
+
+	*found = 0;
+	if (error) {
+		return error;
+	}
+	char *buffer = kalloc_data(4096, Z_WAITOK);
+	uio_t uio = buffer ? uio_create(1, 0, UIO_SYSSPACE, UIO_READ) : NULL;
+	if (!uio) {
+		error = ENOMEM;
+	}
+	while (!error && !eof && *found < max) {
+		int entries = 0;
+		uio_reset(uio, uio_offset(uio), UIO_SYSSPACE, UIO_READ);
+		uio_addiov(uio, CAST_USER_ADDR_T(buffer), 4096);
+		error = VNOP_READDIR(vp, uio, 0, &eof, &entries, ctx);
+		const size_t used = 4096 - (size_t)uio_resid(uio);
+		if (error || !used) {
+			break;
+		}
+		for (size_t at = 0; at + sizeof(struct dirent) - sizeof(((struct dirent *)0)->d_name) <= used && *found < max;) {
+			const struct dirent *entry = (const struct dirent *)(buffer + at);
+			if (!entry->d_reclen) {
+				break;
+			}
+			if (entry->d_namlen < 64 && entry->d_name[0] != '.' && !strncmp(entry->d_name, prefix, prefix_length)) {
+				memcpy(names[*found], entry->d_name, entry->d_namlen);
+				names[(*found)++][entry->d_namlen] = 0;
+			}
+			at += entry->d_reclen;
+		}
+	}
+	if (uio) {
+		uio_free(uio);
+	}
+	if (buffer) {
+		kfree_data(buffer, 4096);
+	}
+	vnode_put(vp);
+	return error;
+}
+
+static const char coachz_ls_marker[] = "/private/var/db/.coachz-ls-built";
+
+/* Called about every ten seconds from the kernel's sampling thread. */
+void coachz_staged_mark_built(void);
+void
+coachz_staged_mark_built(void)
+{
+	static bool done;
+	uint64_t now;
+	vnode_t vp = NULLVP;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+	if (done || now < 300 * NSEC_PER_SEC || !coachz_staged_enabled()) {
+		return;
+	}
+	done = true;
+	const int error = vnode_open(coachz_ls_marker, O_CREAT | O_NOFOLLOW | FWRITE, 0644, 0, &vp, vfs_context_kernel());
+	if (!error) {
+		(void)vnode_close(vp, FWRITE, vfs_context_kernel());
+	}
+	printf("COACHZ staged apps: LaunchServices database kept from now on: %d\n", error);
+}
+
+static void
+coachz_staged_apps_prepare(proc_t p, user_addr_t scratch)
+{
+	static const char parent[] = "/private/var/mobile/Containers/Data/InternalDaemon", prefix[] = "com.apple.LaunchServices-";
+	static const char semaphore[] = "com.apple.lsd.firstboot";
+	char (*containers)[64] = kalloc_data(128 * 64, Z_WAITOK), (*files)[64] = kalloc_data(8 * 64, Z_WAITOK);
+	char *path = kalloc_data(256, Z_WAITOK);
+	unsigned count = 0, removed = 0, looked = 0;
+	int semaphore_error, moved = 0, moved_store = 0, rebuilt = 1;
+	vnode_t marker_vp = NULLVP;
+
+	if (!coachz_staged_enabled()) {
+		goto done;
+	}
+	/* The placeholders an earlier migration left on this Data have the bundle identifiers of the real apps now in /Applications,
+	 * and lsd restored them as "Waiting" installs. They move aside once and stay on the volume. */
+	moved = coachz_rename_path("/private/var/containers/Bundle/Application", "/private/var/containers/Bundle/coachz-placeholders");
+	moved_store = coachz_rename_path("/private/var/mobile/tmp/com.apple.installcoordinationd", "/private/var/mobile/tmp/coachz-installcoordinationd");
+	/* lsd registers system apps only when it builds its database, about 70 s behind the Apple logo here. It writes the database back
+	 * lazily, so the marker comes after five minutes of uptime (coachz_staged_mark_built): a boot cut short rebuilds again. */
+	if (!vnode_lookup(coachz_ls_marker, 0, &marker_vp, vfs_context_current())) {
+		vnode_put(marker_vp);
+		rebuilt = 0;
+	}
+	if (rebuilt && containers && files && path && !coachz_dir_names(parent, "", containers, 128, &count)) {
+		for (unsigned i = 0; i < count; ++i) {
+			unsigned n = 0;
+			snprintf(path, 256, "%s/%s/Library/Caches", parent, containers[i]);
+			if (coachz_dir_names(path, prefix, files, 8, &n)) {
+				continue;
+			}
+			looked++;
+			for (unsigned j = 0; j < n; ++j) {
+				struct unlink_args request = {.path = scratch + 0xc00};
+				int32_t unlink_result = 0;
+				snprintf(path, 256, "%s/%s/Library/Caches/%s", parent, containers[i], files[j]);
+				if (!copyout(path, request.path, strlen(path) + 1) && !unlink(p, &request, &unlink_result)) {
+					removed++;
+				}
+			}
+		}
+	}
+	semaphore_error = copyout(semaphore, scratch + 0xc00, sizeof(semaphore));
+	if (!semaphore_error) {
+		struct sem_open_args open_request = {.name = scratch + 0xc00, .oflag = O_CREAT, .mode = 0444, .value = 0};
+		user_addr_t handle = 0;
+		semaphore_error = sem_open(p, &open_request, &handle);
+		if (!semaphore_error) {
+			struct sem_close_args close_request = {.sem = handle};
+			int32_t close_result = 0;
+			semaphore_error = sem_close(p, &close_request, &close_result);
+		}
+	}
+	printf("COACHZ staged apps: union stage %d status %d; placeholders moved %d, install store %d; LaunchServices rebuild %d, files removed %u (%u caches of %u containers); first boot mark %d\n",
+	    coachz_staged_stage, coachz_staged_status, moved, moved_store, rebuilt, removed, looked, count, semaphore_error);
+done:
+	if (containers) {
+		kfree_data(containers, 128 * 64);
+	}
+	if (files) {
+		kfree_data(files, 8 * 64);
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+}
