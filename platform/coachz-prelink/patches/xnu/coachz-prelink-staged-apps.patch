+#include <sys/dirent.h>
+/*
+ * The deletable system apps (Weather, Calendar, Notes, Maps, ...) ship in the OS volume's /private/var/staged_system_apps; a restore
+ * copies them to Data and the first boot's migration installs them. This Data skips the migration (coachz-skip-setup: it took about an
+ * hour here), so only their placeholders existed: cloud badges and "Waiting...". As Droid-VM does on the same OS build (BSD-2-Clause-
+ * Patent), the sealed directory is shown as a read-only union over /Applications while /private/var still resolves to the OS volume;
+ * the apps then register as built-in system apps and their code is in the static trust cache with the rest of the OS. lsd drops the
+ * apps of every other volume on its first start of a boot, and skips that when the named semaphore com.apple.lsd.firstboot exists; it
+ * registers system apps only when it builds its database, and writes the database back lazily, so a hard reset can keep one without
+ * them: the database is removed at every boot, and lsd rebuilds it. Nothing here is fatal.
+ */
+static volatile int coachz_staged_stage, coachz_staged_status = -1;
+
+static bool
+coachz_staged_enabled(void)
+{
+	int enabled = 0;
+	return PE_parse_boot_argn("coachz-skip-setup", &enabled, sizeof(enabled)) && enabled == 1;
+}
+
+static void
+coachz_staged_apps_union(proc_t p, user_addr_t scratch)
+{
+	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
+
+	if (coachz_staged_enabled()) {
+		native_gpu_addon_mount(p, scratch, 0xc00, source, sizeof(source), point, sizeof(point), "/Applications/Preferences.app/Info.plist",
+		    "/Applications/Weather.app/Info.plist", &coachz_staged_stage, &coachz_staged_status);
+	}
+}
