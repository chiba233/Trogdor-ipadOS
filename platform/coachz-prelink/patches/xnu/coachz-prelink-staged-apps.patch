+/*
+ * Lookup by file ID (fsgetpath, volfs paths). LaunchServices records a bundle's files by volume and file ID and resolves them
+ * back through fsgetpath; without a vfs_vget every bundle seen through a bind mount came back unresolvable, so it was registered
+ * with no platform and its plug-ins with no extension point (a widget extension then looks "restricted" to chronod). bindfs
+ * reports the lower file system's file IDs, so: get the lower vnode, take its path relative to the bound root, and look that
+ * path up from our root -- the vnode returned is ours, named and parented under the mount point, as build_path needs. An ID
+ * outside the bound tree is not found.
+ */
+static int
+bindfs_vget(struct mount * mp, ino64_t ino, struct vnode ** vpp, vfs_context_t ctx)
+{
+	struct bind_mount * bindm = MOUNTTOBINDMOUNT(mp);
+	vnode_t lowervp = NULLVP;
+	char * lowerpath = NULL;
+	char * rootpath = NULL;
+	const char * relative = NULL;
+	size_t rootlen;
+	int len, error;
+
+	*vpp = NULLVP;
+	if (bindm == NULL || bindm->bindm_rootvp == NULLVP || bindm->bindm_lowerrootvp == NULLVP) {
+		return ENOTSUP;
+	}
+	error = VFS_VGET(vnode_mount(bindm->bindm_lowerrootvp), ino, &lowervp, ctx);
+	if (error) {
+		return error;
+	}
+	if (lowervp == bindm->bindm_lowerrootvp) {
+		vnode_put(lowervp);
+		error = vnode_get(bindm->bindm_rootvp);
+		if (error == 0) {
+			*vpp = bindm->bindm_rootvp;
+		}
+		return error;
+	}
+	lowerpath = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_NOFAIL);
+	rootpath = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_NOFAIL);
+	len = MAXPATHLEN;
+	error = vn_getpath(lowervp, lowerpath, &len);
+	vnode_put(lowervp);
+	if (error == 0) {
+		len = MAXPATHLEN;
+		error = vn_getpath(bindm->bindm_lowerrootvp, rootpath, &len);
+	}
+	if (error == 0) {
+		rootlen = strlen(rootpath);
+		if (rootlen == 1 && rootpath[0] == '/') {
+			relative = lowerpath + 1;
+		} else if (strncmp(lowerpath, rootpath, rootlen) == 0 && lowerpath[rootlen] == '/') {
+			relative = lowerpath + rootlen + 1;
+		}
+		error = relative && *relative ? vnode_lookupat(relative, VNODE_LOOKUP_NOFOLLOW, vpp, ctx, bindm->bindm_rootvp) : ENOENT;
+	}
+	kfree_data(lowerpath, MAXPATHLEN);
+	kfree_data(rootpath, MAXPATHLEN);
+	return error;
+}
