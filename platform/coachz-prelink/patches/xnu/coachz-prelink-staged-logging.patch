+/* fseventsd never finishes starting ("Could not open logging directory <1> ... dev[16777231]", then "No global disk logger state?!"),
+ * so FSEventsCopyUUIDForDevice fails and LocalStorageFileProvider has no volume UUID for the Data volume: the Files app lists nothing.
+ * fseventsd refuses a mount whose <mount>/.fseventsd opens on another file system, or a mount on / that is neither read-only nor the
+ * root file system. Which mount that is needs the mount table as the system sees it: printed once, a minute after boot. */
+static int
+coachz_print_mount(mount_t mp, void *arg)
+{
+	struct vfsstatfs *sp = vfs_statfs(mp);
+	unsigned *n = arg;
+	printf("COACHZ mounts: %u %s on %s type %s fsid 0x%x flags 0x%llx\n", (*n)++, sp->f_mntfromname, sp->f_mntonname, sp->f_fstypename,
+	    (unsigned)sp->f_fsid.val[0], (unsigned long long)vfs_flags(mp));
+	return VFS_RETURNED;
+}
 
