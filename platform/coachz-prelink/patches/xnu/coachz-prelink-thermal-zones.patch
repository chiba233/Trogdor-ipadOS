+/*
+ * The board's thermistors behind the PM6150 ADC (USID 0, peripheral 0x31 at 0x3100), read over the SPMI PMIC arbiter v5 as mainline
+ * does (drivers/spmi/spmi-pmic-arb.c: the APID map at core 0x900 + 4n, the owner EE at cnfg 0x700 + 4n, reads through the observer
+ * channel at obsrvr + 0x80 * apid, writes through chnls + 0x10000 * apid, command (opc << 27) | (addr & 0xff) << 4 | (bytes - 1),
+ * STATUS bit 0 done with bits 1-3 failure, denied, dropped; sc7180.dtsi spmi@c440000, qcom,ee 0) and converted as
+ * drivers/iio/adc/qcom-spmi-adc5.c's adc5_do_conversion does for a ratiometric channel (registers 0x42-0x47 read, decimation 840
+ * (index 2), one sample, hw settle 200 us (index 2), calibration ratiometric with the timer value, channel, enable, request; then
+ * STATUS1 polled for EOC, DATA0/1). qcom-vadc-common.c's qcom_vadc_scale_hw_calib_therm turns the code into mV (1875 mV over full
+ * scale 0x70e4) and maps it through the NTCG104EF104 100k pull-up table. The only SPMI writes this file can make are those six
+ * registers of that peripheral, and only through an APID this EE owns.
+ */
+#define SPMI_CORE_PA  0x0c440000ull
+#define SPMI_CHNLS_PA 0x0c600000ull
+#define SPMI_OBSRVR_PA 0x0e600000ull
+#define SPMI_CNFG_PA  0x0c40a000ull
+#define ADC_PPID      0x031u
+static vm_offset_t spmi_core, spmi_obs, spmi_cnfg, spmi_chnl;
+static uint16_t adc_apid;
+static int pmic_state;          /* 0 untried, 1 ready, -1 unavailable */
+
+static const struct { int16_t mv; int32_t mc; } ntc_100k_1875[] = {
+    {1831, -40000}, {1814, -35000}, {1791, -30000}, {1761, -25000}, {1723, -20000}, {1675, -15000}, {1616, -10000}, {1545, -5000},
+    {1463, 0}, {1370, 5000}, {1268, 10000}, {1160, 15000}, {1049, 20000}, {937, 25000}, {828, 30000}, {726, 35000}, {630, 40000},
+    {544, 45000}, {467, 50000}, {399, 55000}, {340, 60000}, {290, 65000}, {247, 70000}, {209, 75000}, {179, 80000}, {153, 85000},
+    {130, 90000}, {112, 95000}, {96, 100000}, {82, 105000}, {71, 110000}, {62, 115000}, {53, 120000}, {46, 125000},
+};
+
+static inline uint32_t mmio_r(vm_offset_t base, uint32_t off) { uint32_t v = *(volatile uint32_t *)(base + off); __asm__ volatile ("dmb oshld" ::: "memory"); return v; }
+static inline void mmio_w(vm_offset_t base, uint32_t off, uint32_t v) { __asm__ volatile ("dmb oshst" ::: "memory"); *(volatile uint32_t *)(base + off) = v; }
+
+static int
+spmi_wait(vm_offset_t base, uint32_t off)
+{
+    for (unsigned i = 0; i < 1000; i++) {
+        const uint32_t status = mmio_r(base, off + 0x08);
+        if (status & 1u) return (status & 0xeu) ? -(int)status : 0;
+        delay(1);
     }
+    return -1;
 }
 
+static int
+spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+    const uint32_t off = 0x80u * adc_apid;
+    if ((addr >> 8) != (ADC_PPID & 0xff) || !len || len > 8) return -1;
+    mmio_w(spmi_obs, off, (1u << 27) | ((addr & 0xffu) << 4) | (len - 1));   /* EXT_READL */
+    const int e = spmi_wait(spmi_obs, off);
+    if (e) return e;
+    const uint32_t d0 = mmio_r(spmi_obs, off + 0x18), d1 = len > 4 ? mmio_r(spmi_obs, off + 0x1c) : 0;
+    for (unsigned i = 0; i < len; i++) buf[i] = (uint8_t)((i < 4 ? d0 >> (8 * i) : d1 >> (8 * (i - 4))) & 0xffu);
+    return 0;
+}
+
+static int
+spmi_write_adc_config(const uint8_t buf[6])
+{
+    /* EXT_WRITEL of 0x3142-0x3147 only. */
+    uint32_t d0 = 0, d1 = 0;
+    for (unsigned i = 0; i < 4; i++) d0 |= (uint32_t)buf[i] << (8 * i);
+    d1 = (uint32_t)buf[4] | (uint32_t)buf[5] << 8;
+    mmio_w(spmi_chnl, 0x10, d0);
+    mmio_w(spmi_chnl, 0x14, d1);
+    mmio_w(spmi_chnl, 0x00, (0u << 27) | (0x42u << 4) | 5u);
+    return spmi_wait(spmi_chnl, 0);
+}
+
+static int
+pmic_adc_init(void)
+{
+    spmi_core = ml_io_map(SPMI_CORE_PA, 0x2000);
+    spmi_cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+    spmi_obs = ml_io_map(SPMI_OBSRVR_PA, 0x10000);
+    if (!spmi_core || !spmi_cnfg || !spmi_obs) return -1;
+    const uint32_t arb_version = mmio_r(spmi_core, 0), count = mmio_r(spmi_core, 0x4) & 0x7ffu;
+    if (arb_version < 0x50000000u || arb_version >= 0x70000000u) { printf("COACHZ thermal pmic: arbiter version 0x%x is not v5\n", arb_version); return -1; }
+    int found = -1;
+    unsigned owner = 0xff;
+    for (unsigned n = 0; n < count && 0x900u + 4u * n < 0x1100u; n++) {
+        const uint32_t map = mmio_r(spmi_core, 0x900u + 4u * n);
+        if (!map || ((map >> 8) & 0xfffu) != ADC_PPID) continue;
+        const unsigned ee = mmio_r(spmi_cnfg, 0x700u + 4u * n) & 7u;
+        /* pmic_arb_read_apid_map_v5: the first mapping, or the one this EE (0) owns. */
+        if (found < 0 || ee == 0) { found = (int)n; owner = ee; }
+    }
+    if (found < 0 || owner != 0) { printf("COACHZ thermal pmic: ADC ppid 0x%x apid %d owner %u, not ours\n", ADC_PPID, found, owner); return -1; }
+    adc_apid = (uint16_t)found;
+    spmi_chnl = ml_io_map(SPMI_CHNLS_PA + 0x10000ull * adc_apid, 0x1000);
+    if (!spmi_chnl) return -1;
+    uint8_t rev[2] = {0};
+    const int e = spmi_read(0x3100, rev, 2);
+    printf("COACHZ thermal pmic: arbiter 0x%x, %u apids, ADC apid %u, revision %u.%u (%d)\n", arb_version, count, adc_apid, rev[1], rev[0], e);
+    return e;
+}
