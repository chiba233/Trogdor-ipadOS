+/* adc5_do_conversion for one ratiometric 100k pull-up thermistor channel, then qcom_vadc_scale_hw_calib_therm. */
+static int
+pmic_adc_read(uint8_t channel, int32_t *milli_c)
+{
+    uint8_t cfg[6], st = 0, lo = 0, hi = 0;
+    int e = spmi_read(0x3142, cfg, 6);
+    if (e) return e;
+    cfg[0] = (uint8_t)((cfg[0] & ~0x7cu) | (1u << 4) | (2u << 2));   /* cal_val timer (0), cal_sel ratiometric (1), decimation 2 */
+    cfg[1] = (uint8_t)(cfg[1] & ~0x07u);                              /* one sample */
+    cfg[2] = channel;
+    cfg[3] = (uint8_t)((cfg[3] & ~0x0fu) | 2u);                       /* 200 us */
+    cfg[4] |= 0x80u;
+    cfg[5] |= 0x80u;
+    if ((e = spmi_write_adc_config(cfg))) return e;
+    unsigned tries = 0;
+    for (; tries < 400; tries++) {
+        if ((e = spmi_read(0x3108, &st, 1))) return e;
+        if ((st & 3u) == 1u) break;
+        delay(264);
+    }
+    if (tries == 400) return -2;
+    if ((e = spmi_read(0x3150, &lo, 1)) || (e = spmi_read(0x3151, &hi, 1))) return e;
+    uint32_t code = (uint32_t)hi << 8 | lo;
+    if (code == 0x8000u) return -3;
+    if (code > 0x7fffu) code = 0;
+    const int32_t mv = (int32_t)((uint64_t)code * 1875u * 1000u / 0x70e4u / 1000u);
+    const unsigned n = sizeof(ntc_100k_1875) / sizeof(ntc_100k_1875[0]);
+    unsigned i = 0;
+    while (i < n && ntc_100k_1875[i].mv > mv) i++;
+    if (i == 0) *milli_c = ntc_100k_1875[0].mc;
+    else if (i == n) *milli_c = ntc_100k_1875[n - 1].mc;
+    else {
+        const int32_t x0 = ntc_100k_1875[i - 1].mv, y0 = ntc_100k_1875[i - 1].mc, x1 = ntc_100k_1875[i].mv, y1 = ntc_100k_1875[i].mc;
+        *milli_c = (y0 == y1 || mv == x0) ? y0 : (x1 == x0 || mv == x1) ? y1 : y0 + (y1 - y0) * (mv - x0) / (x1 - x0);
+    }
+    return 0;
+}
