+/*
+ * Coachz touchscreen (coachz-touch=1): the Goodix GT7375P on QUPv3 wrap0 SE4 as HID over I2C.
+ * The device side is a port of Linux's drivers/hid/i2c-hid: i2c-hid-of-goodix.c's power-up for this part (reset asserted, 10 ms,
+ * reset released, 180 ms), then i2c-hid-core.c's probe: the address probed, the HID descriptor read, the interrupt set up, the
+ * reset handshake (SET_POWER ON and 60 ms, RESET, the device's empty reset response awaited for up to a second, SET_POWER ON
+ * and 60 ms again), the report descriptor read. After that every interrupt reads exactly one input report of wMaxInputLength
+ * bytes, as i2c_hid_get_input does, and nothing is ever read while the controller does not ask for it. The interrupt is the
+ * TLMM's level-low GPIO9 interrupt through its summary line (GIC SPI 208), handled as Linux's handle_level_irq with a threaded
+ * one-shot handler: masked and acknowledged in the interrupt (pinctrl-msm.c msm_gpio_irq_mask/ack), unmasked after the read.
+ * Fingers go to ShengHidInput's touch digitizer (platform/coachz-prelink/package/CoachzHid.cpp) through its seqlock
+ * interface (native_touch_*). The FIFO-mode GENI I2C engine is adapted from ios-sweet's
+ * bsd/dev/sweet_touch.c (MIT, Copyright (c) 2026 dipa-studio), which drove a Goodix controller on another
+ * Qualcomm SoC's GENI I2C on hardware.
+ *
+ * Board facts, from Linux mainline sc7180-trogdor(-coachz).dtsi and Coreboot's sc7180 sources:
+ *   i2c4 = SE4 at 0x890000, 400 kHz, SDA/SCL on GPIO115/116 (WEST tile, function 1, external pull-ups, 2 mA);
+ *   touchscreen@5d: interrupt GPIO9 level low with pull-up, reset GPIO8 active low (8 mA), both on the NORTH tile;
+ *   vdd is pp3300_ts, the eDP panel rail (GPIO67 on Coachz), already on while the panel shows a picture;
+ *   GCC: QUP votes in 0x52008 (wrap0 m_ahb 6, s_ahb 7, core 8, core_2x 9, S4 14); S4 branch 0x174f0, its DFS
+ *   command 0x17508 and performance level 0 at 0x17510. Coreboot loads the SE's I2C firmware and enables DFS.
+ * The HID descriptor address 0x0001 and the reset timing are those Linux's i2c-hid-of-goodix uses for this part.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern uint64_t coachz_io_submap_bytes; /* osfmk/arm/io_map.c */
+extern kern_return_t thread_terminate(thread_t);
+extern void coachz_hid_touch_start(void);
+void coachz_touch_start(void);
+void native_touch_set_sink(void (*)(void *), void *);
+
+#define GCC_PA          0x00100000u
+#define GCC_VOTE        0x52008u
+#define GCC_VOTE_BITS   ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 14))
+#define GCC_S4_CBCR     0x174f0u
+#define GCC_S4_DFS_CMD  0x17508u
+#define GCC_S4_DFS_L0   0x17510u
+#define TLMM_NORTH_PA   0x03900000u
+#define TLMM_WEST_PA    0x03500000u
+#define GPIO_CFG(n)     ((uint32_t)(n) * 0x1000u)
+#define GPIO_IO(n)      (GPIO_CFG(n) + 4u)
+#define GPIO_INTR_CFG(n)    (GPIO_CFG(n) + 8u)
+#define GPIO_INTR_STATUS(n) (GPIO_CFG(n) + 0xcu)
+/* pinctrl-sc7180.c: enable bit 0, polarity 1, detection 3:2, raw status 4, target 7:5 (3 = the apps processor). */
+#define INTR_ENABLE     (1u << 0)
+#define INTR_RAW        (1u << 4)
+#define INTR_TARGET     (3u << 5)
+#define TLMM_SUMMARY_INTID (32u + 208u)
+#define GICD_PA         0x17a00000u
+#define GICD_ISPENDR(n) (0x200u + ((n) / 32u) * 4u)
+#define GICD_ICENABLER(n) (0x180u + ((n) / 32u) * 4u)
+#define SE4_PA          0x00890000u
+#define TOUCH_ADDR      0x5d
+#define HID_DESC_REG    0x0001u
+
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL  0x024u
+#define SE_CGC_CTRL     0x028u
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_IF_DISABLE   0x064u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_SCL          0x278u
+#define SE_BYTE_GRAN    0x254u
+#define SE_DMA          0x258u
+#define SE_TX_PACK0     0x260u
+#define SE_TX_PACK1     0x264u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_RX_PACK0     0x284u
+#define SE_RX_PACK1     0x288u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_S_IRQ_EN     0x644u
+#define SE_S_IRQ_CLR    0x648u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM        0x810u
+#define SE_RX_RFR       0x814u
+#define SE_GSI_EVENT_EN 0xe18u
+#define SE_IRQ_ROUTE    0xe1cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DMA_CFG      0xe30u
+
+#define SE_DONE         (1u << 0)
+#define SE_ABORT_DONE   (1u << 5)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* Linux geni_se_config_packing(8, 4, true): MSB first on the wire, the first byte in the FIFO word's low bits. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+#define MAX_TX          8u
+#define MAX_RX          4096u
+
+static uint16_t
+le16_at(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+/* For the periodic report (osfmk/arm64/coachz_thread.c). */
+char coachz_touch_status[3][160];
+volatile uint32_t coachz_touch_reports;
+
+/*
+ * ShengHidInput's producer interface: the current finger set, odd sequence while it is written, in its units (x 0..30480 along
+ * the 2160-pixel side, y 0..20320). The digitizer calls native_touch_set_sink once started and is notified after each frame.
+ */
+volatile uint32_t native_touch_seq, native_touch_count, native_touch_hid_reports;
+volatile int native_touch_xs[12], native_touch_ys[12], native_touch_ids[12];
+static void (*volatile touch_sink)(void *);
+static void *volatile touch_sink_context;
+
+void
+native_touch_set_sink(void (*sink)(void *), void *context)
+{
+	touch_sink_context = context;
+	__atomic_store_n(&touch_sink, sink, __ATOMIC_RELEASE);
+}
+
+/*
+ * Report 1 of this controller's descriptor (read from the part, the same 1193 bytes Debian's sysfs shows): five contacts of eight bytes,
+ * each tip switch in bit 0 and pressure in bits 7:1 of its first byte, confidence in bit 0 and the contact identifier in bits 7:1 of the
+ * second, X (0..12960) and Y (0..8640) little endian, width and height; then the contact count. 12960 x 8640 is six times the 2160 x 1440
+ * panel. No scan time and no in-range usage.
+ */
+#define REPORT_FINGERS 5
+#define FRAME_CONTACTS 10
+/*
+ * coachz-touch-flip: bit 0 mirrors x, bit 1 mirrors y, bit 2 swaps the axes (applied after mirroring), so the panel orientation
+ * can be matched from a boot argument alone. The stroke record keeps raw controller coordinates for that decision.
+ */
+static unsigned touch_flip;
+static uint32_t stroke_count, stroke_frames;
+static int stroke_first[2] = { -1, -1 }, stroke_last[2] = { -1, -1 };
+char coachz_touch_stroke[160];
+/* What the latest frame left down: the contacts with their tip switch set, since when, and when a report last arrived. When the
+ * interface stops answering, these say whether the controller still reports a finger down (one never lifted) or nothing at all. */
+static volatile uint32_t touch_down_now, touch_down_most;
+static volatile uint64_t touch_down_since, touch_report_at;
+
+/*
+ * Frames as hid-multitouch.c assembles them for this part's class (Debian binds hid-multitouch with quirks 0x51c10, MT_CLS_WIN_8:
+ * ALWAYS_VALID, IGNORE_DUPLICATES, HOVERING, CONTACT_CNT_ACCURATE, STICKY_FINGERS, WIN8_PTP_BUTTONS; mt_touch_input_mapping adds
+ * CONFIDENCE for a Win8 touch screen with a confidence usage). mt_touch_report: a nonzero contact count is the number of contacts the
+ * frame holds; a zero count continues the frame (more than five contacts come in several reports); only that many slots are contacts
+ * (the rest of a report is not), a contact identifier seen twice in a frame is skipped, and the frame is synced once all arrived, every
+ * contact it did not report being up (INPUT_MT_DROP_UNUSED). A contact without confidence is a palm (MT_TOOL_PALM): userspace ignores
+ * it, so it is not a finger of the digitizer here. With a contact down and no report for 100 ms every contact is released.
+ */
+static struct { int id; unsigned x, y; } frame_contact[FRAME_CONTACTS];
+static unsigned frame_count, frame_expected, frame_received;
+static uint8_t frame_seen[128], touch_active[128];
+static uint32_t frame_palms, frame_continued, frame_duplicates, frame_sticky;
+
+static void publish_frame(void);
+
+static void
+touch_report(const uint8_t *input)
+{
+	if (le16_at(input) < 3 + REPORT_FINGERS * 8 + 1 || input[2] != 1) {
+		return;
+	}
+	touch_report_at = mach_absolute_time();
+	const unsigned contact_count = input[3 + REPORT_FINGERS * 8];
+	if (contact_count > 0) {
+		frame_expected = contact_count;
+	} else if (frame_received) {
+		frame_continued++;
+	}
+	for (unsigned finger = 0; finger < REPORT_FINGERS; finger++) {
+		if (frame_received >= frame_expected) {
+			break;
+		}
+		const uint8_t *f = input + 3 + finger * 8;
+		const unsigned id = f[1] >> 1;
+		if (frame_seen[id]) {
+			frame_duplicates++;
+			continue;
+		}
+		frame_seen[id] = 1;
+		frame_received++;
+		touch_active[id] = f[0] & 1;
+		if (!(f[0] & 1)) {
+			continue;
+		}
+		if (!(f[1] & 1)) {
+			frame_palms++;
+			continue;
+		}
+		if (frame_count < FRAME_CONTACTS) {
+			unsigned rx = le16_at(f + 2), ry = le16_at(f + 4);
+			frame_contact[frame_count].id = (int)id;
+			frame_contact[frame_count].x = rx > 12960 ? 12960 : rx;
+			frame_contact[frame_count].y = ry > 8640 ? 8640 : ry;
+			frame_count++;
+		}
+	}
+	if (frame_received >= frame_expected) {
+		for (unsigned id = 0; id < 128; id++) {
+			if (!frame_seen[id]) {
+				touch_active[id] = 0;
+			}
+		}
+		publish_frame();
+		frame_count = frame_received = 0;
+		bzero(frame_seen, sizeof(frame_seen));
+	}
+}
+
+/* mt_release_contacts, from the sticky-fingers timer: an empty frame. */
+static void
+touch_release_all(void)
+{
+	frame_count = frame_received = 0;
+	bzero(frame_seen, sizeof(frame_seen));
+	bzero(touch_active, sizeof(touch_active));
+	frame_sticky++;
+	publish_frame();
+}
+
+static int
+touch_any_active(void)
+{
+	for (unsigned id = 0; id < 128; id++) {
+		if (touch_active[id]) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void
+publish_frame(void)
+{
+	unsigned count = 0;
+	int xs[FRAME_CONTACTS], ys[FRAME_CONTACTS], ids[FRAME_CONTACTS];
+	for (unsigned c = 0; c < frame_count; c++) {
+		const unsigned rx = frame_contact[c].x, ry = frame_contact[c].y;
+		if (!count) {
+			if (stroke_first[0] < 0) {
+				stroke_first[0] = (int)rx;
+				stroke_first[1] = (int)ry;
+				stroke_frames = 0;
+			}
+			stroke_last[0] = (int)rx;
+			stroke_last[1] = (int)ry;
+			stroke_frames++;
+		}
+		unsigned ux = (touch_flip & 1) ? 12960 - rx : rx, uy = (touch_flip & 2) ? 8640 - ry : ry;
+		ids[count] = frame_contact[c].id;
+		if (touch_flip & 4) {
+			xs[count] = (int)(uy * 30480u / 8640u);
+			ys[count] = (int)(ux * 20320u / 12960u);
+		} else {
+			xs[count] = (int)(ux * 30480u / 12960u);
+			ys[count] = (int)(uy * 20320u / 8640u);
+		}
+		count++;
+	}
+	const uint64_t at = mach_absolute_time();
+	if (count && !touch_down_now) {
+		touch_down_since = at;
+	}
+	if (count > touch_down_most) {
+		touch_down_most = count;
+	}
+	touch_down_now = count;
+	if (!count && stroke_first[0] >= 0) {
+		stroke_count++;
+		snprintf(coachz_touch_stroke, sizeof(coachz_touch_stroke),
+		    "K43 stroke %u: raw first %d,%d last %d,%d over %u frames (x 0..12960 along 2160 px, y 0..8640), flip %u",
+		    stroke_count, stroke_first[0], stroke_first[1], stroke_last[0], stroke_last[1], stroke_frames, touch_flip);
+		stroke_first[0] = -1;
+	}
+	uint32_t seq = native_touch_seq;
+	native_touch_seq = seq + 1;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	for (unsigned i = 0; i < count; i++) {
+		native_touch_xs[i] = xs[i];
+		native_touch_ys[i] = ys[i];
+		native_touch_ids[i] = ids[i];
+	}
+	native_touch_count = count;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	native_touch_seq = seq + 2;
+	void (*sink)(void *) = __atomic_load_n(&touch_sink, __ATOMIC_ACQUIRE);
+	if (sink) {
+		sink(touch_sink_context);
+	}
+}
+
+static struct {
+	vm_offset_t gcc, north, west, se;
+	bool dead;
+	uint32_t irq_seen;
+	unsigned sent, got;
+	uint8_t desc[30];
+	uint16_t report_length, report_reg, input_reg, max_input, command_reg, data_reg;
+	uint8_t report[MAX_RX];
+	uint8_t input[512];
+	bool reset_pending, started;
+	volatile uint32_t irqs, spurious, spurious_run, storm, pending;
+	vm_offset_t gicd;
+} st;
+static int touch_chan, touch_irq_chan;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* A short delay spins on the counter: a blocking delay costs a timer interrupt and a wake here. */
+static void
+spin_us(unsigned us)
+{
+	uint64_t hz, start, now;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(hz));
+	__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(start));
+	const uint64_t ticks = (hz ? hz : 19200000) * us / 1000000 + 1;
+	do {
+		__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r"(now));
+	} while (now - start < ticks);
+}
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(base, off) & mask)) {
+			return true;
+		}
+		spin_us(1);
+	}
+	return false;
+}
+
+/* TLMM config: pull 1:0 (0 none, 3 up), function 5:2, drive 8:6 ((mA / 2) - 1), output enable 9. */
+static void
+gpio_set(vm_offset_t tile, unsigned pin, unsigned func, unsigned pull, unsigned drive, bool out, bool high)
+{
+	if (out) {
+		/* Latch the level before enabling the output: reset is active low. */
+		wr(tile, GPIO_IO(pin), (rd(tile, GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = rd(tile, GPIO_CFG(pin)) & ~0x3ffu;
+	cfg |= pull | (func << 2) | (drive << 6) | (out ? 0x200u : 0u);
+	wr(tile, GPIO_CFG(pin), cfg);
+}
+
+static bool
+clocks_on(void)
+{
+	wr(st.gcc, GCC_VOTE, rd(st.gcc, GCC_VOTE) | GCC_VOTE_BITS);
+	if (!wait_clear(st.gcc, GCC_S4_CBCR, 1u << 31)) {
+		return false;
+	}
+	/* With DFS on, SE_CLK_SEL 0 selects level 0; it must be the 19.2 MHz XO undivided (source 0, divider field 1). */
+	if ((rd(st.gcc, GCC_S4_DFS_CMD) & 1u) && (rd(st.gcc, GCC_S4_DFS_L0) & 0x371fu) != 1u) {
+		return false;
+	}
+	return true;
+}
+
+static void
+engine_abort(void)
+{
+	wr(st.se, SE_CTRL, 2);
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (rd(st.se, SE_IRQ) & SE_ABORT_DONE) {
+			done = true;
+			break;
+		}
+		spin_us(1);
+	}
+	if (!done || !wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+	}
+	for (unsigned i = 0; i < 1024 && (rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)rd(st.se, SE_RX);
+	}
+	wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+	}
+}
+
+static uint32_t
+engine_irq(void)
+{
+	uint32_t irq = rd(st.se, SE_IRQ);
+	st.irq_seen |= irq;
+	return irq;
+}
+
+/* One FIFO message: a write of up to MAX_TX bytes, or a read of up to MAX_RX. stretch keeps the bus for a repeated start. */
+static int
+engine_msg(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	if (st.dead || nt > MAX_TX || nr > MAX_RX || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		return EBUSY;
+	}
+	st.sent = st.got = 0;
+	wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)TOUCH_ADDR << 9) | (stretch ? 4u : 0u));
+	uint64_t start = mach_absolute_time(), limit;
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &limit);
+	int err = ETIMEDOUT;
+	while (mach_absolute_time() - start < limit) {
+		uint32_t irq = engine_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				spin_us(1);
+				irq = engine_irq();
+			}
+			if ((irq & SE_DONE) && !(rd(st.se, SE_STATUS) & 1u) && !(rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			/* At most two words: the FIFO holds them (its depth is checked at init). */
+			for (unsigned at = 0; at < nt; at += 4) {
+				uint32_t word = 0;
+				for (unsigned j = 0; j < 4 && at + j < nt; ++j) {
+					word |= (uint32_t)tx[at + j] << (8u * j);
+				}
+				wr(st.se, SE_TX, word);
+			}
+			st.sent = nt;
+			wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		bool drained = count != 0;
+		while (count--) {
+			uint32_t word = rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining, so the last short word is not lost; a late error still wins. */
+		if (irq & SE_DONE) {
+			irq = engine_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			wr(st.se, SE_IRQ_CLR, irq);
+			return st.got == nr && st.sent == nt ? 0 : EIO;
+		}
+		wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		if (!drained) {
+			spin_us(2);
+		}
+	}
+	engine_abort();
+	return err;
+}
+
+/* An HID-over-I2C register read: the 16-bit register little endian, then a repeated-start read. */
+static int
+reg_read(uint16_t reg, uint8_t *buf, unsigned len)
+{
+	const uint8_t ptr[2] = { (uint8_t)reg, (uint8_t)(reg >> 8) };
+	int err = engine_msg(ptr, 2, NULL, 0, true);
+	return err ? err : engine_msg(NULL, 0, buf, len, false);
+}
+
+/* An HID-over-I2C command: command register, then the command's two bytes. */
+static int
+hid_command(uint8_t opcode, uint8_t low)
+{
+	const uint8_t cmd[4] = { (uint8_t)st.command_reg, (uint8_t)(st.command_reg >> 8), low, opcode };
+	return engine_msg(cmd, 4, NULL, 0, false);
+}
+
+static bool
+engine_init(void)
+{
+	uint32_t fw = rd(st.se, SE_FW), tx = rd(st.se, SE_HW_TX), rx = rd(st.se, SE_HW_RX);
+	/* Protocol 3 is I2C; the FIFOs must be 32 bits wide and at least two words deep. */
+	if (((fw >> 8) & 0xffu) != 3u || (rd(st.se, SE_IF_DISABLE) & 1u) || ((tx >> 24) & 0x3fu) != 32u ||
+	    ((rx >> 24) & 0x3fu) != 32u || ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u ||
+	    (rd(st.se, SE_STATUS) & 0x1001u)) {
+		return false;
+	}
+	wr(st.se, SE_GSI_EVENT_EN, 0);
+	wr(st.se, SE_IRQ_ROUTE, 0);           /* polled: no interrupt to the GIC */
+	wr(st.se, SE_S_IRQ_EN, 0);
+	wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	wr(st.se, SE_S_IRQ_CLR, 0xffffffffu);
+	wr(st.se, SE_DMA, 0);                 /* FIFO mode */
+	wr(st.se, SE_CGC_CTRL, rd(st.se, SE_CGC_CTRL) | 0x7fu);
+	wr(st.se, SE_DMA_CFG, rd(st.se, SE_DMA_CFG) | 0x0fu);
+	wr(st.se, SE_OUTPUT_CTRL, 0x7f);
+	wr(st.se, SE_FORCE_DEFAULT, 1);
+	wr(st.se, SE_CLK_SEL, 0);
+	/* 400 kHz from 19.2 MHz: divider 2, t_high 5, t_low 12, t_cycle 24 (Linux's geni_i2c_clk_map_19p2mhz). */
+	wr(st.se, SE_MCLK, (2u << 4) | 1u);
+	wr(st.se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	wr(st.se, SE_BYTE_GRAN, 0);
+	wr(st.se, SE_TX_PACK0, SE_PACK0);
+	wr(st.se, SE_TX_PACK1, SE_PACK1);
+	wr(st.se, SE_RX_PACK0, SE_PACK0);
+	wr(st.se, SE_RX_PACK1, SE_PACK1);
+	wr(st.se, SE_TX_WM, 0);
+	wr(st.se, SE_RX_WM, 0);
+	wr(st.se, SE_RX_RFR, ((rx >> 16) & 0x3fu) - 1u);
+	wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	return rd(st.se, SE_TX_PACK0) == SE_PACK0 && rd(st.se, SE_RX_PACK1) == SE_PACK1 &&
+	       !(rd(st.se, SE_TX_COUNT) & 0xfffffffu) && !(rd(st.se, SE_RX_COUNT) & 0x1ffffffu);
+}
+
+
+/* The TLMM summary interrupt, as pinctrl-msm.c's msm_gpio_irq_handler and handle_level_irq: GPIO9's latched status, then
+ * mask (enable and raw status off, so the level cannot latch again while masked) and acknowledge, and the thread is woken. */
+static void
+touch_irq(__unused void *context)
+{
+	if (!(rd(st.north, GPIO_INTR_STATUS(9)) & 1u)) {
+		st.spurious++;
+		/* The summary line is shared by every TLMM GPIO: another one left enabled by firmware would hold it asserted. */
+		if (++st.spurious_run > 10000 && st.gicd && !st.storm) {
+			wr(st.gicd, GICD_ICENABLER(TLMM_SUMMARY_INTID), 1u << (TLMM_SUMMARY_INTID % 32u));
+			st.storm = 1;
+		}
+		return;
+	}
+	st.spurious_run = 0;
+	wr(st.north, GPIO_INTR_CFG(9), rd(st.north, GPIO_INTR_CFG(9)) & ~(INTR_ENABLE | INTR_RAW));
+	wr(st.north, GPIO_INTR_STATUS(9), 0);
+	st.irqs++;
+	__atomic_store_n(&st.pending, 1, __ATOMIC_RELEASE);
+	thread_wakeup(&touch_irq_chan);
+}
+
+/* msm_gpio_irq_unmask. */
+static void
+irq_unmask(void)
+{
+	wr(st.north, GPIO_INTR_CFG(9), rd(st.north, GPIO_INTR_CFG(9)) | INTR_RAW | INTR_ENABLE);
+}
+
+/* Waits for the interrupt for at most ms; true when one is to be handled. The interrupt leaves a flag that only this takes, so one
+ * that comes between two waits is handled by the next (k99 compared counters and lost the reset response that way, masked for good). */
+static bool
+irq_wait(unsigned ms)
+{
+	if (__atomic_exchange_n(&st.pending, 0, __ATOMIC_ACQ_REL)) {
+		return true;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_irq_chan, THREAD_UNINT, deadline);
+	if (__atomic_load_n(&st.pending, __ATOMIC_ACQUIRE)) {
+		thread_wakeup(&touch_irq_chan);   /* it came before the wait was asserted: the block returns at once */
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+	return __atomic_exchange_n(&st.pending, 0, __ATOMIC_ACQ_REL) != 0;
+}
+
+/* i2c_hid_set_power: one retry after 400-500 us if the address is not acknowledged; 60 ms after PWR_ON. */
+static int
+set_power(bool on)
+{
+	int err = hid_command(0x08, on ? 0x00 : 0x01);
+	if (err && on) {
+		spin_us(500);
+		err = hid_command(0x08, 0x00);
+	}
+	if (!err && on) {
+		sleep_ms(60);
+	}
+	return err;
+}
+
+static unsigned resets_done, resets_unasked, input_errors, short_reads;
+
+/* i2c_hid_get_input: one read of wMaxInputLength bytes; length 0 is a (requested or not) reset completing. */
+static void
+get_input(void)
+{
+	const int err = engine_msg(NULL, 0, st.input, st.max_input, false);
+	if (err) {
+		input_errors++;
+		return;
+	}
+	const unsigned length = le16_at(st.input);
+	if (!length) {
+		if (st.reset_pending) {
+			st.reset_pending = false;
+			resets_done++;
+		} else {
+			resets_unasked++;
+		}
+		return;
+	}
+	if (length > st.max_input || length < 2) {
+		short_reads++;
+		return;
+	}
+	if (st.started && length > 2) {
+		coachz_touch_reports++;
+		touch_report(st.input);
+	}
+}
+
+static void
+touch_thread(__unused void *arg, __unused wait_result_t result)
+{
+	char *s0 = coachz_touch_status[0], *s1 = coachz_touch_status[1], *s2 = coachz_touch_status[2];
+	int err = 0;
+	extern int armcpu_spi_attach(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *);   /* ArmCpu.cpp, IOReturn */
+
+	snprintf(s0, 160, "K42 touch: mapping");
+	st.gcc = ml_io_map(GCC_PA, 0x60000);
+	st.north = ml_io_map(TLMM_NORTH_PA, 0x10000);
+	st.west = ml_io_map(TLMM_WEST_PA + GPIO_CFG(115), 0x2000) - GPIO_CFG(115);
+	st.se = ml_io_map(SE4_PA, 0x4000);
+	if (!st.gcc || !st.north || st.west == (vm_offset_t)-GPIO_CFG(115) || !st.se) {
+		snprintf(s0, 160, "K42 touch: MMIO mapping failed");
+		goto out;
+	}
+	/* What firmware left: votes, S4 branch, DFS, SE firmware and FIFOs, the pins, the interrupt level and its TLMM configuration. */
+	snprintf(s0, 160, "K42 touch: fw vote %x cbcr %x dfs %x/%x se fw %x status %x hw %x/%x pins 8 %x/%x 9 %x/%x intr %x/%x",
+	    rd(st.gcc, GCC_VOTE), rd(st.gcc, GCC_S4_CBCR), rd(st.gcc, GCC_S4_DFS_CMD), rd(st.gcc, GCC_S4_DFS_L0),
+	    rd(st.se, SE_FW), rd(st.se, SE_STATUS), rd(st.se, SE_HW_TX), rd(st.se, SE_HW_RX), rd(st.north, GPIO_CFG(8)),
+	    rd(st.north, GPIO_IO(8)), rd(st.north, GPIO_CFG(9)), rd(st.north, GPIO_IO(9)), rd(st.north, GPIO_INTR_CFG(9)),
+	    rd(st.north, GPIO_INTR_STATUS(9)));
+	if (!clocks_on()) {
+		snprintf(s1, 160, "K42 touch: clocks: cbcr %x dfs %x/%x", rd(st.gcc, GCC_S4_CBCR),
+		    rd(st.gcc, GCC_S4_DFS_CMD), rd(st.gcc, GCC_S4_DFS_L0));
+		goto out;
+	}
+	if (!engine_init()) {
+		snprintf(s1, 160, "K42 touch: SE4 not an idle I2C engine with 32-bit FIFOs: fw %x status %x hw %x/%x",
+		    rd(st.se, SE_FW), rd(st.se, SE_STATUS), rd(st.se, SE_HW_TX), rd(st.se, SE_HW_RX));
+		goto out;
+	}
+	/* The pins as the device tree has them; the interrupt masked while the controller resets. */
+	wr(st.north, GPIO_INTR_CFG(9), rd(st.north, GPIO_INTR_CFG(9)) & ~(INTR_ENABLE | INTR_RAW));
+	gpio_set(st.north, 9, 0, 3, 0, false, false);
+	gpio_set(st.west, 115, 1, 0, 0, false, false);
+	gpio_set(st.west, 116, 1, 0, 0, false, false);
+	/* i2c-hid-of-goodix: probed with reset asserted; vdd (pp3300_dx_edp, the panel rail on GPIO67) is already on with the panel;
+	 * post_power_delay_ms 10, reset released, post_gpio_reset_delay_ms 180. */
+	gpio_set(st.north, 8, 0, 0, 3, true, false);
+	sleep_ms(10);
+	gpio_set(st.north, 8, 0, 0, 3, true, true);
+	sleep_ms(180);
+	/* i2c_hid_probe_address: a one-byte read, again after 400 us. */
+	err = engine_msg(NULL, 0, st.input, 1, false);
+	if (err) {
+		spin_us(500);
+		err = engine_msg(NULL, 0, st.input, 1, false);
+	}
+	if (!err) {
+		err = reg_read(HID_DESC_REG, st.desc, sizeof(st.desc));
+	}
+	if (err) {
+		snprintf(s1, 160, "K42 touch: address probe / HID descriptor %d irq %x status %x int %x", err, st.irq_seen,
+		    rd(st.se, SE_STATUS), rd(st.north, GPIO_IO(9)));
+		goto out;
+	}
+	st.report_length = le16_at(st.desc + 4);
+	st.report_reg = le16_at(st.desc + 6);
+	st.input_reg = le16_at(st.desc + 8);
+	st.max_input = le16_at(st.desc + 10);
+	st.command_reg = le16_at(st.desc + 16);
+	st.data_reg = le16_at(st.desc + 18);
+	snprintf(s1, 160, "K42 touch: desc len %u bcd %x vid %04x pid %04x ver %x | report %u at %x, input %x max %u, cmd %x data %x",
+	    le16_at(st.desc), le16_at(st.desc + 2), le16_at(st.desc + 20), le16_at(st.desc + 22), le16_at(st.desc + 24),
+	    st.report_length, st.report_reg, st.input_reg, st.max_input, st.command_reg, st.data_reg);
+	if (le16_at(st.desc) != 30 || le16_at(st.desc + 2) != 0x0100 || !st.report_length || st.report_length > MAX_RX ||
+	    st.max_input < 2 || st.max_input > sizeof(st.input)) {
+		goto out;
+	}
+	/* i2c_hid_init_irq: GPIO9 level low (msm_gpio_irq_set_type: target the apps processor, raw status on, level, active low,
+	 * stale status cleared), the summary interrupt attached level-triggered, then unmasked. */
+	wr(st.north, GPIO_INTR_CFG(9), (rd(st.north, GPIO_INTR_CFG(9)) & ~((7u << 5) | (3u << 2) | (1u << 1) | INTR_ENABLE)) | INTR_TARGET | INTR_RAW);
+	wr(st.north, GPIO_INTR_STATUS(9), 0);
+	uint32_t readback = 0;
+	uint64_t router = 0;
+	/* With GPIO9 masked nothing of ours drives the summary line: pending now means another GPIO does, and it would never clear. */
+	st.gicd = ml_io_map(GICD_PA, 0x1000);
+	const bool foreign = st.gicd && (rd(st.gicd, GICD_ISPENDR(TLMM_SUMMARY_INTID)) & (1u << (TLMM_SUMMARY_INTID % 32u)));
+	if (!st.gicd || foreign) {
+		printf("K42 touch: TLMM summary interrupt %s, not attached\n", st.gicd ? "already pending from another GPIO" : "unmapped GIC");
+		goto out;
+	}
+	const int attached = armcpu_spi_attach(TLMM_SUMMARY_INTID, false, touch_irq, NULL, &readback, &router);
+	printf("K42 touch: TLMM summary interrupt %u attached 0x%x (gic 0x%x router 0x%llx), GPIO9 intr cfg %x\n", TLMM_SUMMARY_INTID,
+	    (unsigned)attached, readback, router, rd(st.north, GPIO_INTR_CFG(9)));
+	if (attached) {
+		goto out;
+	}
+	irq_unmask();
+	/* i2c_hid_hwreset: power on, reset, the reset response, power on again; then the report descriptor (i2c_hid_parse). */
+	err = set_power(true);
+	if (!err) {
+		st.reset_pending = true;
+		err = hid_command(0x01, 0x00);
+	}
+	if (!err) {
+		for (unsigned waited = 0; st.reset_pending && waited < 1000; waited += 50) {
+			if (irq_wait(50)) {
+				get_input();
+				irq_unmask();
+			}
+		}
+		if (st.reset_pending) {
+			printf("K42 touch: device did not ack reset within 1000 ms\n");
+			st.reset_pending = false;
+		}
+		err = set_power(true);
+	}
+	if (!err) {
+		err = reg_read(st.report_reg, st.report, st.report_length);
+	}
+	if (err) {
+		snprintf(s2, 160, "K42 touch: power / reset / report descriptor %d irq %x", err, st.irq_seen);
+		goto out;
+	}
+	printf("K42 touch: reset acknowledged %u, interrupts %u (spurious %u), report descriptor %u bytes\n", resets_done, st.irqs,
+	    st.spurious, st.report_length);
+	/* i2c_hid_start and open: reports go to the digitizer from now on. */
+	st.started = true;
+	coachz_hid_touch_start();
+	/* Every interrupt: one report read, then unmasked (the line, still low, interrupts again). A line per second with input. */
+	extern volatile uint64_t native_gop_gpu_completions __attribute__((weak));
+	/* ShengHidInput (patches/feeds): what its event driver handed backboardd (collections, fingers, identifiers held touched,
+	 * duplicates, hands, touches begun twice, untouches without a touch, cancels). */
+	extern volatile uint32_t coachz_hid_observed[8] __attribute__((weak));
+	uint32_t irqs_last = st.irqs, reports_last = coachz_touch_reports, hid_last = native_touch_hid_reports, spurious_last = st.spurious;
+	unsigned errors_last = 0, unasked_last = 0, short_last = 0, quiet = 0;
+	uint64_t frames_last = &native_gop_gpu_completions ? native_gop_gpu_completions : 0, second_start = mach_absolute_time(), one_second;
+	uint64_t heartbeat = second_start, interval, sticky;
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &sticky);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &one_second);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &interval);
+	for (;;) {
+		if (irq_wait(100)) {
+			get_input();
+			irq_unmask();
+		}
+		const uint64_t now = mach_absolute_time();
+		/* MT_QUIRK_STICKY_FINGERS: a contact down and no report for 100 ms. */
+		if (now - touch_report_at >= sticky && touch_any_active()) {
+			touch_release_all();
+		}
+		if (now - second_start >= one_second) {
+			const uint32_t irqs = st.irqs - irqs_last, reports = coachz_touch_reports - reports_last;
+			const unsigned problems = (input_errors - errors_last) + (resets_unasked - unasked_last) + (short_reads - short_last) +
+			    (st.spurious - spurious_last);
+			if (irqs || problems || !quiet) {
+				const uint64_t frames = &native_gop_gpu_completions ? native_gop_gpu_completions : 0;
+				uint64_t held = 0;
+				if (touch_down_now) {
+					absolutetime_to_nanoseconds(now - touch_down_since, &held);
+				}
+				printf("K45 touch 1s: interrupts %u, reports %u to HID %u, frames %llu, read errors %u, unasked resets %u, bad lengths %u, "
+				    "spurious %u%s, line %s, intr cfg %x, down %u for %llu ms (most %u), strokes %u, palms %u continued %u duplicates %u "
+				    "sticky %u | hid out %u fingers %u held %u dup %u hand %u rebegin %u lone up %u cancel %u\n", irqs, reports,
+				    native_touch_hid_reports - hid_last, frames - frames_last, input_errors - errors_last, resets_unasked - unasked_last,
+				    short_reads - short_last, st.spurious - spurious_last, st.storm ? " (storm: interrupt disabled)" : "",
+				    (rd(st.north, GPIO_IO(9)) & 1u) ? "high" : "low", rd(st.north, GPIO_INTR_CFG(9)), touch_down_now, held / NSEC_PER_MSEC,
+				    touch_down_most, stroke_count, frame_palms, frame_continued, frame_duplicates, frame_sticky,
+				    &coachz_hid_observed ? coachz_hid_observed[0] : 0, &coachz_hid_observed ? coachz_hid_observed[1] : 0,
+				    &coachz_hid_observed ? coachz_hid_observed[2] : 0, &coachz_hid_observed ? coachz_hid_observed[3] : 0,
+				    &coachz_hid_observed ? coachz_hid_observed[4] : 0, &coachz_hid_observed ? coachz_hid_observed[5] : 0,
+				    &coachz_hid_observed ? coachz_hid_observed[6] : 0, &coachz_hid_observed ? coachz_hid_observed[7] : 0);
+				frames_last = frames;
+			}
+			quiet = !irqs && !problems;
+			irqs_last = st.irqs;
+			reports_last = coachz_touch_reports;
+			hid_last = native_touch_hid_reports;
+			spurious_last = st.spurious;
+			errors_last = input_errors;
+			unasked_last = resets_unasked;
+			short_last = short_reads;
+			second_start = now;
+		}
+		if (now - heartbeat >= interval) {
+			heartbeat = now;
+			uint64_t ns;
+			absolutetime_to_nanoseconds(heartbeat, &ns);
+			printf("K44 alive %llu s, touch reports %u, interrupts %u, io_submap %llu KiB\n", ns / NSEC_PER_SEC, coachz_touch_reports,
+			    st.irqs, coachz_io_submap_bytes / 1024);
+			if (touch_down_now) {
+				/* Reports stopped with a contact down: the digitizer still holds that touch. */
+				uint64_t held = 0, quiet_ns = 0;
+				absolutetime_to_nanoseconds(now - touch_down_since, &held);
+				absolutetime_to_nanoseconds(now - touch_report_at, &quiet_ns);
+				printf("K45 touch: %u contacts down for %llu ms, last report %llu ms ago, line %s\n", touch_down_now, held / NSEC_PER_MSEC,
+				    quiet_ns / NSEC_PER_MSEC, (rd(st.north, GPIO_IO(9)) & 1u) ? "high" : "low");
+			}
+		}
+		const uint8_t *p = st.input;
+		snprintf(s2, 160, "K42 touch: reports %u interrupts %u errors %u resets %u/%u, to HID %u fingers %u: %02x%02x %02x %02x%02x%02x%02x",
+		    coachz_touch_reports, st.irqs, input_errors, resets_done, resets_unasked, native_touch_hid_reports, native_touch_count, p[0], p[1],
+		    p[2], p[3], p[4], p[5], p[6]);
+		if (st.dead) {
+			printf("K42 touch: I2C engine stopped\n");
+			break;
+		}
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+coachz_touch_start(void)
+{
+	static bool started;
+	int enabled = 0;
+	thread_t thread;
+
+	if (started || !PE_parse_boot_argn("coachz-touch", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("coachz-touch-flip", &touch_flip, sizeof(touch_flip));
+	if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
