+/*
+ * Coachz: the Apple USB host stack is prelinked for coachz-usb-host=1 (CoachzUsbHost.cpp). Without that boot argument its controller is
+ * never made, and IOUSBHostFamily's resource services, whose personalities match IOResources as soon as IOKit is published, are left
+ * out so that such a boot starts the same services as before the stack was prelinked.
+ */
+static bool
+coachz_usb_host_personality_unused(OSDictionary * personality)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		unsigned int value = 0;
+		enabled = PE_parse_boot_argn("coachz-usb-host", &value, sizeof(value)) && value == 1;
+	}
+	if (enabled) {
+		return false;
+	}
+	OSString * name = OSDynamicCast(OSString, personality->getObject(gIOClassKey.get()));
+	return name && (name->isEqualTo("AppleUSBHostResources") || name->isEqualTo("AppleUSBHostResourcesTypeC"));
+}
+
 bool
 IOCatalogue::addDrivers(
 	OSArray * drivers,
@@ -454,6 +475,12 @@
 
 		OSKext::uniquePersonalityProperties(personality);
 
+		if (coachz_usb_host_personality_unused(personality)) {
+			IOLog("COACHZ usb-host: %s left out (coachz-usb-host is off)\n",
+			    OSDynamicCast(OSString, personality->getObject(gIOClassKey.get()))->getCStringNoCopy());
+			continue;
+		}
+
 		// Add driver personality to catalogue.
 
