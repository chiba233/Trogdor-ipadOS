+
+/* The first abnormal exit is evidence even when another task processes it. Only a self-exit
+ * can safely use copyin for its user frames. Publish the note after construction.
+ */
+void coachz_usermanager_write(int pid, int fd, uint64_t address, uint64_t size);
+void coachz_usermanager_exit(int, unsigned, uint64_t, const char *, task_t, int, int, int);
+int coachz_usermanager_report(void);
+static char coachz_um_output[4096];
+static uint32_t coachz_um_output_used;
+static char coachz_um_failure[2048];
+static uint32_t coachz_um_captured;
+static unsigned coachz_um_normal_exits;
+static int coachz_um_normal_pid;
+static char coachz_um_normal_tail[512];
+
+void
+coachz_usermanager_write(int pid, int fd, uint64_t address, uint64_t size)
+{
+	char bytes[256];
+	uint32_t length = size > sizeof(bytes) - 1 ? sizeof(bytes) - 1 : (uint32_t)size;
+	uint32_t at;
+
+	if (!length || os_atomic_load(&coachz_um_captured, acquire) || copyin(address, bytes, length)) {
+		return;
+	}
+	bytes[length] = 0;
+	at = os_atomic_add_orig(&coachz_um_output_used, length + 1, relaxed);
+	if (at < sizeof(coachz_um_output) - 1) {
+		uint32_t room = (uint32_t)sizeof(coachz_um_output) - 1 - at;
+		uint32_t count = length < room ? length : room;
+		memcpy(coachz_um_output + at, bytes, count);
+		if (count < room) {
+			coachz_um_output[at + count] = '\n';
+		}
+	}
+	printf("COACHZ usermanagerd[%d] fd%d: %s\n", pid, fd, bytes);
+}
+
+void
+coachz_usermanager_exit(int pid, unsigned ns, uint64_t code, const char *description,
+    task_t task, int self, int caller, int status)
+{
+	arm_saved_state_t *state;
+	uint64_t fp, sp;
+	size_t used;
+
+	/* The -t boot task exits normally before the long-running daemon starts.
+	 * Keep its tail separately; it must not consume the later failure slot.
+	 */
+	if (status == 0) {
+		if (!os_atomic_cmpxchg(&coachz_um_captured, 0, 1, acq_rel)) {
+			return;
+		}
+		used = strnlen(coachz_um_output, sizeof(coachz_um_output));
+		unsigned start = used > sizeof(coachz_um_normal_tail) - 1 ?
+		    (unsigned)(used - (sizeof(coachz_um_normal_tail) - 1)) : 0;
+		snprintf(coachz_um_normal_tail, sizeof(coachz_um_normal_tail), "%s", coachz_um_output + start);
+		memset(coachz_um_output, 0, sizeof(coachz_um_output));
+		os_atomic_store(&coachz_um_output_used, 0, relaxed);
+		coachz_um_normal_pid = pid;
+		coachz_um_normal_exits++;
+		os_atomic_store(&coachz_um_captured, 0, release);
+		return;
+	}
+	if (!os_atomic_cmpxchg(&coachz_um_captured, 0, 1, acq_rel)) {
+		return;
+	}
+	used = snprintf(coachz_um_failure, sizeof(coachz_um_failure),
+	    "COACHZ UM v3 exit[%d]: status 0x%x self %d caller %d\n"
+	    "COACHZ UM reason: namespace %u code 0x%llx description %.200s\n",
+	    pid, status, self, caller, ns, (unsigned long long)code, description ? description : "none");
+	if (task == TASK_NULL) {
+		goto done;
+	}
+	used += snprintf(coachz_um_failure + used, sizeof(coachz_um_failure) - used,
+	    "COACHZ UM image: header 0x%llx cache-slide 0x%x\n",
+	    (unsigned long long)task->mach_header_vm_address, task->task_shared_region_slide);
+	if (!self) {
+		thread_t thread;
+		unsigned index = 0;
+		task_lock(task);
+		queue_iterate(&task->threads, thread, thread_t, task_threads) {
+			if (index == 3) {
+				break;
+			}
+			state = find_user_regs(thread);
+			used += snprintf(coachz_um_failure + used, sizeof(coachz_um_failure) - used,
+			    "COACHZ UM target t%u (sample): pc 0x%llx lr 0x%llx x16 0x%llx\n",
+			    index++, state ? (unsigned long long)get_saved_state_pc(state) : 0ULL,
+			    state ? (unsigned long long)get_saved_state_lr(state) : 0ULL,
+			    state ? (unsigned long long)get_saved_state_reg(state, 16) : 0ULL);
+		}
+		task_unlock(task);
+		goto done;
+	}
+	state = find_user_regs(current_thread());
+	if (!state) {
+		goto done;
+	}
+	used += snprintf(coachz_um_failure + used, sizeof(coachz_um_failure) - used,
+	    "COACHZ UM state: pc 0x%llx lr 0x%llx\n",
+	    (unsigned long long)get_saved_state_pc(state), (unsigned long long)get_saved_state_lr(state));
+	sp = get_saved_state_sp(state);
+	fp = get_saved_state_fp(state);
+	for (unsigned index = 0; index < 8 && used < sizeof(coachz_um_failure) - 100; index++) {
+		uint64_t frame[2];
+		if ((fp & 15) || fp < sp || fp - sp > 65536 || copyin(fp, frame, sizeof(frame))) {
+			break;
+		}
+		used += snprintf(coachz_um_failure + used, sizeof(coachz_um_failure) - used,
+		    "COACHZ UM frame %u: fp 0x%llx lr 0x%llx\n", index,
+		    (unsigned long long)fp, (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+done:
+	os_atomic_store(&coachz_um_captured, 2, release);
+	printf("%s", coachz_um_failure);
+}
+
+int
+coachz_usermanager_report(void)
+{
+	unsigned phase = os_atomic_load(&coachz_um_captured, acquire);
+	printf("COACHZ UM v3 init: normal exits %u last pid %d\n",
+	    coachz_um_normal_exits, coachz_um_normal_pid);
+	if (coachz_um_normal_exits) {
+		printf("COACHZ UM init stdout/stderr tail:\n%s\n", coachz_um_normal_tail);
+	}
+	if (phase != 2) {
+		printf("COACHZ UM v3: waiting for abnormal exit (capture %u)\n", phase);
+		return 0;
+	}
+	size_t length = strnlen(coachz_um_output, sizeof(coachz_um_output));
+	unsigned start = length > 1024 ? (unsigned)(length - 1024) : 0;
+	printf("COACHZ UM v3 abnormal stdout/stderr tail:\n%s\n%s",
+	    coachz_um_output + start, coachz_um_failure);
+	return 1;
+}
