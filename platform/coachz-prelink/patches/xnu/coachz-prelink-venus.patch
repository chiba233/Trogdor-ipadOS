+/*
+ * The video codec's path to memory, as venus_runtime_resume and load_scale_v4 ask for it (icc_set_bw on "video-mem": qxm_venus0 in
+ * MM1, qns_mem_noc_sf in MM2; qns_llcc and ebi already carry the DDR vote's top level; "cpu-cfg" is CN0, kept on). MM1 also carries
+ * the display's qxm_mdp0, which Debian's interconnect summary reads as 920678 kB/s average and 1600000 peak: nobody else votes MM1
+ * here, so that share is added and the peak never drops below it. kB/s in, as icc_set_bw takes them. Returns wifi_bcm_send's result.
+ */
+int coachz_venus_bus_vote(uint64_t avg_kbps, uint64_t peak_kbps);
+int
+coachz_venus_bus_vote(uint64_t avg_kbps, uint64_t peak_kbps)
+{
+    const uint64_t display_avg = 920678, display_peak = 1600000;
+    const struct wifi_bcm bcms[] = {
+        {"MM1", 32, 1, 0, avg_kbps + display_avg, peak_kbps > display_peak ? peak_kbps : display_peak},
+        {"MM2", 32, 1, 0, avg_kbps, peak_kbps},
+    };
+    const vm_offset_t db = wifi_cmd_db();
+    return db ? wifi_bcm_send(db, "venus bus", bcms, 2) : -1;
+}
