+/* launchd rewrites disabled.plist in its own XML form while it runs. Accept that form when the
+ * file stays root-owned, not group/other writable, and still maps com.apple.watchdogd to true.
+ */
+static bool
+coachz_watchdog_policy_launchd_form(const char *path, vnode_t vnode, const struct vnode_attr *found,
+    vfs_context_t context)
+{
+	static const char key[] = "<key>com.apple.watchdogd</key>";
+	uint64_t size = found->va_data_size;
+	char *data, *at;
+	bool accepted = false;
+	int residual = 0;
+
+	if (vnode_vtype(vnode) != VREG || found->va_uid != 0 || (found->va_mode & 0022) ||
+	    size < sizeof(key) || size > 4096) {
+		return false;
+	}
+	data = kalloc_data((size_t)size + 1, Z_WAITOK | Z_NOFAIL);
+	if (!vn_rdwr(UIO_READ, vnode, data, (int)size, 0, UIO_SYSSPACE, 0, vfs_context_ucred(context),
+	    &residual, vfs_context_proc(context)) && !residual) {
+		data[size] = 0;
+		at = strnstr(data, key, (size_t)size);
+		if (at) {
+			at += sizeof(key) - 1;
+			while (*at == ' ' || *at == '\t' || *at == '\n' || *at == '\r') {
+				at++;
+			}
+			accepted = !strncmp(at, "<true/>", 7);
+		}
+	}
+	kfree_data(data, (size_t)size + 1);
+	if (accepted) {
+		printf("COACHZ policy: %s accepted in launchd's form, size %llu\n", path, (unsigned long long)size);
+	}
+	return accepted;
+}
