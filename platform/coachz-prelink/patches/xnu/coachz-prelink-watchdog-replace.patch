+coachz_watchdog_policy_replace(const char *path, vnode_t vnode, const struct vnode_attr *found,
+    const char *bytes, int length, vfs_context_t context)
 {
+	struct vnode_attr attributes;
+	vnode_t target = NULLVP;
+	uint64_t size = found->va_data_size;
+	size_t allocated = size ? (size_t)size : 1;
+	char saved[MAXPATHLEN];
+	char head[97];
