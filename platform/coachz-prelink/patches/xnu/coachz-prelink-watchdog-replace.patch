+		for (unsigned index = 0; index < count; index++) {
+			head[index] = data[index] >= 32 && data[index] < 127 ? data[index] : '.';
+		}
+		head[count] = 0;
+		printf("COACHZ policy: %s differs: uid %u mode 0%o size %llu head %s\n", path,
+		    found->va_uid, found->va_mode & 07777, (unsigned long long)size, head);
+		snprintf(saved, sizeof(saved), "%s.coachz-prev", path);
+		error = vnode_open(saved, O_CREAT | O_TRUNC | O_NOFOLLOW | FWRITE, 0600, 0, &target, context);
+		if (!error) {
+			if (size) {
+				error = vn_rdwr(UIO_WRITE, target, data, (int)size, 0, UIO_SYSSPACE, IO_UNIT | IO_SYNC,
+				    vfs_context_ucred(context), NULL, vfs_context_proc(context));
+			}
+			close_error = vnode_close(target, FWRITE, context);
+			error = error ? error : close_error;
+		}
+	}
+	kfree_data(data, allocated);
+	if (error) {
+		return error;
+	}
+	error = vnode_open(path, O_TRUNC | O_NOFOLLOW | FWRITE, 0, 0, &target, context);
+	if (error) {
+		return error;
+	}
+	if (length) {
+		error = vn_rdwr(UIO_WRITE, target, (caddr_t)bytes, length, 0, UIO_SYSSPACE, IO_UNIT | IO_SYNC,
+		    vfs_context_ucred(context), NULL, vfs_context_proc(context));
+	}
+	if (!error) {
+		VATTR_INIT(&attributes);
+		VATTR_SET(&attributes, va_uid, 0);
+		VATTR_SET(&attributes, va_gid, 0);
+		VATTR_SET(&attributes, va_mode, 0644);
