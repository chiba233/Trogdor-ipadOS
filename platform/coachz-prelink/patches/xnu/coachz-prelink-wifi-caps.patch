+/*
+ * The regulatory rules ath10k's channels get, from the eeprom_rd the firmware reports (ath10k_mac_register: current_rd =
+ * hw_eeprom_rd, then ath/regd.c ath_regd_init). Without WORLDWIDE_ROAMING_FLAG (0x4000) and without COUNTRY_ERD_FLAG (0x8000), a value
+ * whose WORLD_SKU_MASK (0xf0) is 0x60 is a world SKU (is_wwr_sku): the wiphy is REGULATORY_CUSTOM_REG with ath_world_regdomain's
+ * rules, applied by wiphy_apply_custom_regulatory (handle_channel_custom: max_power and max_reg_power the rule's EIRP, max_antenna_gain
+ * the rule's gain), and reg.c ignore_reg_update keeps cfg80211's core world domain off it. ath_reg_apply_radar_flags then marks
+ * 5260-5700 MHz RADAR and NO_IR. All of ath's world rules have antenna gain 0: 2402-2472 MHz 20 dBm (CH01_11), 2457-2482 MHz 20 dBm
+ * NO_IR (CH12_13), 2474-2494 MHz 20 dBm NO_IR (CH14), 5140-5360 MHz, 5460-5860 MHz and 5715-5860 MHz 30 dBm NO_IR. A country SKU takes
+ * cfg80211's regulatory database, which this kernel does not have: ath_default_world_regdomain's 0x64 rules, the most restrictive.
+ */
+enum { WS_R_CH01_11 = 1, WS_R_CH12_13 = 2, WS_R_CH14 = 4, WS_R_5150_5350 = 8, WS_R_5470_5850 = 16, WS_R_5725_5850 = 32 };
+static const struct { uint16_t lo, hi; uint8_t dbm, no_ir; } ws_rules[] = {
+    {2402, 2472, 20, 0}, {2457, 2482, 20, 1}, {2474, 2494, 20, 1}, {5140, 5360, 30, 1}, {5460, 5860, 30, 1}, {5715, 5860, 30, 1},
+};
+struct ws_reg { unsigned rd, world, rules; };
+static struct ws_reg
+ws_regdomain(void)
+{
+    struct ws_reg r = {0x64, 0, 0};
+    const uint32_t rd = (wm.caps_valid ? wm.eeprom_rd : 0) & ~0x4000u;
+    r.world = !(rd & 0x8000u) && (rd & 0xf0u) == 0x60u;
+    if (r.world) r.rd = rd & 0xffu;
+    switch (r.rd) {
+    case 0x60: case 0x61: case 0x62: r.rules = WS_R_CH01_11 | WS_R_CH12_13 | WS_R_CH14 | WS_R_5150_5350 | WS_R_5470_5850; break;
+    case 0x63: case 0x65: r.rules = WS_R_CH01_11 | WS_R_CH12_13 | WS_R_5150_5350 | WS_R_5725_5850; break;
+    case 0x66: case 0x69: r.rules = WS_R_CH01_11 | WS_R_5150_5350 | WS_R_5470_5850; break;
+    case 0x67: case 0x68: case 0x6a: case 0x6c: r.rules = WS_R_CH01_11 | WS_R_CH12_13 | WS_R_5150_5350 | WS_R_5470_5850; break;
+    default: r.rd = 0x64; r.rules = WS_R_CH01_11 | WS_R_5150_5350 | WS_R_5725_5850; break;   /* 0x64, and ath_world_regdomain's default */
+    }
+    return r;
+}
+/* A channel under those rules, as freq_reg_info finds its first rule a 20 MHz channel fits in: 0 when none (IEEE80211_CHAN_DISABLED,
+ * left out of the channel list as ath10k_update_channel_list does). */
+static int
+ws_channel_rule(const struct ws_reg *r, uint32_t mhz, unsigned *dbm, unsigned *gain, int *passive, int *radar)
+{
+    for (unsigned i = 0; i < sizeof(ws_rules) / sizeof(ws_rules[0]); i++) {
+        if (!(r->rules & (1u << i)) || mhz < ws_rules[i].lo + 10u || mhz + 10u > ws_rules[i].hi) continue;
+        *dbm = ws_rules[i].dbm;
+        *gain = 0;
+        *radar = mhz >= 5260 && mhz <= 5700;
+        *passive = ws_rules[i].no_ir || *radar;
+        return 1;
+    }
+    return 0;
+}
