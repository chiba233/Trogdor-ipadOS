+/*
+ * The radio's chains: ath10k_wmi_event_service_ready_work sets cfg_tx_chainmask and cfg_rx_chainmask to (1 << num_rf_chains) - 1
+ * (wmi.c); two chains if service ready has not said.
+ */
+static uint32_t
+ws_chainmask(void)
+{
+    const uint32_t n = wm.caps_valid && wm.rf_chains >= 1 && wm.rf_chains <= 8 ? wm.rf_chains : 2;
+    return (1u << n) - 1u;
+}
