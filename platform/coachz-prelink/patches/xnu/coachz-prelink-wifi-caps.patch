-#define WJ_VHT_CAP (0x739139b2u & ~(1u << 11 | 1u << 12 | 7u << 13 | 7u << 16 | 1u << 19 | 1u << 20))   /* no sounding is set up: no beamforming */
+/*
+ * Our HT capability as mac.c ath10k_get_ht_cap builds it from service ready's ht_cap_info (WMI_HT_CAP_* in wmi.h) and vht_cap_info:
+ * 20/40 MHz, DSSS/CCK in 40 MHz and SM power save disabled always, then SGI 20 and 40, dynamic SMPS (OR'd onto the disabled value, as
+ * mainline does), TX STBC with more than one chain, the RX STBC streams, LDPC, L-SIG TXOP protection and max A-MSDU from vht_cap_info's
+ * MPDU length. 0 when ht_cap_info does not have WMI_HT_CAP_ENABLED. A-MPDU 64K and 8 us density are its fixed values.
+ */
+static uint16_t
+wj_ht_cap(void)
+{
+    const uint32_t ht = wm.ht_cap_info, vht = wm.vht_cap_info;
+    if (!wm.caps_valid || !(ht & 0x0001u)) return 0;
+    uint16_t cap = 0x0002u | 0x1000u | 3u << 2;
+    if (ht & 0x0002u) cap |= 0x0020u;
+    if (ht & 0x0800u) cap |= 0x0040u;
+    if (ht & 0x0004u) cap |= 1u << 2;
+    if ((ht & 0x0008u) && ws_chainmask() > 1) cap |= 0x0080u;
+    if (ht & 0x0030u) cap |= (uint16_t)((((ht & 0x0030u) >> 4) << 8) & 0x0300u);
+    if ((ht & 0x0040u) || ((ht & 0x1000u) && (ht & 0x2000u))) cap |= 0x0001u;
+    if (ht & 0x0080u) cap |= 0x8000u;
+    if (vht & 0x3u) cap |= 0x0800u;
+    return cap;
+}
+/*
+ * Our VHT capability as ath10k_create_vht_cap builds it: vht_cap_info itself, the beamformee STS (3 when not reported) and sounding
+ * dimensions (1) filled in where it claims beamforming, TX STBC dropped with one chain. Then the beamforming bits are cleared: this
+ * driver sets up no sounding (ath10k's txbf vdev parameters are not written), so it does not claim it.
+ */
+static uint32_t
+wj_vht_cap(void)
+{
+    uint32_t vht = wm.caps_valid ? wm.vht_cap_info : 0;
+    if (vht & (1u << 12 | 1u << 20)) vht |= (((vht >> 13) & 7u) ? ((vht >> 13) & 7u) : 3u) << 13;
+    if (vht & (1u << 11 | 1u << 19)) vht |= (((vht >> 16) & 7u) ? ((vht >> 16) & 7u) : 1u) << 16;
+    if (ws_chainmask() <= 1) vht &= ~(1u << 7);
+    return vht & ~(1u << 11 | 1u << 12 | 7u << 13 | 7u << 16 | 1u << 19 | 1u << 20);
+}
+/* ath10k_create_vht_cap's MCS map: MCS 0-9 (2) for each of the chains, not supported (3) above them. */
+static uint16_t
+wj_vht_mcs_map(void)
+{
+    uint16_t map = 0;
+    for (unsigned i = 0; i < 8; i++) map |= (uint16_t)((ws_chainmask() & (1u << i) ? 2u : 3u) << (2 * i));
+    return map;
+}
 
