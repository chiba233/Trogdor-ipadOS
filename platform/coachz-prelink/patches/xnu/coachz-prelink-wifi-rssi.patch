+/*
+ * The access point's signal while joined, kept as mac80211 keeps a station's: every frame from the peer adds -signal to an EWMA
+ * (net/mac80211/rx.c ieee80211_rx_h_sta_process; sta_info.h DECLARE_EWMA(signal, 10, 8), include/linux/average.h), whose negated value is
+ * cfg80211's signal_avg. A frame's signal is ath10k's: over HTT, ATH10K_DEFAULT_NOISE_FLOOR (-95) plus rx_ppdu_start's rssi_comb, read on
+ * a PPDU's first MPDU and kept for the rest of it (htt_rx.c ath10k_htt_rx_h_ppdu, ath10k_htt_rx_h_signal); for management frames the SNR
+ * above that floor (wmi.c ath10k_wmi_event_mgmt_rx), here the joined BSS's beacons. nw_wifi_status_get reports it in place of the join's
+ * strength, so the RSSI request and RSSI_CHANGED follow the link.
+ */
+static struct { uint64_t internal; int32_t ppdu; uint32_t frames, beacons; } wj_sig;   /* the Wi-Fi thread's */
+static volatile int32_t wj_signal_avg;   /* dBm; 0 until a frame of this join was heard */
+static void
+wj_signal_reset(void)
+{
+    wj_sig.internal = 0;
+    wj_sig.ppdu = 0;
+    wj_sig.frames = wj_sig.beacons = 0;
+    __atomic_store_n(&wj_signal_avg, 0, __ATOMIC_RELAXED);
+}
+static void
+wj_signal_add(int32_t dbm)
+{
+    if (dbm >= 0 || dbm < -127) return;
+    const uint64_t val = (uint64_t)(-dbm);   /* ewma_signal_add(..., -signal): precision 10, weight 1/8 */
+    wj_sig.internal = wj_sig.internal ? (((wj_sig.internal << 3) - wj_sig.internal) + (val << 10)) >> 3 : val << 10;
+    __atomic_store_n(&wj_signal_avg, -(int32_t)(wj_sig.internal >> 10), __ATOMIC_RELAXED);
+}
 
