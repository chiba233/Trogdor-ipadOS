+    }
+    const int restored = wifi_mss_rails_vote(0, status);
+    const int unloaded = wifi_qmp_send("{class: image, res: load_state, name: modem, val: off}");
+    printf("COACHZ mba: undone: clocks 0x%x 0x%x 0x%x 0x%x 0x%x, mss_restart %u pdc 0x%x spare 0x%x, rails 0 after %d us, load_state off %d\n",
+        *(volatile uint32_t *)(m->gcc + wifi_mss_clocks[0].offset), *(volatile uint32_t *)(m->gcc + wifi_mss_clocks[1].offset),
+        *(volatile uint32_t *)(m->gcc + wifi_mss_clocks[2].offset), *(volatile uint32_t *)(m->gcc + wifi_mss_clocks[3].offset),
