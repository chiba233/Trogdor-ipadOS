+/* SPDX-License-Identifier: BSD-2-Clause */
+/* WCN3990 / SC7180: the modem that hosts the WLAN firmware, started as mainline's qcom_q6v5_mss does (coachz-wifi=4), and the SMEM
+ * inventory (coachz-wifi=1 plus an explicit /arm-io/coachz-wifi ADT node). With the modem up: SMP2P, GLINK over SMEM, QRTR and
+ * rmtfs, then ath10k's WLFW QMI sequence, the WCN3990's supplies, copy engines, HTC and WMI up to the firmware's READY. No network
+ * interface is registered with the system yet. Also the shared RPMh client (coachz_rpmh_iface.h) every Coachz driver votes through.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/kalloc.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <libkern/crypto/sha2.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <pexpert/arm64/boot.h>
+#include "coachz_wifi_smem.h"
