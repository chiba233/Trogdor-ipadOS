+/*
+ * IPA power as mainline takes it before a modem start (ipa_modem.c: QCOM_SSR_BEFORE_POWERUP -> ipa_uc_power -> ipa_power_enable): the
+ * three interconnect paths of ipa_data-v4.2.c (memory 80 MBps average and 465 MBps peak to EBI1, imem 68.57 MBps, config 30 MBps from
+ * the apps) as the BCMs on them in mainline sc7180.c (qnm_aggre2_noc SN9, qns_gemnoc_sf SN0, qxs_imem SN1, qnm_gemnoc SN12, qhs_ipa
+ * CN0; MC0, ACV, SH0 and SH4 already carry the DDR vote's larger peak), then the core clock RPMH_IPA_CLK at 100 MHz (clk-rpmh.c: BCM
+ * IP0, state = rate / (aux unit * 1000), active only, commit). Debian logs "received modem starting event" before the MBA reports.
+ * Kept on: Linux holds it until the IPA microcontroller, which the modem loads, reports in.
+ */
+static int
+wifi_ipa_power(void)
+{
+    static const struct wifi_bcm paths[] = {
+        {"SN9", 16, 1, 0, 80000, 465000}, {"SN0", 16, 1, 0, 80000, 465000}, {"SN1", 8, 1, 0, 0, 68570},
+        {"SN12", 8, 1, 0, 0, 30000}, {"CN0", 4, 1, 0, 0, 30000},
+    };
+    const vm_offset_t db = wifi_cmd_db();
+    if (!db) return -1;
+    const int voted = wifi_bcm_send(db, "ipa", paths, 5);
+    uint32_t address = 0, aux = 0, length = 0, status = 0;
+    if (!wifi_db_find(db, "IP0", &address, &aux, &length) || length < 4) {
+        printf("COACHZ ipa: IP0 not in cmd-db\n");
+        return -2;
+    }
+    const uint32_t unit = wifi_db_u16(db, aux) | wifi_db_u16(db, aux + 2u) << 16;
+    uint64_t state = unit ? 100000000ull / ((uint64_t)unit * 1000u) : 0;
+    if (!state) state = 1;
+    if (state > 0x3fff) state = 0x3fff;
+    const uint32_t data = (1u << 30) | (1u << 29) | (uint32_t)state;
+    const int clocked = wifi_rpmh_send(&address, &data, 1, &status);
+    printf("COACHZ ipa: paths %d; IP0 address 0x%x unit %u state %llu after %d us, status 0x%x\n", voted, address, unit,
+        (unsigned long long)state, clocked, status);
+    return voted >= 0 && clocked >= 0 ? 0 : -3;
+}
+
+/*
+ * The link to the running modem, set up as Linux does once the modem is up: GLINK over SMEM (qcom_glink_smem.c with qcom_glink_native.c;
+ * the AP's FIFO is item 479, the modem's 480, the descriptor 478 holds our FIFO's tail and head, then the modem's), QRTR on GLINK's
+ * "IPCRTR" channel (net/qrtr af_qrtr.c and the in-kernel name service ns.c, this side node 1 as Debian's qrtr-ns -f 1), and the remote
+ * file system the modem keeps its EFS on (linux-msm rmtfs: QMI service 14 version 1 instance 0, 512-byte sectors moved between the EFS
+ * images and rmtfs_mem). The images (modem_fs1, fs2, fsc, fsg) come with the firmware blob and stay in memory: writes are kept there
+ * only, as Debian's rmtfs -r keeps them. Polled: Linux takes the GLINK interrupt (SPI 449) and kicks the modem through the APSS IPC
+ * register bit 12.
+ */
+#define WG_FIFO_BYTES 16384u
+enum {
+    WG_VERSION = 0, WG_VERSION_ACK = 1, WG_OPEN = 2, WG_CLOSE = 3, WG_OPEN_ACK = 4, WG_INTENT = 5, WG_RX_DONE = 6, WG_INTENT_REQ = 7,
+    WG_INTENT_REQ_ACK = 8, WG_TX_DATA = 9, WG_CLOSE_ACK = 11, WG_TX_DATA_CONT = 12, WG_READ_NOTIF = 13, WG_RX_DONE_REUSE = 14, WG_SIGNALS = 15,
+};
+#define WG_FEATURE_REUSE 1u
+#define WG_LCID 1u
+#define WG_LOCAL_MAX 24
+#define WG_REMOTE_MAX 32
+#define WG_PENDING_MAX 8
+#define WQ_NODE 1u                 /* this side's QRTR node */
+#define WQ_CTRL 0xfffffffeu
+#define WQ_BCAST 0xffffffffu
+#define WQ_RMTFS_PORT 0x4000u
+#define WR_SECTOR 512u
+
+
+static struct {
+    uint32_t desc, tx, rx, rx_bytes;
+    uint32_t features;
+    int open_remote, open_acked, intents_sent, hello_sent, failed;
+    uint32_t rcid, next_liid;
+    struct { uint32_t id, size; int busy, valid; } remote[WG_REMOTE_MAX];
+    struct { uint32_t id, size, fill; uint8_t *data; } local[WG_LOCAL_MAX];
+    unsigned local_count;
+    struct { uint8_t *data; uint32_t bytes; int requested; } pending[WG_PENDING_MAX];
+    uint32_t modem_node;
+    vm_offset_t rmtfs;
+    uint32_t opened[4];
+    uint64_t messages_in, messages_out, qrtr_rx, qrtr_tx, rmtfs_ops, rmtfs_sectors;
+    char channels[160];
+} wg;
+
+static void
+wg_kick(void)
+{
+    if (!wifi_qmp_kick) return;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    *wifi_qmp_kick = 1u << 12;
+}
+
+static uint32_t
+wg_rx_avail(void)
+{
+    const uint32_t head = *wifi_smem_word(wg.desc + 12), tail = *wifi_smem_word(wg.desc + 8);
+    if (head >= wg.rx_bytes || tail >= wg.rx_bytes) return 0;
+    return head >= tail ? head - tail : wg.rx_bytes - tail + head;
+}
+
+static void
+wg_rx_peek(uint32_t offset, void *dst, uint32_t count)
+{
+    uint8_t *d = dst;
+    const uint32_t start = *wifi_smem_word(wg.desc + 8) + offset;
+    __asm__ volatile ("dmb oshld" ::: "memory");
+    for (uint32_t i = 0; i < count; i++) {
+        const uint32_t at = (start + i) % wg.rx_bytes;
+        d[i] = (uint8_t)(*wifi_smem_word(wg.rx + (at & ~3u)) >> (8 * (at & 3u)));
+    }
+}
+
+static void
+wg_rx_advance(uint32_t count)
+{
+    const uint32_t tail = (*wifi_smem_word(wg.desc + 8) + count) % wg.rx_bytes;
+    __asm__ volatile ("dmb osh" ::: "memory");
+    *wifi_smem_word(wg.desc + 8) = tail;
+}
+
+static uint32_t
+wg_tx_avail(void)
+{
+    const uint32_t head = *wifi_smem_word(wg.desc + 4), tail = *wifi_smem_word(wg.desc);
+    const uint32_t avail = tail <= head ? WG_FIFO_BYTES - head + tail : tail - head;
+    return avail < 16 ? 0 : avail - 16;   /* FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE */
+}
+
+/* One message, header then payload padded to 8 bytes, written word by word before the head moves, then a kick. */
+static int
+wg_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+    const uint32_t total = (hlen + dlen + 7) & ~7u;
+    if (wg.failed || total > WG_FIFO_BYTES / 2) return -1;
+    for (unsigned waited = 0; wg_tx_avail() < total; waited++) {
+        if (waited >= 2000) {
+            wg.failed = 1;
+            printf("COACHZ glink: our FIFO stayed full\n");
+            return -1;
+        }
+        delay(1000);
+    }
+    uint32_t head = *wifi_smem_word(wg.desc + 4);
+    for (uint32_t i = 0; i < total; i += 4) {
+        uint8_t bytes[4];
+        for (unsigned b = 0; b < 4; b++) {
+            const uint32_t k = i + b;
+            bytes[b] = k < hlen ? ((const uint8_t *)hdr)[k] : k - hlen < dlen ? ((const uint8_t *)data)[k - hlen] : 0;
+        }
+        uint32_t word;
+        memcpy(&word, bytes, 4);
+        *wifi_smem_word(wg.tx + head) = word;
+        head = (head + 4) % WG_FIFO_BYTES;
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+    *wifi_smem_word(wg.desc + 4) = head;
+    wg_kick();
+    wg.messages_out++;
+    return 0;
+}
+
+static void
+wg_cmd(uint32_t cmd, uint32_t p1, uint32_t p2)
+{
+    const uint32_t m[2] = {cmd | p1 << 16, p2};
+    wg_tx(m, 8, NULL, 0);
+}
+
+/* qcom_glink_advertise_intent: a buffer of size bytes the modem may fill, one message each. */
+static int
+wg_intent_add(uint32_t size)
+{
+    if (wg.local_count >= WG_LOCAL_MAX || !size || size > 65536) return -1;
+    uint8_t *buf = kalloc_data(size, Z_WAITOK);
+    if (!buf) return -1;
+    const unsigned i = wg.local_count++;
+    wg.local[i].id = ++wg.next_liid;
+    wg.local[i].size = size;
+    wg.local[i].fill = 0;
+    wg.local[i].data = buf;
+    const uint32_t m[4] = {WG_INTENT | WG_LCID << 16, 1, size, wg.local[i].id};
+    return wg_tx(m, 16, NULL, 0);
+}
+
+/* A message on IPCRTR: in a free intent the modem advertised, or queued with an RX_INTENT_REQ until it advertises one. */
+static int
+wg_send(const void *data, uint32_t len)
+{
+    for (unsigned i = 0; i < WG_REMOTE_MAX; i++) {
+        if (!wg.remote[i].valid || wg.remote[i].busy || wg.remote[i].size < len) continue;
+        wg.remote[i].busy = 1;
+        const uint32_t h[4] = {WG_TX_DATA | WG_LCID << 16, wg.remote[i].id, len, 0};
+        wg.qrtr_tx++;
+        return wg_tx(h, 16, data, len);
+    }
+    for (unsigned p = 0; p < WG_PENDING_MAX; p++) {
+        if (wg.pending[p].data) continue;
+        wg.pending[p].data = kalloc_data(len, Z_WAITOK);
+        if (!wg.pending[p].data) return -1;
+        memcpy(wg.pending[p].data, data, len);
+        wg.pending[p].bytes = len;
+        wg.pending[p].requested = 1;
+        wg_cmd(WG_INTENT_REQ, WG_LCID, len);
+        return 0;
+    }
+    printf("COACHZ glink: no intent and the queue is full, %u bytes dropped\n", len);
+    return -1;
+}
+
+static void
+wg_retry_pending(void)
+{
+    for (unsigned p = 0; p < WG_PENDING_MAX; p++) {
+        if (!wg.pending[p].data) continue;
+        for (unsigned i = 0; i < WG_REMOTE_MAX; i++) {
+            if (!wg.remote[i].valid || wg.remote[i].busy || wg.remote[i].size < wg.pending[p].bytes) continue;
+            wg.remote[i].busy = 1;
+            const uint32_t h[4] = {WG_TX_DATA | WG_LCID << 16, wg.remote[i].id, wg.pending[p].bytes, 0};
+            wg.qrtr_tx++;
+            wg_tx(h, 16, wg.pending[p].data, wg.pending[p].bytes);
+            kfree_data(wg.pending[p].data, wg.pending[p].bytes);
+            wg.pending[p].data = NULL;
+            break;
+        }
+    }
+}
+
+/* A QRTR v1 packet (af_qrtr.c qrtr_node_enqueue: control packets go to the peer node's control port). */
+static void
+wq_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *payload, uint32_t len)
+{
+    static uint8_t packet[32 + 8192];
+    if (len > 8192) return;
+    const uint32_t h[8] = {1, type, WQ_NODE, src_port, 0, len, dst_node, dst_port};
+    memcpy(packet, h, 32);
+    memcpy(packet + 32, payload, len);
+    const uint32_t padded = (len + 3) & ~3u;
+    bzero(packet + 32 + len, padded - len);
+    wg_send(packet, 32 + padded);
+}
+
+static void
+wq_ctrl(uint32_t cmd, uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint32_t dst_node)
+{
+    const uint32_t pkt[5] = {cmd, a, b, c, d};
+    wq_send(cmd, WQ_CTRL, dst_node, WQ_CTRL, pkt, sizeof(pkt));
+}
+
+/* QMI over QRTR (soc/qcom/qmi_interface.c): a 7-byte header (type, transaction, message, length) and TLVs (type, u16 length). */
+static int
+wr_tlv(const uint8_t *body, uint32_t n, uint8_t want, const uint8_t **value, uint16_t *len)
+{
+    for (uint32_t at = 0; at + 3 <= n;) {
+        const uint8_t type = body[at];
+        const uint16_t l = (uint16_t)(body[at + 1] | body[at + 2] << 8);
+        if (at + 3 + l > n) return 0;
+        if (type == want) {
+            *value = body + at + 3;
+            *len = l;
+            return 1;
+        }
+        at += 3 + l;
+    }
+    return 0;
+}
+
+static uint32_t
+wr_put(uint8_t *out, uint32_t at, uint8_t type, const void *value, uint16_t len)
+{
+    out[at] = type;
+    out[at + 1] = (uint8_t)len;
+    out[at + 2] = (uint8_t)(len >> 8);
+    memcpy(out + at + 3, value, len);
+    return at + 3 + len;
+}
+
+/* rmtfs.c's handlers, for one request from the modem's client at (node, port). */
+static void
+wr_request(uint32_t node, uint32_t port, const uint8_t *msg, uint32_t n)
+{
+    if (n < 7 || msg[0] != 0) return;
+    const uint16_t txn = (uint16_t)(msg[1] | msg[2] << 8), id = (uint16_t)(msg[3] | msg[4] << 8);
+    const uint16_t blen = (uint16_t)(msg[5] | msg[6] << 8);
+    const uint8_t *body = msg + 7;
+    if (7u + blen > n) return;
+    uint8_t out[64];
+    uint32_t at = 7;
+    uint16_t result[2] = {0, 0};
+    const uint8_t *v = NULL;
+    uint16_t l = 0;
+    wg.rmtfs_ops++;
+    if (id == 1) {                      /* OPEN: path -> caller id */
+        char path[64] = {0};
+        int found = -1;
+        if (wr_tlv(body, blen, 1, &v, &l)) memcpy(path, v, l < sizeof(path) - 1 ? l : sizeof(path) - 1);
+        for (int i = 0; i < wifi_efs_count; i++) {
+            char want[32];
+            snprintf(want, sizeof(want), "/boot/%s", wifi_efs[i].name);
+            if (!strcmp(path, want)) found = i;
+        }
+        if (found < 0) {
+            result[0] = 1;
+            result[1] = 1;
+        } else {
+            wg.opened[found]++;
+        }
+        at = wr_put(out, at, 2, result, 4);
+        if (found >= 0) {
+            const uint32_t caller = (uint32_t)found + 1;
+            at = wr_put(out, at, 16, &caller, 4);
+        }
+        printf("COACHZ rmtfs: open \"%s\" -> %d\n", path, found + 1);
+    } else if (id == 2) {               /* CLOSE */
+        at = wr_put(out, at, 2, result, 4);
+    } else if (id == 3) {               /* RW_IOVEC: sectors between the image and rmtfs_mem */
+        uint32_t caller = 0;
+        uint8_t direction = 0;
+        if (wr_tlv(body, blen, 1, &v, &l) && l >= 4) memcpy(&caller, v, 4);
+        if (wr_tlv(body, blen, 2, &v, &l) && l >= 1) direction = v[0];
+        const struct wifi_efs *efs = caller >= 1 && caller <= (uint32_t)wifi_efs_count ? &wifi_efs[caller - 1] : NULL;
+        if (!efs || !wg.rmtfs || !wr_tlv(body, blen, 3, &v, &l) || l < 1 || 1u + v[0] * 12u > l) {
+            result[0] = 1;
+            result[1] = 2;
+        } else {
+            for (uint32_t e = 0; e < v[0] && !result[0]; e++) {
+                uint32_t entry[3];
+                memcpy(entry, v + 1 + 12 * e, 12);
+                for (uint32_t s = 0; s < entry[2]; s++) {
+                    const uint64_t sector = ((uint64_t)entry[0] + s) * WR_SECTOR, phys = (uint64_t)entry[1] + s * WR_SECTOR;
+                    if (phys < wifi_rmtfs_base || phys + WR_SECTOR > wifi_rmtfs_base + wifi_rmtfs_size || sector + WR_SECTOR > efs->bytes) {
+                        result[0] = 1;
+                        result[1] = 1;
+                        break;
+                    }
+                    uint8_t *shared = (uint8_t *)(wg.rmtfs + (phys - wifi_rmtfs_base));
+                    if (direction) memcpy(efs->data + sector, shared, WR_SECTOR);
+                    else memcpy(shared, efs->data + sector, WR_SECTOR);
+                    wg.rmtfs_sectors++;
+                }
+            }
+            __asm__ volatile ("dsb sy" ::: "memory");
+        }
+        at = wr_put(out, at, 2, result, 4);
+    } else if (id == 4) {               /* ALLOC_BUFF: rmtfs_mem */
+        uint32_t size = 0;
+        if (wr_tlv(body, blen, 2, &v, &l) && l >= 4) memcpy(&size, v, 4);
+        const uint64_t address = wifi_rmtfs_base;
+        if (size > wifi_rmtfs_size) {
+            result[0] = 1;
+            result[1] = 1;
+        }
+        at = wr_put(out, at, 2, result, 4);
+        if (!result[0]) at = wr_put(out, at, 16, &address, 8);
+        printf("COACHZ rmtfs: buffer of %u bytes -> %s\n", size, result[0] ? "refused" : "rmtfs_mem");
+    } else if (id == 5) {               /* GET_DEV_ERROR */
+        const uint8_t status = 0;
+        at = wr_put(out, at, 2, result, 4);
+        at = wr_put(out, at, 16, &status, 1);
+    } else {
+        printf("COACHZ rmtfs: request 0x%x not handled\n", id);
+        return;
+    }
+    out[0] = 2;
+    out[1] = (uint8_t)txn;
+    out[2] = (uint8_t)(txn >> 8);
+    out[3] = (uint8_t)id;
+    out[4] = (uint8_t)(id >> 8);
+    out[5] = (uint8_t)(at - 7);
+    out[6] = (uint8_t)((at - 7) >> 8);
+    wq_send(1, WQ_RMTFS_PORT, node, port, out, at);
+}
+
+/*
+ * WLFW, the WLAN firmware service the modem announces (QMI service 69 version 1), as ath10k's qmi.c drives it on a WCN3990 over SNOC:
+ * on the server's arrival the indication registration (fw_ready, msa_ready, client id), the host capability (daemon_support 0), the MSA
+ * information (wlan_mem, 0x94100000 2 MiB; qcom,msa-fixed-perm, so no permission change), 20 ms, MSA ready and the capability query;
+ * once the MSA-ready indication came, the board data (board-2.bin's entry for "bus=snoc,qmi-board-id=<id>", as
+ * ath10k_core_create_board_name names it without a calibration variant, which this machine's device tree has none of) in 6144-byte
+ * segments, then an empty calibration report, then the FW-ready indication awaited. TLVs as qmi_wlfw_v01.c encodes them. WLAN mode and
+ * the copy engines are the next step: nothing here turns the radio on.
+ */
+#define WL_PORT 0x4001u
+#define WL_SEGMENT 6144u
+static uint8_t wl_message[7 + 64 + WL_SEGMENT];
+
+static struct {
+    uint32_t node, port;
+    int known, state, msa_ready, fw_ready, failed;
+    uint16_t txn, want_id, want_txn;
+    unsigned waited_ms;
+    uint8_t resp[1024];
+    uint32_t resp_len;
+    int resp_ready;
+    uint32_t chip_id, chip_family, board_id, soc_id, fw_version;
+    char build_id[96], timestamp[40];
+    const uint8_t *bdf;
+    uint32_t bdf_len, bdf_seg, bdf_at;
+} wl;
+
+static void
+wl_request(uint16_t id, const uint8_t *tlvs, uint32_t len)
+{
+    const uint16_t txn = ++wl.txn;
+    wl_message[0] = 0;
+    wl_message[1] = (uint8_t)txn;
+    wl_message[2] = (uint8_t)(txn >> 8);
+    wl_message[3] = (uint8_t)id;
+    wl_message[4] = (uint8_t)(id >> 8);
+    wl_message[5] = (uint8_t)len;
+    wl_message[6] = (uint8_t)(len >> 8);
+    if (len) memmove(wl_message + 7, tlvs, len);
+    wl.want_id = id;
+    wl.want_txn = txn;
+    wl.resp_ready = 0;
+    wl.waited_ms = 0;
+    wq_send(1, WL_PORT, wl.node, wl.port, wl_message, 7 + len);
+}
+
+/* A response's result TLV (type 2: result, error); 0 when it succeeded. */
+static int
+wl_result(uint16_t *error)
+{
+    const uint8_t *v = NULL;
+    uint16_t l = 0;
+    *error = 0xffff;
+    if (!wr_tlv(wl.resp + 7, wl.resp_len - 7, 2, &v, &l) || l < 4) return -1;
+    *error = (uint16_t)(v[2] | v[3] << 8);
+    return v[0] | v[1] << 8;
+}
+
+/* A QMI message from WLFW to our port: the awaited response, or an indication. */
+static void
+wl_rx(const uint8_t *m, uint32_t n)
+{
+    if (n < 7) return;
+    const uint8_t type = m[0];
+    const uint16_t txn = (uint16_t)(m[1] | m[2] << 8), id = (uint16_t)(m[3] | m[4] << 8);
+    if (type == 2 && id == wl.want_id && txn == wl.want_txn && n <= sizeof(wl.resp)) {
+        memcpy(wl.resp, m, n);
+        wl.resp_len = n;
+        wl.resp_ready = 1;
+    } else if (type == 4 && id == 0x2b) {
+        wl.msa_ready = 1;
+        printf("COACHZ wlfw: MSA ready indication\n");
+    } else if (type == 4 && id == 0x21) {
+        wl.fw_ready = 1;
+        printf("COACHZ wlfw: FW ready indication\n");
+    } else {
+        printf("COACHZ wlfw: message type %u id 0x%x txn %u (%u bytes) not awaited\n", type, id, txn, n);
+    }
+}
+
+/* board-2.bin (ath10k core.c): "QCA-ATH10K-BOARD" padded to 20 bytes, then IEs {id, length, data padded to 4}; a board IE (0) holds
+ * a name IE (0) and a data IE (1). */
+static int
+wl_board(const char *want, const uint8_t **data, uint32_t *len)
+{
+    if (!wifi_board || wifi_board_bytes < 28 || memcmp(wifi_board, "QCA-ATH10K-BOARD", 16)) return 0;
+    for (size_t at = 20; at + 8 <= wifi_board_bytes;) {
+        uint32_t h[2];
+        memcpy(h, wifi_board + at, 8);
+        if (h[1] > wifi_board_bytes - at - 8) return 0;
+        if (h[0] == 0) {
+            const uint8_t *body = wifi_board + at + 8;
+            const uint8_t *name = NULL, *blob = NULL;
+            uint32_t name_len = 0, blob_len = 0;
+            for (uint32_t s = 0; s + 8 <= h[1];) {
+                uint32_t sh[2];
+                memcpy(sh, body + s, 8);
+                if (sh[1] > h[1] - s - 8) break;
+                if (sh[0] == 0) { name = body + s + 8; name_len = sh[1]; }
+                if (sh[0] == 1) { blob = body + s + 8; blob_len = sh[1]; }
+                s += 8 + ((sh[1] + 3) & ~3u);
+            }
+            if (name && blob && name_len == strlen(want) && !memcmp(name, want, name_len)) {
+                *data = blob;
+                *len = blob_len;
+                return 1;
+            }
+        }
+        at += 8 + ((h[1] + 3) & ~3u);
+    }
+    return 0;
+}
+
+static void
+wl_bdf_segment(void)
+{
+    static uint8_t t[64 + WL_SEGMENT];
+    uint32_t at = 0;
+    const uint32_t remaining = wl.bdf_len - wl.bdf_at, n = remaining > WL_SEGMENT ? WL_SEGMENT : remaining;
+    const uint8_t valid = 1, end = n == remaining;
+    const int32_t file_id = 0;
+    at = wr_put(t, at, 0x01, &valid, 1);
+    at = wr_put(t, at, 0x10, &file_id, 4);
+    at = wr_put(t, at, 0x11, &wl.bdf_len, 4);
+    at = wr_put(t, at, 0x12, &wl.bdf_seg, 4);
+    t[at] = 0x13;
+    t[at + 1] = (uint8_t)(n + 2);
+    t[at + 2] = (uint8_t)((n + 2) >> 8);
+    t[at + 3] = (uint8_t)n;
+    t[at + 4] = (uint8_t)(n >> 8);
+    memcpy(t + at + 5, wl.bdf + wl.bdf_at, n);
+    at += 5 + n;
+    at = wr_put(t, at, 0x14, &end, 1);
+    wl_request(0x25, t, at);
+    wl.bdf_at += n;
+    wl.bdf_seg++;
+}
+
+/* One step of the sequence, every millisecond from the watch loop. */
+static void
+wl_step(void)
+{
+    uint8_t t[64];
+    uint32_t at = 0;
+    uint16_t error = 0;
+    int result = 0;
+    if (wl.failed || !wl.known || !wg.open_acked || wl.state >= 10) return;
+    if (wl.state && wl.state != 6 && wl.state != 9 && !wl.resp_ready) {
+        if (++wl.waited_ms >= 30000) {
+            printf("COACHZ wlfw: no response to 0x%x in 30 s (state %d)\n", wl.want_id, wl.state);
+            wl.failed = 1;
+        }
+        return;
+    }
+    if (wl.resp_ready) result = wl_result(&error);
+    switch (wl.state) {
+    case 0: {
+        const uint8_t on = 1;
+        const uint32_t client = 0x4b4e454cu;   /* ATH10K_QMI_CLIENT_ID */
+        at = wr_put(t, at, 0x10, &on, 1);
+        at = wr_put(t, at, 0x13, &on, 1);
+        at = wr_put(t, at, 0x15, &client, 4);
+        wl_request(0x20, t, at);
+        wl.state = 1;
+        break;
+    }
+    case 1: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        uint64_t status = 0;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x10, &v, &l) && l >= 8) memcpy(&status, v, 8);
+        printf("COACHZ wlfw: indication registration %d/%u, fw status 0x%llx\n", result, error, (unsigned long long)status);
+        if (result) { wl.failed = 1; break; }
+        const uint32_t daemon = 0;
+        at = wr_put(t, at, 0x10, &daemon, 4);
+        wl_request(0x34, t, at);
+        wl.state = 2;
+        break;
+    }
+    case 2: {
+        printf("COACHZ wlfw: host capability %d/%u\n", result, error);
+        if (result && error != 0x5e) { wl.failed = 1; break; }   /* QMI_ERR_NOT_SUPPORTED_V01: older firmware, not fatal */
+        const uint64_t base = CW_MSA_BASE;
+        const uint32_t size = CW_MSA_SIZE;
+        at = wr_put(t, at, 0x01, &base, 8);
+        at = wr_put(t, at, 0x02, &size, 4);
+        wl_request(0x2d, t, at);
+        wl.state = 3;
+        break;
+    }
+    case 3: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        char regions[160] = {0};
+        size_t used = 0;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x03, &v, &l) && l >= 1)
+            for (unsigned i = 0; i < v[0] && 1u + 13u * (i + 1) <= l && used < sizeof(regions) - 40; i++) {
+                uint64_t address;
+                uint32_t size;
+                memcpy(&address, v + 1 + 13 * i, 8);
+                memcpy(&size, v + 9 + 13 * i, 4);
+                used += snprintf(regions + used, sizeof(regions) - used, " 0x%llx+0x%x%s", (unsigned long long)address, size,
+                    v[13 + 13 * i] ? " secure" : "");
+            }
+        printf("COACHZ wlfw: MSA info %d/%u, regions%s\n", result, error, regions[0] ? regions : " none");
+        if (result) { wl.failed = 1; break; }
+        delay(20000);   /* the 20 ms ath10k waits after the MSA info (SDM845 XPU crash) */
+        wl_request(0x2e, NULL, 0);
+        wl.state = 4;
+        break;
+    }
+    case 4:
+        printf("COACHZ wlfw: MSA ready %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        wl_request(0x24, NULL, 0);
+        wl.state = 5;
+        break;
+    case 5: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        wl.board_id = 0xff;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x10, &v, &l) && l >= 8) { memcpy(&wl.chip_id, v, 4); memcpy(&wl.chip_family, v + 4, 4); }
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x11, &v, &l) && l >= 4) memcpy(&wl.board_id, v, 4);
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x12, &v, &l) && l >= 4) memcpy(&wl.soc_id, v, 4);
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x13, &v, &l) && l >= 5) {
+            memcpy(&wl.fw_version, v, 4);
+            const uint32_t n = v[4] < l - 5 ? v[4] : l - 5;
+            memcpy(wl.timestamp, v + 5, n < sizeof(wl.timestamp) - 1 ? n : sizeof(wl.timestamp) - 1);
+        }
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x14, &v, &l)) memcpy(wl.build_id, v, l < sizeof(wl.build_id) - 1 ? l : sizeof(wl.build_id) - 1);
+        printf("COACHZ wlfw: capability %d/%u: chip 0x%x family 0x%x board 0x%x soc 0x%x fw 0x%x \"%s\" build \"%s\"\n", result, error,
+            wl.chip_id, wl.chip_family, wl.board_id, wl.soc_id, wl.fw_version, wl.timestamp, wl.build_id);
+        if (result) { wl.failed = 1; break; }
+        wl.state = 6;
+        break;
+    }
+    case 6: {
+        if (!wl.msa_ready) {
+            if (++wl.waited_ms >= 30000) { printf("COACHZ wlfw: no MSA ready indication in 30 s\n"); wl.failed = 1; }
+            return;
+        }
+        char name[80];
+        snprintf(name, sizeof(name), "bus=snoc,qmi-board-id=%x,qmi-chip-id=%x", wl.board_id, wl.chip_id);
+        int found = wl_board(name, &wl.bdf, &wl.bdf_len);
+        if (!found) {
+            snprintf(name, sizeof(name), "bus=snoc,qmi-board-id=%x", wl.board_id);
+            found = wl_board(name, &wl.bdf, &wl.bdf_len);
+        }
+        printf("COACHZ wlfw: board data \"%s\" %s (%u bytes, board file %zu bytes)\n", name, found ? "found" : "missing", wl.bdf_len,
+            wifi_board_bytes);
+        if (!found) { wl.failed = 1; break; }
+        wl.bdf_at = wl.bdf_seg = 0;
+        wl_bdf_segment();
+        wl.state = 7;
+        break;
+    }
+    case 7:
+        if (result) {
+            printf("COACHZ wlfw: board data segment %u refused %d/%u\n", wl.bdf_seg - 1, result, error);
+            wl.failed = 1;
+            break;
+        }
+        if (wl.bdf_at < wl.bdf_len) {
+            wl_bdf_segment();
+            break;
+        }
+        printf("COACHZ wlfw: board data sent in %u segments\n", wl.bdf_seg);
+        {
+            const uint8_t none = 0;   /* meta_data: no calibration entries */
+            at = wr_put(t, at, 0x01, &none, 1);
+            wl_request(0x26, t, at);
+        }
+        wl.state = 8;
+        break;
+    case 8:
+        printf("COACHZ wlfw: calibration report %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        wl.state = 9;
+        wl.waited_ms = 0;
+        break;
+    case 9:
+        if (wl.fw_ready) {
+            printf("COACHZ wlfw: WLAN firmware ready; WLAN mode and the copy engines are next\n");
+            wl.state = 10;
+        } else if (++wl.waited_ms >= 30000) {
+            printf("COACHZ wlfw: no FW ready indication in 30 s\n");
+            wl.failed = 1;
+        }
+        break;
+    }
+}
+
+/* One complete QRTR packet from the modem. */
+static void
+wq_rx(const uint8_t *p, uint32_t n)
+{
+    uint32_t type, src_node, src_port, dst_port, size, confirm, hdr;
+    wg.qrtr_rx++;
+    if (n >= 32 && p[0] == 1) {
+        uint32_t h[8];
+        memcpy(h, p, 32);
+        type = h[1]; src_node = h[2]; src_port = h[3]; confirm = h[4]; size = h[5]; dst_port = h[7]; hdr = 32;
+    } else if (n >= 16 && p[0] == 3) {
+        type = p[1]; confirm = p[2] & 1; hdr = 16 + p[3];
+        memcpy(&size, p + 4, 4);
+        src_node = (uint32_t)(p[8] | p[9] << 8); src_port = (uint32_t)(p[10] | p[11] << 8); dst_port = (uint32_t)(p[14] | p[15] << 8);
+        if (src_port == 0xffff) src_port = WQ_CTRL;
+        if (dst_port == 0xffff) dst_port = WQ_CTRL;
+    } else {
+        printf("COACHZ qrtr: %u bytes of version %u refused\n", n, n ? p[0] : 0);
+        return;
+    }
+    if (hdr + size > n) return;
+    const uint8_t *body = p + hdr;
+    uint32_t ctrl[5] = {0};
+    if (type != 1) memcpy(ctrl, body, size < 20 ? size : 20);
+    switch (type) {
+    case 1:
+        if (dst_port == WQ_RMTFS_PORT) wr_request(src_node, src_port, body, size);
+        else if (dst_port == WL_PORT) wl_rx(body, size);
+        else printf("COACHZ qrtr: data for port 0x%x from %u:0x%x\n", dst_port, src_node, src_port);
+        if (confirm) wq_send(7, dst_port, src_node, src_port, (const uint32_t[]){7, WQ_NODE, dst_port, 0, 0}, 20);
+        break;
+    case 2:                             /* HELLO: ns.c ctrl_cmd_hello announces this node's servers to the peer */
+        wg.modem_node = src_node;
+        printf("COACHZ qrtr: hello from node %u\n", src_node);
+        if (!wg.hello_sent) {
+            wq_ctrl(2, 0, 0, 0, 0, src_node);
+            wg.hello_sent = 1;
+        }
+        wq_ctrl(4, 14, 1 | 0 << 8, WQ_NODE, WQ_RMTFS_PORT, src_node);
+        break;
+    case 4:
+        printf("COACHZ qrtr: new server %u version %u instance %u at %u:0x%x\n", ctrl[1], ctrl[2] & 0xff, ctrl[2] >> 8, ctrl[3], ctrl[4]);
+        if (ctrl[1] == 69 && !wl.known) {
+            wl.node = ctrl[3];
+            wl.port = ctrl[4];
+            wl.known = 1;
+        }
+        break;
+    case 5:
+        printf("COACHZ qrtr: server %u gone at %u:0x%x\n", ctrl[1], ctrl[3], ctrl[4]);
+        break;
+    case 10:
+        printf("COACHZ qrtr: lookup for %u from %u:0x%x (remote lookups are ns.c's to refuse)\n", ctrl[1], src_node, src_port);
+        break;
+    default:
+        printf("COACHZ qrtr: control %u from %u:0x%x\n", type, src_node, src_port);
+        break;
+    }
+}
+
+/* Every message waiting in the modem's FIFO, as qcom_glink_native_rx and qcom_glink_work handle them. */
+static void
+wg_poll(void)
+{
+    while (!wg.failed) {
+        const uint32_t avail = wg_rx_avail();
+        uint32_t m[4] = {0};
+        if (avail < 8) break;
+        wg_rx_peek(0, m, 8);
+        const uint32_t cmd = m[0] & 0xffff, p1 = m[0] >> 16, p2 = m[1];
+        wg.messages_in++;
+        if (cmd == WG_VERSION || cmd == WG_VERSION_ACK) {
+            wg_rx_advance(8);
+            const uint32_t features = wg.features & p2;
+            printf("COACHZ glink: %s version %u features 0x%x\n", cmd ? "ack" : "remote", p1, p2);
+            if (cmd == WG_VERSION) {
+                wg.features = features;
+                wg_cmd(WG_VERSION_ACK, 1, wg.features);
+            } else if (features != wg.features) {
+                wg.features = features;
+                wg_cmd(WG_VERSION, 1, wg.features);
+            }
+        } else if (cmd == WG_OPEN) {
+            const uint32_t name_len = p2 & 0xffff, extra = (name_len + 7) & ~7u;
+            if (avail < 8 + extra) break;
+            char name[33] = {0};
+            wg_rx_peek(8, name, name_len < 32 ? name_len : 32);
+            wg_rx_advance(8 + extra);
+            const size_t used = strlen(wg.channels);
+            snprintf(wg.channels + used, sizeof(wg.channels) - used, " %s(%u)", name, p1);
+            if (!strcmp(name, "IPCRTR") && !wg.open_remote) {
+                /* qcom_glink_create_remote: the open acknowledged, then ours with the same name. */
+                wg.rcid = p1;
+                wg.open_remote = 1;
+                wg_cmd(WG_OPEN_ACK, p1, 0);
+                uint32_t req[2 + 2] = {WG_OPEN | WG_LCID << 16, 7, 0, 0};
+                memcpy(&req[2], "IPCRTR", 7);
+                wg_tx(req, 16, NULL, 0);
+            }
+            printf("COACHZ glink: modem opens \"%s\" as %u%s\n", name, p1, strcmp(name, "IPCRTR") ? ", left alone" : "");
+        } else if (cmd == WG_OPEN_ACK) {
+            wg_rx_advance(8);
+            if (p1 == WG_LCID && !wg.open_acked) {
+                wg.open_acked = 1;
+                /* qcom_glink_announce_create's default set: five intents (1 KiB each there; larger here, for rmtfs's iovec requests). */
+                for (unsigned i = 0; i < 5; i++) wg_intent_add(4096);
+                wg.intents_sent = 1;
+                /* af_qrtr.c qrtr_endpoint_register: hello to the peer's control port at once. */
+                wq_ctrl(2, 0, 0, 0, 0, WQ_BCAST);
+                wg.hello_sent = 1;
+                printf("COACHZ glink: IPCRTR open, intents advertised, QRTR hello sent\n");
+            }
+        } else if (cmd == WG_CLOSE) {
+            wg_rx_advance(8);
+            wg_cmd(WG_CLOSE_ACK, p1, 0);
+            printf("COACHZ glink: modem closes %u\n", p1);
+        } else if (cmd == WG_INTENT) {
+            const uint32_t len = 8 + 8 * p2, padded = (len + 7) & ~7u;
+            if (avail < padded) break;
+            for (uint32_t i = 0; i < p2; i++) {
+                uint32_t pair[2];
+                wg_rx_peek(8 + 8 * i, pair, 8);
+                for (unsigned r = 0; r < WG_REMOTE_MAX; r++) {
+                    if (wg.remote[r].valid) continue;
+                    wg.remote[r].valid = 1;
+                    wg.remote[r].busy = 0;
+                    wg.remote[r].size = pair[0];
+                    wg.remote[r].id = pair[1];
+                    break;
+                }
+            }
+            wg_rx_advance(padded);
+            wg_retry_pending();
+        } else if (cmd == WG_RX_DONE || cmd == WG_RX_DONE_REUSE) {
+            wg_rx_advance(8);
+            for (unsigned r = 0; r < WG_REMOTE_MAX; r++) {
+                if (!wg.remote[r].valid || wg.remote[r].id != p2) continue;
+                wg.remote[r].busy = 0;
+                if (cmd == WG_RX_DONE) wg.remote[r].valid = 0;
+            }
+            wg_retry_pending();
+        } else if (cmd == WG_INTENT_REQ) {
+            wg_rx_advance(8);
+            const int granted = !wg_intent_add(p2 < 1024 ? 1024 : p2);
+            wg_cmd(WG_INTENT_REQ_ACK, WG_LCID, (uint32_t)granted);
+        } else if (cmd == WG_INTENT_REQ_ACK || cmd == WG_CLOSE_ACK || cmd == WG_SIGNALS) {
+            wg_rx_advance(8);
+        } else if (cmd == WG_READ_NOTIF) {
+            wg_rx_advance(8);
+            wg_kick();
+        } else if (cmd == WG_TX_DATA || cmd == WG_TX_DATA_CONT) {
+            if (avail < 16) break;
+            wg_rx_peek(0, m, 16);
+            const uint32_t chunk = m[2], left = m[3], padded = (16 + chunk + 7) & ~7u;
+            if (avail < 16 + chunk) break;
+            int slot = -1;
+            for (unsigned i = 0; i < wg.local_count; i++) if (wg.local[i].id == p2) slot = (int)i;
+            if (slot < 0 || wg.local[slot].fill + chunk > wg.local[slot].size) {
+                printf("COACHZ glink: data for intent %u (%u bytes) has no room\n", p2, chunk);
+                wg_rx_advance(padded);
+                continue;
+            }
+            wg_rx_peek(16, wg.local[slot].data + wg.local[slot].fill, chunk);
+            wg.local[slot].fill += chunk;
+            wg_rx_advance(padded);
+            if (!left) {
+                const uint32_t length = wg.local[slot].fill;
+                wg.local[slot].fill = 0;
+                wq_rx(wg.local[slot].data, length);
+                /* qcom_glink_rx_done: the intent kept for reuse when that was negotiated, else given up and a new one advertised. */
+                if (wg.features & WG_FEATURE_REUSE) {
+                    wg_cmd(WG_RX_DONE_REUSE, WG_LCID, p2);
+                } else {
+                    wg_cmd(WG_RX_DONE, WG_LCID, p2);
+                    wg.local[slot].id = ++wg.next_liid;
+                    const uint32_t a[4] = {WG_INTENT | WG_LCID << 16, 1, wg.local[slot].size, wg.local[slot].id};
+                    wg_tx(a, 16, NULL, 0);
+                }
+            }
+        } else {
+            printf("COACHZ glink: command %u (0x%x 0x%x) not understood, link stopped\n", cmd, p1, p2);
+            wg.failed = 1;
+        }
+    }
+}
+
+/* qcom_glink_smem_register, once the modem is up: our FIFO allocated, the modem's descriptor and FIFO found, our tail and head reset,
+ * our version sent. */
+static int
+wg_start(void)
+{
+    struct cw_smem layout;
+    struct cw_item item;
+    const int64_t fifo = wifi_smem_alloc(479, WG_FIFO_BYTES);
+    if (fifo < 0 || !wifi_smem_now(&layout) || !layout.has_modem) return -1;
+    if (cw_smem_find(&wifi_smem_reader, &layout.modem, 478, &item) || item.bytes != 32) return -2;
+    wg.desc = item.offset;
+    if (cw_smem_find(&wifi_smem_reader, &layout.modem, 480, &item) || item.bytes < 1024) return -3;
+    wg.rx = item.offset;
+    wg.rx_bytes = item.bytes;
+    wg.tx = (uint32_t)fifo;
+    wg.features = WG_FEATURE_REUSE;
+    *wifi_smem_word(wg.desc + 8) = 0;
+    *wifi_smem_word(wg.desc + 4) = 0;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    if (!wg.rmtfs) wg.rmtfs = ml_io_map_unmappable((vm_offset_t)wifi_rmtfs_base, (vm_size_t)wifi_rmtfs_size, 0x6);
+    if (!wifi_efs_count) {
+        /* Without images in the blob: four blank 2 MiB ones, which is what Debian's /lib/firmware/rmtfs holds on this machine. */
+        static const char *const names[4] = {"modem_fs1", "modem_fs2", "modem_fsc", "modem_fsg"};
+        for (unsigned i = 0; i < 4; i++) {
+            uint8_t *blank = kalloc_data(2u << 20, Z_WAITOK | Z_ZERO);
+            if (!blank) break;
+            strlcpy(wifi_efs[i].name, names[i], sizeof(wifi_efs[i].name));
+            wifi_efs[i].data = blank;
+            wifi_efs[i].bytes = 2u << 20;
+            wifi_efs_count = (int)i + 1;
+        }
+    }
+    wg_cmd(WG_VERSION, 1, wg.features);
+    printf("COACHZ glink: started, modem FIFO %u bytes, %d EFS images, rmtfs_mem %s\n", wg.rx_bytes, wifi_efs_count,
+        wg.rmtfs ? "mapped" : "not mapped");
+    return 0;
+}
+
+static void
+wg_report(unsigned second)
+{
+    unsigned remote = 0;
+    for (unsigned r = 0; r < WG_REMOTE_MAX; r++) remote += wg.remote[r].valid;
+    printf("COACHZ glink at %u s: rx %llu tx %llu, IPCRTR %s, intents %u ours %u theirs, qrtr rx %llu tx %llu, rmtfs %llu requests %llu sectors, "
+        "opened %u/%u/%u/%u, channels%s\n", second, wg.messages_in, wg.messages_out, wg.open_acked ? "open" : wg.open_remote ? "half open" : "closed",
+        wg.local_count, remote, wg.qrtr_rx, wg.qrtr_tx, wg.rmtfs_ops, wg.rmtfs_sectors, wg.opened[0], wg.opened[1], wg.opened[2],
+        wg.opened[3], wg.channels[0] ? wg.channels : " none");
+}
+
+static void
+wifi_mba_stage2_thread(void *parameter __unused, wait_result_t result __unused)
+{
+    /* As soon as the firmware thread has the verified MBA (there was a fixed wait until 200 s), and qdsp6sw.mbn, which it verifies
+     * next (without it only the MBA runs, as before). */
+    for (unsigned waited = 0; waited < 300 && !wifi_mba_image; waited++) delay(1000 * 1000);
+    for (unsigned waited = 0; waited < 120 && wifi_mba_image && __atomic_load_n(&wifi_mpss_disk, __ATOMIC_ACQUIRE) < 0; waited++)
+        delay(1000 * 1000);
+    const int mpss = __atomic_load_n(&wifi_mpss_disk, __ATOMIC_ACQUIRE) >= 0;
+    const vm_offset_t gcc = wifi_gcc_mss(), qdsp6 = ml_io_map(0x04080000, 0x5000), rmb_page = ml_io_map(0x04180000, 0x1000),
+        tcsr = ml_io_map(0x01f60000, 0x6000), spare_page = ml_io_map(0x01fcb000, 0x1000), aoss = ml_io_map(0x0c2b0000, 0x1000),
+        pdc = ml_io_map(0x0b2e0000, 0x1000), smmu = ml_io_map(0x15000000, 0x1000);
+    if (!gcc || !qdsp6 || !rmb_page || !tcsr || !spare_page || !aoss || !pdc || !smmu || !wifi_qmp_q || !wifi_mba_image) {
+        printf("COACHZ mba: not started (maps %d, qmp %d, image %d)\n", gcc && qdsp6 && rmb_page && tcsr && spare_page && aoss && pdc && smmu,
+            wifi_qmp_q != NULL, wifi_mba_image != NULL);
+        return;
+    }
+    const struct wifi_mba_maps maps = {
+        .gcc = gcc, .tcsr = tcsr, .q6 = (volatile uint32_t *)qdsp6, .rmb = (volatile uint32_t *)rmb_page,
+        .restart = (volatile uint32_t *)aoss, .spare = (volatile uint32_t *)(spare_page + 0x3e4), .pdc_sync = (volatile uint32_t *)(pdc + 0x100),
+    };
+    /* The QDSP6SS and RMB registers are read only once the rails, clocks and reset allow it, as Linux does. */
+    printf("COACHZ mba: apps smmu sCR0 0x%x; mss_restart %u, pdc sync 0x%x, spare 0x%x\n", *(volatile uint32_t *)smmu, *maps.restart,
+        *maps.pdc_sync, *maps.spare);
+    /* Nothing of XNU's may lie in the regions the modem gets (mpss_mem, mba_mem, mpss-metadata, rmtfs_mem): its memory (boot_args,
+     * everything the pmap manages) and the firmware framebuffer the display copies into. No fixed buffer of ours (audio DMA at
+     * 0x81200000) is near them. */
+    const boot_args *args = (const boot_args *)PE_state.bootArgs;
+    PE_Video video;
+    bzero(&video, sizeof(video));
+    const int console = PE_current_console(&video) == 0;
+    const uint64_t fb = video.v_baseAddr, fb_size = (uint64_t)video.v_rowBytes * video.v_height;
+    const int known = args && args->memSize && console && fb && fb_size && fb < (1ull << 40);
+    const uint64_t regions[4][2] = {
+        {wifi_mpss_base, wifi_mpss_size}, {wifi_mba_base, wifi_mba_size}, {wifi_mdata_base, wifi_mdata_size}, {wifi_rmtfs_base, wifi_rmtfs_size},
+    };
+    int memory_clear = known, fb_clear = known;
+    for (unsigned i = 0; i < 4; i++) {
+        memory_clear = memory_clear && cw_disjoint(regions[i][0], regions[i][1], args->physBase, args->memSize);
+        fb_clear = fb_clear && cw_disjoint(regions[i][0], regions[i][1], fb, fb_size);
+    }
+    printf("COACHZ mba: modem regions known %d, clear of XNU memory %d, framebuffer %d; qdsp6sw.mbn %s\n", known, memory_clear, fb_clear,
+        mpss ? "verified" : "missing, MBA only");
+    if (!memory_clear || !fb_clear) {
+        printf("COACHZ mba: not started, a modem region is not known to be free\n");
+        return;
+    }
+    /* Mainline's proxy clock "xo" (RPMH_CXO_CLK, ARC xo.lvl on = 3), active only and kept. */
+    {
+        const vm_offset_t db = wifi_cmd_db();
+        uint32_t address = 0, aux = 0, length = 0, status = 0;
+        const uint32_t on = 3;
+        if (db && wifi_db_find(db, "xo.lvl", &address, &aux, &length)) {
+            const int sent = wifi_rpmh_send(&address, &on, 1, &status);
+            printf("COACHZ mba: xo.lvl address 0x%x on after %d us, status 0x%x\n", address, sent, status);
+        } else {
+            printf("COACHZ mba: xo.lvl not in cmd-db\n");
+        }
+    }
+    /* rmtfs_mem shared with the modem as rmtfs_mem.c does at probe (HLOS and MSS_MSA read-write), kept. */
+    if (mpss) {
+        const uint32_t from = WIFI_VM_HLOS, to[2] = {WIFI_VM_HLOS, WIFI_VM_MSS}, rights[2] = {0x6, 0x6};
+        printf("COACHZ mpss: rmtfs_mem shared with the modem %lld\n",
+            (long long)wifi_assign_vms(wifi_rmtfs_base, wifi_rmtfs_size, &from, 1, to, rights, 2));
+    }
+    /* The AP's SMP2P item, which Linux's smp2p driver makes at boot, long before the modem starts. */
+    if (mpss) {
+        wifi_smem_list("before start");
+        const int64_t made = wifi_smp2p_create();
+        printf("COACHZ smp2p: AP item %u %s (%lld)\n", CW_SMP2P_OUT, made ? "not made" : "made", (long long)made);
+    }
+    /* IPA power before the start, as ipa_modem.c takes it on QCOM_SSR_BEFORE_POWERUP (the modem loads the IPA's GSI firmware). */
+    const int ipa = wifi_ipa_power();
+    printf("COACHZ mba attempt 1: IPA %s\n", ipa ? "vote failed" : "powered");
+    const uint32_t outcome = wifi_mba_attempt(&maps, 1);
+    printf("COACHZ mba attempt 1 result: status 0x%x%s%s\n", outcome & 0xff, (outcome & 0xff) == 1 || (outcome & 0xff) == 2 ? ", MBA ready" : "",
+        outcome & 0x100 ? ", modem running" : "");
+    if (!(outcome & 0x100)) return;
+    /*
+     * The modem runs. Its bits are watched as qcom_q6v5.c's interrupts would see them: every change printed (each second for a minute,
+     * then every 10 s, with a line each minute); at handover the proxy votes go as q6v5_handover drops them (cx/mx/mss to 0; xo stays
+     * voted, as this kernel's own); on a fatal error the crash reason is printed and the watch ends. GLINK starts at once (Linux registers
+     * the edge when the remote processor is up) and its FIFO is serviced every millisecond, with a line every 10 s for the first minutes.
+     */
+    int64_t seen = wifi_modem_bits();
+    int handed = 0;
+    printf("COACHZ mpss: watching the modem, bits %lld\n", (long long)seen);
+    struct cw_smem now_layout;
+    wifi_smem_list("running");
+    wifi_smp2p_print("running");
+    if (wifi_smem_now(&now_layout)) wifi_glink_state(&wifi_smem_reader, &now_layout);
+    const int link = wg_start();
+    if (link) printf("COACHZ glink: not started (%d)\n", link);
+    for (unsigned second = 1;; second++) {
+        for (unsigned ms = 0; ms < 1000; ms++) {
+            if (!link) {
+                wg_poll();
+                wl_step();
+            }
+            delay(1000);
+        }
+        if (!link && (second <= 120 ? !(second % 10) : !(second % 60))) wg_report(second);
+        if (second > 60 && second % 10) continue;
+        const int64_t bits = wifi_modem_bits();
+        if (bits != seen || !(second % 60)) {
+            printf("COACHZ mpss: bits %lld at %u s of running (rmb mba 0x%x)\n", (long long)bits, second, maps.rmb[0x0c / 4]);
+            if (bits != seen) wifi_smp2p_print("change");
+            seen = bits;
+        }
+        if (bits >= 0 && (bits & 4) && !handed) {
+            const uint32_t off[3] = {0, 0, 0};
+            uint32_t status[3] = {0};
+            const int sent = wifi_rpmh_send(wifi_mss_rails, off, 3, status);
+            handed = 1;
+            printf("COACHZ mpss: handover at %u s; proxy rails to 0 after %d us, status 0x%x 0x%x 0x%x\n", second, sent, status[0], status[1], status[2]);
+        }
+        if (second == 30 && wifi_smem_now(&now_layout)) wifi_glink_state(&wifi_smem_reader, &now_layout);
+        if (bits >= 0 && (bits & 1)) {
+            printf("COACHZ mpss: fatal error at %u s\n", second);
+            wifi_modem_reason();
+            if (!link) wg_report(second);
+            return;
+        }
+    }
+}
+
+/* Call from the existing sampler thread after IOKit has started, once. */
+void
+coachz_wifi_start(void)
+{
+    static int started;
+    unsigned mode = 0;
+    if (started || !PE_parse_boot_argn("coachz-wifi", &mode, sizeof(mode)) || mode < 1 || mode > 4) return;
+    started = 1;
+    wifi_mpss_probe();
+    wifi_power_probe();
+    if (mode >= 2) {
+        wifi_qmp_open();
+        wifi_rpmh_vote_test();
+    }
+    {
+        unsigned vote = 0;
+        thread_t thread;
+        if (PE_parse_boot_argn("coachz-ddr-vote", &vote, sizeof(vote)) && (vote == 1 || vote == 2) &&
+            kernel_thread_start(wifi_ddr_vote_thread, NULL, &thread) == KERN_SUCCESS) {
+            thread_deallocate(thread);
+        }
+    }
+    if (mode == 3) {
+        thread_t stage1;
+        if (kernel_thread_start(wifi_mba_stage1_thread, NULL, &stage1) == KERN_SUCCESS) thread_deallocate(stage1);
+    }
+    if (mode == 4) {
+        thread_t stage2;
+        if (kernel_thread_start(wifi_mba_stage2_thread, NULL, &stage2) == KERN_SUCCESS) thread_deallocate(stage2);
+    }
+    {
+        unsigned firmware = 0;
+        thread_t thread;
+        if (PE_parse_boot_argn("coachz-modem-fw", &firmware, sizeof(firmware)) && firmware == 1 &&
+            kernel_thread_start(wifi_firmware_thread, NULL, &thread) == KERN_SUCCESS) {
+            thread_deallocate(thread);
+        }
+    }
+    DTEntry node;
+    const void *property = NULL;
+    unsigned size = 0;
+    const char compatible[] = "google,coachz-wcn3990";
+    if (SecureDTLookupEntry(NULL, "/arm-io/coachz-wifi", &node) != kSuccess ||
+        SecureDTGetProperty(node, "compatible", &property, &size) != kSuccess || size != sizeof(compatible) ||
+        memcmp(property, compatible, sizeof(compatible))) {
+        printf("COACHZ wifi: explicit Coachz ADT node missing, not mapped\n"); return;
+    }
+    if (SecureDTGetProperty(node, "smem-region", &property, &size) != kSuccess || size != 16) {
+        printf("COACHZ wifi: smem-region must contain a physical base and size, not mapped\n"); return;
+    }
+    const uint8_t *range = property;
+    if (cw_u64(range) != CW_SMEM_BASE || cw_u64(range + 8) != CW_SMEM_SIZE) {
+        printf("COACHZ wifi: SMEM differs from this SC7180 layout, not mapped\n"); return;
+    }
+    const boot_args *args = PE_state.bootArgs;
+    if (!args || !cw_disjoint(CW_SMEM_BASE, CW_SMEM_SIZE, args->physBase, args->memSize)) {
+        printf("COACHZ wifi: SMEM overlaps the XNU memory window or boot args are unavailable, not mapped\n"); return;
+    }
+    static struct wifi_mapping mapping;
+    mapping.base = (uintptr_t)ml_io_map((vm_offset_t)CW_SMEM_BASE, CW_SMEM_SIZE);
+    if (!mapping.base) { printf("COACHZ wifi: SMEM map failed\n"); return; }
+    /* Kept for the kernel lifetime; no pointer escapes this module. */
+    const struct cw_reader reader = {&mapping, CW_SMEM_SIZE, wifi_read};
+    struct cw_smem layout;
+    const int status = cw_smem_layout(&reader, &layout);
+    printf("COACHZ wifi: SMEM v12 inventory status %d table entries %u\n", status, layout.count);
+    if (status) return;
+    wifi_partition("global", layout.has_global, &layout.global);
+    wifi_partition("apps-modem", layout.has_modem, &layout.modem);
+    wifi_modem_state(&reader, &layout);
+    wifi_glink_state(&reader, &layout);
+    wifi_smem_reader = reader;
+    wifi_smem_layout = layout;
+    __atomic_store_n(&wifi_smem_ready, 1, __ATOMIC_RELEASE);
+    printf("COACHZ wifi: inventory complete; MPSS/WLFW liveness and radio not tested\n");
+}
