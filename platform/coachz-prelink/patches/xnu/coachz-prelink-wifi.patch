+}
+
+/*
+ * IPA power as mainline takes it before a modem start (ipa_modem.c: QCOM_SSR_BEFORE_POWERUP -> ipa_uc_power -> ipa_power_enable): the
+ * three interconnect paths of ipa_data-v4.2.c (memory 80 MBps average and 465 MBps peak to EBI1, imem 68.57 MBps, config 30 MBps from
+ * the apps) as the BCMs on them in mainline sc7180.c (qnm_aggre2_noc SN9, qns_gemnoc_sf SN0, qxs_imem SN1, qnm_gemnoc SN12, qhs_ipa
+ * CN0; MC0, ACV, SH0 and SH4 already carry the DDR vote's larger peak), then the core clock RPMH_IPA_CLK at 100 MHz (clk-rpmh.c: BCM
+ * IP0, state = rate / (aux unit * 1000), active only, commit). Debian logs "received modem starting event" before the MBA reports.
+ * Kept on: Linux holds it until the IPA microcontroller, which the modem loads, reports in.
+ */
+static int
+wifi_ipa_power(void)
+{
+    static const struct wifi_bcm paths[] = {
+        {"SN9", 16, 1, 0, 80000, 465000}, {"SN0", 16, 1, 0, 80000, 465000}, {"SN1", 8, 1, 0, 0, 68570},
+        {"SN12", 8, 1, 0, 0, 30000}, {"CN0", 4, 1, 0, 0, 30000},
+    };
+    const vm_offset_t db = wifi_cmd_db();
+    if (!db) return -1;
+    const int voted = wifi_bcm_send(db, "ipa", paths, 5);
+    uint32_t address = 0, aux = 0, length = 0, status = 0;
+    if (!wifi_db_find(db, "IP0", &address, &aux, &length) || length < 4) {
+        printf("COACHZ ipa: IP0 not in cmd-db\n");
+        return -2;
+    }
+    const uint32_t unit = wifi_db_u16(db, aux) | wifi_db_u16(db, aux + 2u) << 16;
+    uint64_t state = unit ? 100000000ull / ((uint64_t)unit * 1000u) : 0;
+    if (!state) state = 1;
+    if (state > 0x3fff) state = 0x3fff;
+    const uint32_t data = (1u << 30) | (1u << 29) | (uint32_t)state;
+    const int clocked = wifi_rpmh_send(&address, &data, 1, &status);
+    printf("COACHZ ipa: paths %d; IP0 address 0x%x unit %u state %llu after %d us, status 0x%x\n", voted, address, unit,
+        (unsigned long long)state, clocked, status);
+    return voted >= 0 && clocked >= 0 ? 0 : -3;
+}
+
+/*
+ * The link to the running modem, set up as Linux does once the modem is up: GLINK over SMEM (qcom_glink_smem.c with qcom_glink_native.c;
+ * the AP's FIFO is item 479, the modem's 480, the descriptor 478 holds our FIFO's tail and head, then the modem's), QRTR on GLINK's
+ * "IPCRTR" channel (net/qrtr af_qrtr.c and the in-kernel name service ns.c, this side node 1 as Debian's qrtr-ns -f 1), and the remote
+ * file system the modem keeps its EFS on (linux-msm rmtfs: QMI service 14 version 1 instance 0, 512-byte sectors moved between the EFS
+ * images and rmtfs_mem). The images (modem_fs1, fs2, fsc, fsg) come with the firmware blob and stay in memory: writes are kept there
+ * only, as Debian's rmtfs -r keeps them. Polled: Linux takes the GLINK interrupt (SPI 449) and kicks the modem through the APSS IPC
+ * register bit 12.
+ */
+#define WG_FIFO_BYTES 16384u
+enum {
+    WG_VERSION = 0, WG_VERSION_ACK = 1, WG_OPEN = 2, WG_CLOSE = 3, WG_OPEN_ACK = 4, WG_INTENT = 5, WG_RX_DONE = 6, WG_INTENT_REQ = 7,
+    WG_INTENT_REQ_ACK = 8, WG_TX_DATA = 9, WG_CLOSE_ACK = 11, WG_TX_DATA_CONT = 12, WG_READ_NOTIF = 13, WG_RX_DONE_REUSE = 14, WG_SIGNALS = 15,
+};
+#define WG_FEATURE_REUSE 1u
+#define WG_LCID 1u
+#define WG_LOCAL_MAX 24
+#define WG_REMOTE_MAX 32
+#define WG_PENDING_MAX 8
+#define WQ_NODE 1u                 /* this side's QRTR node */
+#define WQ_CTRL 0xfffffffeu
+#define WQ_BCAST 0xffffffffu
+#define WQ_RMTFS_PORT 0x4000u
+#define WR_SECTOR 512u
+
+
+static struct {
+    uint32_t desc, tx, rx, rx_bytes;
+    uint32_t features;
+    int open_remote, open_acked, intents_sent, hello_sent, failed;
+    uint32_t rcid, next_liid;
+    struct { uint32_t id, size; int busy, valid; } remote[WG_REMOTE_MAX];
+    struct { uint32_t id, size, fill; uint8_t *data; } local[WG_LOCAL_MAX];
+    unsigned local_count;
+    struct { uint8_t *data; uint32_t bytes; int requested; } pending[WG_PENDING_MAX];
+    uint32_t modem_node;
+    vm_offset_t rmtfs;
+    uint32_t opened[4];
+    uint64_t messages_in, messages_out, qrtr_rx, qrtr_tx, rmtfs_ops, rmtfs_sectors;
+    char channels[160];
+} wg;
+
+static void
+wg_kick(void)
+{
+    if (!wifi_qmp_kick) return;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    *wifi_qmp_kick = 1u << 12;
+}
+
+static uint32_t
+wg_rx_avail(void)
+{
+    const uint32_t head = *wifi_smem_word(wg.desc + 12), tail = *wifi_smem_word(wg.desc + 8);
+    if (head >= wg.rx_bytes || tail >= wg.rx_bytes) return 0;
+    return head >= tail ? head - tail : wg.rx_bytes - tail + head;
+}
+
+static void
+wg_rx_peek(uint32_t offset, void *dst, uint32_t count)
+{
+    uint8_t *d = dst;
+    const uint32_t start = *wifi_smem_word(wg.desc + 8) + offset;
+    __asm__ volatile ("dmb oshld" ::: "memory");
+    for (uint32_t i = 0; i < count; i++) {
+        const uint32_t at = (start + i) % wg.rx_bytes;
+        d[i] = (uint8_t)(*wifi_smem_word(wg.rx + (at & ~3u)) >> (8 * (at & 3u)));
+    }
+}
+
+static void
+wg_rx_advance(uint32_t count)
+{
+    const uint32_t tail = (*wifi_smem_word(wg.desc + 8) + count) % wg.rx_bytes;
+    __asm__ volatile ("dmb osh" ::: "memory");
+    *wifi_smem_word(wg.desc + 8) = tail;
+}
+
+static uint32_t
+wg_tx_avail(void)
+{
+    const uint32_t head = *wifi_smem_word(wg.desc + 4), tail = *wifi_smem_word(wg.desc);
+    const uint32_t avail = tail <= head ? WG_FIFO_BYTES - head + tail : tail - head;
+    return avail < 16 ? 0 : avail - 16;   /* FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE */
+}
+
+/* One message, header then payload padded to 8 bytes, written word by word before the head moves, then a kick. */
+static int
+wg_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+    const uint32_t total = (hlen + dlen + 7) & ~7u;
+    if (wg.failed || total > WG_FIFO_BYTES / 2) return -1;
+    for (unsigned waited = 0; wg_tx_avail() < total; waited++) {
+        if (waited >= 2000) {
+            wg.failed = 1;
+            printf("COACHZ glink: our FIFO stayed full\n");
+            return -1;
+        }
+        delay(1000);
+    }
+    uint32_t head = *wifi_smem_word(wg.desc + 4);
+    for (uint32_t i = 0; i < total; i += 4) {
+        uint8_t bytes[4];
+        for (unsigned b = 0; b < 4; b++) {
+            const uint32_t k = i + b;
+            bytes[b] = k < hlen ? ((const uint8_t *)hdr)[k] : k - hlen < dlen ? ((const uint8_t *)data)[k - hlen] : 0;
+        }
+        uint32_t word;
+        memcpy(&word, bytes, 4);
+        *wifi_smem_word(wg.tx + head) = word;
+        head = (head + 4) % WG_FIFO_BYTES;
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+    *wifi_smem_word(wg.desc + 4) = head;
+    wg_kick();
+    wg.messages_out++;
+    return 0;
+}
+
+static void
+wg_cmd(uint32_t cmd, uint32_t p1, uint32_t p2)
+{
+    const uint32_t m[2] = {cmd | p1 << 16, p2};
+    wg_tx(m, 8, NULL, 0);
+}
+
+/* qcom_glink_advertise_intent: a buffer of size bytes the modem may fill, one message each. */
+static int
+wg_intent_add(uint32_t size)
+{
+    if (wg.local_count >= WG_LOCAL_MAX || !size || size > 65536) return -1;
+    uint8_t *buf = kalloc_data(size, Z_WAITOK);
+    if (!buf) return -1;
+    const unsigned i = wg.local_count++;
+    wg.local[i].id = ++wg.next_liid;
+    wg.local[i].size = size;
+    wg.local[i].fill = 0;
+    wg.local[i].data = buf;
+    const uint32_t m[4] = {WG_INTENT | WG_LCID << 16, 1, size, wg.local[i].id};
+    return wg_tx(m, 16, NULL, 0);
+}
+
+/* A message on IPCRTR: in a free intent the modem advertised, or queued with an RX_INTENT_REQ until it advertises one. */
+static int
+wg_send(const void *data, uint32_t len)
+{
+    for (unsigned i = 0; i < WG_REMOTE_MAX; i++) {
+        if (!wg.remote[i].valid || wg.remote[i].busy || wg.remote[i].size < len) continue;
+        wg.remote[i].busy = 1;
+        const uint32_t h[4] = {WG_TX_DATA | WG_LCID << 16, wg.remote[i].id, len, 0};
+        wg.qrtr_tx++;
+        return wg_tx(h, 16, data, len);
+    }
+    for (unsigned p = 0; p < WG_PENDING_MAX; p++) {
+        if (wg.pending[p].data) continue;
+        wg.pending[p].data = kalloc_data(len, Z_WAITOK);
+        if (!wg.pending[p].data) return -1;
+        memcpy(wg.pending[p].data, data, len);
+        wg.pending[p].bytes = len;
+        wg.pending[p].requested = 1;
+        wg_cmd(WG_INTENT_REQ, WG_LCID, len);
+        return 0;
+    }
+    printf("COACHZ glink: no intent and the queue is full, %u bytes dropped\n", len);
+    return -1;
+}
+
+static void
+wg_retry_pending(void)
+{
+    for (unsigned p = 0; p < WG_PENDING_MAX; p++) {
+        if (!wg.pending[p].data) continue;
+        for (unsigned i = 0; i < WG_REMOTE_MAX; i++) {
+            if (!wg.remote[i].valid || wg.remote[i].busy || wg.remote[i].size < wg.pending[p].bytes) continue;
+            wg.remote[i].busy = 1;
+            const uint32_t h[4] = {WG_TX_DATA | WG_LCID << 16, wg.remote[i].id, wg.pending[p].bytes, 0};
+            wg.qrtr_tx++;
+            wg_tx(h, 16, wg.pending[p].data, wg.pending[p].bytes);
+            kfree_data(wg.pending[p].data, wg.pending[p].bytes);
+            wg.pending[p].data = NULL;
+            break;
+        }
+    }
+}
+
+/* A QRTR v1 packet (af_qrtr.c qrtr_node_enqueue: control packets go to the peer node's control port). */
+static void
+wq_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *payload, uint32_t len)
+{
+    static uint8_t packet[32 + 8192];
+    if (len > 8192) return;
+    const uint32_t h[8] = {1, type, WQ_NODE, src_port, 0, len, dst_node, dst_port};
+    memcpy(packet, h, 32);
+    memcpy(packet + 32, payload, len);
+    const uint32_t padded = (len + 3) & ~3u;
+    bzero(packet + 32 + len, padded - len);
+    wg_send(packet, 32 + padded);
+}
+
+static void
+wq_ctrl(uint32_t cmd, uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint32_t dst_node)
+{
+    const uint32_t pkt[5] = {cmd, a, b, c, d};
+    wq_send(cmd, WQ_CTRL, dst_node, WQ_CTRL, pkt, sizeof(pkt));
+}
+
+/* QMI over QRTR (soc/qcom/qmi_interface.c): a 7-byte header (type, transaction, message, length) and TLVs (type, u16 length). */
+static int
+wr_tlv(const uint8_t *body, uint32_t n, uint8_t want, const uint8_t **value, uint16_t *len)
+{
+    for (uint32_t at = 0; at + 3 <= n;) {
+        const uint8_t type = body[at];
+        const uint16_t l = (uint16_t)(body[at + 1] | body[at + 2] << 8);
+        if (at + 3 + l > n) return 0;
+        if (type == want) {
+            *value = body + at + 3;
+            *len = l;
+            return 1;
+        }
+        at += 3 + l;
+    }
+    return 0;
+}
+
+static uint32_t
+wr_put(uint8_t *out, uint32_t at, uint8_t type, const void *value, uint16_t len)
+{
+    out[at] = type;
+    out[at + 1] = (uint8_t)len;
+    out[at + 2] = (uint8_t)(len >> 8);
+    memcpy(out + at + 3, value, len);
+    return at + 3 + len;
+}
+
+/* rmtfs.c's handlers, for one request from the modem's client at (node, port). */
+static void
+wr_request(uint32_t node, uint32_t port, const uint8_t *msg, uint32_t n)
+{
+    if (n < 7 || msg[0] != 0) return;
+    const uint16_t txn = (uint16_t)(msg[1] | msg[2] << 8), id = (uint16_t)(msg[3] | msg[4] << 8);
+    const uint16_t blen = (uint16_t)(msg[5] | msg[6] << 8);
+    const uint8_t *body = msg + 7;
+    if (7u + blen > n) return;
+    uint8_t out[64];
+    uint32_t at = 7;
+    uint16_t result[2] = {0, 0};
+    const uint8_t *v = NULL;
+    uint16_t l = 0;
+    wg.rmtfs_ops++;
+    if (id == 1) {                      /* OPEN: path -> caller id */
+        char path[64] = {0};
+        int found = -1;
+        if (wr_tlv(body, blen, 1, &v, &l)) memcpy(path, v, l < sizeof(path) - 1 ? l : sizeof(path) - 1);
+        for (int i = 0; i < wifi_efs_count; i++) {
+            char want[32];
+            snprintf(want, sizeof(want), "/boot/%s", wifi_efs[i].name);
+            if (!strcmp(path, want)) found = i;
+        }
+        if (found < 0) {
+            result[0] = 1;
+            result[1] = 1;
+        } else {
+            wg.opened[found]++;
+        }
+        at = wr_put(out, at, 2, result, 4);
+        if (found >= 0) {
+            const uint32_t caller = (uint32_t)found + 1;
+            at = wr_put(out, at, 16, &caller, 4);
+        }
+        printf("COACHZ rmtfs: open \"%s\" -> %d\n", path, found + 1);
+    } else if (id == 2) {               /* CLOSE */
+        at = wr_put(out, at, 2, result, 4);
+    } else if (id == 3) {               /* RW_IOVEC: sectors between the image and rmtfs_mem */
+        uint32_t caller = 0;
+        uint8_t direction = 0;
+        if (wr_tlv(body, blen, 1, &v, &l) && l >= 4) memcpy(&caller, v, 4);
+        if (wr_tlv(body, blen, 2, &v, &l) && l >= 1) direction = v[0];
+        const struct wifi_efs *efs = caller >= 1 && caller <= (uint32_t)wifi_efs_count ? &wifi_efs[caller - 1] : NULL;
+        if (!efs || !wg.rmtfs || !wr_tlv(body, blen, 3, &v, &l) || l < 1 || 1u + v[0] * 12u > l) {
+            result[0] = 1;
+            result[1] = 2;
+        } else {
+            for (uint32_t e = 0; e < v[0] && !result[0]; e++) {
+                uint32_t entry[3];
+                memcpy(entry, v + 1 + 12 * e, 12);
+                for (uint32_t s = 0; s < entry[2]; s++) {
+                    const uint64_t sector = ((uint64_t)entry[0] + s) * WR_SECTOR, phys = (uint64_t)entry[1] + s * WR_SECTOR;
+                    if (phys < wifi_rmtfs_base || phys + WR_SECTOR > wifi_rmtfs_base + wifi_rmtfs_size || sector + WR_SECTOR > efs->bytes) {
+                        result[0] = 1;
+                        result[1] = 1;
+                        break;
+                    }
+                    uint8_t *shared = (uint8_t *)(wg.rmtfs + (phys - wifi_rmtfs_base));
+                    if (direction) memcpy(efs->data + sector, shared, WR_SECTOR);
+                    else memcpy(shared, efs->data + sector, WR_SECTOR);
+                    wg.rmtfs_sectors++;
+                }
+            }
+            __asm__ volatile ("dsb sy" ::: "memory");
+        }
+        at = wr_put(out, at, 2, result, 4);
+    } else if (id == 4) {               /* ALLOC_BUFF: rmtfs_mem */
+        uint32_t size = 0;
+        if (wr_tlv(body, blen, 2, &v, &l) && l >= 4) memcpy(&size, v, 4);
+        const uint64_t address = wifi_rmtfs_base;
+        if (size > wifi_rmtfs_size) {
+            result[0] = 1;
+            result[1] = 1;
+        }
+        at = wr_put(out, at, 2, result, 4);
+        if (!result[0]) at = wr_put(out, at, 16, &address, 8);
+        printf("COACHZ rmtfs: buffer of %u bytes -> %s\n", size, result[0] ? "refused" : "rmtfs_mem");
+    } else if (id == 5) {               /* GET_DEV_ERROR */
+        const uint8_t status = 0;
+        at = wr_put(out, at, 2, result, 4);
+        at = wr_put(out, at, 16, &status, 1);
+    } else {
+        printf("COACHZ rmtfs: request 0x%x not handled\n", id);
+        return;
+    }
+    out[0] = 2;
+    out[1] = (uint8_t)txn;
+    out[2] = (uint8_t)(txn >> 8);
+    out[3] = (uint8_t)id;
+    out[4] = (uint8_t)(id >> 8);
+    out[5] = (uint8_t)(at - 7);
+    out[6] = (uint8_t)((at - 7) >> 8);
+    wq_send(1, WQ_RMTFS_PORT, node, port, out, at);
+}
+
+/*
+ * WLFW, the WLAN firmware service the modem announces (QMI service 69 version 1), as ath10k's qmi.c drives it on a WCN3990 over SNOC:
+ * on the server's arrival the indication registration (fw_ready, msa_ready, client id), the host capability (daemon_support 0), the MSA
+ * information (wlan_mem, 0x94100000 2 MiB; qcom,msa-fixed-perm, so no permission change), 20 ms, MSA ready and the capability query;
+ * once the MSA-ready indication came, the board data (board-2.bin's entry for "bus=snoc,qmi-board-id=<id>", as
+ * ath10k_core_create_board_name names it without a calibration variant, which this machine's device tree has none of) in 6144-byte
+ * segments, then an empty calibration report, then the FW-ready indication awaited. TLVs as qmi_wlfw_v01.c encodes them. WLAN mode and
+ * the copy engines are the next step: nothing here turns the radio on.
+ */
+#define WL_PORT 0x4001u
+#define WL_SEGMENT 6144u
+static uint8_t wl_message[7 + 64 + WL_SEGMENT];
+
+static struct {
+    uint32_t node, port;
+    int known, state, msa_ready, fw_ready, failed;
+    uint16_t txn, want_id, want_txn;
+    unsigned waited_ms;
+    uint8_t resp[1024];
+    uint32_t resp_len;
+    int resp_ready;
+    uint32_t chip_id, chip_family, board_id, soc_id, fw_version;
+    char build_id[96], timestamp[40];
+    const uint8_t *bdf;
+    uint32_t bdf_len, bdf_seg, bdf_at;
+} wl;
+
+static void
+wl_request(uint16_t id, const uint8_t *tlvs, uint32_t len)
+{
+    const uint16_t txn = ++wl.txn;
+    wl_message[0] = 0;
+    wl_message[1] = (uint8_t)txn;
+    wl_message[2] = (uint8_t)(txn >> 8);
+    wl_message[3] = (uint8_t)id;
+    wl_message[4] = (uint8_t)(id >> 8);
+    wl_message[5] = (uint8_t)len;
+    wl_message[6] = (uint8_t)(len >> 8);
+    if (len) memmove(wl_message + 7, tlvs, len);
+    wl.want_id = id;
+    wl.want_txn = txn;
+    wl.resp_ready = 0;
+    wl.waited_ms = 0;
+    wq_send(1, WL_PORT, wl.node, wl.port, wl_message, 7 + len);
+}
+
+/* A response's result TLV (type 2: result, error); 0 when it succeeded. */
+static int
+wl_result(uint16_t *error)
+{
+    const uint8_t *v = NULL;
+    uint16_t l = 0;
+    *error = 0xffff;
+    if (!wr_tlv(wl.resp + 7, wl.resp_len - 7, 2, &v, &l) || l < 4) return -1;
+    *error = (uint16_t)(v[2] | v[3] << 8);
+    return v[0] | v[1] << 8;
+}
+
+/* A QMI message from WLFW to our port: the awaited response, or an indication. */
+static void
+wl_rx(const uint8_t *m, uint32_t n)
+{
+    if (n < 7) return;
+    const uint8_t type = m[0];
+    const uint16_t txn = (uint16_t)(m[1] | m[2] << 8), id = (uint16_t)(m[3] | m[4] << 8);
+    if (type == 2 && id == wl.want_id && txn == wl.want_txn && n <= sizeof(wl.resp)) {
+        memcpy(wl.resp, m, n);
+        wl.resp_len = n;
+        wl.resp_ready = 1;
+    } else if (type == 4 && id == 0x2b) {
+        wl.msa_ready = 1;
+        printf("COACHZ wlfw: MSA ready indication\n");
+    } else if (type == 4 && id == 0x21) {
+        wl.fw_ready = 1;
+        printf("COACHZ wlfw: FW ready indication\n");
+    } else {
+        printf("COACHZ wlfw: message type %u id 0x%x txn %u (%u bytes) not awaited\n", type, id, txn, n);
+    }
+}
+
+/* board-2.bin (ath10k core.c): "QCA-ATH10K-BOARD" padded to 20 bytes, then IEs {id, length, data padded to 4}; a board IE (0) holds
+ * a name IE (0) and a data IE (1). */
+static int
+wl_board(const char *want, const uint8_t **data, uint32_t *len)
+{
+    if (!wifi_board || wifi_board_bytes < 28 || memcmp(wifi_board, "QCA-ATH10K-BOARD", 16)) return 0;
+    for (size_t at = 20; at + 8 <= wifi_board_bytes;) {
+        uint32_t h[2];
+        memcpy(h, wifi_board + at, 8);
+        if (h[1] > wifi_board_bytes - at - 8) return 0;
+        if (h[0] == 0) {
+            const uint8_t *body = wifi_board + at + 8;
+            const uint8_t *name = NULL, *blob = NULL;
+            uint32_t name_len = 0, blob_len = 0;
+            for (uint32_t s = 0; s + 8 <= h[1];) {
+                uint32_t sh[2];
+                memcpy(sh, body + s, 8);
+                if (sh[1] > h[1] - s - 8) break;
+                if (sh[0] == 0) { name = body + s + 8; name_len = sh[1]; }
+                if (sh[0] == 1) { blob = body + s + 8; blob_len = sh[1]; }
+                s += 8 + ((sh[1] + 3) & ~3u);
+            }
+            if (name && blob && name_len == strlen(want) && !memcmp(name, want, name_len)) {
+                *data = blob;
+                *len = blob_len;
+                return 1;
+            }
+        }
+        at += 8 + ((h[1] + 3) & ~3u);
+    }
+    return 0;
+}
+
+static void
+wl_bdf_segment(void)
+{
+    static uint8_t t[64 + WL_SEGMENT];
+    uint32_t at = 0;
+    const uint32_t remaining = wl.bdf_len - wl.bdf_at, n = remaining > WL_SEGMENT ? WL_SEGMENT : remaining;
+    const uint8_t valid = 1, end = n == remaining;
+    const int32_t file_id = 0;
+    at = wr_put(t, at, 0x01, &valid, 1);
+    at = wr_put(t, at, 0x10, &file_id, 4);
+    at = wr_put(t, at, 0x11, &wl.bdf_len, 4);
+    at = wr_put(t, at, 0x12, &wl.bdf_seg, 4);
+    t[at] = 0x13;
+    t[at + 1] = (uint8_t)(n + 2);
+    t[at + 2] = (uint8_t)((n + 2) >> 8);
+    t[at + 3] = (uint8_t)n;
+    t[at + 4] = (uint8_t)(n >> 8);
+    memcpy(t + at + 5, wl.bdf + wl.bdf_at, n);
+    at += 5 + n;
+    at = wr_put(t, at, 0x14, &end, 1);
+    wl_request(0x25, t, at);
+    wl.bdf_at += n;
+    wl.bdf_seg++;
+}
+
+/*
+ * ath10k_hw_power_on before the QMI client starts: the WCN3990's five supplies (sc7180-trogdor.dtsi), as the regulator core and
+ * qcom-rpmh-regulator.c leave them on Debian here (read back there: these voltages, normal mode, enabled): the initial mode (HPM, 7)
+ * when the regulator registers, then at enable the cached voltage in mV and the enable bit, each an active-only VRM request waited for.
+ * The SoC has no "qdss" or "cxo_ref_clk_pin" clock on this node.
+ */
+static const struct { const char *name, *supply; uint32_t mv; } wl_supplies[5] = {
+    {"ldoa9", "vdd-0.8-cx-mx", 488}, {"ldoc1", "vdd-1.8-xo", 1616}, {"ldoc2", "vdd-1.3-rfa", 1168}, {"ldoc10", "vdd-3.3-ch0", 3000},
+    {"ldoc11", "vdd-3.3-ch1", 3000},
+};
+
+static int
+wl_power_on(void)
+{
+    const vm_offset_t db = wifi_cmd_db();
+    int failed = 0;
+    for (unsigned i = 0; i < 5; i++) {
+        uint32_t address = 0, aux = 0, length = 0;
+        if (!db || !wifi_db_find(db, wl_supplies[i].name, &address, &aux, &length)) {
+            printf("COACHZ wlan: %s (%s) not in cmd-db\n", wl_supplies[i].name, wl_supplies[i].supply);
+            failed++;
+            continue;
+        }
+        const uint32_t reg[3] = {address + 8, address, address + 4}, value[3] = {7, wl_supplies[i].mv, 1};
+        uint32_t status[3] = {0};
+        int sent[3];
+        for (unsigned j = 0; j < 3; j++) sent[j] = wifi_rpmh_send(&reg[j], &value[j], 1, &status[j]);
+        printf("COACHZ wlan: %s (%s) at 0x%x: mode HPM %d us, %u mV %d us, enabled %d us (status 0x%x 0x%x 0x%x)\n", wl_supplies[i].name,
+            wl_supplies[i].supply, address, sent[0], wl_supplies[i].mv, sent[1], sent[2], status[0], status[1], status[2]);
+        if (sent[0] < 0 || sent[1] < 0 || sent[2] < 0) failed++;
+    }
+    return failed;
+}
+
+/*
+ * The WCN3990's copy engines (ath10k ce.c with snoc.c's tables and hw.c's wcn3990 registers; hw_params target_64bit, shadow_reg_support,
+ * rri_on_ddr). Twelve CEs at membase + 0x240000 + 0x1000 * id, 16-byte descriptors {address with bits 32-34 in the second word,
+ * length, flags with the HTC endpoint in bits 4-15, hash}. The firmware writes every ring's read indices to a host array (RRI); source
+ * write indices go to the shadow registers at membase + 0x32000, destination write indices to the CE. Linux's coherent DMA memory (no
+ * dma-coherent on this node) is a write-combining (Normal non-cacheable) window in low DRAM outside the kernel's: the apps SMMU is
+ * disabled here (sCR0 CLIENTPD), so the device sees these physical addresses.
+ */
+#define WC_COUNT 12
+#define WC_MEMBASE 0x18800000ull
+#define WC_MEM_PA 0x81800000ull          /* ordinary RAM in Debian's tree, outside every reserved-memory node */
+#define WC_MEM_BYTES 0x800000u
+#define WC_DIS_INTR 8u                   /* CE_ATTR_DIS_INTR */
+#define WC_CTRL1 0x18u
+#define WC_HOST_IE 0x2cu
+#define WC_STATUS 0x30u
+#define WC_MISC_IE 0x34u
+#define WC_SR_WRITE 0x3cu
+#define WC_DR_WRITE 0x40u
+#define WC_SR_READ 0x44u
+#define WC_DR_READ 0x48u
+#define WC_SRC_WM 0x4cu
+#define WC_DST_WM 0x50u
+
+/* host_ce_config_wlan: flags, source entries and maximum, destination entries, callbacks (1 send, 2 receive). */
+static const struct { uint32_t flags, src_n, src_max, dst_n, cb; } wc_host[WC_COUNT] = {
+    {0, 16, 2048, 0, 1}, {0, 0, 2048, 512, 2}, {0, 0, 2048, 64, 2}, {0, 32, 2048, 0, 1}, {WC_DIS_INTR, 2048, 256, 0, 1},
+    {0, 0, 512, 512, 2}, {0, 0, 0, 0, 0}, {0, 2, 2048, 2, 0}, {0, 0, 2048, 128, 0}, {0, 0, 2048, 512, 2}, {0, 0, 2048, 512, 2},
+    {0, 0, 2048, 512, 2},
+};
+/* target_ce_config_wlan: pipe, direction (1 in, 2 out, 3 both), entries, maximum bytes, flags. */
+static const uint32_t wc_target[WC_COUNT][5] = {
+    {0, 2, 32, 2048, 0}, {1, 1, 32, 2048, 0}, {2, 1, 64, 2048, 0}, {3, 2, 32, 2048, 0}, {4, 2, 256, 256, WC_DIS_INTR},
+    {5, 2, 1024, 64, WC_DIS_INTR}, {6, 3, 32, 16384, 0}, {7, 4, 0, 0, WC_DIS_INTR}, {8, 1, 32, 2048, 0}, {9, 1, 32, 2048, 0},
+    {10, 1, 32, 2048, 0}, {11, 1, 32, 2048, 0},
+};
+/* target_service_to_ce_map_wlan, its terminating zero entry included (Linux sends the whole array). */
+static const uint32_t wc_services[21][3] = {
+    {0x104, 2, 3}, {0x104, 1, 2}, {0x102, 2, 3}, {0x102, 1, 2}, {0x101, 2, 3}, {0x101, 1, 2}, {0x103, 2, 3}, {0x103, 1, 2},
+    {0x100, 2, 3}, {0x100, 1, 2}, {0x001, 2, 0}, {0x001, 1, 2}, {0xfe00, 2, 0}, {0xfe00, 1, 2}, {0x300, 2, 4}, {0x300, 1, 1},
+    {0xfe00, 2, 5}, {0x301, 1, 9}, {0x302, 1, 10}, {0x600, 1, 11}, {0, 0, 0},
+};
+/* target_shadow_reg_cfg_map: CE and the register the firmware shadows. */
+static const uint16_t wc_shadow[12][2] = {
+    {0, 0x3c}, {3, 0x3c}, {4, 0x3c}, {5, 0x3c}, {7, 0x3c}, {1, 0x40}, {2, 0x40}, {7, 0x40}, {8, 0x40}, {9, 0x40}, {10, 0x40}, {11, 0x40},
+};
+
+struct wc_ring { uint32_t n, mask, sw, write, hw; uint8_t *desc; uint64_t desc_pa; uint8_t *buf; uint64_t buf_pa; };
+static struct {
+    volatile uint8_t *regs, *shadow;
+    uint8_t *mem;
+    uint32_t used;
+    volatile uint32_t *rri;
+    uint64_t rri_pa;
+    struct wc_ring src[WC_COUNT], dst[WC_COUNT];
+    volatile uint32_t pending, masked;
+    volatile uint32_t *gicd;
+    int window_clear, up, irq;
+    uint32_t repeats[WC_COUNT];
+    uint64_t irqs[WC_COUNT], rx[WC_COUNT], tx[WC_COUNT], tx_done[WC_COUNT], rx_bad;
+} wc;
+
+static inline uint32_t wc_r(unsigned id, uint32_t reg) { return *(volatile uint32_t *)(wc.regs + 0x1000u * id + reg); }
+static inline void wc_w(unsigned id, uint32_t reg, uint32_t v) { *(volatile uint32_t *)(wc.regs + 0x1000u * id + reg) = v; }
+
+static uint8_t *
+wc_alloc(uint32_t bytes, uint64_t *pa)
+{
+    const uint32_t at = (wc.used + 63u) & ~63u;
+    if (at > WC_MEM_BYTES || bytes > WC_MEM_BYTES - at) return NULL;
+    wc.used = at + bytes;
+    *pa = WC_MEM_PA + at;
+    return wc.mem + at;
+}
+
+/* ath10k_ce_src_ring_read_index_get / dest: from the RRI array for DIS_INTR pipes, else the CE's current read index register. */
+static uint32_t
+wc_src_read(unsigned id)
+{
+    return (wc_host[id].flags & WC_DIS_INTR) ? (wc.rri[id] & 0xffffu) : wc_r(id, WC_SR_READ);
+}
+
+static uint32_t
+wc_dst_read(unsigned id)
+{
+    return (wc_host[id].flags & WC_DIS_INTR) ? ((wc.rri[id] >> 16) & 0xffffu) : wc_r(id, WC_DR_READ);
+}
+
+/* ath10k_snoc_hif_power_up after wlan_enable: the register windows and rings, ath10k_ce_alloc_rri, ath10k_ce_init_pipe for every CE
+ * and ath10k_ce_enable_interrupts (copy complete on for the CEs with a callback and without DIS_INTR, watermarks off). */
+static int
+wc_power_up(void)
+{
+    if (!wc.window_clear) return -1;
+    if (!wc.regs) wc.regs = (volatile uint8_t *)ml_io_map((vm_offset_t)(WC_MEMBASE + 0x240000u), 0xd000);
+    if (!wc.shadow) wc.shadow = (volatile uint8_t *)ml_io_map((vm_offset_t)(WC_MEMBASE + 0x32000u), 0x1000);
+    if (!wc.mem) wc.mem = (uint8_t *)ml_io_map_wcomb((vm_offset_t)WC_MEM_PA, WC_MEM_BYTES);
+    if (!wc.regs || !wc.shadow || !wc.mem) return -2;
+    wc.used = 0;
+    bzero(wc.mem, WC_MEM_BYTES);
+    wc.rri = (volatile uint32_t *)wc_alloc(WC_COUNT * 4u, &wc.rri_pa);
+    for (unsigned id = 0; id < WC_COUNT; id++) {
+        struct wc_ring *s = &wc.src[id], *d = &wc.dst[id];
+        bzero(s, sizeof(*s));
+        bzero(d, sizeof(*d));
+        if (wc_host[id].src_n) {
+            s->n = wc_host[id].src_n;
+            s->desc = wc_alloc(16u * s->n, &s->desc_pa);
+            if (wc_host[id].cb & 1) s->buf = wc_alloc(s->n * wc_host[id].src_max, &s->buf_pa);
+        }
+        if (wc_host[id].dst_n) {
+            d->n = wc_host[id].dst_n;
+            d->desc = wc_alloc(16u * d->n, &d->desc_pa);
+            if (wc_host[id].src_max) d->buf = wc_alloc(d->n * wc_host[id].src_max, &d->buf_pa);
+        }
+        if ((s->n && !s->desc) || (d->n && (!d->desc || (wc_host[id].src_max && !d->buf)))) return -3;
+        s->mask = s->n ? s->n - 1 : 0;
+        d->mask = d->n ? d->n - 1 : 0;
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+    wc_w(0, 0xc004u, (uint32_t)wc.rri_pa);   /* ce_rri_low and high: membase + 0x24c004 / 0x24c008 */
+    wc_w(0, 0xc008u, (uint32_t)(wc.rri_pa >> 32) & 0x1fu);
+    for (unsigned id = 0; id < WC_COUNT; id++) wc_w(id, WC_CTRL1, wc_r(id, WC_CTRL1) | 0x80000u);
+    for (unsigned id = 0; id < WC_COUNT; id++) {
+        struct wc_ring *s = &wc.src[id], *d = &wc.dst[id];
+        if (s->n) {
+            s->sw = wc_src_read(id) & s->mask;
+            s->hw = s->sw;
+            s->write = wc_r(id, WC_SR_WRITE) & s->mask;
+            wc_w(id, 0x00, (uint32_t)s->desc_pa);
+            wc_w(id, 0x04, (uint32_t)(s->desc_pa >> 32) & 0x1fu);
+            wc_w(id, 0x08, s->n);
+            wc_w(id, WC_CTRL1, (wc_r(id, WC_CTRL1) & ~0xffffu) | (wc_host[id].src_max & 0xffffu));
+            wc_w(id, WC_CTRL1, wc_r(id, WC_CTRL1) & ~(1u << 17));
+            wc_w(id, WC_SRC_WM, wc_r(id, WC_SRC_WM) & ~0xffff0000u);
+            wc_w(id, WC_SRC_WM, (wc_r(id, WC_SRC_WM) & ~0xffffu) | (s->n & 0xffffu));
+        }
+        if (d->n) {
+            d->sw = wc_dst_read(id) & d->mask;
+            d->write = wc_r(id, WC_DR_WRITE) & d->mask;
+            wc_w(id, 0x0c, (uint32_t)d->desc_pa);
+            wc_w(id, 0x10, (wc_r(id, 0x10) & ~0x1fu) | ((uint32_t)(d->desc_pa >> 32) & 0x1fu));
+            wc_w(id, 0x14, d->n);
+            wc_w(id, WC_CTRL1, wc_r(id, WC_CTRL1) & ~(1u << 18));
+            wc_w(id, WC_DST_WM, wc_r(id, WC_DST_WM) & ~0xffff0000u);
+            wc_w(id, WC_DST_WM, (wc_r(id, WC_DST_WM) & ~0xffffu) | (d->n & 0xffffu));
+        }
+    }
+    for (unsigned id = 0; id < WC_COUNT; id++) {
+        const uint32_t ie = wc_r(id, WC_HOST_IE);
+        wc_w(id, WC_HOST_IE, (!(wc_host[id].flags & WC_DIS_INTR) && wc_host[id].cb) ? ie | 1u : ie & ~1u);
+        wc_w(id, WC_HOST_IE, wc_r(id, WC_HOST_IE) & ~0x1eu);
+    }
+    wc.up = 1;
+    return 0;
+}
+
+/* __ath10k_ce_rx_post_buf_64 for every free entry (ath10k_snoc_rx_post_pipe): entry i always holds buffer slot i. */
+static void
+wc_rx_post(unsigned id)
+{
+    struct wc_ring *d = &wc.dst[id];
+    if (!d->n || !d->buf) return;
+    for (uint32_t free = ((d->sw - 1u) - d->write) & d->mask; free; free--) {
+        uint8_t *desc = d->desc + 16u * d->write;
+        const uint64_t address = (d->buf_pa + (uint64_t)d->write * wc_host[id].src_max) & ((1ull << 35) - 1);
+        memcpy(desc, &address, 8);
+        desc[8] = desc[9] = 0;
+        d->write = (d->write + 1u) & d->mask;
+        __asm__ volatile ("dsb st" ::: "memory");
+        wc_w(id, WC_DR_WRITE, d->write);
+    }
+}
+
+/* _ath10k_ce_send_nolock_64 of one buffer (no gather): copied into the slot of the write index, the index then written to the CE's
+ * shadow register. */
+static int
+wc_send(unsigned id, const void *data, uint32_t bytes, uint32_t transfer_id)
+{
+    static const uint32_t shadow[WC_COUNT] = {0x00, 0, 0, 0x0c, 0x10, 0x14, 0, 0x1c, 0, 0, 0, 0};
+    struct wc_ring *s = &wc.src[id];
+    if (!wc.up || !s->n || !s->buf || bytes > wc_host[id].src_max) return -1;
+    const uint32_t sw = wc.rri[id] & 0xffffu;
+    if (!(((sw - 1u) - s->write) & s->mask)) return -2;   /* ring full (ENOSR) */
+    const uint64_t pa = s->buf_pa + (uint64_t)s->write * wc_host[id].src_max;
+    memcpy(s->buf + (uint64_t)s->write * wc_host[id].src_max, data, bytes);
+    uint8_t *desc = s->desc + 16u * s->write;
+    const uint32_t words[2] = {(uint32_t)pa, (uint32_t)(pa >> 32) & 0x1fu};
+    const uint16_t length = (uint16_t)bytes, flags = (uint16_t)((transfer_id << 4) & 0xfff0u);
+    memcpy(desc, words, 8);
+    memcpy(desc + 8, &length, 2);
+    memcpy(desc + 10, &flags, 2);
+    s->write = (s->write + 1u) & s->mask;
+    __asm__ volatile ("dsb st" ::: "memory");
+    *(volatile uint32_t *)(wc.shadow + shadow[id]) = s->write;
+    wc.tx[id]++;
+    return 0;
+}
+
+static void wh_rx(unsigned pipe, const uint8_t *data, uint32_t bytes);
+static void ws_scan_event(const uint8_t *m, uint32_t n);
+static void ws_chan_info(const uint8_t *m, uint32_t n);
+static void ws_mgmt_rx(const uint8_t *m, uint32_t n);
+/* Past READY (ws_next and the wl_step states from 20). Addresses are only hashed to count them; names are never read. */
+static struct {
+    unsigned step, number;
+    uint8_t mac[8];
+    uint8_t htt_version, htt_major, htt_minor, started, completed;
+    uint32_t events, channels, last_mhz, reason, last_type;
+    uint32_t mgmt, beacons, band2, band5, bad, snr_best, bss, bss_hash[64];
+    uint32_t chan_infos, htt_types[32], wmi_ids[12], wmi_counts[12];
+    int32_t noise_low, noise_high;
+    uint32_t busy_most;
+} ws;
+
+/* ath10k_ce_per_engine_service: the copy complete and watermark status cleared, completed receives handed to HTC and their entries
+ * posted again (_ath10k_ce_completed_recv_next_nolock_64: a zero length is not done yet), completed sends retired
+ * (_ath10k_ce_completed_send_next_nolock_64). */
+static void
+wc_service(unsigned id)
+{
+    wc_w(id, WC_STATUS, 0x1u | 0x1eu);
+    struct wc_ring *d = &wc.dst[id], *s = &wc.src[id];
+    if (wc_host[id].cb & 2) {
+        for (;;) {
+            uint8_t *desc = d->desc + 16u * d->sw;
+            uint16_t bytes;
+            memcpy(&bytes, desc + 8, 2);
+            if (!bytes) break;
+            desc[8] = desc[9] = 0;
+            const uint8_t *data = d->buf + (uint64_t)d->sw * wc_host[id].src_max;
+            d->sw = (d->sw + 1u) & d->mask;
+            wc.rx[id]++;
+            if (bytes > wc_host[id].src_max) { wc.rx_bad++; continue; }
+            wh_rx(id, data, bytes);
+        }
+        wc_rx_post(id);
+    }
+    if (wc_host[id].cb & 1) {
+        for (;;) {
+            if (s->hw == s->sw) {
+                const uint32_t read = wc_src_read(id);
+                if (read == 0xffffffffu) break;
+                s->hw = read & s->mask;
+            }
+            if ((wc_src_read(id) & s->mask) == s->sw) break;
+            s->desc[16u * s->sw + 8] = s->desc[16u * s->sw + 9] = 0;
+            s->sw = (s->sw + 1u) & s->mask;
+            wc.tx_done[id]++;
+        }
+    }
+}
+
+/* ath10k_ce_per_engine_handler_adjust, and ath10k_ce_disable_interrupt (copy complete, errors and watermarks off). */
+static void
+wc_enable(unsigned id)
+{
+    const uint32_t ie = wc_r(id, WC_HOST_IE);
+    wc_w(id, WC_HOST_IE, (!(wc_host[id].flags & WC_DIS_INTR) && wc_host[id].cb) ? ie | 1u : ie & ~1u);
+    wc_w(id, WC_HOST_IE, wc_r(id, WC_HOST_IE) & ~0x1eu);
+}
+
+/* ath10k_snoc_per_engine_handler: SPI 414 + CE, level high. The CE's interrupts go off and the service loop takes it, as NAPI does.
+ * Not in Linux: a line that keeps firing while its CE is still pending (its interrupt enables did not silence it) is masked at the
+ * GIC after 1000 repeats and reported, so it cannot hold a core. */
+static void
+wc_irq(void *context)
+{
+    const unsigned id = (unsigned)(uintptr_t)context;
+    if (id >= WC_COUNT || !wc.up) return;
+    wc_w(id, WC_HOST_IE, wc_r(id, WC_HOST_IE) & ~1u);
+    wc_w(id, WC_MISC_IE, wc_r(id, WC_MISC_IE) & ~0x3e0u);
+    wc_w(id, WC_HOST_IE, wc_r(id, WC_HOST_IE) & ~0x1eu);
+    wc.irqs[id]++;
+    const uint32_t before = __atomic_fetch_or(&wc.pending, 1u << id, __ATOMIC_ACQ_REL);
+    if (!(before & (1u << id))) { wc.repeats[id] = 0; return; }
+    if (++wc.repeats[id] >= 1000 && wc.gicd) {
+        const uint32_t intid = 32u + 414u + id;
+        wc.gicd[(0x180u + (intid / 32u) * 4u) / 4u] = 1u << (intid % 32u);   /* GICD_ICENABLER */
+        __atomic_or_fetch(&wc.masked, 1u << id, __ATOMIC_RELEASE);
+    }
+}
+
+/* ath10k_snoc_hif_start: the twelve CE interrupts (requested with IRQF_NO_AUTOEN, enabled here) and every receive ring filled. */
+static void
+wc_start(void)
+{
+    extern int armcpu_spi_attach(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *);   /* ArmCpu.cpp, IOReturn */
+    unsigned attached = 0;
+    if (!wc.gicd) wc.gicd = (volatile uint32_t *)ml_io_map(0x17a00000, 0x1000);
+    for (unsigned id = 0; id < WC_COUNT; id++) {
+        uint32_t readback = 0;
+        uint64_t router = 0;
+        const int status = armcpu_spi_attach(32u + 414u + id, false, wc_irq, (void *)(uintptr_t)id, &readback, &router);
+        if (!status) attached++;
+        else printf("COACHZ wlan: CE%u interrupt (SPI %u) not attached: 0x%x\n", id, 414u + id, status);
+    }
+    wc.irq = attached == WC_COUNT;
+    for (unsigned id = 0; id < WC_COUNT; id++) wc_rx_post(id);
+    printf("COACHZ wlan: copy engines up, %u of 12 interrupts, %u KiB of ring and buffer memory at 0x%llx\n", attached, wc.used >> 10,
+        (unsigned long long)WC_MEM_PA);
+}
+
+/* The service loop's share (ath10k_snoc_napi_poll): every CE whose interrupt fired, serviced and its interrupt enabled again; all of
+ * them when an interrupt could not be attached, or when ath10k_htc_wait_target's workaround forces it. */
+static void
+wc_poll(int all)
+{
+    if (!wc.up) return;
+    const uint32_t pending = all || !wc.irq ? (1u << WC_COUNT) - 1u : __atomic_exchange_n(&wc.pending, 0u, __ATOMIC_ACQUIRE);
+    for (unsigned id = 0; id < WC_COUNT; id++) {
+        if (!(pending & (1u << id))) continue;
+        wc_service(id);
+        if (wc.irq) wc_enable(id);
+    }
+}
+
+/*
+ * HTC (htc.c) on those pipes: an 8-byte header {endpoint, flags, payload length, trailer length or sequence, padding}; endpoint 0 is
+ * the control service (connected locally to pipes 0 and 2, without credit flow), the WMI control service alone has credit flow and all
+ * of the target's credits (use_fw_tx_credits is false for WCN3990: one), credit reports arrive in trailers.
+ */
+#define WH_EPS 9
+static struct {
+    struct { uint16_t service, max_len; uint8_t ul, dl, flow, seq; int credits; uint64_t rx, tx; } ep[WH_EPS];
+    uint8_t ctl[256];
+    uint32_t ctl_len;
+    volatile int ctl_new;
+    uint16_t credit_count, credit_size, alt_credit_size;
+    uint8_t max_eps, bundle;
+    int total_credits, htt, wmi, log;
+    uint32_t wmi_events, htt_messages, log_messages, unsolicited, dropped;
+    uint32_t last_wmi, last_wmi_len;
+    uint8_t svc_rdy[2048], svc_avail[256], rdy[512];
+    uint32_t svc_rdy_len, svc_avail_len, rdy_len;
+    int service_ready, service_available, ready_event;
+    uint32_t wmi_ids[8], wmi_lens[8];
+} wh;
+
+static int
+wh_map(uint16_t service, uint8_t *ul, uint8_t *dl)
+{
+    int up = 0, down = 0;
+    for (unsigned i = 0; i < 21; i++) {
+        if (wc_services[i][0] != service) continue;
+        if (wc_services[i][1] == 1 || wc_services[i][1] == 3) { *dl = (uint8_t)wc_services[i][2]; down = 1; }
+        if (wc_services[i][1] == 2 || wc_services[i][1] == 3) { *ul = (uint8_t)wc_services[i][2]; up = 1; }
+    }
+    return up && down ? 0 : -1;
+}
+
+/* ath10k_htc_init: endpoint states reset, the pseudo control service connected. */
+static void
+wh_init(void)
+{
+    bzero(&wh, sizeof(wh));
+    for (unsigned e = 0; e < WH_EPS; e++) wh.ep[e].flow = 1;
+    wh.htt = wh.wmi = wh.log = -1;
+    wh.ep[0].service = 0x0001;
+    wh.ep[0].max_len = 256;
+    wh.ep[0].flow = 0;
+    (void)wh_map(0x0001, &wh.ep[0].ul, &wh.ep[0].dl);
+}
+
+/* ath10k_htc_send: credits consumed on a flow-controlled endpoint, the header put before the payload, one CE send on the endpoint's
+ * uplink pipe with the endpoint as transfer id. */
+static int
+wh_send(unsigned eid, const void *payload, uint32_t bytes)
+{
+    static uint8_t m[2048];   /* the service thread's only */
+    if (eid >= WH_EPS || bytes + 8u > sizeof(m)) return -1;
+    if (wh.ep[eid].flow) {
+        if (!wh.credit_size) return -3;
+        const int need = (int)((bytes + 8u + wh.credit_size - 1u) / wh.credit_size);
+        if (wh.ep[eid].credits < need) return -2;
+        wh.ep[eid].credits -= need;
+    }
+    m[0] = (uint8_t)eid;
+    m[1] = wh.ep[eid].flow ? 1 : 0;   /* ATH10K_HTC_FLAG_NEED_CREDIT_UPDATE */
+    m[2] = (uint8_t)bytes;
+    m[3] = (uint8_t)(bytes >> 8);
+    m[4] = 0;
+    m[5] = wh.ep[eid].seq++;
+    m[6] = m[7] = 0;
+    memcpy(m + 8, payload, bytes);
+    const int sent = wc_send(wh.ep[eid].ul, m, bytes + 8u, eid);
+    if (!sent) wh.ep[eid].tx++;
+    return sent;
+}
+
+/* ath10k_htc_rx_completion_handler with the trailer's credit reports (ath10k_htc_process_trailer), then the endpoint's handler. */
+static void
+wh_rx(unsigned pipe, const uint8_t *d, uint32_t n)
+{
+    (void)pipe;
+    if (n < 8) { wh.dropped++; return; }
+    const uint8_t eid = d[0], flags = d[1];
+    const uint32_t len = (uint32_t)(d[2] | d[3] << 8);
+    if (eid >= WH_EPS || !wh.ep[eid].service || len + 8u > 4096u || n - 8u < len) { wh.dropped++; return; }
+    uint32_t trailer = 0;
+    if (flags & 2) {
+        trailer = d[4];
+        if (trailer < 4 || trailer > len) { wh.dropped++; return; }
+        const uint8_t *r = d + 8 + len - trailer;
+        for (int left = (int)trailer; left > 0;) {
+            if (left < 4 || r[1] > left) { wh.dropped++; return; }
+            if (r[0] == 1)
+                for (unsigned k = 0; k + 4u <= r[1]; k += 4) {
+                    if (r[4 + k] >= WH_EPS) break;
+                    wh.ep[r[4 + k]].credits += r[5 + k];
+                }
+            left -= 4 + r[1];
+            r += 4 + r[1];
+        }
+    }
+    if ((int)len - (int)trailer <= 0) return;
+    const uint8_t *p = d + 8;
+    const uint32_t bytes = len - trailer;
+    wh.ep[eid].rx++;
+    if (eid == 0) {
+        const uint16_t id = bytes >= 2 ? (uint16_t)(p[0] | p[1] << 8) : 0;
+        if (id == 1 || id == 3) {
+            wh.ctl_len = bytes < sizeof(wh.ctl) ? bytes : sizeof(wh.ctl);
+            memcpy(wh.ctl, p, wh.ctl_len);
+            wh.ctl_new = 1;
+        } else {
+            wh.unsolicited++;
+        }
+    } else if ((int)eid == wh.wmi) {
+        /* WMI-TLV: a 32-bit header with the event id in bits 0-23, then TLVs {length, tag}. */
+        uint32_t header = 0;
+        if (bytes >= 4) memcpy(&header, p, 4);
+        wh.last_wmi = header & 0xffffffu;
+        wh.last_wmi_len = bytes;
+        if (wh.wmi_events < 8) { wh.wmi_ids[wh.wmi_events] = wh.last_wmi; wh.wmi_lens[wh.wmi_events] = bytes; }
+        for (unsigned i = 0; i < 12; i++) {
+            if (!ws.wmi_ids[i] || ws.wmi_ids[i] == wh.last_wmi) {
+                ws.wmi_ids[i] = wh.last_wmi;
+                ws.wmi_counts[i]++;
+                break;
+            }
+        }
+        wh.wmi_events++;
+        /* WMI_TLV_SERVICE_READY_EVENTID 1, READY 2, SERVICE_AVAILABLE 3: kept whole (without the header) for the sequence. */
+        if (wh.last_wmi == 1 && !wh.service_ready && bytes - 4 <= sizeof(wh.svc_rdy)) {
+            wh.svc_rdy_len = bytes - 4;
+            memcpy(wh.svc_rdy, p + 4, wh.svc_rdy_len);
+            wh.service_ready = 1;
+        } else if (wh.last_wmi == 3 && !wh.service_available && bytes - 4 <= sizeof(wh.svc_avail)) {
+            wh.svc_avail_len = bytes - 4;
+            memcpy(wh.svc_avail, p + 4, wh.svc_avail_len);
+            wh.service_available = 1;
+        } else if (wh.last_wmi == 2 && !wh.ready_event && bytes - 4 <= sizeof(wh.rdy)) {
+            wh.rdy_len = bytes - 4;
+            memcpy(wh.rdy, p + 4, wh.rdy_len);
+            wh.ready_event = 1;
+        } else if (wh.last_wmi == 0x4002 && bytes >= 4) {   /* WMI_TLV_CHAN_INFO_EVENTID */
+            ws_chan_info(p + 4, bytes - 4);
+        } else if (wh.last_wmi == 0x3001 && bytes >= 4) {   /* WMI_TLV_SCAN_EVENTID */
+            ws_scan_event(p + 4, bytes - 4);
+        } else if (wh.last_wmi == 0x7001 && bytes >= 4) {   /* WMI_TLV_MGMT_RX_EVENTID */
+            ws_mgmt_rx(p + 4, bytes - 4);
+        }
+    } else if ((int)eid == wh.htt) {
+        wh.htt_messages++;
+        if (bytes && p[0] < 32) ws.htt_types[p[0]]++;
+        /* ath10k_htt_t2h_msg_handler: VERSION_CONF is message 0 in every map, then minor and major. */
+        if (bytes >= 3 && p[0] == 0) {
+            ws.htt_minor = p[1];
+            ws.htt_major = p[2];
+            ws.htt_version = 1;
+        }
+    } else if ((int)eid == wh.log) {
+        wh.log_messages++;
+    }
+}
+
+/* ath10k_htc_connect_service's request: the service, its credit allocation and the flow-control flag. */
+static int
+wh_connect(uint16_t service)
+{
+    const uint8_t alloc = service == 0x0100 ? (uint8_t)wh.total_credits : 0;
+    const uint16_t flags = (uint16_t)(alloc << 8) | (service != 0x0100 ? 1u << 3 : 0);
+    const uint8_t m[8] = {2, 0, (uint8_t)service, (uint8_t)(service >> 8), (uint8_t)flags, (uint8_t)(flags >> 8), 0, 0};
+    wh.ctl_new = 0;
+    return wh_send(0, m, sizeof(m));
+}
+
+/* Its response: the endpoint set up (service, credits, flow control, pipes); the endpoint, or a negative status. */
+static int
+wh_connected(uint16_t service)
+{
+    if (wh.ctl_len < 8 || (wh.ctl[0] | wh.ctl[1] << 8) != 3 || (wh.ctl[2] | wh.ctl[3] << 8) != service) return -1;
+    const uint8_t status = wh.ctl[4], eid = wh.ctl[5];
+    const uint16_t max_len = (uint16_t)(wh.ctl[6] | wh.ctl[7] << 8);
+    printf("COACHZ htc: service 0x%x status %u endpoint %u max message %u\n", service, status, eid, max_len);
+    if (status || eid >= WH_EPS || !max_len || wh.ep[eid].service) return -2;
+    wh.ep[eid].service = service;
+    wh.ep[eid].max_len = max_len;
+    wh.ep[eid].credits = service == 0x0100 ? wh.total_credits : 0;
+    wh.ep[eid].flow = service == 0x0100;
+    if (wh_map(service, &wh.ep[eid].ul, &wh.ep[eid].dl)) return -3;
+    return eid;
+}
+
+/*
+ * WMI-TLV (wmi-tlv.c). Messages are a 32-bit header holding the command or event id in bits 0-23, then TLVs {length, tag} padded
+ * to 4 bytes. Tags: ARRAY_UINT32 16, ARRAY_STRUCT 18, SERVICE_READY_EVENT 32, HAL_REG_CAPABILITIES 33, WLAN_HOST_MEM_REQ 34,
+ * READY_EVENT 35, INIT_CMD 74, RESOURCE_CONFIG 75, WLAN_HOST_MEMORY_CHUNK 76.
+ */
+#define WM_ABI_VER0 0x01000000u   /* major 1, minor 0 */
+#define WM_ABI_VER1 53u
+#define WM_ABI_NS0 0x5f414351u
+#define WM_ABI_NS1 0x00004c4du
+static const uint8_t *
+wm_tlv(const uint8_t *m, uint32_t n, uint16_t tag, unsigned nth, uint16_t *len)
+{
+    for (uint32_t at = 0; at + 4 <= n;) {
+        const uint16_t l = (uint16_t)(m[at] | m[at + 1] << 8), t = (uint16_t)(m[at + 2] | m[at + 3] << 8);
+        if (at + 4 + l > n) return NULL;
+        if (t == tag && !nth--) { *len = l; return m + at + 4; }
+        at += 4 + ((l + 3u) & ~3u);
+    }
+    return NULL;
+}
+static uint32_t wm_u32(const uint8_t *v, unsigned word) { uint32_t x; memcpy(&x, v + 4 * word, 4); return x; }
+
+static struct {
+    uint32_t chunks, chunk_id[16], chunk_pa[16], chunk_bytes[16];
+    int rx_full_reorder, ack_rssi, extend_address;
+} wm;
+
+/* ath10k_wmi_tlv_op_pull_svc_rdy_ev and ath10k_wmi_event_service_ready_work: the ABI check, the service map (four services per
+ * 32-bit word in this bitmap), and host memory for each request (num_units from the vdev/peer counts when its flags say so, one
+ * chunk of num_units * unit_size rounded to 4), here from the copy engines' window. 0 when WMI init may be sent. */
+static int
+wm_service_ready(void)
+{
+    uint16_t lev = 0, lreg = 0, lmem = 0, lsvc = 0;
+    const uint8_t *ev = wm_tlv(wh.svc_rdy, wh.svc_rdy_len, 32, 0, &lev), *reg = wm_tlv(wh.svc_rdy, wh.svc_rdy_len, 33, 0, &lreg),
+                  *mem = NULL, *svc = wm_tlv(wh.svc_rdy, wh.svc_rdy_len, 16, 0, &lsvc);
+    /* ath10k_wmi_tlv_svc_rdy_parse keeps the last ARRAY_STRUCT as the memory requests and the first ARRAY_UINT32 as the services. */
+    for (unsigned nth = 0;; nth++) {
+        uint16_t l = 0;
+        const uint8_t *a = wm_tlv(wh.svc_rdy, wh.svc_rdy_len, 18, nth, &l);
+        if (!a) break;
+        mem = a;
+        lmem = l;
+    }
+    if (!ev || lev < 4 * 21 || !reg || lreg < 4 * 9 || !mem || !svc) {
+        printf("COACHZ wmi: service ready incomplete (event %d, reg %d, mem %d, services %d)\n", ev != NULL, reg != NULL, mem != NULL, svc != NULL);
+        return -1;
+    }
+    const int abi = wm_u32(ev, 1) == WM_ABI_VER0 && wm_u32(ev, 3) == WM_ABI_NS0 && wm_u32(ev, 4) == WM_ABI_NS1 && !wm_u32(ev, 5) && !wm_u32(ev, 6);
+    const unsigned svc_words = lsvc / 4u;
+    wm.rx_full_reorder = 65u / 4u < svc_words && (wm_u32(svc, 65u / 4u) >> (65u % 4u) & 1u);
+    printf("COACHZ wmi: service ready: fw build 0x%x abi 0x%x/%u ns 0x%x 0x%x %s, phy 0x%x frag %u rf chains %u ht 0x%x vht 0x%x mcs 0x%x tx power %u..%u, "
+        "sys 0x%x, %u mem requests, %u scan channels, board %u; regdomain 0x%x 2 GHz %u..%u 5 GHz %u..%u; %u service words, rx full reorder %d\n",
+        wm_u32(ev, 0), wm_u32(ev, 1), wm_u32(ev, 2), wm_u32(ev, 3), wm_u32(ev, 4), abi ? "matches" : "differs", wm_u32(ev, 7), wm_u32(ev, 8),
+        wm_u32(ev, 9), wm_u32(ev, 10), wm_u32(ev, 11), wm_u32(ev, 12), wm_u32(ev, 13), wm_u32(ev, 14), wm_u32(ev, 15), wm_u32(ev, 18),
+        wm_u32(ev, 19), wm_u32(ev, 20), wm_u32(reg, 0), wm_u32(reg, 5), wm_u32(reg, 6), wm_u32(reg, 7), wm_u32(reg, 8), svc_words,
+        wm.rx_full_reorder);
+    if (!abi) return -2;
+    /* Extended services (128 and up) from SERVICE_AVAILABLE, 32 a word: TX_DATA_MGMT_ACK_RSSI 174, SUPPORT_EXTEND_ADDRESS 179. */
+    if (wh.service_available && wh.svc_avail_len >= 8) {
+        /* Its one TLV (SERVICE_AVAILABLE_EVENT): the word count, then the words. */
+        const uint16_t l = (uint16_t)(wh.svc_avail[0] | wh.svc_avail[1] << 8);
+        const uint8_t *v = wh.svc_avail + 4;
+        if (l >= 8 && 4u + l <= wh.svc_avail_len) {
+            const uint32_t count = wm_u32(v, 0), words = (l - 4u) / 4u;
+            const unsigned ack = 174 - 128, ext = 179 - 128;
+            wm.ack_rssi = ack / 32 < count && ack / 32 < words && (wm_u32(v, 1 + ack / 32) >> (ack % 32) & 1u);
+            wm.extend_address = ext / 32 < count && ext / 32 < words && (wm_u32(v, 1 + ext / 32) >> (ext % 32) & 1u);
+        }
+    }
+    const uint32_t requests = wm_u32(ev, 18);
+    wm.chunks = 0;
+    for (unsigned i = 0; i < requests && i < 16; i++) {
+        uint16_t lr = 0;
+        const uint8_t *r = wm_tlv(mem, lmem, 34, i, &lr);
+        if (!r || lr < 16) { printf("COACHZ wmi: mem request %u missing\n", i); return -3; }
+        const uint32_t id = wm_u32(r, 0), unit = wm_u32(r, 1), info = wm_u32(r, 2);
+        uint32_t units = wm_u32(r, 3);
+        if (info & 4) units = 33 + 1;        /* NUM_UNITS_IS_NUM_ACTIVE_PEERS: no active peers, max_num_peers + 1 */
+        else if (info & 2) units = 33 + 1;   /* NUM_UNITS_IS_NUM_PEERS */
+        else if (info & 1) units = 4 + 1;    /* NUM_UNITS_IS_NUM_VDEVS */
+        const uint64_t bytes = (uint64_t)units * ((unit + 3u) & ~3u);
+        uint64_t pa = 0;
+        uint8_t *va = bytes && bytes < WC_MEM_BYTES ? wc_alloc((uint32_t)bytes, &pa) : NULL;
+        printf("COACHZ wmi: mem request %u: id %u unit %u info 0x%x units %u -> %llu bytes %s\n", i, id, unit, info, units,
+            (unsigned long long)bytes, va ? "allocated" : "not available");
+        if (!va) return -4;
+        bzero(va, (size_t)bytes);
+        wm.chunk_id[wm.chunks] = id;
+        wm.chunk_pa[wm.chunks] = (uint32_t)pa;
+        wm.chunk_bytes[wm.chunks] = (uint32_t)bytes;
+        wm.chunks++;
+    }
+    return 0;
+}
+
+/* ath10k_wmi_tlv_op_gen_init with WCN3990's parameters (hw_params num_peers 33, ast_skid_limit 16, num_wds_entries 2; TLV
+ * firmware: 4 vdevs, 1056 MSDU descriptors, native wifi decap; no wow patterns before mac registration), sent on the WMI endpoint
+ * (ath10k_wmi_cmd_send: the header, then one HTC send that takes a credit). */
+static int
+wm_send_init(void)
+{
+    static uint8_t m[4 + 4 + 28 + 4 + 46 * 4 + 4 + 16 * 20];
+    uint32_t at = 0;
+    const uint32_t header = 0x1;   /* WMI_TLV_INIT_CMDID */
+#define WM_PUT32(v) do { const uint32_t w_ = (v); memcpy(m + at, &w_, 4); at += 4; } while (0)
+#define WM_TLV(tag, len) do { const uint16_t l_ = (uint16_t)(len), t_ = (uint16_t)(tag); memcpy(m + at, &l_, 2); memcpy(m + at + 2, &t_, 2); at += 4; } while (0)
+    WM_PUT32(header);
+    WM_TLV(74, 28);
+    WM_PUT32(WM_ABI_VER0); WM_PUT32(WM_ABI_VER1); WM_PUT32(WM_ABI_NS0); WM_PUT32(WM_ABI_NS1); WM_PUT32(0); WM_PUT32(0);
+    WM_PUT32(wm.chunks);
+    const uint32_t cfg[46] = {
+        4, 33, wm.rx_full_reorder ? 4u : 0u, wm.rx_full_reorder ? 4u : 0u, 2, 66, 16, 0x7, 0x7, 0x64, 0x64, 0x64, 0x28,
+        1, 4, 4, 4, 8, 0, 0, 0, 0x400, 2, 0, 0, 0, 0, 2, 1056, 2, 1, 0x20, 2, 5, 0, 6, 0, 1, 1, 0, 0, 0, 0,
+        (1u << 9) | (wm.ack_rssi ? 1u << 18 : 0u), 0, 0,
+    };
+    /* The structure's order: num_vdevs, num_peers, offload peers and reorder buffers, peer keys, tids, ast_skid_limit, tx and rx
+     * chain masks, rx_timeout_pri[4], rx_decap_mode, scan_max_pending_reqs, bmiss and roam offload vdevs, roam AP profiles, mcast
+     * groups and table elements, mcast2ucast, tx_dbg_log_size, num_wds_entries, dma_burst_size, mac_aggr_delim, defrag check,
+     * vow_config, gtk offload vdevs, num_msdu_desc, max_frag_entries, tdls vdevs and table entries, beacon offload vdevs, multicast
+     * filters, wow filters, keep alive patterns and size, tdls sleep and buffer sta, wmi_send_separate, ocb vdevs, channels and
+     * schedules, host_capab: 44 words. */
+    WM_TLV(75, 44 * 4);
+    for (unsigned i = 0; i < 44; i++) WM_PUT32(cfg[i]);
+    WM_TLV(18, wm.chunks * 20);
+    for (unsigned i = 0; i < wm.chunks; i++) {
+        WM_TLV(76, 16);
+        WM_PUT32(wm.chunk_id[i]); WM_PUT32(wm.chunk_pa[i]); WM_PUT32(wm.chunk_bytes[i]);
+        WM_PUT32(wm.extend_address ? 0u : 0u);   /* upper 32 bits: the window is below 4 GiB */
+    }
+#undef WM_PUT32
+#undef WM_TLV
+    printf("COACHZ wmi: init: %u bytes, %u host memory chunks, rx full reorder %d, ack rssi %d, extended addresses %d\n", at, wm.chunks,
+        wm.rx_full_reorder, wm.ack_rssi, wm.extend_address);
+    return wh_send((unsigned)wh.wmi, m, at);
+}
+
+/* ath10k_start's order past ath10k_core_start, ath10k_regd_update, ath10k_update_channel_list, ath10k_add_interface and
+ * ath10k_hw_scan. With no SSID the scan is passive and every channel is marked passive, so the radio only listens. */
+static const uint16_t ws_mhz[] = {2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+    5180, 5200, 5220, 5240, 5745, 5765, 5785, 5805, 5825};
+#define WS_CHANS (sizeof(ws_mhz) / sizeof(ws_mhz[0]))
+#define WS_PUT32(v) do { const uint32_t w_ = (v); memcpy(m + at, &w_, 4); at += 4; } while (0)
+#define WS_TLV(tag, len) do { const uint16_t l_ = (uint16_t)(len), t_ = (uint16_t)(tag); memcpy(m + at, &l_, 2); memcpy(m + at + 2, &t_, 2); at += 4; } while (0)
+
+/* ath10k_htt_rx_alloc and ath10k_htt_rx_ring_refill: a ring of 64-bit buffer addresses (target_64bit) and the index the firmware reads
+ * for how many are posted. Half a ring, HTT_RX_RING_FILL_LEVEL: the 8 MiB window has no room for this chip's larger level. */
+#define WS_RX_RING 2048u
+#define WS_RX_FILL 1023u
+#define WS_RX_BUF 2048u
+#define WS_FRAG_DESCS 1056u   /* TARGET_TLV_NUM_MSDU_DESC */
+#define WS_FRAG_DESC 72u      /* sizeof(struct htt_msdu_ext_desc_64) */
+static uint64_t ws_ring_pa, ws_index_pa, ws_frag_pa;
+
+static int
+ws_htt_prepare(void)
+{
+    uint64_t buffers_pa = 0;
+    uint8_t *ring = wc_alloc(WS_RX_RING * 8u, &ws_ring_pa), *index = wc_alloc(4, &ws_index_pa), *buffers = wc_alloc(WS_RX_FILL * WS_RX_BUF, &buffers_pa),
+            *frags = wc_alloc(WS_FRAG_DESCS * WS_FRAG_DESC, &ws_frag_pa);
+    if (!ring || !index || !buffers || !frags) return -1;
+    memset(ring, 0, WS_RX_RING * 8u);
+    memset(buffers, 0, WS_RX_FILL * WS_RX_BUF);
+    memset(frags, 0, WS_FRAG_DESCS * WS_FRAG_DESC);
+    for (uint32_t i = 0; i < WS_RX_FILL; i++) {
+        const uint64_t pa = buffers_pa + (uint64_t)i * WS_RX_BUF;
+        memcpy(ring + 8u * i, &pa, 8);
+    }
+    const uint32_t posted = WS_RX_FILL;
+    memcpy(index, &posted, 4);
+    __asm__ volatile ("dsb st" ::: "memory");
+    return 0;
+}
+
+/* ath10k_htt_setup past the version: ath10k_htt_send_frag_desc_bank_cfg_64, ath10k_htt_send_rx_ring_cfg_64, ath10k_htt_h2t_aggr_cfg_msg_v2. */
+static int
+ws_htt_next(unsigned step)
+{
+    uint8_t m[64];
+    uint32_t bytes = 0;
+    memset(m, 0, sizeof(m));
+    if (step == 0) {
+        m[0] = 6;               /* HTT_H2T_MSG_TYPE_FRAG_DESC_BANK_CFG */
+        m[2] = 1;               /* one bank; info 0: no peer flow control, so no queue state */
+        m[3] = WS_FRAG_DESC;
+        memcpy(m + 4, &ws_frag_pa, 8);
+        const uint16_t last = WS_FRAG_DESCS - 1u;
+        memcpy(m + 4 + 32 + 2, &last, 2);
+        m[4 + 32 + 16 + 8] = 1;   /* q_state.record_size, HTT_TX_Q_STATE_ENTRY_SIZE */
+        bytes = 4 + 32 + 16 + 12;
+    } else if (step == 1) {
+        /* rx desc offsets in 4-byte units, from struct htt_rx_desc_v2 compiled with Linux's rx_desc.h: header, payload, PPDU start and end,
+         * MPDU start and end, MSDU start and end, attention, frag info. */
+        static const uint16_t offsets[10] = {74, 90, 27, 37, 4, 26, 7, 12, 1, 2};
+        const uint16_t values[4] = {WS_RX_RING, WS_RX_BUF, 0xffff /* every HTT_RX_RING_FLAGS_ */, WS_RX_FILL};
+        m[0] = 2;               /* HTT_H2T_MSG_TYPE_RX_RING_CFG */
+        m[1] = 1;               /* one ring */
+        memcpy(m + 4, &ws_index_pa, 8);
+        memcpy(m + 12, &ws_ring_pa, 8);
+        memcpy(m + 20, values, sizeof(values));
+        memcpy(m + 28, offsets, sizeof(offsets));
+        bytes = 48;
+    } else {
+        m[0] = 5;               /* HTT_H2T_MSG_TYPE_AGGR_CFG */
+        m[1] = 64;              /* ATH10K_HTT_MAX_NUM_AMPDU_DEFAULT */
+        m[2] = 3;               /* ATH10K_HTT_MAX_NUM_AMSDU_DEFAULT */
+        bytes = 4;
+    }
+    return wh_send((unsigned)wh.htt, m, bytes);
+}
+
+/* The next command before the scan: 0 sent, 1 when none is left, otherwise wh_send's error (-2 waits for credits). */
+static int
+ws_next(void)
+{
+    if (ws.step < 3) {
+        const int sent = ws_htt_next(ws.step);
+        if (!sent) ws.step++;
+        return sent;
+    }
+    const unsigned command = ws.step - 3u;
+    static const struct { uint32_t id, value; } param[] = {
+        {0x22, 1},   /* PMF_QOS */
+        {0x0a, 1},   /* DYNAMIC_BW */
+        {0x2c, 1},   /* IDLE_PS_CONFIG */
+        {0x01, 3},   /* TX_CHAIN_MASK: __ath10k_set_antenna, the two chains service ready reports */
+        {0x02, 3},   /* RX_CHAIN_MASK */
+        {0x23, 0},   /* ARP_AC_OVERRIDE */
+        {0x25, 1},   /* ANI_ENABLE */
+    };
+    const unsigned params = sizeof(param) / sizeof(param[0]);
+    static uint8_t m[4 + 8 + 4 + WS_CHANS * 28];
+    uint32_t at = 0;
+    if (command < params) {
+        WS_PUT32(0x4003);   /* WMI_TLV_PDEV_SET_PARAM_CMDID */
+        WS_TLV(0x52, 12);
+        WS_PUT32(0);
+        WS_PUT32(param[command].id);
+        WS_PUT32(param[command].value);
+    } else if (command == params) {
+        /* ath10k_regd_update: service ready's 0x406c is the world SKU pair 0x6c, without a conformance test limit (NO_CTL). */
+        WS_PUT32(0x4001);   /* WMI_TLV_PDEV_SET_REGDOMAIN_CMDID */
+        WS_TLV(0x51, 24);
+        WS_PUT32(0);
+        WS_PUT32(0x6c);
+        WS_PUT32(0x6c);
+        WS_PUT32(0x6c);
+        WS_PUT32(0xff);
+        WS_PUT32(0xff);
+    } else if (command == params + 1) {
+        WS_PUT32(0x3003);   /* WMI_TLV_SCAN_CHAN_LIST_CMDID */
+        WS_TLV(0x4f, 4);
+        WS_PUT32(WS_CHANS);
+        WS_TLV(0x12, WS_CHANS * 28);
+        for (unsigned c = 0; c < WS_CHANS; c++) {
+            WS_TLV(0x50, 24);
+            WS_PUT32(ws_mhz[c]);
+            WS_PUT32(ws_mhz[c]);
+            WS_PUT32(0);
+            /* ath10k_wmi_put_wmi_channel: the mode (11G 1, 11A 0) in the low bits, PASSIVE bit 7, ALLOW_HT bit 11. */
+            WS_PUT32((ws_mhz[c] < 3000 ? 1u : 0u) | 1u << 7 | 1u << 11);
+            WS_PUT32(40u << 8 | 40u << 16);   /* min 0, max and regulatory 20 dBm in half dB: the world entries of Debian's iw reg get */
+            WS_PUT32(6u | 40u << 8);          /* antenna 6 dBi, max tx */
+        }
+    } else if (command == params + 2) {
+        /* A locally administered address for this boot, not the device's. */
+        const uint64_t now = mach_absolute_time();
+        ws.mac[0] = 0x02;
+        for (unsigned b = 1; b < 6; b++) ws.mac[b] = (uint8_t)(now >> (b * 7));
+        WS_PUT32(0x5001);   /* WMI_TLV_VDEV_CREATE_CMDID */
+        WS_TLV(0x56, 20);
+        WS_PUT32(0);
+        WS_PUT32(2);        /* WMI_VDEV_TYPE_STA */
+        WS_PUT32(0);
+        memcpy(m + at, ws.mac, 8);
+        at += 8;
+    } else {
+        return 1;
+    }
+    const int sent = wh_send((unsigned)wh.wmi, m, at);
+    if (!sent) ws.step++;
+    return sent;
+}
+
+/* ath10k_wmi_tlv_op_gen_start_scan with ath10k_wmi_start_scan_init's values. */
+static int
+ws_start_scan(void)
+{
+    static uint8_t m[4 + 4 + 100 + 4 + WS_CHANS * 4 + 4 + 4 + 8 + 4];
+    uint32_t at = 0;
+    WS_PUT32(0x3001);        /* WMI_TLV_START_SCAN_CMDID */
+    WS_TLV(0x4d, 100);
+    WS_PUT32(0xa000u | ws.number);   /* scan id */
+    WS_PUT32(0xa001);        /* requester */
+    WS_PUT32(0);             /* vdev */
+    WS_PUT32(1);             /* WMI_SCAN_PRIORITY_LOW */
+    WS_PUT32(0x11f);         /* STARTED, COMPLETED, BSS_CHANNEL, FOREIGN_CHANNEL, DEQUEUED, FOREIGN_CHANNEL_EXIT */
+    WS_PUT32(50);            /* dwell active */
+    WS_PUT32(150);           /* dwell passive */
+    WS_PUT32(50);            /* min rest */
+    WS_PUT32(500);           /* max rest */
+    WS_PUT32(0);             /* repeat probe */
+    WS_PUT32(0);             /* probe spacing */
+    WS_PUT32(0);             /* idle */
+    WS_PUT32(20000);         /* max scan time */
+    WS_PUT32(5);             /* probe delay */
+    /* PASSIVE, CHAN_STAT_EVENT, and WMI-TLV inverts FILTER_PROBE_REQ. */
+    WS_PUT32(0x01u | 0x10u | 0x20u);
+    WS_PUT32(0);             /* burst duration */
+    WS_PUT32(WS_CHANS);
+    WS_PUT32(1);             /* bssids */
+    WS_PUT32(0);             /* ssids */
+    WS_PUT32(0);             /* ie length */
+    WS_PUT32(3);             /* probes */
+    memset(m + at, 0, 16);   /* no random address: mac and mask */
+    at += 16;
+    WS_TLV(0x10, WS_CHANS * 4);
+    for (unsigned c = 0; c < WS_CHANS; c++) WS_PUT32(ws_mhz[c]);
+    WS_TLV(0x13, 0);
+    WS_TLV(0x13, 8);
+    memset(m + at, 0xff, 6);
+    m[at + 6] = m[at + 7] = 0;
+    at += 8;
+    WS_TLV(0x11, 0);
+    return wh_send((unsigned)wh.wmi, m, at);
+}
+#undef WS_PUT32
+#undef WS_TLV
+
+/* ath10k_wmi_event_scan: the started, foreign channel and completed events (types 1, 8 and 2). */
+static void
+ws_scan_event(const uint8_t *m, uint32_t n)
+{
+    uint16_t l = 0;
+    const uint8_t *e = wm_tlv(m, n, 0x24, 0, &l);
+    if (!e || l < 24) { ws.bad++; return; }
+    const uint32_t type = wm_u32(e, 0);
+    ws.events++;
+    ws.last_type = type;
+    if (type == 1) ws.started = 1;
+    if (type == 8) { ws.channels++; ws.last_mhz = wm_u32(e, 2); }
+    if (type == 2 || type == 0x40) { ws.completed = 1; ws.reason = wm_u32(e, 1); }
+}
+
+/* ath10k_wmi_event_chan_info: the noise floor and how busy the channel was, which only a listening radio can report. */
+static void
+ws_chan_info(const uint8_t *m, uint32_t n)
+{
+    uint16_t l = 0;
+    const uint8_t *e = wm_tlv(m, n, 0x26, 0, &l);
+    if (!e || l < 24) { ws.bad++; return; }
+    const int32_t noise = (int32_t)wm_u32(e, 3);
+    const uint32_t clear = wm_u32(e, 4), cycles = wm_u32(e, 5);
+    if (!ws.chan_infos || noise < ws.noise_low) ws.noise_low = noise;
+    if (!ws.chan_infos || noise > ws.noise_high) ws.noise_high = noise;
+    if (cycles) {
+        const uint32_t busy = (uint32_t)((uint64_t)clear * 100u / cycles);
+        if (busy > ws.busy_most) ws.busy_most = busy;
+    }
+    ws.chan_infos++;
+}
+
+/* ath10k_wmi_event_mgmt_rx: counts beacons and probe responses per band and their distinct transmitters. */
+static void
+ws_mgmt_rx(const uint8_t *m, uint32_t n)
+{
+    uint16_t lh = 0, lf = 0;
+    const uint8_t *h = wm_tlv(m, n, 0x2c, 0, &lh), *f = wm_tlv(m, n, 0x11, 0, &lf);
+    if (!h || lh < 24 || !f || lf < 24) { ws.bad++; return; }
+    ws.mgmt++;
+    const uint8_t type = f[0] & 0xfc;
+    if (type != 0x80 && type != 0x50) return;
+    ws.beacons++;
+    /* The header's channel is the IEEE number: ath10k_wmi_event_mgmt_rx takes 1..14 as 2.4 GHz. */
+    if (wm_u32(h, 0) <= 14) ws.band2++; else ws.band5++;
+    if (wm_u32(h, 1) > ws.snr_best) ws.snr_best = wm_u32(h, 1);
+    uint32_t hash = 2166136261u;
+    for (unsigned b = 16; b < 22; b++) hash = (hash ^ f[b]) * 16777619u;
+    for (unsigned b = 0; b < ws.bss && b < 64; b++) {
+        if (ws.bss_hash[b] == hash) return;
+    }
+    if (ws.bss < 64) ws.bss_hash[ws.bss] = hash;
+    ws.bss++;
+}
+
+static void
+wc_report(unsigned second)
+{
+    if (!wc.up) return;
+    char line[400];
+    size_t used = 0;
+    for (unsigned id = 0; id < WC_COUNT; id++)
+        if (wc.irqs[id] || wc.rx[id] || wc.tx[id])
+            used += snprintf(line + used, sizeof(line) - used, " ce%u %llu/%llu/%llu/%llu", id, (unsigned long long)wc.irqs[id],
+                (unsigned long long)wc.rx[id], (unsigned long long)wc.tx[id], (unsigned long long)wc.tx_done[id]);
+    printf("COACHZ wlan at %u s: interrupts/received/sent/completed%s; bad %llu, masked 0x%x; htc ready %u, eps htt %d wmi %d log %d, wmi events %u "
+        "(last 0x%x, %u bytes), htt %u, log %u, unsolicited %u, dropped %u, wmi credits %d\n", second, used ? line : " none",
+        (unsigned long long)wc.rx_bad, wc.masked, wh.credit_size ? 1u : 0u, wh.htt, wh.wmi, wh.log, wh.wmi_events, wh.last_wmi, wh.last_wmi_len,
+        wh.htt_messages, wh.log_messages, wh.unsolicited, wh.dropped, wh.wmi >= 0 ? wh.ep[wh.wmi].credits : -1);
+}
+
+/* One step of the sequence, every millisecond from the watch loop. */
+static void
+wl_step(void)
+{
+    uint8_t t[64];
+    uint32_t at = 0;
+    uint16_t error = 0;
+    int result = 0;
+    if (wl.failed || !wl.known || !wg.open_acked || wl.state == 19) return;
+    const int awaiting = (wl.state >= 1 && wl.state <= 8 && wl.state != 6) || wl.state == 11 || wl.state == 12;
+    if (awaiting && !wl.resp_ready) {
+        if (++wl.waited_ms >= 30000) {
+            printf("COACHZ wlfw: no response to 0x%x in 30 s (state %d)\n", wl.want_id, wl.state);
+            wl.failed = 1;
+        }
+        return;
+    }
+    if (wl.resp_ready) result = wl_result(&error);
+    switch (wl.state) {
+    case 0: {
+        const uint8_t on = 1;
+        const uint32_t client = 0x4b4e454cu;   /* ATH10K_QMI_CLIENT_ID */
+        at = wr_put(t, at, 0x10, &on, 1);
+        at = wr_put(t, at, 0x13, &on, 1);
+        at = wr_put(t, at, 0x15, &client, 4);
+        wl_request(0x20, t, at);
+        wl.state = 1;
+        break;
+    }
+    case 1: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        uint64_t status = 0;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x10, &v, &l) && l >= 8) memcpy(&status, v, 8);
+        printf("COACHZ wlfw: indication registration %d/%u, fw status 0x%llx\n", result, error, (unsigned long long)status);
+        if (result) { wl.failed = 1; break; }
+        const uint32_t daemon = 0;
+        at = wr_put(t, at, 0x10, &daemon, 4);
+        wl_request(0x34, t, at);
+        wl.state = 2;
+        break;
+    }
+    case 2: {
+        printf("COACHZ wlfw: host capability %d/%u\n", result, error);
+        if (result && error != 0x5e) { wl.failed = 1; break; }   /* QMI_ERR_NOT_SUPPORTED_V01: older firmware, not fatal */
+        const uint64_t base = CW_MSA_BASE;
+        const uint32_t size = CW_MSA_SIZE;
+        at = wr_put(t, at, 0x01, &base, 8);
+        at = wr_put(t, at, 0x02, &size, 4);
+        wl_request(0x2d, t, at);
+        wl.state = 3;
+        break;
+    }
+    case 3: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        char regions[160] = {0};
+        size_t used = 0;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x03, &v, &l) && l >= 1)
+            for (unsigned i = 0; i < v[0] && 1u + 13u * (i + 1) <= l && used < sizeof(regions) - 40; i++) {
+                uint64_t address;
+                uint32_t size;
+                memcpy(&address, v + 1 + 13 * i, 8);
+                memcpy(&size, v + 9 + 13 * i, 4);
+                used += snprintf(regions + used, sizeof(regions) - used, " 0x%llx+0x%x%s", (unsigned long long)address, size,
+                    v[13 + 13 * i] ? " secure" : "");
+            }
+        printf("COACHZ wlfw: MSA info %d/%u, regions%s\n", result, error, regions[0] ? regions : " none");
+        if (result) { wl.failed = 1; break; }
+        delay(20000);   /* the 20 ms ath10k waits after the MSA info (SDM845 XPU crash) */
+        wl_request(0x2e, NULL, 0);
+        wl.state = 4;
+        break;
+    }
+    case 4:
+        printf("COACHZ wlfw: MSA ready %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        wl_request(0x24, NULL, 0);
+        wl.state = 5;
+        break;
+    case 5: {
+        const uint8_t *v = NULL;
+        uint16_t l = 0;
+        wl.board_id = 0xff;
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x10, &v, &l) && l >= 8) { memcpy(&wl.chip_id, v, 4); memcpy(&wl.chip_family, v + 4, 4); }
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x11, &v, &l) && l >= 4) memcpy(&wl.board_id, v, 4);
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x12, &v, &l) && l >= 4) memcpy(&wl.soc_id, v, 4);
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x13, &v, &l) && l >= 5) {
+            memcpy(&wl.fw_version, v, 4);
+            const uint32_t n = v[4] < l - 5 ? v[4] : l - 5;
+            memcpy(wl.timestamp, v + 5, n < sizeof(wl.timestamp) - 1 ? n : sizeof(wl.timestamp) - 1);
+        }
+        if (wr_tlv(wl.resp + 7, wl.resp_len - 7, 0x14, &v, &l)) memcpy(wl.build_id, v, l < sizeof(wl.build_id) - 1 ? l : sizeof(wl.build_id) - 1);
+        printf("COACHZ wlfw: capability %d/%u: chip 0x%x family 0x%x board 0x%x soc 0x%x fw 0x%x \"%s\" build \"%s\"\n", result, error,
+            wl.chip_id, wl.chip_family, wl.board_id, wl.soc_id, wl.fw_version, wl.timestamp, wl.build_id);
+        if (result) { wl.failed = 1; break; }
+        wl.state = 6;
+        break;
+    }
+    case 6: {
+        if (!wl.msa_ready) {
+            if (++wl.waited_ms >= 30000) { printf("COACHZ wlfw: no MSA ready indication in 30 s\n"); wl.failed = 1; }
+            return;
+        }
+        char name[80];
+        snprintf(name, sizeof(name), "bus=snoc,qmi-board-id=%x,qmi-chip-id=%x", wl.board_id, wl.chip_id);
+        int found = wl_board(name, &wl.bdf, &wl.bdf_len);
+        if (!found) {
+            snprintf(name, sizeof(name), "bus=snoc,qmi-board-id=%x", wl.board_id);
+            found = wl_board(name, &wl.bdf, &wl.bdf_len);
+        }
+        printf("COACHZ wlfw: board data \"%s\" %s (%u bytes, board file %zu bytes)\n", name, found ? "found" : "missing", wl.bdf_len,
+            wifi_board_bytes);
+        if (!found) { wl.failed = 1; break; }
+        wl.bdf_at = wl.bdf_seg = 0;
+        wl_bdf_segment();
+        wl.state = 7;
+        break;
+    }
+    case 7:
+        if (result) {
+            printf("COACHZ wlfw: board data segment %u refused %d/%u\n", wl.bdf_seg - 1, result, error);
+            wl.failed = 1;
+            break;
+        }
+        if (wl.bdf_at < wl.bdf_len) {
+            wl_bdf_segment();
+            break;
+        }
+        printf("COACHZ wlfw: board data sent in %u segments\n", wl.bdf_seg);
+        {
+            const uint8_t none = 0;   /* meta_data: no calibration entries */
+            at = wr_put(t, at, 0x01, &none, 1);
+            wl_request(0x26, t, at);
+        }
+        wl.state = 8;
+        break;
+    case 8:
+        printf("COACHZ wlfw: calibration report %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        wl.state = 9;
+        wl.waited_ms = 0;
+        break;
+    case 9:
+        if (wl.fw_ready) {
+            printf("COACHZ wlfw: WLAN firmware ready\n");
+            wl.state = 10;
+        } else if (++wl.waited_ms >= 30000) {
+            printf("COACHZ wlfw: no FW ready indication in 30 s\n");
+            wl.failed = 1;
+        }
+        break;
+    case 10: {
+        /* ath10k_snoc_wlan_enable -> ath10k_qmi_cfg_send_sync_msg: no host version, the target CE table, the service map and the
+         * shadow registers, each a length byte and its structures. */
+        static uint8_t cfg[600], value[300];
+        uint32_t v = 0;
+        value[v++] = WC_COUNT;
+        for (unsigned i = 0; i < WC_COUNT; i++) { memcpy(value + v, wc_target[i], 20); v += 20; }
+        at = wr_put(cfg, 0, 0x11, value, (uint16_t)v);
+        v = 0;
+        value[v++] = 21;
+        for (unsigned i = 0; i < 21; i++) { memcpy(value + v, wc_services[i], 12); v += 12; }
+        at = wr_put(cfg, at, 0x12, value, (uint16_t)v);
+        v = 0;
+        value[v++] = 12;
+        for (unsigned i = 0; i < 12; i++) { memcpy(value + v, wc_shadow[i], 4); v += 4; }
+        at = wr_put(cfg, at, 0x13, value, (uint16_t)v);
+        wl_request(0x23, cfg, at);
+        wl.state = 11;
+        break;
+    }
+    case 11: {
+        printf("COACHZ wlfw: WLAN configuration %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        const uint32_t mission = 0;   /* QMI_WLFW_MISSION_V01, with hw_debug present and 0 */
+        const uint8_t debug = 0;
+        at = wr_put(t, at, 0x01, &mission, 4);
+        at = wr_put(t, at, 0x10, &debug, 1);
+        wl_request(0x22, t, at);
+        wl.state = 12;
+        break;
+    }
+    case 12: {
+        printf("COACHZ wlfw: WLAN mode mission %d/%u\n", result, error);
+        if (result) { wl.failed = 1; break; }
+        /* The rest of ath10k_snoc_hif_power_up, then ath10k_core_start's htc_init and hif_start. */
+        const int up = wc_power_up();
+        if (up) {
+            printf("COACHZ wlan: copy engines not set up (%d)\n", up);
+            wl.failed = 1;
+            break;
+        }
+        wh_init();
+        wc_start();
+        wl.state = 13;
+        wl.waited_ms = 0;
+        break;
+    }
+    case 13:
+        /* ath10k_htc_wait_target: 1 s for the target's READY, then every CE serviced once by force and 1 s more. */
+        if (!wh.ctl_new) {
+            if (++wl.waited_ms == 1000) {
+                printf("COACHZ htc: no control response in 1 s, polling\n");
+                wc_poll(1);
+            } else if (wl.waited_ms >= 2000) {
+                printf("COACHZ htc: target never sent READY\n");
+                wl.failed = 1;
+            }
+            break;
+        }
+        if (wh.ctl_len < 8 || (wh.ctl[0] | wh.ctl[1] << 8) != 1) {
+            printf("COACHZ htc: invalid READY (%u bytes, message 0x%x)\n", wh.ctl_len, wh.ctl[0] | wh.ctl[1] << 8);
+            wl.failed = 1;
+            break;
+        }
+        wh.credit_count = (uint16_t)(wh.ctl[2] | wh.ctl[3] << 8);
+        wh.credit_size = (uint16_t)(wh.ctl[4] | wh.ctl[5] << 8);
+        wh.max_eps = wh.ctl[6];
+        wh.total_credits = 1;
+        if (wh.ctl_len >= 12) {
+            wh.alt_credit_size = (uint16_t)((wh.ctl[10] | wh.ctl[11] << 8) & 0xfffu);
+            wh.bundle = wh.ctl[9] < 32 ? wh.ctl[9] : 32;
+        }
+        printf("COACHZ htc: target ready after %u ms: %u credits (1 used) of %u bytes, %u endpoints, %u bytes%s, version %u bundle %u alt size %u\n",
+            wl.waited_ms, wh.credit_count, wh.credit_size, wh.max_eps, wh.ctl_len, wh.ctl_len >= 12 ? " (extended)" : "",
+            wh.ctl_len >= 12 ? wh.ctl[8] : 0, wh.bundle, wh.alt_credit_size);
+        if (!wh.credit_size) { wl.failed = 1; break; }
+        /* ath10k_htt_connect */
+        if (wh_connect(0x0300)) { printf("COACHZ htc: HTT connect not sent\n"); wl.failed = 1; break; }
+        wl.state = 14;
+        wl.waited_ms = 0;
+        break;
+    case 14:
+    case 15:
+    case 16: {
+        static const uint16_t services[3] = {0x0300, 0x0100, 0x0600};
+        static const char *const names[3] = {"HTT data", "WMI control", "pktlog"};
+        const unsigned k = (unsigned)wl.state - 14u;
+        if (!wh.ctl_new) {
+            if (++wl.waited_ms >= 1000) { printf("COACHZ htc: %s connect timeout\n", names[k]); wl.failed = 1; }
+            break;
+        }
+        const int eid = wh_connected(services[k]);
+        if (eid < 0) { printf("COACHZ htc: %s connect failed (%d)\n", names[k], eid); wl.failed = 1; break; }
+        if (k == 0) {
+            wh.htt = eid;
+            if (wh_connect(0x0100)) { wl.failed = 1; break; }   /* ath10k_wmi_connect */
+        } else if (k == 1) {
+            /* ath10k_htc_start: SETUP_COMPLETE_EX (no SDIO bundling), then pktlog only if the service map has both of its pipes
+             * (ath10k_htc_pktlog_svc_supported); snoc's has only the downlink one, so Linux does not connect it here. */
+            static const uint8_t setup[12] = {5, 0};
+            uint8_t ul = 0, dl = 0;
+            wh.wmi = eid;
+            const int sent = wh_send(0, setup, sizeof(setup));
+            if (sent) { printf("COACHZ htc: setup complete not sent (%d)\n", sent); wl.failed = 1; break; }
+            if (wh_map(0x0600, &ul, &dl)) {
+                printf("COACHZ htc: started; HTT endpoint %d, WMI %d (%d credits), no pktlog uplink in the map\n", wh.htt, wh.wmi,
+                    wh.ep[wh.wmi].credits);
+                wl.state = 17;
+                wl.waited_ms = 0;
+                break;
+            }
+            if (wh_connect(0x0600)) { wl.failed = 1; break; }
+        } else {
+            wh.log = eid;
+            printf("COACHZ htc: started; HTT endpoint %d, WMI %d (%d credits), pktlog %d\n", wh.htt, wh.wmi, wh.ep[wh.wmi].credits, wh.log);
+        }
+        wl.state++;
+        wl.waited_ms = 0;
+        break;
+    }
+    case 17:
+        /* ath10k_wmi_wait_for_service_ready: 5 s, then the service ready work and ath10k_wmi_cmd_init. */
+        if (wh.service_ready) {
+            printf("COACHZ wmi: service ready after %u ms (%u bytes; events so far 0x%x 0x%x 0x%x 0x%x)\n", wl.waited_ms, wh.svc_rdy_len,
+                wh.wmi_ids[0], wh.wmi_ids[1], wh.wmi_ids[2], wh.wmi_ids[3]);
+            const int ready = wm_service_ready();
+            if (ready) { printf("COACHZ wmi: init not sent (%d)\n", ready); wl.state = 19; break; }
+            const int sent = wm_send_init();
+            if (sent) { printf("COACHZ wmi: init send failed (%d)\n", sent); wl.state = 19; break; }
+            wl.state = 18;
+            wl.waited_ms = 0;
+        } else if (++wl.waited_ms >= 5000) {
+            printf("COACHZ wmi: no service ready in 5 s (%u events, last 0x%x)\n", wh.wmi_events, wh.last_wmi);
+            wl.state = 19;
+        }
+        break;
+    case 18:
+        /* ath10k_wmi_wait_for_unified_ready: 5 s. The READY event's MAC address is a device identifier: only its OUI is printed. */
+        if (wh.ready_event) {
+            uint16_t l = 0;
+            const uint8_t *r = wm_tlv(wh.rdy, wh.rdy_len, 35, 0, &l);
+            if (r && l >= 36) {
+                printf("COACHZ wmi: ready after %u ms: sw 0x%x abi %u, status %u, MAC %02x:%02x:%02x:xx:xx:xx\n", wl.waited_ms, wm_u32(r, 0),
+                    wm_u32(r, 1), wm_u32(r, 8), r[24], r[25], r[26]);
+            } else {
+                printf("COACHZ wmi: ready event without its structure (%u bytes)\n", wh.rdy_len);
+            }
+            wl.state = 20;
+            wl.waited_ms = 0;
+        } else if (++wl.waited_ms >= 5000) {
+            printf("COACHZ wmi: no ready event in 5 s after init (%u events, last 0x%x, wmi credits %d):", wh.wmi_events, wh.last_wmi,
+                wh.ep[wh.wmi].credits);
+            for (unsigned i = 0; i < 8 && i < wh.wmi_events; i++) printf(" 0x%x/%u", wh.wmi_ids[i], wh.wmi_lens[i]);
+            printf("\n");
+            wl.state = 19;
+        }
+        break;
+    case 20: {
+        /* ath10k_core_start refills the ring, then ath10k_htt_setup begins with the version request (HTT_H2T_MSG_TYPE_VERSION_REQ). */
+        static const uint8_t version_req[4] = {0, 0, 0, 0};
+        const int prepared = ws_htt_prepare();
+        if (prepared) {
+            printf("COACHZ wifi: no room for the HTT rings (%u of %u bytes used)\n", wc.used, WC_MEM_BYTES);
+            wl.state = 19;
+            break;
+        }
+        const int sent = wh.htt >= 0 ? wh_send((unsigned)wh.htt, version_req, sizeof(version_req)) : -1;
+        printf("COACHZ wifi: %u rx buffers posted, %u of %u bytes used, HTT version request %d\n", WS_RX_FILL, wc.used, WC_MEM_BYTES, sent);
+        wl.waited_ms = 0;
+        wl.state = 21;
+        break;
+    }
+    case 21:
+        if (ws.htt_version || ++wl.waited_ms >= 1000) {
+            printf("COACHZ wifi: HTT version %u.%u after %u ms (%u messages)\n", ws.htt_major, ws.htt_minor, wl.waited_ms, wh.htt_messages);
+            wl.waited_ms = 0;
+            wl.state = 22;
+        }
+        break;
+    case 22: {
+        const int next = ws_next();
+        if (next == -2) {
+            if (++wl.waited_ms >= 5000) {
+                printf("COACHZ wifi: no WMI credits for command %u in 5 s\n", ws.step);
+                wl.state = 19;
+            }
+        } else if (next < 0) {
+            printf("COACHZ wifi: command %u not sent (%d)\n", ws.step, next);
+            wl.state = 19;
+        } else {
+            wl.waited_ms = 0;
+            if (next == 1) {
+                printf("COACHZ wifi: %u commands sent: HTT frag bank, rx ring, aggregation, pdev parameters, regdomain, %u passive channels, vdev 0\n", ws.step, (unsigned)WS_CHANS);
+                wl.state = 23;
+            }
+        }
+        break;
+    }
+    case 23:
+        if (++wl.waited_ms >= 100) {
+            const uint32_t number = ws.number;
+            const int sent = ws_start_scan();
+            if (sent == -2) {
+                if (wl.waited_ms >= 5000) {
+                    printf("COACHZ wifi: no WMI credits for scan %u in 5 s\n", number);
+                    wl.state = 19;
+                }
+                break;
+            }
+            if (sent) {
+                printf("COACHZ wifi: scan %u not sent (%d)\n", number, sent);
+                wl.state = 19;
+                break;
+            }
+            memset((uint8_t *)&ws + __builtin_offsetof(__typeof__(ws), started), 0, sizeof(ws) - __builtin_offsetof(__typeof__(ws), started));
+            wl.waited_ms = 0;
+            wl.state = 24;
+        }
+        break;
+    case 24:
+        /* ath10k_hw_scan waits for the started event, then the scan's own 20 s limit and a margin. */
+        if (ws.completed || ++wl.waited_ms >= 30000) {
+            printf("COACHZ wifi: scan %u %s after %u ms: started %u, reason %u, %u events, %u channels, last type 0x%x, %u bad\n", ws.number,
+                ws.completed ? "done" : "timed out", wl.waited_ms, ws.started, ws.reason, ws.events, ws.channels, ws.last_type, ws.bad);
+            printf("COACHZ wifi: scan %u heard %u frames, %u beacons or probe responses from %u transmitters, 2.4 GHz %u, 5 GHz %u, best snr %u\n",
+                ws.number, ws.mgmt, ws.beacons, ws.bss, ws.band2, ws.band5, ws.snr_best);
+            printf("COACHZ wifi: scan %u radio: %u channel reports, noise %d to %d, busiest %u%%, %u HTT messages\n", ws.number, ws.chan_infos, ws.noise_low,
+                ws.noise_high, ws.busy_most, wh.htt_messages);
+            for (unsigned i = 0; i < 32; i++) {
+                if (ws.htt_types[i]) printf("COACHZ wifi: HTT message %u: %u\n", i, ws.htt_types[i]);
+            }
+            for (unsigned i = 0; i < 12 && ws.wmi_ids[i]; i++) printf("COACHZ wifi: WMI event 0x%x: %u\n", ws.wmi_ids[i], ws.wmi_counts[i]);
+            ws.number++;
+            wl.waited_ms = 0;
+            wl.state = ws.number < 3 ? 25 : 19;
+        }
+        break;
+    case 25:
+        if (++wl.waited_ms >= 30000) {
+            wl.waited_ms = 100;
+            wl.state = 23;
+        }
+        break;
+    }
+}
+
+/* One complete QRTR packet from the modem. */
+static void
+wq_rx(const uint8_t *p, uint32_t n)
+{
+    uint32_t type, src_node, src_port, dst_port, size, confirm, hdr;
+    wg.qrtr_rx++;
+    if (n >= 32 && p[0] == 1) {
+        uint32_t h[8];
+        memcpy(h, p, 32);
+        type = h[1]; src_node = h[2]; src_port = h[3]; confirm = h[4]; size = h[5]; dst_port = h[7]; hdr = 32;
+    } else if (n >= 16 && p[0] == 3) {
+        type = p[1]; confirm = p[2] & 1; hdr = 16 + p[3];
+        memcpy(&size, p + 4, 4);
+        src_node = (uint32_t)(p[8] | p[9] << 8); src_port = (uint32_t)(p[10] | p[11] << 8); dst_port = (uint32_t)(p[14] | p[15] << 8);
+        if (src_port == 0xffff) src_port = WQ_CTRL;
+        if (dst_port == 0xffff) dst_port = WQ_CTRL;
+    } else {
+        printf("COACHZ qrtr: %u bytes of version %u refused\n", n, n ? p[0] : 0);
+        return;
+    }
+    if (hdr + size > n) return;
+    const uint8_t *body = p + hdr;
+    uint32_t ctrl[5] = {0};
+    if (type != 1) memcpy(ctrl, body, size < 20 ? size : 20);
+    switch (type) {
+    case 1:
+        if (dst_port == WQ_RMTFS_PORT) wr_request(src_node, src_port, body, size);
+        else if (dst_port == WL_PORT) wl_rx(body, size);
+        else printf("COACHZ qrtr: data for port 0x%x from %u:0x%x\n", dst_port, src_node, src_port);
+        if (confirm) wq_send(7, dst_port, src_node, src_port, (const uint32_t[]){7, WQ_NODE, dst_port, 0, 0}, 20);
+        break;
+    case 2:                             /* HELLO: ns.c ctrl_cmd_hello announces this node's servers to the peer */
+        wg.modem_node = src_node;
+        printf("COACHZ qrtr: hello from node %u\n", src_node);
+        if (!wg.hello_sent) {
+            wq_ctrl(2, 0, 0, 0, 0, src_node);
+            wg.hello_sent = 1;
+        }
+        wq_ctrl(4, 14, 1 | 0 << 8, WQ_NODE, WQ_RMTFS_PORT, src_node);
+        break;
+    case 4:
+        printf("COACHZ qrtr: new server %u version %u instance %u at %u:0x%x\n", ctrl[1], ctrl[2] & 0xff, ctrl[2] >> 8, ctrl[3], ctrl[4]);
+        if (ctrl[1] == 69 && !wl.known) {
+            wl.node = ctrl[3];
+            wl.port = ctrl[4];
+            wl.known = 1;
+        }
+        break;
+    case 5:
+        printf("COACHZ qrtr: server %u gone at %u:0x%x\n", ctrl[1], ctrl[3], ctrl[4]);
+        break;
+    case 10:
+        printf("COACHZ qrtr: lookup for %u from %u:0x%x (remote lookups are ns.c's to refuse)\n", ctrl[1], src_node, src_port);
+        break;
+    default:
+        printf("COACHZ qrtr: control %u from %u:0x%x\n", type, src_node, src_port);
+        break;
+    }
+}
+
+/* Every message waiting in the modem's FIFO, as qcom_glink_native_rx and qcom_glink_work handle them. */
+static void
+wg_poll(void)
+{
+    while (!wg.failed) {
+        const uint32_t avail = wg_rx_avail();
+        uint32_t m[4] = {0};
+        if (avail < 8) break;
+        wg_rx_peek(0, m, 8);
+        const uint32_t cmd = m[0] & 0xffff, p1 = m[0] >> 16, p2 = m[1];
+        wg.messages_in++;
+        if (cmd == WG_VERSION || cmd == WG_VERSION_ACK) {
+            wg_rx_advance(8);
+            const uint32_t features = wg.features & p2;
+            printf("COACHZ glink: %s version %u features 0x%x\n", cmd ? "ack" : "remote", p1, p2);
+            if (cmd == WG_VERSION) {
+                wg.features = features;
+                wg_cmd(WG_VERSION_ACK, 1, wg.features);
+            } else if (features != wg.features) {
+                wg.features = features;
+                wg_cmd(WG_VERSION, 1, wg.features);
+            }
+        } else if (cmd == WG_OPEN) {
+            const uint32_t name_len = p2 & 0xffff, extra = (name_len + 7) & ~7u;
+            if (avail < 8 + extra) break;
+            char name[33] = {0};
+            wg_rx_peek(8, name, name_len < 32 ? name_len : 32);
+            wg_rx_advance(8 + extra);
+            const size_t used = strlen(wg.channels);
+            snprintf(wg.channels + used, sizeof(wg.channels) - used, " %s(%u)", name, p1);
+            if (!strcmp(name, "IPCRTR") && !wg.open_remote) {
+                /* qcom_glink_create_remote: the open acknowledged, then ours with the same name. */
+                wg.rcid = p1;
+                wg.open_remote = 1;
+                wg_cmd(WG_OPEN_ACK, p1, 0);
+                uint32_t req[2 + 2] = {WG_OPEN | WG_LCID << 16, 7, 0, 0};
+                memcpy(&req[2], "IPCRTR", 7);
+                wg_tx(req, 16, NULL, 0);
+            }
+            printf("COACHZ glink: modem opens \"%s\" as %u%s\n", name, p1, strcmp(name, "IPCRTR") ? ", left alone" : "");
+        } else if (cmd == WG_OPEN_ACK) {
+            wg_rx_advance(8);
+            if (p1 == WG_LCID && !wg.open_acked) {
+                wg.open_acked = 1;
+                /* qcom_glink_announce_create's default set: five intents (1 KiB each there; larger here, for rmtfs's iovec requests). */
+                for (unsigned i = 0; i < 5; i++) wg_intent_add(4096);
+                wg.intents_sent = 1;
+                /* af_qrtr.c qrtr_endpoint_register: hello to the peer's control port at once. */
+                wq_ctrl(2, 0, 0, 0, 0, WQ_BCAST);
+                wg.hello_sent = 1;
+                printf("COACHZ glink: IPCRTR open, intents advertised, QRTR hello sent\n");
+            }
+        } else if (cmd == WG_CLOSE) {
+            wg_rx_advance(8);
+            wg_cmd(WG_CLOSE_ACK, p1, 0);
+            printf("COACHZ glink: modem closes %u\n", p1);
+        } else if (cmd == WG_INTENT) {
+            const uint32_t len = 8 + 8 * p2, padded = (len + 7) & ~7u;
+            if (avail < padded) break;
+            for (uint32_t i = 0; i < p2; i++) {
+                uint32_t pair[2];
+                wg_rx_peek(8 + 8 * i, pair, 8);
+                for (unsigned r = 0; r < WG_REMOTE_MAX; r++) {
+                    if (wg.remote[r].valid) continue;
+                    wg.remote[r].valid = 1;
+                    wg.remote[r].busy = 0;
+                    wg.remote[r].size = pair[0];
+                    wg.remote[r].id = pair[1];
+                    break;
+                }
+            }
+            wg_rx_advance(padded);
+            wg_retry_pending();
+        } else if (cmd == WG_RX_DONE || cmd == WG_RX_DONE_REUSE) {
+            wg_rx_advance(8);
+            for (unsigned r = 0; r < WG_REMOTE_MAX; r++) {
+                if (!wg.remote[r].valid || wg.remote[r].id != p2) continue;
+                wg.remote[r].busy = 0;
+                if (cmd == WG_RX_DONE) wg.remote[r].valid = 0;
+            }
+            wg_retry_pending();
+        } else if (cmd == WG_INTENT_REQ) {
+            wg_rx_advance(8);
+            const int granted = !wg_intent_add(p2 < 1024 ? 1024 : p2);
+            wg_cmd(WG_INTENT_REQ_ACK, WG_LCID, (uint32_t)granted);
+        } else if (cmd == WG_INTENT_REQ_ACK || cmd == WG_CLOSE_ACK || cmd == WG_SIGNALS) {
+            wg_rx_advance(8);
+        } else if (cmd == WG_READ_NOTIF) {
+            wg_rx_advance(8);
+            wg_kick();
+        } else if (cmd == WG_TX_DATA || cmd == WG_TX_DATA_CONT) {
+            if (avail < 16) break;
+            wg_rx_peek(0, m, 16);
+            const uint32_t chunk = m[2], left = m[3], padded = (16 + chunk + 7) & ~7u;
+            if (avail < 16 + chunk) break;
+            int slot = -1;
+            for (unsigned i = 0; i < wg.local_count; i++) if (wg.local[i].id == p2) slot = (int)i;
+            if (slot < 0 || wg.local[slot].fill + chunk > wg.local[slot].size) {
+                printf("COACHZ glink: data for intent %u (%u bytes) has no room\n", p2, chunk);
+                wg_rx_advance(padded);
+                continue;
+            }
+            wg_rx_peek(16, wg.local[slot].data + wg.local[slot].fill, chunk);
+            wg.local[slot].fill += chunk;
+            wg_rx_advance(padded);
+            if (!left) {
+                const uint32_t length = wg.local[slot].fill;
+                wg.local[slot].fill = 0;
+                wq_rx(wg.local[slot].data, length);
+                /* qcom_glink_rx_done: the intent kept for reuse when that was negotiated, else given up and a new one advertised. */
+                if (wg.features & WG_FEATURE_REUSE) {
+                    wg_cmd(WG_RX_DONE_REUSE, WG_LCID, p2);
+                } else {
+                    wg_cmd(WG_RX_DONE, WG_LCID, p2);
+                    wg.local[slot].id = ++wg.next_liid;
+                    const uint32_t a[4] = {WG_INTENT | WG_LCID << 16, 1, wg.local[slot].size, wg.local[slot].id};
+                    wg_tx(a, 16, NULL, 0);
+                }
+            }
+        } else {
+            printf("COACHZ glink: command %u (0x%x 0x%x) not understood, link stopped\n", cmd, p1, p2);
+            wg.failed = 1;
+        }
+    }
+}
+
+/* qcom_glink_smem_register, once the modem is up: our FIFO allocated, the modem's descriptor and FIFO found, our tail and head reset,
+ * our version sent. */
+static int
+wg_start(void)
+{
+    struct cw_smem layout;
+    struct cw_item item;
+    const int64_t fifo = wifi_smem_alloc(479, WG_FIFO_BYTES);
+    if (fifo < 0 || !wifi_smem_now(&layout) || !layout.has_modem) return -1;
+    if (cw_smem_find(&wifi_smem_reader, &layout.modem, 478, &item) || item.bytes != 32) return -2;
+    wg.desc = item.offset;
+    if (cw_smem_find(&wifi_smem_reader, &layout.modem, 480, &item) || item.bytes < 1024) return -3;
+    wg.rx = item.offset;
+    wg.rx_bytes = item.bytes;
+    wg.tx = (uint32_t)fifo;
+    wg.features = WG_FEATURE_REUSE;
+    *wifi_smem_word(wg.desc + 8) = 0;
+    *wifi_smem_word(wg.desc + 4) = 0;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    if (!wg.rmtfs) wg.rmtfs = ml_io_map_unmappable((vm_offset_t)wifi_rmtfs_base, (vm_size_t)wifi_rmtfs_size, 0x6);
+    if (!wifi_efs_count) {
+        /* Without images in the blob: four blank 2 MiB ones, which is what Debian's /lib/firmware/rmtfs holds on this machine. */
+        static const char *const names[4] = {"modem_fs1", "modem_fs2", "modem_fsc", "modem_fsg"};
+        for (unsigned i = 0; i < 4; i++) {
+            uint8_t *blank = kalloc_data(2u << 20, Z_WAITOK | Z_ZERO);
+            if (!blank) break;
+            strlcpy(wifi_efs[i].name, names[i], sizeof(wifi_efs[i].name));
+            wifi_efs[i].data = blank;
+            wifi_efs[i].bytes = 2u << 20;
+            wifi_efs_count = (int)i + 1;
+        }
+    }
+    wg_cmd(WG_VERSION, 1, wg.features);
+    printf("COACHZ glink: started, modem FIFO %u bytes, %d EFS images, rmtfs_mem %s\n", wg.rx_bytes, wifi_efs_count,
+        wg.rmtfs ? "mapped" : "not mapped");
+    return 0;
+}
+
+static void
+wg_report(unsigned second)
+{
+    unsigned remote = 0;
+    for (unsigned r = 0; r < WG_REMOTE_MAX; r++) remote += wg.remote[r].valid;
+    printf("COACHZ glink at %u s: rx %llu tx %llu, IPCRTR %s, intents %u ours %u theirs, qrtr rx %llu tx %llu, rmtfs %llu requests %llu sectors, "
+        "opened %u/%u/%u/%u, channels%s\n", second, wg.messages_in, wg.messages_out, wg.open_acked ? "open" : wg.open_remote ? "half open" : "closed",
+        wg.local_count, remote, wg.qrtr_rx, wg.qrtr_tx, wg.rmtfs_ops, wg.rmtfs_sectors, wg.opened[0], wg.opened[1], wg.opened[2],
+        wg.opened[3], wg.channels[0] ? wg.channels : " none");
+}
+
+static void
+wifi_mba_stage2_thread(void *parameter __unused, wait_result_t result __unused)
+{
+    /* As soon as the firmware thread has the verified MBA (there was a fixed wait until 200 s), and qdsp6sw.mbn, which it verifies
+     * next (without it only the MBA runs, as before). */
+    for (unsigned waited = 0; waited < 300 && !wifi_mba_image; waited++) delay(1000 * 1000);
+    for (unsigned waited = 0; waited < 120 && wifi_mba_image && __atomic_load_n(&wifi_mpss_disk, __ATOMIC_ACQUIRE) < 0; waited++)
+        delay(1000 * 1000);
+    const int mpss = __atomic_load_n(&wifi_mpss_disk, __ATOMIC_ACQUIRE) >= 0;
+    const vm_offset_t gcc = wifi_gcc_mss(), qdsp6 = ml_io_map(0x04080000, 0x5000), rmb_page = ml_io_map(0x04180000, 0x1000),
+        tcsr = ml_io_map(0x01f60000, 0x6000), spare_page = ml_io_map(0x01fcb000, 0x1000), aoss = ml_io_map(0x0c2b0000, 0x1000),
+        pdc = ml_io_map(0x0b2e0000, 0x1000), smmu = ml_io_map(0x15000000, 0x1000);
+    if (!gcc || !qdsp6 || !rmb_page || !tcsr || !spare_page || !aoss || !pdc || !smmu || !wifi_qmp_q || !wifi_mba_image) {
+        printf("COACHZ mba: not started (maps %d, qmp %d, image %d)\n", gcc && qdsp6 && rmb_page && tcsr && spare_page && aoss && pdc && smmu,
+            wifi_qmp_q != NULL, wifi_mba_image != NULL);
+        return;
+    }
+    const struct wifi_mba_maps maps = {
+        .gcc = gcc, .tcsr = tcsr, .q6 = (volatile uint32_t *)qdsp6, .rmb = (volatile uint32_t *)rmb_page,
+        .restart = (volatile uint32_t *)aoss, .spare = (volatile uint32_t *)(spare_page + 0x3e4), .pdc_sync = (volatile uint32_t *)(pdc + 0x100),
+    };
+    /* The QDSP6SS and RMB registers are read only once the rails, clocks and reset allow it, as Linux does. */
+    printf("COACHZ mba: apps smmu sCR0 0x%x; mss_restart %u, pdc sync 0x%x, spare 0x%x\n", *(volatile uint32_t *)smmu, *maps.restart,
+        *maps.pdc_sync, *maps.spare);
+    /* Nothing of XNU's may lie in the regions the modem gets (mpss_mem, mba_mem, mpss-metadata, rmtfs_mem): its memory (boot_args,
+     * everything the pmap manages) and the firmware framebuffer the display copies into. No fixed buffer of ours (audio DMA at
+     * 0x81200000) is near them. */
+    const boot_args *args = (const boot_args *)PE_state.bootArgs;
+    PE_Video video;
+    bzero(&video, sizeof(video));
+    const int console = PE_current_console(&video) == 0;
+    const uint64_t fb = video.v_baseAddr, fb_size = (uint64_t)video.v_rowBytes * video.v_height;
+    const int known = args && args->memSize && console && fb && fb_size && fb < (1ull << 40);
+    const uint64_t regions[4][2] = {
+        {wifi_mpss_base, wifi_mpss_size}, {wifi_mba_base, wifi_mba_size}, {wifi_mdata_base, wifi_mdata_size}, {wifi_rmtfs_base, wifi_rmtfs_size},
+    };
+    int memory_clear = known, fb_clear = known;
+    for (unsigned i = 0; i < 4; i++) {
+        memory_clear = memory_clear && cw_disjoint(regions[i][0], regions[i][1], args->physBase, args->memSize);
+        fb_clear = fb_clear && cw_disjoint(regions[i][0], regions[i][1], fb, fb_size);
+    }
+    printf("COACHZ mba: modem regions known %d, clear of XNU memory %d, framebuffer %d; qdsp6sw.mbn %s\n", known, memory_clear, fb_clear,
+        mpss ? "verified" : "missing, MBA only");
+    if (!memory_clear || !fb_clear) {
+        printf("COACHZ mba: not started, a modem region is not known to be free\n");
+        return;
+    }
+    /* The copy engines' window likewise, and clear of the modem's regions. */
+    wc.window_clear = known && cw_disjoint(WC_MEM_PA, WC_MEM_BYTES, args->physBase, args->memSize) && cw_disjoint(WC_MEM_PA, WC_MEM_BYTES, fb, fb_size);
+    for (unsigned i = 0; i < 4; i++) wc.window_clear = wc.window_clear && cw_disjoint(WC_MEM_PA, WC_MEM_BYTES, regions[i][0], regions[i][1]);
+    /* ath10k probes at boot, before the modem starts: its supplies go on first (ath10k_hw_power_on). */
+    if (mpss) printf("COACHZ wlan: WCN3990 supplies on, %d failed; copy engine window clear %d\n", wl_power_on(), wc.window_clear);
+    /* Mainline's proxy clock "xo" (RPMH_CXO_CLK, ARC xo.lvl on = 3), active only and kept. */
+    {
+        const vm_offset_t db = wifi_cmd_db();
+        uint32_t address = 0, aux = 0, length = 0, status = 0;
+        const uint32_t on = 3;
+        if (db && wifi_db_find(db, "xo.lvl", &address, &aux, &length)) {
+            const int sent = wifi_rpmh_send(&address, &on, 1, &status);
+            printf("COACHZ mba: xo.lvl address 0x%x on after %d us, status 0x%x\n", address, sent, status);
+        } else {
+            printf("COACHZ mba: xo.lvl not in cmd-db\n");
+        }
+    }
+    /* rmtfs_mem shared with the modem as rmtfs_mem.c does at probe (HLOS and MSS_MSA read-write), kept. */
+    if (mpss) {
+        const uint32_t from = WIFI_VM_HLOS, to[2] = {WIFI_VM_HLOS, WIFI_VM_MSS}, rights[2] = {0x6, 0x6};
+        printf("COACHZ mpss: rmtfs_mem shared with the modem %lld\n",
+            (long long)wifi_assign_vms(wifi_rmtfs_base, wifi_rmtfs_size, &from, 1, to, rights, 2));
+    }
+    /* The AP's SMP2P item, which Linux's smp2p driver makes at boot, long before the modem starts. */
+    if (mpss) {
+        wifi_smem_list("before start");
+        const int64_t made = wifi_smp2p_create();
+        printf("COACHZ smp2p: AP item %u %s (%lld)\n", CW_SMP2P_OUT, made ? "not made" : "made", (long long)made);
+    }
+    /* IPA power before the start, as ipa_modem.c takes it on QCOM_SSR_BEFORE_POWERUP (the modem loads the IPA's GSI firmware). */
+    const int ipa = wifi_ipa_power();
+    printf("COACHZ mba attempt 1: IPA %s\n", ipa ? "vote failed" : "powered");
+    const uint32_t outcome = wifi_mba_attempt(&maps, 1);
+    printf("COACHZ mba attempt 1 result: status 0x%x%s%s\n", outcome & 0xff, (outcome & 0xff) == 1 || (outcome & 0xff) == 2 ? ", MBA ready" : "",
+        outcome & 0x100 ? ", modem running" : "");
+    if (!(outcome & 0x100)) return;
+    /*
+     * The modem runs. Its bits are watched as qcom_q6v5.c's interrupts would see them: every change printed (each second for a minute,
+     * then every 10 s, with a line each minute); at handover the proxy votes go as q6v5_handover drops them (cx/mx/mss to 0; xo stays
+     * voted, as this kernel's own); on a fatal error the crash reason is printed and the watch ends. GLINK starts at once (Linux registers
+     * the edge when the remote processor is up) and its FIFO is serviced every millisecond, with a line every 10 s for the first minutes.
+     */
+    int64_t seen = wifi_modem_bits();
+    int handed = 0;
+    printf("COACHZ mpss: watching the modem, bits %lld\n", (long long)seen);
+    struct cw_smem now_layout;
+    wifi_smem_list("running");
+    wifi_smp2p_print("running");
+    if (wifi_smem_now(&now_layout)) wifi_glink_state(&wifi_smem_reader, &now_layout);
+    const int link = wg_start();
+    if (link) printf("COACHZ glink: not started (%d)\n", link);
+    for (unsigned second = 1;; second++) {
+        for (unsigned ms = 0; ms < 1000; ms++) {
+            if (!link) {
+                wg_poll();
+                wc_poll(0);
+                wl_step();
+            }
+            delay(1000);
+        }
+        if (!link && (second <= 120 ? !(second % 10) : !(second % 60))) {
+            wg_report(second);
+            wc_report(second);
+        }
+        if (second > 60 && second % 10) continue;
+        const int64_t bits = wifi_modem_bits();
+        if (bits != seen || !(second % 60)) {
+            printf("COACHZ mpss: bits %lld at %u s of running (rmb mba 0x%x)\n", (long long)bits, second, maps.rmb[0x0c / 4]);
+            if (bits != seen) wifi_smp2p_print("change");
+            seen = bits;
+        }
+        if (bits >= 0 && (bits & 4) && !handed) {
+            uint32_t status[3] = {0};
+            const int sent = wifi_mss_rails_vote(0, status);
+            handed = 1;
+            printf("COACHZ mpss: handover at %u s; proxy rails to 0 after %d us, status 0x%x 0x%x 0x%x\n", second, sent, status[0], status[1], status[2]);
+        }
+        if (second == 30 && wifi_smem_now(&now_layout)) wifi_glink_state(&wifi_smem_reader, &now_layout);
+        if (bits >= 0 && (bits & 1)) {
+            printf("COACHZ mpss: fatal error at %u s\n", second);
+            wifi_modem_reason();
+            if (!link) { wg_report(second); wc_report(second); }
+            return;
+        }
+    }
+}
+
+/* Call from the existing sampler thread after IOKit has started, once. */
+void
+coachz_wifi_start(void)
+{
+    static int started;
+    unsigned mode = 0;
+    if (started || !PE_parse_boot_argn("coachz-wifi", &mode, sizeof(mode)) || mode < 1 || mode > 4) return;
+    started = 1;
+    wifi_mpss_probe();
+    wifi_power_probe();
+    if (mode >= 2) {
+        wifi_qmp_open();
+        wifi_rpmh_vote_test();
+    }
+    {
+        unsigned vote = 0;
+        thread_t thread;
+        if (PE_parse_boot_argn("coachz-ddr-vote", &vote, sizeof(vote)) && (vote == 1 || vote == 2) &&
+            kernel_thread_start(wifi_ddr_vote_thread, NULL, &thread) == KERN_SUCCESS) {
+            thread_deallocate(thread);
+        }
+    }
+    if (mode == 3) {
+        thread_t stage1;
+        if (kernel_thread_start(wifi_mba_stage1_thread, NULL, &stage1) == KERN_SUCCESS) thread_deallocate(stage1);
+    }
+    if (mode == 4) {
+        thread_t stage2;
+        if (kernel_thread_start(wifi_mba_stage2_thread, NULL, &stage2) == KERN_SUCCESS) thread_deallocate(stage2);
+    }
+    {
+        unsigned firmware = 0;
+        thread_t thread;
+        if (PE_parse_boot_argn("coachz-modem-fw", &firmware, sizeof(firmware)) && firmware == 1 &&
+            kernel_thread_start(wifi_firmware_thread, NULL, &thread) == KERN_SUCCESS) {
+            thread_deallocate(thread);
+        }
+    }
+    DTEntry node;
+    const void *property = NULL;
+    unsigned size = 0;
+    const char compatible[] = "google,coachz-wcn3990";
+    if (SecureDTLookupEntry(NULL, "/arm-io/coachz-wifi", &node) != kSuccess ||
+        SecureDTGetProperty(node, "compatible", &property, &size) != kSuccess || size != sizeof(compatible) ||
+        memcmp(property, compatible, sizeof(compatible))) {
+        printf("COACHZ wifi: explicit Coachz ADT node missing, not mapped\n"); return;
+    }
+    if (SecureDTGetProperty(node, "smem-region", &property, &size) != kSuccess || size != 16) {
+        printf("COACHZ wifi: smem-region must contain a physical base and size, not mapped\n"); return;
+    }
+    const uint8_t *range = property;
+    if (cw_u64(range) != CW_SMEM_BASE || cw_u64(range + 8) != CW_SMEM_SIZE) {
+        printf("COACHZ wifi: SMEM differs from this SC7180 layout, not mapped\n"); return;
+    }
+    const boot_args *args = PE_state.bootArgs;
+    if (!args || !cw_disjoint(CW_SMEM_BASE, CW_SMEM_SIZE, args->physBase, args->memSize)) {
+        printf("COACHZ wifi: SMEM overlaps the XNU memory window or boot args are unavailable, not mapped\n"); return;
+    }
+    static struct wifi_mapping mapping;
+    mapping.base = (uintptr_t)ml_io_map((vm_offset_t)CW_SMEM_BASE, CW_SMEM_SIZE);
+    if (!mapping.base) { printf("COACHZ wifi: SMEM map failed\n"); return; }
+    /* Kept for the kernel lifetime; no pointer escapes this module. */
+    const struct cw_reader reader = {&mapping, CW_SMEM_SIZE, wifi_read};
+    struct cw_smem layout;
+    const int status = cw_smem_layout(&reader, &layout);
+    printf("COACHZ wifi: SMEM v12 inventory status %d table entries %u\n", status, layout.count);
+    if (status) return;
+    wifi_partition("global", layout.has_global, &layout.global);
+    wifi_partition("apps-modem", layout.has_modem, &layout.modem);
+    wifi_modem_state(&reader, &layout);
+    wifi_glink_state(&reader, &layout);
+    wifi_smem_reader = reader;
+    wifi_smem_layout = layout;
+    __atomic_store_n(&wifi_smem_ready, 1, __ATOMIC_RELEASE);
+    printf("COACHZ wifi: inventory complete; MPSS/WLFW liveness and radio not tested\n");
+}
