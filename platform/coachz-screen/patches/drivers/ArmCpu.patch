+// SC7180 frequency domains, addresses from the device tree Linux runs with: A55, A76 and L3. Each has a table of states and
+// a state register (the interface of Linux's qcom-cpufreq-hw and osm-l3); the hardware sets the voltage itself. Nothing else
+// here votes, so the firmware's low state would stay. armcpu_freq[domain]: enabled, state before, state chosen, state read
+// back, MHz before, MHz chosen.
+volatile uint32_t armcpu_freq[3][6];
+static const uint64_t kFreqWindow = 0x18320000;
+static const uint32_t kFreqOffset[3] = {0x3000, 0x5800, 0x1000};
+static uintptr_t gFreqBase = 0;
+static bool gMaxFreq = false;
+
+static void mapFrequencyDomains (void)
+{
+  IOMemoryDescriptor *memory = IOMemoryDescriptor::withPhysicalAddress (kFreqWindow, 0x8000, kIODirectionInOut);
+  IOMemoryMap *map = memory != nullptr ? memory->map (kIOMapAnywhere | kIOMapInhibitCache) : nullptr;
+  // Kept for the life of the kernel: the A76 domain is raised when its first core starts.
+  if (map != nullptr) { gFreqBase = static_cast<uintptr_t> (map->getVirtualAddress ()); }
+}
+
+static uint32_t freqKhz (uint32_t row)
+{
+  return (row >> 30) != 0 ? 19200 * (row & 0xff) : 300000;
+}
+
+static void raiseFrequency (unsigned domain)
+{
+  if (!gMaxFreq || gFreqBase == 0) { return; }
+  const uintptr_t base = gFreqBase + kFreqOffset[domain];
+  volatile uint32_t *report = armcpu_freq[domain];
+  report[0] = read32 (base, 0) & 1;
+  if (report[0] == 0) { return; }
+  uint32_t best = 0, bestKhz = 0, previous = 0;
+  for (uint32_t index = 0; index < 40; index++) {
+    const uint32_t row = read32 (base, 0x110 + index * 32);
+    const uint32_t khz = freqKhz (row);
+    if (index > 0 && khz == previous) { break; }
+    // In a CPU domain, core count 1 marks a boost state, which Linux leaves off by default.
+    if (domain == 2 || ((row >> 16) & 7) != 1) { best = index; bestKhz = khz; }
+    previous = khz;
+  }
+  const uint32_t before = read32 (base, 0x920);
+  report[1] = before;
+  report[4] = before < 40 ? freqKhz (read32 (base, 0x110 + before * 32)) / 1000 : 0;
+  report[2] = best;
+  report[5] = bestKhz / 1000;
+  write32 (base, 0x920, best);
+  __asm__ volatile ("dsb sy" ::: "memory");
+  report[3] = read32 (base, 0x920);
+}
