+  waitClear (gDist, 0, 1U << 31);
+  write32 (gDist, 0, (*ctlrFound & ~3U) | 16U);
+  waitClear (gDist, 0, 1U << 31);
+  const unsigned interrupts = ((read32 (gDist, 4) & 31) + 1) * 32;
