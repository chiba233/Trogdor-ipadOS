 // Kernel-internal entries used for secondary CPU startup (Darwin 23 osfmk).
 extern "C" vm_offset_t ml_static_vtop (vm_offset_t);
 extern "C" char LowResetVectorBase[], LowResetVectorEnd[], ResetHandlerData[], const_boot_args[];
+// Coachz: TF-A's PSCI CPU_ON starts a core at EL2, but XNU's reset vector runs at EL1. This position-
+// independent stub repeats boot/entry.S's EL2 setup, also opens the GICv3 system registers to EL1 and gives
+// EL1 the real MIDR/MPIDR, then erets to the physical reset vector passed as the PSCI context id (x0).
+extern "C" char armcpu_el2_entry[], armcpu_el2_entry_end[];
+__asm__ (
+  "  .text\n"
+  "  .balign 4\n"
+  "  .globl _armcpu_el2_entry\n"
+  "_armcpu_el2_entry:\n"
+  "  mrs x9, CurrentEL\n"
+  "  cmp x9, #8\n"
+  "  b.ne 1f\n"
+  "  mov x9, #0x80000000\n"        // HCR_EL2.RW: AArch64 EL1, no stage-2 translation
+  "  msr hcr_el2, x9\n"
+  "  mov x9, #0x33ff\n"            // CPTR_EL2 RES1, no FP trapping
+  "  msr cptr_el2, x9\n"
+  "  msr mdcr_el2, xzr\n"
+  "  mrs x9, cnthctl_el2\n"
+  "  orr x9, x9, #3\n"             // EL1 physical timer and counter access
+  "  msr cnthctl_el2, x9\n"
+  "  msr cntvoff_el2, xzr\n"
+  "  mrs x9, S3_4_C12_C9_5\n"      // ICC_SRE_EL2: SRE and Enable, so EL1 uses the GICv3 system registers
+  "  orr x9, x9, #1\n"             // SRE
+  "  orr x9, x9, #8\n"             // Enable
+  "  msr S3_4_C12_C9_5, x9\n"
+  "  isb\n"
+  "  msr S3_4_C12_C11_0, xzr\n"    // ICH_HCR_EL2
+  "  mrs x9, midr_el1\n"
+  "  msr vpidr_el2, x9\n"
+  "  mrs x9, mpidr_el1\n"
+  "  msr vmpidr_el2, x9\n"
+  "  mov x9, #0x0800\n"
+  "  movk x9, #0x30d0, lsl #16\n"  // SCTLR_EL1 RES1, M/C/I disabled
+  "  msr sctlr_el1, x9\n"
+  "  msr elr_el2, x0\n"
+  "  mov x9, #0x3c5\n"             // DAIF masked, EL1h
+  "  msr spsr_el2, x9\n"
+  "  mov x0, #0\n"
+  "  isb\n"
+  "  eret\n"
+  "1:\n"
+  "  mov x9, x0\n"
+  "  mov x0, #0\n"
+  "  br x9\n"
+  "  .globl _armcpu_el2_entry_end\n"
+  "_armcpu_el2_entry_end:\n");
