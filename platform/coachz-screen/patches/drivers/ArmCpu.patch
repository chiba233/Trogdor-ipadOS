 // Readback after configuration: bit 0 group 1, bit 1 enabled, bit 2 edge, bits 8..15 priority; IROUTER separately.
 extern "C" IOReturn armcpu_spi_attach (uint32_t intid, bool edge, void (*handler) (void *), void *context,
                                        uint32_t *readback, uint64_t *router)
 {
+  // Coachz: a driver thread can get here before the boot CPU's ArmCpu has set the GIC up. k224's eMMC power interrupt did,
+  // got kIOReturnNotReady, gave up, and the root and the disk log never came (the early log in ramoops showed
+  // "pwr_irq 676 not attached" two lines before "COACHZ GIC:"). From a caller with interrupts on, wait for the GIC (polled
+  // with IODelay, which needs no timer interrupt) for up to 10 s.
+  if ((gDist == 0 || armcpu_gic_ready == 0) && ml_get_interrupts_enabled ()) {
+    unsigned waited = 0;
+    while ((__atomic_load_n (&gDist, __ATOMIC_ACQUIRE) == 0 || __atomic_load_n (&armcpu_gic_ready, __ATOMIC_ACQUIRE) == 0) &&
+           waited < 10000) {
+      IODelay (1000);
+      waited++;
+    }
+    kprintf ("COACHZ SMP: SPI %u waited %u ms for the GIC: %s\n", intid, waited, armcpu_gic_ready ? "ready" : "still not ready");
+  }
