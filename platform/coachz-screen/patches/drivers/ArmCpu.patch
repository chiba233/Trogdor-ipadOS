   if (intid < 32 || intid >= 1020 || intid >= interrupts) { return kIOReturnBadArgument; }
+  // Coachz: drivers attach from their own threads at the same time (both SDHCI slots, the USB host, GPU, Wi-Fi). Unserialized, two
+  // callers read the same gSpiUsed, fill the same slot and one handler is lost: its SPI then fires into "no handler" and is
+  // disabled, and the driver waits for it forever. The slot choice, the GICD read-modify-writes and the publication are one step.
+  static volatile uint32_t attachBusy = 0;
+  while (!__sync_bool_compare_and_swap (&attachBusy, 0U, 1U)) { __asm__ volatile ("yield"); }
