+  for (uint32_t slot = 0; slot < gSpiSavedCount; slot++) {
+    const uint32_t intid = gSpi[slot].id, word = (intid / 32) * 4, bit = 1U << (intid % 32);
+    const unsigned cfg = 0xc00 + (intid / 16) * 4, shift = (intid % 16) * 2 + 1;
+    const ArmCpuSpiState &saved = gSpiSaved[slot];
+    if (((read32 (gDist, 0x100 + word) & bit) ? 1 : 0) == saved.enabled &&
+        *reinterpret_cast<volatile uint8_t *> (gDist + 0x400 + intid) == saved.priority &&
+        ((read32 (gDist, cfg) >> shift) & 1U) == saved.edge &&
+        *reinterpret_cast<volatile uint64_t *> (gDist + 0x6000 + 8 * intid) == saved.router) {
