+// PDC 3.2 and in bit 3 of IRQ_i_CFG from 3.2. The pin's GIC SPI stays as it is: nothing here handles the EC's interrupt.
+static void pdcArm (void)
+{
+  if (gPdc == 0) { return; }
+  const unsigned cfg = 0x110 + 4 * kPdcEcPin, bank = 0x10 + 4 * (kPdcEcPin / 32);
+  const uint32_t bit = 1U << (kPdcEcPin % 32);
