+/*
+ * Keep the screen console alive once the bootstrap TTBR0 goes away: a Normal-NC
+ * alias in the unused blocks between low globals and the kernel.
+ */
+#define COACHZ_EARLY_ALIAS_BLOCK 16
+
+static uintptr_t
+coachz_early_map_final(void)
+{
+	uint64_t pa, bytes;
+	if (!coachz_early_range(&pa, &bytes)) {
+		return 0;
+	}
+	const uintptr_t va = (gVirtBase & ~(uintptr_t)(ARM_TT_L1_SIZE - 1)) + COACHZ_EARLY_ALIAS_BLOCK * ARM_TT_L2_SIZE;
+	const uint64_t base = pa & ~(uint64_t)(ARM_TT_L2_SIZE - 1);
+	const uint64_t blocks = (pa + bytes - base + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE;
+	if (va + blocks * ARM_TT_L2_SIZE > gVirtBase) {
+		return 0;
+	}
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		return 0;
+	}
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	for (uint64_t i = 0; i < blocks; i++) {
+		if (l2[((va + i * ARM_TT_L2_SIZE) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT] != ARM_TTE_EMPTY) {
+			return 0;
+		}
+	}
+	for (uint64_t i = 0; i < blocks; i++) {
+		l2[((va + i * ARM_TT_L2_SIZE) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT] = (base + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile ("dsb ishst" ::: "memory");
+	return va;
+}
