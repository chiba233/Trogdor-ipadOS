diff --git a/osfmk/arm64/coachz_early.c b/osfmk/arm64/coachz_early.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/coachz_early.c
@@ -0,0 +1,221 @@
+/*
+ * Coachz screen console for kernel bring-up, adapted from sweet_early.c in
+ * ios-sweet (MIT, Copyright (c) 2026 dipa-studio). The boot probe restarts the
+ * scanout Depthcharge stopped and describes it in boot_args.Video.
+ *
+ * No allocation, locks, ADT parsing or per-CPU state: panic() can reach this
+ * before a current thread exists. Until arm_vm_init replaces it, the
+ * framebuffer is mapped VA=PA in the bootstrap TTBR0 as Normal Non-Cacheable.
+ */
+#include <arm64/coachz_early.h>
+#include <arm64/proc_reg.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_BLACK 0xff000000u
+#define EARLY_WHITE 0xffffffffu
+
+extern unsigned char iso_font[256 * 16];
+extern uint64_t bootstrap_pagetables[];
+
+static volatile uint32_t *early_fb;
+static uint64_t early_pa, early_bytes;
+static uint32_t early_width, early_height, early_stride;
+static uint32_t early_rows, early_cols, early_row, early_col;
+static unsigned int early_panicking;
+
+static void
+coachz_early_clear_row(uint32_t row)
+{
+	for (uint32_t y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = early_fb + (row * EARLY_CELL_H + y) * early_stride;
+		for (uint32_t x = 0; x < early_width; x++) {
+			line[x] = EARLY_BLACK;
+		}
+	}
+}
+
+static void
+coachz_early_newline(void)
+{
+	early_col = 0;
+	early_row = (early_row + 1) % early_rows;
+	coachz_early_clear_row(early_row);
+	coachz_early_clear_row((early_row + 1) % early_rows);
+}
+
+void
+coachz_early_putc(char c)
+{
+	if (early_fb == NULL) {
+		return;
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		coachz_early_newline();
+		return;
+	}
+	if (early_col >= early_cols) {
+		coachz_early_newline();
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * early_stride +
+			    early_col * EARLY_CELL_W;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? EARLY_WHITE : EARLY_BLACK;
+				for (uint32_t sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+coachz_early_string(const char *s)
+{
+	while (*s) {
+		coachz_early_putc(*s++);
+	}
+}
+
+void
+coachz_early_init(const boot_args *args)
+{
+	uint64_t pa = args->Video.v_baseAddr;
+	uint32_t width = (uint32_t)args->Video.v_width;
+	uint32_t height = (uint32_t)args->Video.v_height;
+	uint32_t row_bytes = (uint32_t)args->Video.v_rowBytes;
+
+	if (pa == 0 || width == 0 || height < EARLY_CELL_H * 2 || row_bytes < width * 4) {
+		return;
+	}
+	uint64_t *slot = &bootstrap_pagetables[pa >> ARM_TT_L1_SHIFT];
+	if (*slot != 0) {
+		return;
+	}
+	*slot = (pa & ~(uint64_t)(ARM_TT_L1_SIZE - 1)) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	__asm__ volatile ("dsb ish; isb" ::: "memory");
+
+	early_pa = pa;
+	early_bytes = (uint64_t)row_bytes * height;
+	early_width = width;
+	early_height = height;
+	early_stride = row_bytes / 4;
+	early_rows = height / EARLY_CELL_H;
+	early_cols = width / EARLY_CELL_W;
+	early_row = early_col = 0;
+	early_fb = (volatile uint32_t *)(uintptr_t)pa;
+	coachz_early_clear_row(0);
+	coachz_early_clear_row(1);
+}
+
+void
+coachz_early_mark(unsigned int stage, const char *label)
+{
+	coachz_early_string("COACHZ ");
+	if (stage >= 10) {
+		coachz_early_putc((char)('0' + (stage / 10) % 10));
+	}
+	coachz_early_putc((char)('0' + stage % 10));
+	coachz_early_string(": ");
+	coachz_early_string(label);
+	coachz_early_putc('\n');
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+coachz_early_hex(uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+	coachz_early_string(" 0x");
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		coachz_early_putc(digits[(value >> shift) & 15]);
+	}
+}
+
+/* Bounded frame-pointer walk within the current stack: symbolicate offline. */
+static void
+coachz_early_backtrace(void)
+{
+	uintptr_t fp = (uintptr_t)__builtin_frame_address(0);
+	const uintptr_t low = fp, high = fp + 64 * 1024;
+
+	coachz_early_string("COACHZ BT:");
+	for (unsigned int i = 0; i < 24; i++) {
+		if ((fp & 15) || fp < low || fp + 16 > high) {
+			break;
+		}
+		const uintptr_t next = ((const uintptr_t *)fp)[0];
+		const uintptr_t lr = ((const uintptr_t *)fp)[1];
+		if (lr == 0) {
+			break;
+		}
+		coachz_early_hex(lr);
+		if (i % 6 == 5) {
+			coachz_early_putc('\n');
+		}
+		if (next <= fp) {
+			break;
+		}
+		fp = next;
+	}
+	coachz_early_putc('\n');
+}
+
+void
+coachz_early_panic(const char *fmt, va_list *args)
+{
+	if (early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	coachz_early_string("\nCOACHZ PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, coachz_early_putc, 16);
+	va_end(copy);
+	coachz_early_putc('\n');
+	coachz_early_backtrace();
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+int
+coachz_early_active(void)
+{
+	return early_fb != NULL;
+}
+
+int
+coachz_early_range(uint64_t *pa, uint64_t *bytes)
+{
+	if (early_fb == NULL) {
+		return 0;
+	}
+	*pa = early_pa;
+	*bytes = early_bytes;
+	return 1;
+}
+
+void
+coachz_early_relocate(uintptr_t block_va)
+{
+	early_fb = (volatile uint32_t *)(block_va + (early_pa & (ARM_TT_L2_SIZE - 1)));
+}
+
+void
+coachz_early_disable(void)
+{
+	early_fb = NULL;
+}
