+++ b/bsd/kern/coachz_amfi.c
@@ -0,0 +1,153 @@
+/*
+ * Built-in AMFI interface for the Coachz screen kernel, adapted from sweet_amfi.c in
+ * ios-sweet (MIT, Copyright (c) 2026 dipa-studio). AppleMobileFileIntegrity normally
+ * registers this from prelink, which this kernel does not have yet, and every exec
+ * reaches it through ubc_cs_blob_add. Remove this file when prelink is added: the kext
+ * registering a second interface panics.
+ *
+ * It reports that no entitlements exist: nothing is granted, and code signature and page
+ * hash validation stay with the kernel. The trust cache interface stays at version 0.
+ */
+#include <kern/debug.h>
+#include <kern/startup.h>
+#include <libkern/amfi/amfi.h>
+#include <mach/kern_return.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+
+static void
+coachz_amfi_invalidate(__unused void *os_entitlements)
+{
+}
+
+static void *
+coachz_amfi_as_dict(__unused void *os_entitlements)
+{
+	return NULL;
+}
+
+static CEError_t
+coachz_amfi_query(__unused void *os_entitlements, __unused uint8_t cdhash[CS_CDHASH_LEN],
+    __unused CEQuery_t query, __unused size_t query_length)
+{
+	panic("Coachz AMFI: CoreEntitlements queries are not implemented");
+}
+
+static bool
+coachz_amfi_get_transmuted(__unused void *os_entitlements, __unused const CS_GenericBlob **blob)
+{
+	return false;
+}
+
+static bool
+coachz_amfi_get_xml(__unused void *os_entitlements, __unused CS_GenericBlob **blob)
+{
+	return false;
+}
+
+static bool
+coachz_amfi_profile_exemptions(__unused const uint8_t **profile, __unused size_t *profile_length)
+{
+	return false;
+}
+
+static bool
+coachz_amfi_get_udid(__unused const uint8_t **udid, __unused size_t *udid_length)
+{
+	return false;
+}
+
+static void *
+coachz_amfi_context_to_object(__unused CEQueryContext_t ctx)
+{
+	panic("Coachz AMFI: CoreEntitlements query contexts are not implemented");
+}
+
+static kern_return_t
+coachz_amfi_adjust_with_monitor(__unused void *os_entitlements, __unused const CEQueryContext_t ce_ctx,
+    __unused const void *monitor_sig_obj, __unused const char *identity, __unused const uint32_t code_signing_flags)
+{
+	return KERN_NOT_SUPPORTED;
+}
+
+static kern_return_t
+coachz_amfi_adjust_without_monitor(__unused void *os_entitlements, __unused struct cs_blob *code_signing_blob)
+{
+	return KERN_SUCCESS;
+}
+
+static kern_return_t
+coachz_amfi_query_boolean(__unused const void *os_entitlements, __unused const char *entitlement_name)
+{
+	return KERN_DENIED;
+}
+
+static kern_return_t
+coachz_amfi_query_boolean_proc(__unused const proc_t proc, __unused const char *entitlement_name)
+{
+	return KERN_DENIED;
+}
+
+static kern_return_t
+coachz_amfi_query_string(__unused const void *os_entitlements, __unused const char *entitlement_name,
+    __unused const char *entitlement_value)
+{
+	return KERN_DENIED;
+}
+
+static kern_return_t
+coachz_amfi_query_string_proc(__unused const proc_t proc, __unused const char *entitlement_name,
+    __unused const char *entitlement_value)
+{
+	return KERN_DENIED;
+}
+
+static kern_return_t
+coachz_amfi_copy_object(__unused const void *os_entitlements, __unused const char *entitlement_name,
+    void **entitlement_object)
+{
+	if (entitlement_object) {
+		*entitlement_object = NULL;
+	}
+	return KERN_NOT_FOUND;
+}
+
+static kern_return_t
+coachz_amfi_copy_object_proc(__unused const proc_t proc, __unused const char *entitlement_name,
+    void **entitlement_object)
+{
+	if (entitlement_object) {
+		*entitlement_object = NULL;
+	}
+	return KERN_NOT_FOUND;
+}
+
+static const amfi_t coachz_amfi = {
+	.OSEntitlements_invalidate = coachz_amfi_invalidate,
+	.OSEntitlements_asdict = coachz_amfi_as_dict,
+	.OSEntitlements_query = coachz_amfi_query,
+	.OSEntitlements_get_transmuted = coachz_amfi_get_transmuted,
+	.OSEntitlements_get_xml = coachz_amfi_get_xml,
+	.get_legacy_profile_exemptions = coachz_amfi_profile_exemptions,
+	.get_udid = coachz_amfi_get_udid,
+	.query_context_to_object = coachz_amfi_context_to_object,
+	.OSEntitlements = {
+		.version = OSENTITLEMENTS_INTERFACE_VERSION,
+		.adjustContextWithMonitor = coachz_amfi_adjust_with_monitor,
+		.adjustContextWithoutMonitor = coachz_amfi_adjust_without_monitor,
+		.queryEntitlementBoolean = coachz_amfi_query_boolean,
+		.queryEntitlementBooleanWithProc = coachz_amfi_query_boolean_proc,
+		.queryEntitlementString = coachz_amfi_query_string,
+		.queryEntitlementStringWithProc = coachz_amfi_query_string_proc,
+		.copyEntitlementAsOSObject = coachz_amfi_copy_object,
+		.copyEntitlementAsOSObjectWithProc = coachz_amfi_copy_object_proc,
+	},
+};
+
+__startup_func
+static void
+coachz_amfi_register(void)
+{
+	amfi_interface_register(&coachz_amfi);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, coachz_amfi_register);
